ta-access#reading-cells-with-labels","content":"Reading Cells with Labels"},"8239":{"id":"/docs/security/data-access-18","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#hbase-shell-toc","content":"HBase Shell: [!toc]"},"8240":{"id":"/docs/security/data-access-19","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#java-api-toc","content":"Java API: [!toc]"},"8241":{"id":"/docs/security/data-access-20","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#implementing-your-own-visibility-label-algorithm","content":"Implementing Your Own Visibility Label Algorithm"},"8242":{"id":"/docs/security/data-access-21","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#replicating-visibility-tags-as-strings","content":"Replicating Visibility Tags as Strings"},"8243":{"id":"/docs/security/data-access-22","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#transparent-encryption-of-data-at-rest","content":"Transparent Encryption of Data At Rest"},"8244":{"id":"/docs/security/data-access-23","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#how-it-works-1","content":"How It Works"},"8245":{"id":"/docs/security/data-access-24","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#enable-or-disable-the-feature","content":"Enable or disable the feature."},"8246":{"id":"/docs/security/data-access-25","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Server-Side Configuration"},"8247":{"id":"/docs/security/data-access-26","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#data-access-administration-encryption","content":"Administration"},"8248":{"id":"/docs/security/data-access-27","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#enable-encryption-on-a-column-family","content":"Enable Encryption on a Column Family"},"8249":{"id":"/docs/security/data-access-28","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#rotate-the-data-key","content":"Rotate the Data Key"},"8250":{"id":"/docs/security/data-access-29","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#switching-between-using-a-random-data-key-and-specifying-a-key","content":"Switching Between Using a Random Data Key and Specifying A Key"},"8251":{"id":"/docs/security/data-access-30","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#rotate-the-master-key","content":"Rotate the Master Key"},"8252":{"id":"/docs/security/data-access-31","page_id":"/docs/security/data-access","type":"heading","tags":["multi-page"],"url":"/docs/security/data-access#secure-enable","content":"Secure Enable"},"8253":{"id":"/docs/security/data-access-32","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access","content":"After you have configured secure authentication between HBase client and server processes and gateways, you need to consider the security of your data itself. HBase provides several strategies for securing your data:"},"8254":{"id":"/docs/security/data-access-33","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access","content":"Role-based Access Control (RBAC) controls which users or groups can read and write to a given HBase resource or execute a coprocessor endpoint, using the familiar paradigm of roles."},"8255":{"id":"/docs/security/data-access-34","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access","content":"Visibility Labels which allow you to label cells and control access to labelled cells, to further restrict who can read or write to certain subsets of your data. Visibility labels are stored as tags. See hbase.tags for more information."},"8256":{"id":"/docs/security/data-access-35","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access","content":"Transparent encryption of data at rest on the underlying filesystem, both in HFiles and in the WAL. This protects your data at rest from an attacker who has access to the underlying filesystem, without the need to change the implementation of the client. It can also protect against data leakage from improperly disposed disks, which can be important for legal and regulatory compliance."},"8257":{"id":"/docs/security/data-access-36","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access","content":"Server-side configuration, administration, and implementation details of each of these features are discussed below, along with any performance trade-offs. An example security configuration is given at the end, to show these features all used together, as they might be in a real-world scenario."},"8258":{"id":"/docs/security/data-access-37","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access","content":"All aspects of security in HBase are in active development and evolving rapidly. Any strategy you\nemploy for security of your data should be thoroughly tested. In addition, some of these features\nare still in the experimental stage of development. To take advantage of many of these features,\nyou must be running HBase 0.98+ and using the HFile v3 file format."},"8259":{"id":"/docs/security/data-access-38","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access","content":"Several procedures in this section require you to copy files between cluster nodes. When copying\nkeys, configuration files, or other files containing sensitive strings, use a secure method, such\nas `ssh`, to avoid leaking sensitive data."},"8260":{"id":"/docs/security/data-access-39","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#procedure-basic-server-side-configuration","content":"Enable HFile v3, by setting `hfile.format.version` to 3 in *hbase-site.xml*. This is the default for HBase 1.0 and newer."},"8261":{"id":"/docs/security/data-access-40","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#procedure-basic-server-side-configuration","content":"Enable SASL and Kerberos authentication for RPC and ZooKeeper, as described in security.prerequisites and ZooKeeper."},"8262":{"id":"/docs/security/data-access-41","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#tags","content":"*Tags* are a feature of HFile v3. A tag is a piece of metadata which is part of a cell, separate from the key, value, and version. Tags are an implementation detail which provides a foundation for other security-related features such as cell-level ACLs and visibility labels. Tags are stored in the HFiles themselves. It is possible that in the future, tags will be used to implement other HBase features. You don't need to know a lot about tags in order to use the security features they enable."},"8263":{"id":"/docs/security/data-access-42","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementation-details","content":"Every cell can have zero or more tags. Every tag has a type and the actual tag byte array."},"8264":{"id":"/docs/security/data-access-43","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementation-details","content":"Just as row keys, column families, qualifiers and values can be encoded (see data.block.encoding.types), tags can also be encoded as well. You can enable or disable tag encoding at the level of the column family, and it is enabled by default. Use the `HColumnDescriptor#setCompressionTags(boolean compressTags)` method to manage encoding settings on a column family. You also need to enable the DataBlockEncoder for the column family, for encoding of tags to take effect."},"8265":{"id":"/docs/security/data-access-44","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementation-details","content":"You can enable compression of each tag in the WAL, if WAL compression is also enabled, by setting the value of `hbase.regionserver.wal.tags.enablecompression` to `true` in *hbase-site.xml*. Tag compression uses dictionary encoding."},"8266":{"id":"/docs/security/data-access-45","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementation-details","content":"Coprocessors that run server-side on RegionServers can perform get and set operations on cell Tags. Tags are stripped out at the RPC layer before the read response is sent back, so clients do not see these tags. Tag compression is not supported when using WAL encryption."},"8267":{"id":"/docs/security/data-access-46","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works","content":"ACLs in HBase are based upon a user's membership in or exclusion from groups, and a given group's permissions to access a given resource. ACLs are implemented as a coprocessor called AccessController."},"8268":{"id":"/docs/security/data-access-47","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works","content":"HBase does not maintain a private group mapping, but relies on a &#x2A;**Hadoop group mapper***, which maps between entities in a directory such as LDAP or Active Directory, and HBase users. Any supported Hadoop group mapper will work. Users are then granted specific permissions (Read, Write, Execute, Create, Admin) against resources (global, namespaces, tables, cells, or endpoints)."},"8269":{"id":"/docs/security/data-access-48","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works","content":"With Kerberos and Access Control enabled, client access to HBase is authenticated and user data is\nprivate unless access has been explicitly granted."},"8270":{"id":"/docs/security/data-access-49","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works","content":"HBase has a simpler security model than relational databases, especially in terms of client operations. No distinction is made between an insert (new record) and update (of existing record), for example, as both collapse down into a Put."},"8271":{"id":"/docs/security/data-access-50","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"HBase access levels are granted independently of each other and allow for different types of operations at a given scope."},"8272":{"id":"/docs/security/data-access-51","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Read (R)* - can read data at the given scope"},"8273":{"id":"/docs/security/data-access-52","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Write (W)* - can write data at the given scope"},"8274":{"id":"/docs/security/data-access-53","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Execute (X)* - can execute coprocessor endpoints at the given scope"},"8275":{"id":"/docs/security/data-access-54","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Create (C)* - can create tables or drop tables (even those they did not create) at the given scope"},"8276":{"id":"/docs/security/data-access-55","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Admin (A)* - can perform cluster operations such as balancing the cluster or assigning regions at the given scope"},"8277":{"id":"/docs/security/data-access-56","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"The possible scopes are:"},"8278":{"id":"/docs/security/data-access-57","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Superuser* - superusers can perform any operation available in HBase, to any resource. The user who runs HBase on your cluster is a superuser, as are any principals assigned to the configuration property `hbase.superuser` in *hbase-site.xml* on the HMaster."},"8279":{"id":"/docs/security/data-access-58","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Global* - permissions granted at *global* scope allow the admin to operate on all tables of the cluster."},"8280":{"id":"/docs/security/data-access-59","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Namespace* - permissions granted at *namespace* scope apply to all tables within a given namespace."},"8281":{"id":"/docs/security/data-access-60","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Table* - permissions granted at *table* scope apply to data or metadata within a given table."},"8282":{"id":"/docs/security/data-access-61","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*ColumnFamily* - permissions granted at *ColumnFamily* scope apply to cells within that ColumnFamily."},"8283":{"id":"/docs/security/data-access-62","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Cell* - permissions granted at *cell* scope apply to that exact cell coordinate (key, value, timestamp). This allows for policy evolution along with data.\nTo change an ACL on a specific cell, write an updated cell with new ACL to the precise coordinates of the original.\\\nIf you have a multi-versioned schema and want to update ACLs on all visible versions, you need to write new cells for all visible versions. The application has complete control over policy evolution.\\\nThe exception to the above rule is `append` and `increment` processing. Appends and increments can carry an ACL in the operation. If one is included in the operation, then it will be applied to the result of the `append` or `increment`. Otherwise, the ACL of the existing cell you are appending to or incrementing is preserved."},"8284":{"id":"/docs/security/data-access-63","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"The combination of access levels and scopes creates a matrix of possible access levels that can be granted to a user. In a production environment, it is useful to think of access levels in terms of what is needed to do a specific job. The following list describes appropriate access levels for some common types of HBase users. It is important not to grant more access than is required for a given user to perform their required tasks."},"8285":{"id":"/docs/security/data-access-64","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Superusers* - In a production system, only the HBase user should have superuser access. In a development environment, an administrator may need superuser access in order to quickly control and manage the cluster. However, this type of administrator should usually be a Global Admin rather than a superuser."},"8286":{"id":"/docs/security/data-access-65","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Global Admins* - A global admin can perform tasks and access every table in HBase. In a typical production environment, an admin should not have Read or Write permissions to data within tables."},"8287":{"id":"/docs/security/data-access-66","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"A global admin with Admin permissions can perform cluster-wide operations on the cluster, such as balancing, assigning or unassigning regions, or calling an explicit major compaction. This is an operations role."},"8288":{"id":"/docs/security/data-access-67","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"A global admin with Create permissions can create or drop any table within HBase. This is more of a DBA-type role.\nIn a production environment, it is likely that different users will have only one of Admin and Create permissions."},"8289":{"id":"/docs/security/data-access-68","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"In the current implementation, a Global Admin with `Admin` permission can grant himself `Read`\nand `Write` permissions on a table and gain access to that table's data. For this reason, only\ngrant `Global Admin` permissions to trusted user who actually need them. Also be aware that a\n`Global Admin` with `Create` permission can perform a `Put` operation on the ACL table,\nsimulating a `grant` or `revoke` and circumventing the authorization check for `Global Admin`\npermissions. Due to these issues, be cautious with granting `Global Admin` privileges."},"8290":{"id":"/docs/security/data-access-69","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Namespace Admins* - a namespace admin with `Create` permissions can create or drop tables within that namespace, and take and restore snapshots. A namespace admin with `Admin` permissions can perform operations such as splits or major compactions on tables within that namespace."},"8291":{"id":"/docs/security/data-access-70","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Table Admins* - A table admin can perform administrative operations only on that table. A table admin with `Create` permissions can create snapshots from that table or restore that table from a snapshot. A table admin with `Admin` permissions can perform operations such as splits or major compactions on that table."},"8292":{"id":"/docs/security/data-access-71","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#understanding-access-levels","content":"*Users* - Users can read or write data, or both. Users can also execute coprocessor endpoints, if given `Executable` permissions."},"8293":{"id":"/docs/security/data-access-72","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Job Title"},"8294":{"id":"/docs/security/data-access-73","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Scope"},"8295":{"id":"/docs/security/data-access-74","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Permissions"},"8296":{"id":"/docs/security/data-access-75","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Description"},"8297":{"id":"/docs/security/data-access-76","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Senior Administrator"},"8298":{"id":"/docs/security/data-access-77","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Global"},"8299":{"id":"/docs/security/data-access-78","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Access, Create"},"8300":{"id":"/docs/security/data-access-79","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Manages the cluster and gives access to Junior Administrators."},"8301":{"id":"/docs/security/data-access-80","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Junior Administrator"},"8302":{"id":"/docs/security/data-access-81","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Global"},"8303":{"id":"/docs/security/data-access-82","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Create"},"8304":{"id":"/docs/security/data-access-83","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Creates tables and gives access to Table Administrators."},"8305":{"id":"/docs/security/data-access-84","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Table Administrator"},"8306":{"id":"/docs/security/data-access-85","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Table"},"8307":{"id":"/docs/security/data-access-86","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Access"},"8308":{"id":"/docs/security/data-access-87","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Maintains a table from an operations point of view."},"8309":{"id":"/docs/security/data-access-88","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Data Analyst"},"8310":{"id":"/docs/security/data-access-89","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Table"},"8311":{"id":"/docs/security/data-access-90","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Read"},"8312":{"id":"/docs/security/data-access-91","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Creates reports from HBase data."},"8313":{"id":"/docs/security/data-access-92","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Web Application"},"8314":{"id":"/docs/security/data-access-93","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Table"},"8315":{"id":"/docs/security/data-access-94","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Read, Write"},"8316":{"id":"/docs/security/data-access-95","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#real-world-example-of-access-levels-toc","content":"Puts data into HBase and uses HBase data to perform operations."},"8317":{"id":"/docs/security/data-access-96","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#acl-matrix-toc","content":"For more details on how ACLs map to specific HBase operations and tasks, see appendix acl matrix."},"8318":{"id":"/docs/security/data-access-97","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementation-details-1","content":"Cell-level ACLs are implemented using tags (see Tags). In order to use cell-level ACLs, you must be using HFile v3 and HBase 0.98 or newer."},"8319":{"id":"/docs/security/data-access-98","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementation-details-1","content":"Files created by HBase are owned by the operating system user running the HBase process. To interact with HBase files, you should use the API or bulk load facility."},"8320":{"id":"/docs/security/data-access-99","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementation-details-1","content":"HBase does not model \"roles\" internally in HBase. Instead, group names can be granted permissions. This allows external modeling of roles via group membership. Groups are created and manipulated externally to HBase, via the Hadoop group mapping service."},"8321":{"id":"/docs/security/data-access-100","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"As a prerequisite, perform the steps in Procedure: Basic Server-Side Configuration."},"8322":{"id":"/docs/security/data-access-101","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"Install and configure the AccessController coprocessor, by setting the following properties in *hbase-site.xml*. These properties take a list of classes."},"8323":{"id":"/docs/security/data-access-102","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"If you use the AccessController along with the VisibilityController, the AccessController must\ncome first in the list, because with both components active, the VisibilityController will\ndelegate access control on its system tables to the AccessController. For an example of using both\ntogether, see Security Configuration Example."},"8324":{"id":"/docs/security/data-access-103","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"Optionally, you can enable transport security, by setting `hbase.rpc.protection` to\n`privacy`. This requires HBase 0.98.4 or newer."},"8325":{"id":"/docs/security/data-access-104","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"Set up the Hadoop group mapper in the Hadoop namenode's *core-site.xml*. This is a Hadoop file, not an HBase file. Customize it to your site's needs. Following is an example."},"8326":{"id":"/docs/security/data-access-105","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"Optionally, enable the early-out evaluation strategy. Prior to HBase 0.98.0, if a user was not granted access to a column family, or at least a column qualifier, an AccessDeniedException would be thrown. HBase 0.98.0 removed this exception in order to allow cell-level exceptional grants. To restore the old behavior in HBase 0.98.0-0.98.6, set `hbase.security.access.early_out` to `true` in *hbase-site.xml*. In HBase 0.98.6, the default has been returned to `true`."},"8327":{"id":"/docs/security/data-access-106","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"Distribute your configuration and restart your cluster for changes to take effect."},"8328":{"id":"/docs/security/data-access-107","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-acl-server-side-configuration","content":"To test your configuration, log into HBase Shell as a given user and use the `whoami` command to report the groups your user is part of. In this example, the user is reported as being a member of the `services` group."},"8329":{"id":"/docs/security/data-access-108","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Administration tasks can be performed from HBase Shell or via an API."},"8330":{"id":"/docs/security/data-access-109","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Many of the API examples below are taken from source files *hbase-server/src/test/java/org/apache/hadoop/hbase/security/access/TestAccessController.java* and *hbase-server/src/test/java/org/apache/hadoop/hbase/security/access/SecureTestUtil.java*."},"8331":{"id":"/docs/security/data-access-110","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Neither the examples, nor the source files they are taken from, are part of the public HBase API, and are provided for illustration only. Refer to the official API for usage instructions."},"8332":{"id":"/docs/security/data-access-111","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"As a prerequisite, perform the steps in Procedure: Basic Server-Side Configuration.."},"8333":{"id":"/docs/security/data-access-112","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Install and configure the AccessController coprocessor, by setting the following properties in *hbase-site.xml*. These properties take a list of classes."},"8334":{"id":"/docs/security/data-access-113","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"If you use the AccessController along with the VisibilityController, the AccessController must\ncome first in the list, because with both components active, the VisibilityController will\ndelegate access control on its system tables to the AccessController. For an example of using both\ntogether, see Security Configuration Example."},"8335":{"id":"/docs/security/data-access-114","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Optionally, you can enable transport security, by setting `hbase.rpc.protection` to\n`privacy`. This requires HBase 0.98.4 or newer."},"8336":{"id":"/docs/security/data-access-115","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Set up the Hadoop group mapper in the Hadoop namenode's *core-site.xml*. This is a Hadoop file, not an HBase file. Customize it to your site's needs. Following is an example."},"8337":{"id":"/docs/security/data-access-116","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Optionally, enable the early-out evaluation strategy. Prior to HBase 0.98.0, if a user was not granted access to a column family, or at least a column qualifier, an AccessDeniedException would be thrown. HBase 0.98.0 removed this exception in order to allow cell-level exceptional grants. To restore the old behavior in HBase 0.98.0-0.98.6, set `hbase.security.access.early_out` to `true` in *hbase-site.xml*. In HBase 0.98.6, the default has been returned to `true`."},"8338":{"id":"/docs/security/data-access-117","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"Distribute your configuration and restart your cluster for changes to take effect."},"8339":{"id":"/docs/security/data-access-118","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-shell","content":"To test your configuration, log into HBase Shell as a given user and use the `whoami` command to report the groups your user is part of. In this example, the user is reported as being a member of the `services` group."},"8340":{"id":"/docs/security/data-access-119","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"Visibility labels control can be used to only permit users or principals associated with a given label to read or access cells with that label. For instance, you might label a cell `top-secret`, and only grant access to that label to the `managers` group. Visibility labels are implemented using Tags, which are a feature of HFile v3, and allow you to store metadata on a per-cell basis. A label is a string, and labels can be combined into expressions by using logical operators (&, |, or !), and using parentheses for grouping. HBase does not do any kind of validation of expressions beyond basic well-formedness. Visibility labels have no meaning on their own, and may be used to denote sensitivity level, privilege level, or any other arbitrary semantic meaning."},"8341":{"id":"/docs/security/data-access-120","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"If a user's labels do not match a cell's label or expression, the user is denied access to the cell."},"8342":{"id":"/docs/security/data-access-121","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"In HBase 0.98.6 and newer, UTF-8 encoding is supported for visibility labels and expressions. When creating labels using the `addLabels(conf, labels)` method provided by the `org.apache.hadoop.hbase.security.visibility.VisibilityClient` class and passing labels in Authorizations via Scan or Get, labels can contain UTF-8 characters, as well as the logical operators normally used in visibility labels, with normal Java notations, without needing any escaping method. However, when you pass a CellVisibility expression via a Mutation, you must enclose the expression with the `CellVisibility.quote()` method if you use UTF-8 characters or logical operators. See `TestExpressionParser` and the source file *hbase-client/src/test/java/org/apache/hadoop/hbase/client/TestScan.java*."},"8343":{"id":"/docs/security/data-access-122","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"A user adds visibility expressions to a cell during a Put operation. In the default configuration, the user does not need to have access to a label in order to label cells with it. This behavior is controlled by the configuration option `hbase.security.visibility.mutations.checkauths`. If you set this option to `true`, the labels the user is modifying as part of the mutation must be associated with the user, or the mutation will fail. Whether a user is authorized to read a labelled cell is determined during a Get or Scan, and results which the user is not allowed to read are filtered out. This incurs the same I/O penalty as if the results were returned, but reduces load on the network."},"8344":{"id":"/docs/security/data-access-123","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"Visibility labels can also be specified during Delete operations. For details about visibility labels and Deletes, see HBASE-10885."},"8345":{"id":"/docs/security/data-access-124","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"The user's effective label set is built in the RPC context when a request is first received by the RegionServer. The way that users are associated with labels is pluggable. The default plugin passes through labels specified in Authorizations added to the Get or Scan and checks those against the calling user's authenticated labels list. When the client passes labels for which the user is not authenticated, the default plugin drops them. You can pass a subset of user authenticated labels via the `Get#setAuthorizations(Authorizations(String,...))` and `Scan#setAuthorizations(Authorizations(String,...));` methods."},"8346":{"id":"/docs/security/data-access-125","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"Groups can be granted visibility labels the same way as users. Groups are prefixed with an @ symbol. When checking visibility labels of a user, the server will include the visibility labels of the groups of which the user is a member, together with the user's own labels. When the visibility labels are retrieved using API `VisibilityClient#getAuths` or Shell command `get_auths` for a user, we will return labels added specifically for that user alone, not the group level labels."},"8347":{"id":"/docs/security/data-access-126","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"Visibility label access checking is performed by the VisibilityController coprocessor. You can use interface `VisibilityLabelService` to provide a custom implementation and/or control the way that visibility labels are stored with cells. See the source file *hbase-server/src/test/java/org/apache/hadoop/hbase/security/visibility/TestVisibilityLabelsWithCustomVisLabService.java* for one example."},"8348":{"id":"/docs/security/data-access-127","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"Visibility labels can be used in conjunction with ACLs."},"8349":{"id":"/docs/security/data-access-128","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"The labels have to be explicitly defined before they can be used in visibility labels. See below\nfor an example of how this can be done."},"8350":{"id":"/docs/security/data-access-129","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#visibility-labels","content":"There is currently no way to determine which labels have been applied to a cell. See\nHBASE-12470 for details."},"8351":{"id":"/docs/security/data-access-130","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"Expression"},"8352":{"id":"/docs/security/data-access-131","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"Interpretation"},"8353":{"id":"/docs/security/data-access-132","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"`fulltime`"},"8354":{"id":"/docs/security/data-access-133","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"Allow access to users associated with the fulltime label."},"8355":{"id":"/docs/security/data-access-134","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"`!public`"},"8356":{"id":"/docs/security/data-access-135","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"Allow access to users not associated with the public label."},"8357":{"id":"/docs/security/data-access-136","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"`( secret \\| topsecret ) & !probationary`"},"8358":{"id":"/docs/security/data-access-137","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#examples-of-visibility-expressions","content":"Allow access to users associated with either the secret or topsecret label and not associated with the probationary label."},"8359":{"id":"/docs/security/data-access-138","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-visibility-labels-server-side-configuration","content":"As a prerequisite, perform the steps in Procedure: Basic Server-Side Configuration.."},"8360":{"id":"/docs/security/data-access-139","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-visibility-labels-server-side-configuration","content":"Install and configure the VisibilityController coprocessor by setting the following properties in *hbase-site.xml*. These properties take a list of class names."},"8361":{"id":"/docs/security/data-access-140","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-visibility-labels-server-side-configuration","content":"If you use the AccessController and VisibilityController coprocessors together, the\nAccessController must come first in the list, because with both components active, the\nVisibilityController will delegate access control on its system tables to the AccessController."},"8362":{"id":"/docs/security/data-access-141","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-visibility-labels-server-side-configuration","content":"Adjust Configuration"},"8363":{"id":"/docs/security/data-access-142","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-visibility-labels-server-side-configuration","content":"By default, users can label cells with any label, including labels they are not associated with, which means that a user can Put data that he cannot read. For example, a user could label a cell with the (hypothetical) 'topsecret' label even if the user is not associated with that label. If you only want users to be able to label cells with labels they are associated with, set `hbase.security.visibility.mutations.checkauths` to `true`. In that case, the mutation will fail if it makes use of labels the user is not associated with."},"8364":{"id":"/docs/security/data-access-143","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-visibility-labels-server-side-configuration","content":"Distribute your configuration and restart your cluster for changes to take effect."},"8365":{"id":"/docs/security/data-access-144","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"Administration tasks can be performed using the HBase Shell or the Java API. For defining the list of visibility labels and associating labels with users, the HBase Shell is probably simpler."},"8366":{"id":"/docs/security/data-access-145","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"Many of the Java API examples in this section are taken from the source file *hbase-server/src/test/java/org/apache/hadoop/hbase/security/visibility/TestVisibilityLabels.java*. Refer to that file or the API documentation for more context."},"8367":{"id":"/docs/security/data-access-146","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"Neither these examples, nor the source file they were taken from, are part of the public HBase API, and are provided for illustration only. Refer to the official API for usage instructions."},"8368":{"id":"/docs/security/data-access-147","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"Define the List of Visibility Labels"},"8369":{"id":"/docs/security/data-access-148","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**HBase Shell:**"},"8370":{"id":"/docs/security/data-access-149","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**Java API:**"},"8371":{"id":"/docs/security/data-access-150","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"Associate Labels with Users"},"8372":{"id":"/docs/security/data-access-151","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**HBase Shell:**"},"8373":{"id":"/docs/security/data-access-152","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**Java API:**"},"8374":{"id":"/docs/security/data-access-153","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"Clear Labels From Users"},"8375":{"id":"/docs/security/data-access-154","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**HBase Shell:**"},"8376":{"id":"/docs/security/data-access-155","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**Java API:**"},"8377":{"id":"/docs/security/data-access-156","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"Apply a Label or Expression to a Cell"},"8378":{"id":"/docs/security/data-access-157","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"The label is only applied when data is written. The label is associated with a given version of the cell."},"8379":{"id":"/docs/security/data-access-158","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**HBase Shell:**"},"8380":{"id":"/docs/security/data-access-159","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"HBase Shell support for applying labels or permissions to cells is for testing and verification\nsupport, and should not be employed for production use because it won't apply the labels to cells\nthat don't exist yet. The correct way to apply cell level labels is to do so in the application\ncode when storing the values."},"8381":{"id":"/docs/security/data-access-160","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-visibility","content":"**Java API example:**"},"8382":{"id":"/docs/security/data-access-161","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#reading-cells-with-labels","content":"When you issue a Scan or Get, HBase uses your default set of authorizations to filter out cells that you do not have access to. A superuser can set the default set of authorizations for a given user by using the `set_auths` HBase Shell command or the VisibilityClient.setAuths() method."},"8383":{"id":"/docs/security/data-access-162","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#reading-cells-with-labels","content":"You can specify a different authorization during the Scan or Get, by passing the AUTHORIZATIONS option in HBase Shell, or the Scan.setAuthorizations() method if you use the API. This authorization will be combined with your default set as an additional filter. It will further filter your results, rather than giving you additional authorization."},"8384":{"id":"/docs/security/data-access-163","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementing-your-own-visibility-label-algorithm","content":"Interpreting the labels authenticated for a given get/scan request is a pluggable algorithm."},"8385":{"id":"/docs/security/data-access-164","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementing-your-own-visibility-label-algorithm","content":"You can specify a custom plugin or plugins by using the property `hbase.regionserver.scan.visibility.label.generator.class`. The output for the first `ScanLabelGenerator` will be the input for the next one, until the end of the list."},"8386":{"id":"/docs/security/data-access-165","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#implementing-your-own-visibility-label-algorithm","content":"The default implementation, which was implemented in HBASE-12466, loads two plugins, `FeedUserAuthScanLabelGenerator` and `DefinedSetFilterScanLabelGenerator`. See Reading Cells with Labels."},"8387":{"id":"/docs/security/data-access-166","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#replicating-visibility-tags-as-strings","content":"As mentioned in the above sections, the interface `VisibilityLabelService` could be used to implement a different way of storing the visibility expressions in the cells. Clusters with replication enabled also must replicate the visibility expressions to the peer cluster. If `DefaultVisibilityLabelServiceImpl` is used as the implementation for `VisibilityLabelService`, all the visibility expression are converted to the corresponding expression based on the ordinals for each visibility label stored in the labels table. During replication, visible cells are also replicated with the ordinal-based expression intact. The peer cluster may not have the same `labels` table with the same ordinal mapping for the visibility labels. In that case, replicating the ordinals makes no sense. It would be better if the replication occurred with the visibility expressions transmitted as strings. To replicate the visibility expression as strings to the peer cluster, create a `RegionServerObserver` configuration which works based on the implementation of the `VisibilityLabelService` interface. The configuration below enables replication of visibility expressions to peer clusters as strings. See HBASE-11639 for more details."},"8388":{"id":"/docs/security/data-access-167","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#transparent-encryption-of-data-at-rest","content":"HBase provides a mechanism for protecting your data at rest, in HFiles and the WAL, which reside within HDFS or another distributed filesystem. A two-tier architecture is used for flexible and non-intrusive key rotation. \"Transparent\" means that no implementation changes are needed on the client side. When data is written, it is encrypted. When it is read, it is decrypted on demand."},"8389":{"id":"/docs/security/data-access-168","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works-1","content":"The administrator provisions a master key for the cluster, which is stored in a key provider accessible to every trusted HBase process, including the HMaster, RegionServers, and clients (such as HBase Shell) on administrative workstations. The default key provider is integrated with the Java KeyStore API and any key management systems with support for it. Other custom key provider implementations are possible. The key retrieval mechanism is configured in the *hbase-site.xml* configuration file. The master key may be stored on the cluster servers, protected by a secure KeyStore file, or on an external keyserver, or in a hardware security module. This master key is resolved as needed by HBase processes through the configured key provider."},"8390":{"id":"/docs/security/data-access-169","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works-1","content":"Next, encryption use can be specified in the schema, per column family, by creating or modifying a column descriptor to include two additional attributes: the name of the encryption algorithm to use (currently only \"AES\" is supported), and optionally, a data key wrapped (encrypted) with the cluster master key. If a data key is not explicitly configured for a ColumnFamily, HBase will create a random data key per HFile. This provides an incremental improvement in security over the alternative. Unless you need to supply an explicit data key, such as in a case where you are generating encrypted HFiles for bulk import with a given data key, only specify the encryption algorithm in the ColumnFamily schema metadata and let HBase create data keys on demand. Per Column Family keys facilitate low impact incremental key rotation and reduce the scope of any external leak of key material. The wrapped data key is stored in the ColumnFamily schema metadata, and in each HFile for the Column Family, encrypted with the cluster master key. After the Column Family is configured for encryption, any new HFiles will be written encrypted. To ensure encryption of all HFiles, trigger a major compaction after enabling this feature."},"8391":{"id":"/docs/security/data-access-170","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works-1","content":"When the HFile is opened, the data key is extracted from the HFile, decrypted with the cluster master key, and used for decryption of the remainder of the HFile. The HFile will be unreadable if the master key is not available. If a remote user somehow acquires access to the HFile data because of some lapse in HDFS permissions, or from inappropriately discarded media, it will not be possible to decrypt either the data key or the file data."},"8392":{"id":"/docs/security/data-access-171","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#how-it-works-1","content":"It is also possible to encrypt the WAL. Even though WALs are transient, it is necessary to encrypt the WALEdits to avoid circumventing HFile protections for encrypted column families, in the event that the underlying filesystem is compromised. When WAL encryption is enabled, all WALs are encrypted, regardless of whether the relevant HFiles are encrypted."},"8393":{"id":"/docs/security/data-access-172","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#enable-or-disable-the-feature","content":"The \"Transparent Encryption of Data At Rest\" feature is enabled by default, meaning the users can define tables with column families where the HFiles and WAL files will be encrypted by HBase, assuming the feature is properly configured (see Server-Side Configuration)."},"8394":{"id":"/docs/security/data-access-173","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#enable-or-disable-the-feature","content":"In some cases (e.g. due to custom security policies), the operator of the HBase cluster might wish to only rely on an encryption at rest mechanism outside of HBase (e.g. those offered by HDFS) and wants to ensure that HBase's encryption at rest system is inactive. Since HBASE-25181 it is possible to explicitly disable HBase's own encryption by setting `hbase.crypto.enabled` to `false`. This configuration is `true` by default. If it is set to `false`, the users won't be able to create any table (column family) with HFile and WAL file encryption and the related create table shell (or API) commands will fail if they try."},"8395":{"id":"/docs/security/data-access-174","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"This procedure assumes you are using the default Java keystore implementation. If you are using a custom implementation, check its documentation and adjust accordingly."},"8396":{"id":"/docs/security/data-access-175","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Create a secret key of appropriate length for AES encryption, using the `keytool` utility."},"8397":{"id":"/docs/security/data-access-176","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Replace \\*\\*\\*\\* with the password for the keystore file and \\<alias> with the username of the HBase service account, or an arbitrary string. If you use an arbitrary string, you will need to configure HBase to use it, and that is covered below. Specify a keysize that is appropriate. Do not specify a separate password for the key, but press `Return` when prompted."},"8398":{"id":"/docs/security/data-access-177","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Set appropriate permissions on the keyfile and distribute it to all the HBase servers."},"8399":{"id":"/docs/security/data-access-178","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"The previous command created a file called *hbase.jks* in the HBase &#x2A;conf/* directory. Set the permissions and ownership on this file such that only the HBase service account user can read the file, and securely distribute the key to all HBase servers."},"8400":{"id":"/docs/security/data-access-179","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Configure the HBase daemons."},"8401":{"id":"/docs/security/data-access-180","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Set the following properties in *hbase-site.xml* on the region servers, to configure HBase daemons to use a key provider backed by the KeyStore file or retrieving the cluster master key. In the example below, replace \\*\\*\\*\\* with the password."},"8402":{"id":"/docs/security/data-access-181","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"By default, the HBase service account name will be used to resolve the cluster master key. However, you can store it with an arbitrary alias (in the `keytool` command). In that case, set the following property to the alias you used."},"8403":{"id":"/docs/security/data-access-182","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"You also need to be sure your HFiles use HFile v3, in order to use transparent encryption. This is the default configuration for HBase 1.0 onward. For previous versions, set the following property in your *hbase-site.xml* file."},"8404":{"id":"/docs/security/data-access-183","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Optionally, you can use a different cipher provider, either a Java Cryptography Encryption (JCE) algorithm provider or a custom HBase cipher implementation."},"8405":{"id":"/docs/security/data-access-184","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"JCE:"},"8406":{"id":"/docs/security/data-access-185","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Install a signed JCE provider (supporting `AES/CTR/NoPadding` mode with 128 bit keys)"},"8407":{"id":"/docs/security/data-access-186","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Add it with highest preference to the JCE site configuration file *\\$JAVA\\_HOME/lib/security/java.security*."},"8408":{"id":"/docs/security/data-access-187","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Update `hbase.crypto.algorithm.aes.provider` and `hbase.crypto.algorithm.rng.provider` options in *hbase-site.xml*."},"8409":{"id":"/docs/security/data-access-188","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Custom HBase Cipher:"},"8410":{"id":"/docs/security/data-access-189","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Implement `org.apache.hadoop.hbase.io.crypto.CipherProvider`."},"8411":{"id":"/docs/security/data-access-190","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Add the implementation to the server classpath."},"8412":{"id":"/docs/security/data-access-191","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Update `hbase.crypto.cipherprovider` in *hbase-site.xml*."},"8413":{"id":"/docs/security/data-access-192","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Configure WAL encryption."},"8414":{"id":"/docs/security/data-access-193","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Configure WAL encryption in every RegionServer's *hbase-site.xml*, by setting the following properties. You can include these in the HMaster's *hbase-site.xml* as well, but the HMaster does not have a WAL and will not use them."},"8415":{"id":"/docs/security/data-access-194","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Starting from 2.6.0, the hbase.regionserver.hlog.reader.impl and\nhbase.regionserver.hlog.writer.impl configurations are removed, you do not need to specify them\nany more. Just set hbase.regionserver.wal.encryption to true is enough to enable WAL encryption."},"8416":{"id":"/docs/security/data-access-195","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"(Optional) Configure encryption key hash algorithm."},"8417":{"id":"/docs/security/data-access-196","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Since HBASE-25181 it is possible to use custom encryption key hash algorithm instead of the default MD5 algorithm. This hash is needed to verify the secret key during decryption. The MD5 algorithm is considered weak, and can not be used in some (e.g. FIPS compliant) clusters."},"8418":{"id":"/docs/security/data-access-197","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"The hash is set via the configuration option `hbase.crypto.key.hash.algorithm`. It should be set to a JDK `MessageDigest` algorithm like \"MD5\", \"SHA-384\" or \"SHA-512\". The default is \"MD5\" for backward compatibility. An example of this configuration parameter on a FIPS-compliant cluster:"},"8419":{"id":"/docs/security/data-access-198","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Configure permissions on the *hbase-site.xml* file."},"8420":{"id":"/docs/security/data-access-199","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Because the keystore password is stored in the hbase-site.xml, you need to ensure that only the HBase user can read the *hbase-site.xml* file, using file ownership and permissions."},"8421":{"id":"/docs/security/data-access-200","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Restart your cluster."},"8422":{"id":"/docs/security/data-access-201","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#security-data-access-transparent-encryption-of-data-at-test-server-side-configuration","content":"Distribute the new configuration file to all nodes and restart your cluster."},"8423":{"id":"/docs/security/data-access-202","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-encryption","content":"Administrative tasks can be performed in HBase Shell or the Java API."},"8424":{"id":"/docs/security/data-access-203","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-encryption","content":"Java API examples in this section are taken from the source file *hbase-server/src/test/java/org/apache/hadoop/hbase/util/TestHBaseFsckEncryption.java*. ."},"8425":{"id":"/docs/security/data-access-204","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#data-access-administration-encryption","content":"Neither these examples, nor the source files they are taken from, are part of the public HBase API, and are provided for illustration only. Refer to the official API for usage instructions."},"8426":{"id":"/docs/security/data-access-205","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#enable-encryption-on-a-column-family","content":"To enable encryption on a column family, you can either use HBase Shell or the Java API. After enabling encryption, trigger a major compaction. When the major compaction completes, the compacted new HFiles will be encrypted. However, depending on the compaction settings, it is possible that not all the HFiles will be rewritten during a major compaction and there still might remain some old unencrypted HFiles. Also please note, that the snapshots are immutable. So the snapshots taken before you enabled the encryption will still contain the unencrypted HFiles."},"8427":{"id":"/docs/security/data-access-206","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#rotate-the-data-key","content":"To rotate the data key, first change the ColumnFamily key in the column descriptor, then trigger a major compaction. Until the compaction completes, the old HFiles will still be readable using the old key. During compaction, the compacted HFiles will be re-encrypted using the new data key. However, depending on the compaction settings, it is possible that not all the HFiles will be rewritten during a major compaction and there still might remain some old HFiles encrypted with the old key. Also please note, that the snapshots are immutable. So the snapshots taken before the changing of the encryption key will still contain the HFiles written using the old key."},"8428":{"id":"/docs/security/data-access-207","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#switching-between-using-a-random-data-key-and-specifying-a-key","content":"If you configured a column family to use a specific key and you want to return to the default behavior of using a randomly-generated key for that column family, use the Java API to alter the `HColumnDescriptor` so that no value is sent with the key `ENCRYPTION_KEY`."},"8429":{"id":"/docs/security/data-access-208","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#rotate-the-master-key","content":"To rotate the master key, first generate and distribute the new key. Then update the KeyStore to contain a new master key, and keep the old master key in the KeyStore using a different alias. Next, configure fallback to the old master key in the *hbase-site.xml* file."},"8430":{"id":"/docs/security/data-access-209","page_id":"/docs/security/data-access","tags":["multi-page"],"type":"text","url":"/docs/security/data-access#secure-enable","content":"After hbase-2.x, the default 'hbase.security.authorization' changed. Before hbase-2.x, it defaulted to true, in later HBase versions, the default became false. So to enable hbase authorization, the following propertie must be configured in *hbase-site.xml*. See HBASE-19483;"},"8431":{"id":"/docs/security/example","page_id":"/docs/security/example","type":"page","content":"Security Configuration Example","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security/example"},"8432":{"id":"/docs/security/example-0","page_id":"/docs/security/example","tags":["multi-page"],"type":"text","url":"/docs/security/example","content":"This configuration example includes support for HFile v3, ACLs, Visibility Labels, and transparent encryption of data at rest and the WAL. All options have been discussed separately in the sections above."},"8433":{"id":"/docs/security/example-1","page_id":"/docs/security/example","type":"heading","tags":["multi-page"],"url":"/docs/security/example#example-security-settings-in-hbase-sitexml","content":"Example Security Settings in *hbase-site.xml*"},"8434":{"id":"/docs/security/example-2","page_id":"/docs/security/example","type":"heading","tags":["multi-page"],"url":"/docs/security/example#example-group-mapper-in-hadoop-core-sitexml","content":"Example Group Mapper in Hadoop *core-site.xml*"},"8435":{"id":"/docs/security/example-3","page_id":"/docs/security/example","tags":["multi-page"],"type":"text","url":"/docs/security/example#example-security-settings-in-hbase-sitexml","content":"Starting from 2.6.0, the hbase.regionserver.hlog.reader.impl and\nhbase.regionserver.hlog.writer.impl configurations are removed, you do not need to specify them\nany more. Just set hbase.regionserver.wal.encryption to true is enough to enable WAL encryption."},"8436":{"id":"/docs/security/example-4","page_id":"/docs/security/example","tags":["multi-page"],"type":"text","url":"/docs/security/example#example-group-mapper-in-hadoop-core-sitexml","content":"Adjust these settings to suit your environment."},"8437":{"id":"/docs/security/hdfs-and-zookeeper-access","page_id":"/docs/security/hdfs-and-zookeeper-access","type":"page","content":"Securing Access to HDFS and ZooKeeper","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security/hdfs-and-zookeeper-access"},"8438":{"id":"/docs/security/hdfs-and-zookeeper-access-0","page_id":"/docs/security/hdfs-and-zookeeper-access","tags":["multi-page"],"type":"text","url":"/docs/security/hdfs-and-zookeeper-access","content":"Secure HBase requires secure ZooKeeper and HDFS so that users cannot access and/or modify the metadata and data from under HBase. HBase uses HDFS (or configured file system) to keep its data files as well as write ahead logs (WALs) and other data. HBase uses ZooKeeper to store some metadata for operations (master address, table locks, recovery state, etc)."},"8439":{"id":"/docs/security/hdfs-and-zookeeper-access-1","page_id":"/docs/security/hdfs-and-zookeeper-access","type":"heading","tags":["multi-page"],"url":"/docs/security/hdfs-and-zookeeper-access#securing-zookeeper-data","content":"Securing ZooKeeper Data"},"8440":{"id":"/docs/security/hdfs-and-zookeeper-access-2","page_id":"/docs/security/hdfs-and-zookeeper-access","type":"heading","tags":["multi-page"],"url":"/docs/security/hdfs-and-zookeeper-access#securing-file-system-hdfs-data","content":"Securing File System (HDFS) Data"},"8441":{"id":"/docs/security/hdfs-and-zookeeper-access-3","page_id":"/docs/security/hdfs-and-zookeeper-access","tags":["multi-page"],"type":"text","url":"/docs/security/hdfs-and-zookeeper-access#securing-zookeeper-data","content":"ZooKeeper has a pluggable authentication mechanism to enable access from clients using different methods. ZooKeeper even allows authenticated and un-authenticated clients at the same time. The access to znodes can be restricted by providing Access Control Lists (ACLs) per znode. An ACL contains two components, the authentication method and the principal. ACLs are NOT enforced hierarchically. See ZooKeeper Programmers Guide for details."},"8442":{"id":"/docs/security/hdfs-and-zookeeper-access-4","page_id":"/docs/security/hdfs-and-zookeeper-access","tags":["multi-page"],"type":"text","url":"/docs/security/hdfs-and-zookeeper-access#securing-zookeeper-data","content":"HBase daemons authenticate to ZooKeeper via SASL and kerberos (See ZooKeeper). HBase sets up the znode ACLs so that only the HBase user and the configured hbase superuser (`hbase.superuser`) can access and modify the data. In cases where ZooKeeper is used for service discovery or sharing state with the client, the znodes created by HBase will also allow anyone (regardless of authentication) to read these znodes (clusterId, master address, meta location, etc), but only the HBase user can modify them."},"8443":{"id":"/docs/security/hdfs-and-zookeeper-access-5","page_id":"/docs/security/hdfs-and-zookeeper-access","tags":["multi-page"],"type":"text","url":"/docs/security/hdfs-and-zookeeper-access#securing-file-system-hdfs-data","content":"All of the data under management is kept under the root directory in the file system (`hbase.rootdir`). Access to the data and WAL files in the filesystem should be restricted so that users cannot bypass the HBase layer, and peek at the underlying data files from the file system. HBase assumes the filesystem used (HDFS or other) enforces permissions hierarchically. If sufficient protection from the file system (both authorization and authentication) is not provided, HBase level authorization control (ACLs, visibility labels, etc) is meaningless since the user can always access the data from the file system."},"8444":{"id":"/docs/security/hdfs-and-zookeeper-access-6","page_id":"/docs/security/hdfs-and-zookeeper-access","tags":["multi-page"],"type":"text","url":"/docs/security/hdfs-and-zookeeper-access#securing-file-system-hdfs-data","content":"HBase enforces the posix-like permissions 700 (`rwx------`) to its root directory. It means that only the HBase user can read or write the files in FS. The default setting can be changed by configuring `hbase.rootdir.perms` in hbase-site.xml. A restart of the active master is needed so that it changes the used permissions. For versions before 1.2.0, you can check whether HBASE-13780 is committed, and if not, you can manually set the permissions for the root directory if needed. Using HDFS, the command would be:"},"8445":{"id":"/docs/security/hdfs-and-zookeeper-access-7","page_id":"/docs/security/hdfs-and-zookeeper-access","tags":["multi-page"],"type":"text","url":"/docs/security/hdfs-and-zookeeper-access#securing-file-system-hdfs-data","content":"You should change `/hbase` if you are using a different `hbase.rootdir`."},"8446":{"id":"/docs/security","page_id":"/docs/security","type":"page","content":"Security","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security"},"8447":{"id":"/docs/security-0","page_id":"/docs/security","tags":["multi-page"],"type":"text","url":"/docs/security","content":"Comprehensive guide to securing Apache HBase, including authentication, authorization, encryption, and access control mechanisms."},"8448":{"id":"/docs/security-1","page_id":"/docs/security","tags":["multi-page"],"type":"text","url":"/docs/security","content":"**Reporting Security Bugs**"},"8449":{"id":"/docs/security-2","page_id":"/docs/security","tags":["multi-page"],"type":"text","url":"/docs/security","content":"HBase adheres to the Apache Software Foundation's policy on reported vulnerabilities, available at http\\://apache.org/security/."},"8450":{"id":"/docs/security-3","page_id":"/docs/security","tags":["multi-page"],"type":"text","url":"/docs/security","content":"If you wish to send an encrypted report, you can use the GPG details provided for the general ASF security list. This will likely increase the response time to your report."},"8451":{"id":"/docs/security-4","page_id":"/docs/security","tags":["multi-page"],"type":"text","url":"/docs/security","content":"To protect existing HBase installations from exploitation, please **do not** use JIRA to report\nsecurity-related bugs. Instead, send your report to the mailing list `private@hbase.apache.org`,\nwhich allows anyone to send messages, but restricts who can read them. Someone on that list will\ncontact you to follow up on your report."},"8452":{"id":"/docs/security-5","page_id":"/docs/security","tags":["multi-page"],"type":"text","url":"/docs/security","content":"**Security Model**"},"8453":{"id":"/docs/security-6","page_id":"/docs/security","tags":["multi-page"],"type":"text","url":"/docs/security","content":"Before reporting a security issue, please review the Apache HBase Security Model page, which describes the project's security assumptions, trust boundaries, and what constitutes a valid vulnerability report."},"8454":{"id":"/docs/security/tls","page_id":"/docs/security/tls","type":"page","content":"Transport Level Security (TLS) in HBase RPC communication","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security/tls"},"8455":{"id":"/docs/security/tls-0","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls","content":"Configuring TLS encryption for secure HBase client-server and Master-RegionServer communication without downtime."},"8456":{"id":"/docs/security/tls-1","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#server-side-configuration","content":"Server side configuration"},"8457":{"id":"/docs/security/tls-2","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#client-side-configuration","content":"Client side configuration"},"8458":{"id":"/docs/security/tls-3","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#creating-self-signed-certificates","content":"Creating self-signed certificates"},"8459":{"id":"/docs/security/tls-4","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Upgrading existing non-TLS cluster with no downtime"},"8460":{"id":"/docs/security/tls-5","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#enable-automatic-certificate-reloading","content":"Enable automatic certificate reloading"},"8461":{"id":"/docs/security/tls-6","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#additional-configuration","content":"Additional configuration"},"8462":{"id":"/docs/security/tls-7","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#enabled-protocols","content":"Enabled protocols"},"8463":{"id":"/docs/security/tls-8","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#default-protocol","content":"Default protocol"},"8464":{"id":"/docs/security/tls-9","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#enabled-cipher-suites","content":"Enabled cipher suites"},"8465":{"id":"/docs/security/tls-10","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#certificate-revocation-checking","content":"Certificate Revocation Checking"},"8466":{"id":"/docs/security/tls-11","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#online-certificate-status-protocol","content":"Online Certificate Status Protocol"},"8467":{"id":"/docs/security/tls-12","page_id":"/docs/security/tls","type":"heading","tags":["multi-page"],"url":"/docs/security/tls#client-handshake-timeout","content":"Client handshake timeout"},"8468":{"id":"/docs/security/tls-13","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls","content":"Since version `2.6.0` HBase supports TLS encryption in server-client and Master-RegionServer communication. Transport Layer Security (TLS) is a standard cryptographic protocol designed to provide communications security over a computer network. HBase TLS implementation works exactly how secure websites are accessed via **https** prefix in a web browser: once established all communication on the channel will be securely hidden from malicious access."},"8469":{"id":"/docs/security/tls-14","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls","content":"The encryption works at the transport level which means it's independent of the configured authentication method. Secure client access mentioned in the previous section requires Kerberos to be configured and used in HBase authentication, while TLS can be configured with any other SASL mechanism or even with simple client access methods, effectively preventing attackers from eavesdropping the communication. No Kerberos KDC or other complicated infrastructure required."},"8470":{"id":"/docs/security/tls-15","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls","content":"HBase TLS is based on the Netty library therefore it only works with Netty client and server RPC implementations. Netty's powerful SSL implementation is a great foundation for highly secure and performant communication providing the latest and greatest cryptographic solution at all times."},"8471":{"id":"/docs/security/tls-16","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls","content":"Since Region Servers effectively work as clients from Master's perspective, TLS supports encrypted communication between cluster members too."},"8472":{"id":"/docs/security/tls-17","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls","content":"From version 2.6.0 HBase supports the Hadoop CredentialProvider API to avoid storing sensitive information in HBase configuration files. The recommended way of storing keystore / truststore passwords is to use one of the supported credential providers e.g. the local jceks file provider. You can find more information about how to setup credential providers in the Hadoop documentation."},"8473":{"id":"/docs/security/tls-18","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls","content":"The CLI interface for accessing the Hadoop Credential Shell is also available in HBase CLI. Type `hbase credential` to get help."},"8474":{"id":"/docs/security/tls-19","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#server-side-configuration","content":"We need to set up Java key store for the server. Key store is the list of private keys that a server can use to configure TLS encryption. See TLS wikipedia page for further details of the protocol. Add the following configuration to `hbase-site.xml` on Master, Region Servers and HBase clients:"},"8475":{"id":"/docs/security/tls-20","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#server-side-configuration","content":"Use `hbase.rpc.tls.keystore.password` alias to retrieve key store password from Hadoop credential provider."},"8476":{"id":"/docs/security/tls-21","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#server-side-configuration","content":"The supported storefile formats are based on the registered security providers and the loader can\nbe autodetected from the file extension. If needed, the file format can be explicitly specified\nwith the `hbase.rpc.tls.keystore.type` property."},"8477":{"id":"/docs/security/tls-22","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#client-side-configuration","content":"We need to configure trust store for the client. Trust store contains the list of certificates that the client should trust when doing the handshake with the server. Add the following to `hbase-site.xml`."},"8478":{"id":"/docs/security/tls-23","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#client-side-configuration","content":"Use `hbase.rpc.tls.truststore.password` alias to retrieve trust store password from Hadoop credential provider."},"8479":{"id":"/docs/security/tls-24","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#client-side-configuration","content":"The supported storefile formats are based on the registered security providers and the loader can\nbe autodetected from the file extension. If needed, the file format can be explicitly specified\nwith the `hbase.rpc.tls.truststore.type` property."},"8480":{"id":"/docs/security/tls-25","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#client-side-configuration","content":"However, specifying a trust store is not always required. Standard JDK implementations are shipped with a standard list of trusted certificates (the certificates of Certificate Authorities) and if your private key is provided by one of them, you don't need to configure your clients to trust it. Similarly to an internet browser, you don't need to set up the certificates of every single website you're planning to visit. Later in this documentation we'll walk through the steps of creating self-signed certificates which requires a trust store setup."},"8481":{"id":"/docs/security/tls-26","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#client-side-configuration","content":"You can check the list of public certificate authorities shipped with your JDK implementation:"},"8482":{"id":"/docs/security/tls-27","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#client-side-configuration","content":"Password is empty by default."},"8483":{"id":"/docs/security/tls-28","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"While obtaining globally trusted certificates from Certificate Authorities is convenient, it's perfectly valid to generate your own private/public keypairs and set them up specifically for the HBase cluster. Especially if you don't want to enable public access to the cluster, paying money for a certificate doesn't make sense."},"8484":{"id":"/docs/security/tls-29","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"Follow the following steps to generate self-signed certificates."},"8485":{"id":"/docs/security/tls-30","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"Create SSL key store JKS to store local credentials"},"8486":{"id":"/docs/security/tls-31","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"Please note that the alias (-alias) and the distinguished name (-dname) must match the hostname of the machine that is associated with, otherwise hostname verification won't work."},"8487":{"id":"/docs/security/tls-32","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"At the end of this operation you'll have as many key store files as many servers you have in your cluster. Each cluster member will have its own key store."},"8488":{"id":"/docs/security/tls-33","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"Extract the signed public key (certificate) from each key store"},"8489":{"id":"/docs/security/tls-34","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"Create SSL trust store JKS containing certificates for the clients"},"8490":{"id":"/docs/security/tls-35","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#creating-self-signed-certificates","content":"The same truststore (storing all accepted certs) should be shared on participants of the cluster. You need to use different aliases to store multiple certificates in the same truststore. Name of the aliases doesn't matter."},"8491":{"id":"/docs/security/tls-36","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Here are the steps needed to upgrade an already running HBase cluster to TLS without downtime by taking advantage of port unification functionality. There's a property on server side called `hbase.server.netty.tls.supportplaintext` which makes possible to accept TLS and plaintext connections on the same socket port."},"8492":{"id":"/docs/security/tls-37","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Create the necessary key stores and trust stores for all server participants as described in the previous section."},"8493":{"id":"/docs/security/tls-38","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Enable secure communication on the Master node in *server-only* mode with plaintext support"},"8494":{"id":"/docs/security/tls-39","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Restart the Master. Master now accepts both TLS/non-TLS connections and works with non-TLS in client mode."},"8495":{"id":"/docs/security/tls-40","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Enable secure communication on the Region Servers in both *server and client* mode with plaintext support"},"8496":{"id":"/docs/security/tls-41","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Client mode here will ensure that RegionServer's communication to Master is encrypted."},"8497":{"id":"/docs/security/tls-42","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"**Replication**"},"8498":{"id":"/docs/security/tls-43","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"If you have read replicas enabled in your cluster or replication between two different clusters, you have to break this into two steps. Secure communication has to be enabled on the *server side* first with plaintext support and once all Region Servers are upgraded you can repeat the upgrade by enabling *client side* as well."},"8499":{"id":"/docs/security/tls-44","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"You have to prepare all Region Servers for secure communication before upgrading the client side."},"8500":{"id":"/docs/security/tls-45","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Restart Region Servers in rolling restart fashion. They send requests with TLS and accept both TLS and non-TLS communication."},"8501":{"id":"/docs/security/tls-46","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Enable secure communication on the clients"},"8502":{"id":"/docs/security/tls-47","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Enable client-mode TLS on master and disable plaintext mode"},"8503":{"id":"/docs/security/tls-48","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Restart Master."},"8504":{"id":"/docs/security/tls-49","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Disable plaintext communication on the Region Servers"},"8505":{"id":"/docs/security/tls-50","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Disable plaintext communication on the Region Servers by removing `supportplaintext` property. Restart RSs in rolling restart fashion."},"8506":{"id":"/docs/security/tls-51","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#upgrading-existing-non-tls-cluster-with-no-downtime","content":"Once `hbase.client.netty.tls.enabled` is enabled on the server side, the cluster will only be able\nto communicate with other clusters which have TLS enabled. For example, this would impact\ninter-cluster replication."},"8507":{"id":"/docs/security/tls-52","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#enable-automatic-certificate-reloading","content":"Certificates usually expire after some time to improve security. In this case we need to replace them by modifying Keystore / Truststore files and HBase processes have to be restarted. In order to avoid that you can enable automatic file change detection and certificate reloading with the following option. Default: false."},"8508":{"id":"/docs/security/tls-53","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#enabled-protocols","content":"Comma-separated list of TLS protocol versions to enable. Default is empty."},"8509":{"id":"/docs/security/tls-54","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#default-protocol","content":"Set the default TLS protocol version to use. Default is TLSv1.2. Use this protocol if enabled protocols is not defined."},"8510":{"id":"/docs/security/tls-55","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#enabled-cipher-suites","content":"List of enabled cipher suites in TLS protocol. Useful when you want to disable certain cipher suites due to recent security concerns. Default value is a mix of CBC and GCM ciphers. Due to performance reasons we prefer CBC ciphers for Java 8 and GCM ciphers for Java 9+."},"8511":{"id":"/docs/security/tls-56","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#certificate-revocation-checking","content":"There's a built-in mechanism in JDK's TrustManager which automatically checks certificates for revocation. See Managing Server Certificates. Disabled by default."},"8512":{"id":"/docs/security/tls-57","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#online-certificate-status-protocol","content":"Enables OCSP stapling. Please note that not all `SSLProvider` implementations support OCSP stapling and an exception will be thrown upon. Disabled by default."},"8513":{"id":"/docs/security/tls-58","page_id":"/docs/security/tls","tags":["multi-page"],"type":"text","url":"/docs/security/tls#client-handshake-timeout","content":"Set the TLS client handshake timeout is milliseconds. Default is 5 seconds."},"8514":{"id":"/docs/security/user-access","page_id":"/docs/security/user-access","type":"page","content":"Simple User Access to Apache HBase","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security/user-access"},"8515":{"id":"/docs/security/user-access-0","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access","content":"Setting up simple SASL authentication for HBase clients without Kerberos, using username/password-based access control."},"8516":{"id":"/docs/security/user-access-1","page_id":"/docs/security/user-access","type":"heading","tags":["multi-page"],"url":"/docs/security/user-access#simple-versus-secure-access","content":"Simple versus Secure Access"},"8517":{"id":"/docs/security/user-access-2","page_id":"/docs/security/user-access","type":"heading","tags":["multi-page"],"url":"/docs/security/user-access#security-user-access-prerequisites","content":"Prerequisites"},"8518":{"id":"/docs/security/user-access-3","page_id":"/docs/security/user-access","type":"heading","tags":["multi-page"],"url":"/docs/security/user-access#server-side-configuration-for-simple-user-access-operation","content":"Server-side Configuration for Simple User Access Operation"},"8519":{"id":"/docs/security/user-access-4","page_id":"/docs/security/user-access","type":"heading","tags":["multi-page"],"url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation","content":"Client-side Configuration for Simple User Access Operation"},"8520":{"id":"/docs/security/user-access-5","page_id":"/docs/security/user-access","type":"heading","tags":["multi-page"],"url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---thrift-gateway","content":"Client-side Configuration for Simple User Access Operation - Thrift Gateway"},"8521":{"id":"/docs/security/user-access-6","page_id":"/docs/security/user-access","type":"heading","tags":["multi-page"],"url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---rest-gateway","content":"Client-side Configuration for Simple User Access Operation - REST Gateway"},"8522":{"id":"/docs/security/user-access-7","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access","content":"Newer releases of Apache HBase (>= 0.92) support optional SASL authentication of clients. See also Matteo Bertozzi's article on Understanding User Authentication and Authorization in Apache HBase."},"8523":{"id":"/docs/security/user-access-8","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access","content":"This describes how to set up Apache HBase and clients for simple user access to HBase resources."},"8524":{"id":"/docs/security/user-access-9","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#simple-versus-secure-access","content":"The following section shows how to set up simple user access. Simple user access is not a secure method of operating HBase. This method is used to prevent users from making mistakes. It can be used to mimic the Access Control using on a development system without having to set up Kerberos."},"8525":{"id":"/docs/security/user-access-10","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#simple-versus-secure-access","content":"This method is not used to prevent malicious or hacking attempts. To make HBase secure against these types of attacks, you must configure HBase for secure operation. Refer to the section Secure Client Access to Apache HBase and complete all of the steps described there."},"8526":{"id":"/docs/security/user-access-11","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#security-user-access-prerequisites","content":"None"},"8527":{"id":"/docs/security/user-access-12","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#server-side-configuration-for-simple-user-access-operation","content":"Add the following to the `hbase-site.xml` file on every server machine in the cluster:"},"8528":{"id":"/docs/security/user-access-13","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#server-side-configuration-for-simple-user-access-operation","content":"For 0.94, add the following to the `hbase-site.xml` file on every server machine in the cluster:"},"8529":{"id":"/docs/security/user-access-14","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#server-side-configuration-for-simple-user-access-operation","content":"A full shutdown and restart of HBase service is required when deploying these configuration changes."},"8530":{"id":"/docs/security/user-access-15","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation","content":"Add the following to the `hbase-site.xml` file on every client:"},"8531":{"id":"/docs/security/user-access-16","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation","content":"For 0.94, add the following to the `hbase-site.xml` file on every server machine in the cluster:"},"8532":{"id":"/docs/security/user-access-17","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation","content":"Be advised that if the `hbase.security.authentication` in the client- and server-side site files do not match, the client will not be able to communicate with the cluster."},"8533":{"id":"/docs/security/user-access-18","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---thrift-gateway","content":"The Thrift gateway user will need access. For example, to give the Thrift API user, `thrift_server`, administrative access, a command such as this one will suffice:"},"8534":{"id":"/docs/security/user-access-19","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---thrift-gateway","content":"For more information about ACLs, please see the Access Control Labels (ACLs) section"},"8535":{"id":"/docs/security/user-access-20","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---thrift-gateway","content":"The Thrift gateway will authenticate with HBase using the supplied credential. No authentication will be performed by the Thrift gateway itself. All client access via the Thrift gateway will use the Thrift gateway's credential and have its privilege."},"8536":{"id":"/docs/security/user-access-21","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---rest-gateway","content":"The REST gateway will authenticate with HBase using the supplied credential. No authentication will be performed by the REST gateway itself. All client access via the REST gateway will use the REST gateway's credential and have its privilege."},"8537":{"id":"/docs/security/user-access-22","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---rest-gateway","content":"The REST gateway user will need access. For example, to give the REST API user, `rest_server`, administrative access, a command such as this one will suffice:"},"8538":{"id":"/docs/security/user-access-23","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---rest-gateway","content":"For more information about ACLs, please see the Access Control Labels (ACLs) section"},"8539":{"id":"/docs/security/user-access-24","page_id":"/docs/security/user-access","tags":["multi-page"],"type":"text","url":"/docs/security/user-access#client-side-configuration-for-simple-user-access-operation---rest-gateway","content":"It should be possible for clients to authenticate with the HBase cluster through the REST gateway in a pass-through manner via SPNEGO HTTP authentication. This is future work."},"8540":{"id":"/docs/security/web-ui","page_id":"/docs/security/web-ui","type":"page","content":"Web UI Security","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security/web-ui"},"8541":{"id":"/docs/security/web-ui-0","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui","content":"HBase provides mechanisms to secure various components and aspects of HBase and how it relates to the rest of the Hadoop infrastructure, as well as clients and resources outside Hadoop."},"8542":{"id":"/docs/security/web-ui-1","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#using-secure-http-https-for-the-web-ui","content":"Using Secure HTTP (HTTPS) for the Web UI"},"8543":{"id":"/docs/security/web-ui-2","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#disable-cache-in-hbase-ui","content":"Disable cache in HBase UI"},"8544":{"id":"/docs/security/web-ui-3","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#using-spnego-for-kerberos-authentication-with-web-uis","content":"Using SPNEGO for Kerberos authentication with Web UIs"},"8545":{"id":"/docs/security/web-ui-4","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"Defining administrators of the Web UI with SPNEGO"},"8546":{"id":"/docs/security/web-ui-5","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#using-ldap-authentication-with-web-uis","content":"Using LDAP authentication with Web UIs"},"8547":{"id":"/docs/security/web-ui-6","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-ldap","content":"Defining Administrators of the Web UI with LDAP"},"8548":{"id":"/docs/security/web-ui-7","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#security-web-ui-notes","content":"Notes"},"8549":{"id":"/docs/security/web-ui-8","page_id":"/docs/security/web-ui","type":"heading","tags":["multi-page"],"url":"/docs/security/web-ui#other-ui-security-related-configuration","content":"Other UI security-related configuration"},"8550":{"id":"/docs/security/web-ui-9","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-secure-http-https-for-the-web-ui","content":"A default HBase install uses insecure HTTP connections for Web UIs for the master and region servers. To enable secure HTTP (HTTPS) connections instead, set `hbase.ssl.enabled` to `true` in *hbase-site.xml*(Please prepare SSL certificate and ssl configuration file in advance). This does not change the port used by the Web UI. To change the port for the web UI for a given HBase component, configure that port's setting in hbase-site.xml. These settings are:"},"8551":{"id":"/docs/security/web-ui-10","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-secure-http-https-for-the-web-ui","content":"`hbase.master.info.port`"},"8552":{"id":"/docs/security/web-ui-11","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-secure-http-https-for-the-web-ui","content":"`hbase.regionserver.info.port`"},"8553":{"id":"/docs/security/web-ui-12","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-secure-http-https-for-the-web-ui","content":"If you enable secure HTTP, clients should connect to HBase using the `https://` URL. Clients using the `http://` URL will receive an HTTP response of `200`, but will not receive any data. The following exception is logged:"},"8554":{"id":"/docs/security/web-ui-13","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-secure-http-https-for-the-web-ui","content":"This is because the same port is used for HTTP and HTTPS."},"8555":{"id":"/docs/security/web-ui-14","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-secure-http-https-for-the-web-ui","content":"HBase uses Jetty for the Web UI. Without modifying Jetty itself, it does not seem possible to configure Jetty to redirect one port to another on the same host. See Nick Dimiduk's contribution on this Stack Overflow thread for more information. If you know how to fix this without opening a second port for HTTPS, patches are appreciated."},"8556":{"id":"/docs/security/web-ui-15","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#disable-cache-in-hbase-ui","content":"Set the following configuration in hbase-site to set max age to zero and disable cache for the web UI:"},"8557":{"id":"/docs/security/web-ui-16","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-spnego-for-kerberos-authentication-with-web-uis","content":"Kerberos-authentication to HBase Web UIs can be enabled via configuring SPNEGO with the `hbase.security.authentication.ui` property in *hbase-site.xml*. Enabling this authentication requires that HBase is also configured to use Kerberos authentication for RPCs (e.g `hbase.security.authentication` = `kerberos`)."},"8558":{"id":"/docs/security/web-ui-17","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-spnego-for-kerberos-authentication-with-web-uis","content":"A number of properties exist to configure SPNEGO authentication for the web server:"},"8559":{"id":"/docs/security/web-ui-18","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"In the previous section, we cover how to enable authentication for the Web UI via SPNEGO. However, some portions of the Web UI could be used to impact the availability and performance of an HBase cluster. As such, it is desirable to ensure that only those with proper authority can interact with these sensitive endpoints."},"8560":{"id":"/docs/security/web-ui-19","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"HBase allows the adminstrators to be defined via a list of usernames or groups in hbase-site.xml"},"8561":{"id":"/docs/security/web-ui-20","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"The usernames are those which the Kerberos identity maps to, given the Hadoop `auth_to_local` rules in core-site.xml. The groups here are the Unix groups associated with the mapped usernames."},"8562":{"id":"/docs/security/web-ui-21","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"Consider the following scenario to describe how the configuration properties operate. Consider three users which are defined in the Kerberos KDC:"},"8563":{"id":"/docs/security/web-ui-22","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"`alice@COMPANY.COM`"},"8564":{"id":"/docs/security/web-ui-23","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"`bob@COMPANY.COM`"},"8565":{"id":"/docs/security/web-ui-24","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"`charlie@COMPANY.COM`"},"8566":{"id":"/docs/security/web-ui-25","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"The default Hadoop `auth_to_local` rules map these principals to the \"shortname\":"},"8567":{"id":"/docs/security/web-ui-26","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"`alice`"},"8568":{"id":"/docs/security/web-ui-27","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"`bob`"},"8569":{"id":"/docs/security/web-ui-28","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"`charlie`"},"8570":{"id":"/docs/security/web-ui-29","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"Unix groups membership define that `alice` is a member of the group `admins`. `bob` and `charlie` are not members of the `admins` group."},"8571":{"id":"/docs/security/web-ui-30","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"Given the above configuration, `alice` is allowed to access sensitive endpoints in the Web UI as she is a member of the `admins` group. `charlie` is also allowed to access sensitive endpoints because he is explicitly listed as an admin in the configuration. `bob` is not allowed to access sensitive endpoints because he is not a member of the `admins` group nor is listed as an explicit admin user via `hbase.security.authentication.spnego.admin.users`, but can still use any non-sensitive endpoints in the Web UI."},"8572":{"id":"/docs/security/web-ui-31","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-spnego","content":"If it doesn't go without saying: non-authenticated users cannot access any part of the Web UI."},"8573":{"id":"/docs/security/web-ui-32","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-ldap-authentication-with-web-uis","content":"LDAP authentication to HBase Web UIs can be enabled via configuring LDAP with the `hbase.security.authentication.ui` property in *hbase-site.xml*. The `hbase.http.filter.initializers` property also needs to have the `AuthenticationFilterInitializer` class."},"8574":{"id":"/docs/security/web-ui-33","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-ldap-authentication-with-web-uis","content":"**IMPORTANT:** A LDAP server must be configured and running. When TLS is enabled for communication with LDAP server (either via ldaps scheme or ‘start TLS' extension), configure the public certificate of the LDAP server in the local truststore. The LDAP authentication mechanism uses HTTP Basic authentication scheme to verify user specified credentials against a configured LDAP (or Active Directory) server. The authentication filter must be configured with the following init parameters:"},"8575":{"id":"/docs/security/web-ui-34","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#using-ldap-authentication-with-web-uis","content":"A number of properties exist to configure LDAP authentication for the web server:"},"8576":{"id":"/docs/security/web-ui-35","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-ldap","content":"In the previous section, we discussed enabling authentication for the Web UI via LDAP. Certain portions of the Web UI can impact the availability and performance of an HBase cluster. To safeguard these sensitive endpoints, it is essential to restrict access to authorized administrators only."},"8577":{"id":"/docs/security/web-ui-36","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-ldap","content":"HBase provides a mechanism to define administrators for the Web UI through a list of usernames in the `hbase-site.xml` configuration file."},"8578":{"id":"/docs/security/web-ui-37","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-ldap","content":"To specify the administrators, use the following property in `hbase-site.xml`:"},"8579":{"id":"/docs/security/web-ui-38","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#defining-administrators-of-the-web-ui-with-ldap","content":"The usernames listed in the above property should correspond to the LDAP usernames of the administrators."},"8580":{"id":"/docs/security/web-ui-39","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#security-web-ui-notes","content":"This feature is supported by only versions of HBase having HBASE-29244"},"8581":{"id":"/docs/security/web-ui-40","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#security-web-ui-notes","content":"Ensure that the LDAP server is properly configured and running. See the previous section for details."},"8582":{"id":"/docs/security/web-ui-41","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#security-web-ui-notes","content":"Only users explicitly listed in the `hbase.security.authentication.ldap.admin.users` property will have access to sensitive endpoints."},"8583":{"id":"/docs/security/web-ui-42","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#security-web-ui-notes","content":"Non-administrative users can still access non-sensitive endpoints, provided they are authenticated."},"8584":{"id":"/docs/security/web-ui-43","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#security-web-ui-notes","content":"By defining administrators in this way, you can ensure that only authorized personnel can interact with critical Web UI functionalities, thereby enhancing the security and stability of your HBase cluster."},"8585":{"id":"/docs/security/web-ui-44","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#other-ui-security-related-configuration","content":"While it is a clear anti-pattern for HBase developers, the developers acknowledge that the HBase configuration (including Hadoop configuration files) may contain sensitive information. As such, a user may find that they do not want to expose the HBase service-level configuration to all authenticated users. They may configure HBase to require a user must be an admin to access the service-level configuration via the HBase UI. This configuration is **false** by default (any authenticated user may access the configuration)."},"8586":{"id":"/docs/security/web-ui-45","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#other-ui-security-related-configuration","content":"Users who wish to change this would set the following in their hbase-site.xml:"},"8587":{"id":"/docs/security/web-ui-46","page_id":"/docs/security/web-ui","tags":["multi-page"],"type":"text","url":"/docs/security/web-ui#other-ui-security-related-configuration","content":"To disable showing stack traces in HBase UI for hiding sensitive information, set the following in hbase-site:"},"8588":{"id":"/docs/shell","page_id":"/docs/shell","type":"page","content":"The Apache HBase Shell","breadcrumbs":["Docs","Multi-Page Documentation","Configuration & Setup"],"tags":["multi-page"],"url":"/docs/shell"},"8589":{"id":"/docs/shell-0","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell","content":"Guide to using the HBase Shell including scripting, tricks, and advanced features."},"8590":{"id":"/docs/shell-1","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#scripting-with-ruby","content":"Scripting with Ruby"},"8591":{"id":"/docs/shell-2","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#running-the-shell-in-non-interactive-mode","content":"Running the Shell in Non-Interactive Mode"},"8592":{"id":"/docs/shell-3","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#hbase-shell-in-os-scripts","content":"HBase Shell in OS Scripts"},"8593":{"id":"/docs/shell-4","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#passing-commands-to-the-hbase-shell","content":"Passing Commands to the HBase Shell"},"8594":{"id":"/docs/shell-5","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#checking-the-result-of-a-scripted-command","content":"Checking the Result of a Scripted Command"},"8595":{"id":"/docs/shell-6","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#checking-for-success-or-failure-in-scripts","content":"Checking for Success or Failure In Scripts"},"8596":{"id":"/docs/shell-7","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#read-hbase-shell-commands-from-a-command-file","content":"Read HBase Shell Commands from a Command File"},"8597":{"id":"/docs/shell-8","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#example-command-file","content":"Example Command File"},"8598":{"id":"/docs/shell-9","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#directing-hbase-shell-to-execute-the-commands","content":"Directing HBase Shell to Execute the Commands"},"8599":{"id":"/docs/shell-10","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#passing-vm-options-to-the-shell","content":"Passing VM Options to the Shell"},"8600":{"id":"/docs/shell-11","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#overriding-configuration-starting-the-hbase-shell","content":"Overriding configuration starting the HBase Shell"},"8601":{"id":"/docs/shell-12","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#shell-tricks","content":"Shell Tricks"},"8602":{"id":"/docs/shell-13","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#table-variables","content":"Table variables"},"8603":{"id":"/docs/shell-14","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#irbrc","content":"*irbrc*"},"8604":{"id":"/docs/shell-15","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#log-data-to-timestamp","content":"LOG data to timestamp"},"8605":{"id":"/docs/shell-16","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#query-shell-configuration","content":"Query Shell Configuration"},"8606":{"id":"/docs/shell-17","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"Pre-splitting tables with the HBase Shell"},"8607":{"id":"/docs/shell-18","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#debug","content":"Debug"},"8608":{"id":"/docs/shell-19","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#shell-debug-switch","content":"Shell debug switch"},"8609":{"id":"/docs/shell-20","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#debug-log-level","content":"DEBUG log level"},"8610":{"id":"/docs/shell-21","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#shell-commands","content":"Commands"},"8611":{"id":"/docs/shell-22","page_id":"/docs/shell","type":"heading","tags":["multi-page"],"url":"/docs/shell#count","content":"count"},"8612":{"id":"/docs/shell-23","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell","content":"The Apache HBase Shell is (J)Ruby's IRB with some HBase particular commands added.\nAnything you can do in IRB, you should be able to do in the HBase Shell."},"8613":{"id":"/docs/shell-24","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell","content":"To run the HBase shell, do as follows:"},"8614":{"id":"/docs/shell-25","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell","content":"Type `help` and then `<RETURN>` to see a listing of shell commands and options.\nBrowse at least the paragraphs at the end of the help output for the gist of how variables and command arguments are entered into the HBase shell; in particular note how table names, rows, and columns, etc., must be quoted."},"8615":{"id":"/docs/shell-26","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell","content":"See shell exercises for example basic shell operation."},"8616":{"id":"/docs/shell-27","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell","content":"Here is a nicely formatted listing of all shell commands by Rajeshbabu Chintaguntla."},"8617":{"id":"/docs/shell-28","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#scripting-with-ruby","content":"For examples scripting Apache HBase, look in the HBase *bin&#x2A; directory.\nLook at the files that end in *\\*.rb*.\nTo run one of these files, do as follows:"},"8618":{"id":"/docs/shell-29","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#running-the-shell-in-non-interactive-mode","content":"A new non-interactive mode has been added to the HBase Shell (HBASE-11658).\nNon-interactive mode captures the exit status (success or failure) of HBase Shell commands and passes that status back to the command interpreter.\nIf you use the normal interactive mode, the HBase Shell will only ever return its own exit status, which will nearly always be `0` for success."},"8619":{"id":"/docs/shell-30","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#running-the-shell-in-non-interactive-mode","content":"To invoke non-interactive mode, pass the `-n` or `--non-interactive` option to HBase Shell."},"8620":{"id":"/docs/shell-31","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#hbase-shell-in-os-scripts","content":"You can use the HBase shell from within operating system script interpreters like the Bash shell which is the default command interpreter for most Linux and UNIX distributions.\nThe following guidelines use Bash syntax, but could be adjusted to work with C-style shells such as csh or tcsh, and could probably be modified to work with the Microsoft Windows script interpreter as well. Submissions are welcome."},"8621":{"id":"/docs/shell-32","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#hbase-shell-in-os-scripts","content":"Spawning HBase Shell commands in this way is slow, so keep that in mind when you are deciding when\ncombining HBase operations with the operating system command line is appropriate."},"8622":{"id":"/docs/shell-33","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#passing-commands-to-the-hbase-shell","content":"You can pass commands to the HBase Shell in non-interactive mode (see hbase.shell.noninteractive) using the `echo` command and the `|` (pipe) operator.\nBe sure to escape characters in the HBase commands which would otherwise be interpreted by the shell.\nSome debug-level output has been truncated from the example below."},"8623":{"id":"/docs/shell-34","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#passing-commands-to-the-hbase-shell","content":"To suppress all output, echo it to &#x2A;/dev/null:*"},"8624":{"id":"/docs/shell-35","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#checking-the-result-of-a-scripted-command","content":"Since scripts are not designed to be run interactively, you need a way to check whether your command failed or succeeded.\nThe HBase shell uses the standard convention of returning a value of `0` for successful commands, and some non-zero value for failed commands.\nBash stores a command's return value in a special environment variable called `$?`.\nBecause that variable is overwritten each time the shell runs any command, you should store the result in a different, script-defined variable."},"8625":{"id":"/docs/shell-36","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#checking-the-result-of-a-scripted-command","content":"This is a naive script that shows one way to store the return value and make a decision based upon it."},"8626":{"id":"/docs/shell-37","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#checking-for-success-or-failure-in-scripts","content":"Getting an exit code of `0` means that the command you scripted definitely succeeded.\nHowever, getting a non-zero exit code does not necessarily mean the command failed.\nThe command could have succeeded, but the client lost connectivity, or some other event obscured its success.\nThis is because RPC commands are stateless.\nThe only way to be sure of the status of an operation is to check.\nFor instance, if your script creates a table, but returns a non-zero exit value, you should check whether the table was actually created before trying again to create it."},"8627":{"id":"/docs/shell-38","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#read-hbase-shell-commands-from-a-command-file","content":"You can enter HBase Shell commands into a text file, one command per line, and pass that file to the HBase Shell."},"8628":{"id":"/docs/shell-39","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#directing-hbase-shell-to-execute-the-commands","content":"Pass the path to the command file as the only argument to the `hbase shell` command.\nEach command is executed and its output is shown.\nIf you do not include the `exit` command in your script, you are returned to the HBase shell prompt.\nThere is no way to programmatically check each individual command for success or failure.\nAlso, though you see the output for each command, the commands themselves are not echoed to the screen so it can be difficult to line up the command with its output."},"8629":{"id":"/docs/shell-40","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#passing-vm-options-to-the-shell","content":"You can pass VM options to the HBase Shell using the `HBASE_SHELL_OPTS&#x60; environment variable.\nYou can set this in your environment, for instance by editing *\\~/.bashrc*, or set it as part of the command to launch HBase Shell.\nThe following example sets several garbage-collection-related variables, just for the lifetime of the VM running the HBase Shell.\nThe command should be run all on a single line, but is broken by the `\\` character, for readability."},"8630":{"id":"/docs/shell-41","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#overriding-configuration-starting-the-hbase-shell","content":"As of hbase-2.0.5/hbase-2.1.3/hbase-2.2.0/hbase-1.4.10/hbase-1.5.0, you can\npass or override hbase configuration as specified in `hbase-*.xml` by passing\nyour key/values prefixed with `-D` on the command-line as follows:"},"8631":{"id":"/docs/shell-42","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#table-variables","content":"HBase 0.95 adds shell commands that provides jruby-style object-oriented references for tables.\nPreviously all of the shell commands that act upon a table have a procedural style that always took the name of the table as an argument.\nHBase 0.95 introduces the ability to assign a table to a jruby variable.\nThe table reference can be used to perform data read write operations such as puts, scans, and gets well as admin functionality such as disabling, dropping, describing tables."},"8632":{"id":"/docs/shell-43","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#table-variables","content":"For example, previously you would always specify a table name:"},"8633":{"id":"/docs/shell-44","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#table-variables","content":"Now you can assign the table to a variable and use the results in jruby shell code."},"8634":{"id":"/docs/shell-45","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#table-variables","content":"If the table has already been created, you can assign a Table to a variable by using the get\\_table method:"},"8635":{"id":"/docs/shell-46","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#table-variables","content":"The list functionality has also been extended so that it returns a list of table names as strings.\nYou can then use jruby to script table operations based on these names.\nThe list\\_snapshots command also acts similarly."},"8636":{"id":"/docs/shell-47","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#irbrc","content":"Create an *.irbrc* file for yourself in your home directory.\nAdd customizations.\nA useful one is command history so commands are save across Shell invocations:"},"8637":{"id":"/docs/shell-48","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#irbrc","content":"If you'd like to avoid printing the result of evaluting each expression to stderr, for example the array of tables returned from the \"list\" command:"},"8638":{"id":"/docs/shell-49","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#irbrc","content":"See the `ruby&#x60; documentation of *.irbrc* to learn about other possible configurations."},"8639":{"id":"/docs/shell-50","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#log-data-to-timestamp","content":"To convert the date '08/08/16 20:56:29' from an hbase log into a timestamp, do:"},"8640":{"id":"/docs/shell-51","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#log-data-to-timestamp","content":"To go the other direction:"},"8641":{"id":"/docs/shell-52","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#log-data-to-timestamp","content":"To output in a format that is exactly like that of the HBase log format will take a little messing with SimpleDateFormat."},"8642":{"id":"/docs/shell-53","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#query-shell-configuration","content":"To set a config in the shell:"},"8643":{"id":"/docs/shell-54","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"You can use a variety of options to pre-split tables when creating them via the HBase Shell `create` command."},"8644":{"id":"/docs/shell-55","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"The simplest approach is to specify an array of split points when creating the table. Note that when specifying string literals as split points, these will create split points based on the underlying byte representation of the string. So when specifying a split point of '10', we are actually specifying the byte split point '\\x31\\30'."},"8645":{"id":"/docs/shell-56","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"The split points will define `n+1` regions where `n` is the number of split points. The lowest region will contain all keys from the lowest possible key up to but not including the first split point key.\nThe next region will contain keys from the first split point up to, but not including the next split point key.\nThis will continue for all split points up to the last. The last region will be defined from the last split point up to the maximum possible key."},"8646":{"id":"/docs/shell-57","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"In the above example, the table 't1' will be created with column family 'f', pre-split to four regions. Note the first region will contain all keys from '\\x00' up to '\\x30' (as '\\x31' is the ASCII code for '1')."},"8647":{"id":"/docs/shell-58","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"You can pass the split points in a file using following variation. In this example, the splits are read from a file corresponding to the local path on the local filesystem. Each line in the file specifies a split point key."},"8648":{"id":"/docs/shell-59","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"The other options are to automatically compute splits based on a desired number of regions and a splitting algorithm.\nHBase supplies algorithms for splitting the key range based on uniform splits or based on hexadecimal keys, but you can provide your own splitting algorithm to subdivide the key range."},"8649":{"id":"/docs/shell-60","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"As the HBase Shell is effectively a Ruby environment, you can use simple Ruby scripts to compute splits algorithmically."},"8650":{"id":"/docs/shell-61","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#pre-splitting-tables-with-the-hbase-shell","content":"Note that the HBase Shell command `truncate` effectively drops and recreates the table with default options which will discard any pre-splitting.\nIf you need to truncate a pre-split table, you must drop and recreate the table explicitly to re-specify custom split options."},"8651":{"id":"/docs/shell-62","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#shell-debug-switch","content":"You can set a debug switch in the shell to see more output — e.g.\nmore of the stack trace on exception — when you run a command:"},"8652":{"id":"/docs/shell-63","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#debug-log-level","content":"To enable DEBUG level logging in the shell, launch it with the `-d` option."},"8653":{"id":"/docs/shell-64","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#count","content":"Count command returns the number of rows in a table.\nIt's quite fast when configured with the right CACHE"},"8654":{"id":"/docs/shell-65","page_id":"/docs/shell","tags":["multi-page"],"type":"text","url":"/docs/shell#count","content":"The above count fetches 1000 rows at a time.\nSet CACHE lower if your rows are big.\nDefault is to fetch one row at a time."},"8655":{"id":"/docs/spark","page_id":"/docs/spark","type":"page","content":"HBase and Spark","breadcrumbs":["Docs","Multi-Page Documentation","APIs & Integration"],"tags":["multi-page"],"url":"/docs/spark"},"8656":{"id":"/docs/spark-0","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark","content":"Apache Spark is a software framework that is used to process data in memory in a distributed manner, and is replacing MapReduce in many use cases."},"8657":{"id":"/docs/spark-1","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#basic-spark","content":"Basic Spark"},"8658":{"id":"/docs/spark-2","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#hbasecontext-usage-example","content":"HBaseContext Usage Example"},"8659":{"id":"/docs/spark-3","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#spark-streaming","content":"Spark Streaming"},"8660":{"id":"/docs/spark-4","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#bulkput-example-with-dstreams","content":"`bulkPut` Example with DStreams"},"8661":{"id":"/docs/spark-5","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#bulk-load","content":"Bulk Load"},"8662":{"id":"/docs/spark-6","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#bulk-loading-example","content":"Bulk Loading Example"},"8663":{"id":"/docs/spark-7","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#additional-parameters-for-bulk-loading-with-spark","content":"Additional Parameters for Bulk Loading with Spark"},"8664":{"id":"/docs/spark-8","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#using-additional-parameters","content":"Using Additional Parameters"},"8665":{"id":"/docs/spark-9","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#using-thin-record-bulk-load","content":"Using thin record bulk load"},"8666":{"id":"/docs/spark-10","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#sparksqldataframes","content":"SparkSQL/DataFrames"},"8667":{"id":"/docs/spark-11","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#define-catalog","content":"Define catalog"},"8668":{"id":"/docs/spark-12","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#save-the-dataframe","content":"Save the DataFrame"},"8669":{"id":"/docs/spark-13","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#load-the-dataframe","content":"Load the DataFrame"},"8670":{"id":"/docs/spark-14","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#language-integrated-query","content":"Language Integrated Query"},"8671":{"id":"/docs/spark-15","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#sql-query","content":"SQL Query"},"8672":{"id":"/docs/spark-16","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#spark-sql-others","content":"Others"},"8673":{"id":"/docs/spark-17","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#query-with-different-timestamps","content":"Query with different timestamps"},"8674":{"id":"/docs/spark-18","page_id":"/docs/spark","type":"heading","tags":["multi-page"],"url":"/docs/spark#native-avro-support","content":"Native Avro support"},"8675":{"id":"/docs/spark-19","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark","content":"Spark itself is out of scope of this document, please refer to the Spark site for\nmore information on the Spark project and subprojects. This document will focus\non 4 main interaction points between Spark and HBase. Those interaction points are:"},"8676":{"id":"/docs/spark-20","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark","content":"**Basic Spark**\\\nThe ability to have an HBase Connection at any point in your Spark DAG."},"8677":{"id":"/docs/spark-21","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark","content":"**Spark Streaming**\\\nThe ability to have an HBase Connection at any point in your Spark Streaming\napplication."},"8678":{"id":"/docs/spark-22","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark","content":"**Spark Bulk Load**\\\nThe ability to write directly to HBase HFiles for bulk insertion into HBase"},"8679":{"id":"/docs/spark-23","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark","content":"**SparkSQL/DataFrames**\\\nThe ability to write SparkSQL that draws on tables that are represented in HBase."},"8680":{"id":"/docs/spark-24","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark","content":"The following sections will walk through examples of all these interaction points."},"8681":{"id":"/docs/spark-25","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#basic-spark","content":"This section discusses Spark HBase integration at the lowest and simplest levels.\nAll the other interaction points are built upon the concepts that will be described\nhere."},"8682":{"id":"/docs/spark-26","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#basic-spark","content":"At the root of all Spark and HBase integration is the HBaseContext. The HBaseContext\ntakes in HBase configurations and pushes them to the Spark executors. This allows\nus to have an HBase Connection per Spark Executor in a static location."},"8683":{"id":"/docs/spark-27","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#basic-spark","content":"For reference, Spark Executors can be on the same nodes as the Region Servers or\non different nodes, there is no dependence on co-location. Think of every Spark\nExecutor as a multi-threaded client application. This allows any Spark Tasks\nrunning on the executors to access the shared Connection object."},"8684":{"id":"/docs/spark-28","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"This example shows how HBaseContext can be used to do a `foreachPartition` on a RDD\nin Scala:"},"8685":{"id":"/docs/spark-29","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"Here is the same example implemented in Java:"},"8686":{"id":"/docs/spark-30","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"All functionality between Spark and HBase will be supported both in Scala and in\nJava, with the exception of SparkSQL which will support any language that is\nsupported by Spark. For the remaining of this documentation we will focus on\nScala examples."},"8687":{"id":"/docs/spark-31","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"The examples above illustrate how to do a foreachPartition with a connection. A\nnumber of other Spark base functions are supported out of the box:"},"8688":{"id":"/docs/spark-32","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"**`bulkPut`**\\\nFor massively parallel sending of puts to HBase"},"8689":{"id":"/docs/spark-33","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"**`bulkDelete`**\\\nFor massively parallel sending of deletes to HBase"},"8690":{"id":"/docs/spark-34","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"**`bulkGet`**\\\nFor massively parallel sending of gets to HBase to create a new RDD"},"8691":{"id":"/docs/spark-35","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"**`mapPartition`**\\\nTo do a Spark Map function with a Connection object to allow full\naccess to HBase"},"8692":{"id":"/docs/spark-36","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"**`hbaseRDD`**\\\nTo simplify a distributed scan to create a RDD"},"8693":{"id":"/docs/spark-37","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#hbasecontext-usage-example","content":"For examples of all these functionalities, see the\nhbase-spark integration\nin the hbase-connectors repository\n(the hbase-spark connectors live outside hbase core in a related,\nApache HBase project maintained, associated repo)."},"8694":{"id":"/docs/spark-38","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"Spark Streaming is a micro batching stream\nprocessing framework built on top of Spark. HBase and Spark Streaming make great\ncompanions in that HBase can help serve the following benefits alongside Spark\nStreaming."},"8695":{"id":"/docs/spark-39","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"A place to grab reference data or profile data on the fly"},"8696":{"id":"/docs/spark-40","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"A place to store counts or aggregates in a way that supports Spark Streaming's\npromise of *only once processing*."},"8697":{"id":"/docs/spark-41","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"The hbase-spark integration\nwith Spark Streaming is similar to its normal Spark integration points, in that the following\ncommands are possible straight off a Spark Streaming DStream."},"8698":{"id":"/docs/spark-42","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"**`bulkPut`**\\\nFor massively parallel sending of puts to HBase"},"8699":{"id":"/docs/spark-43","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"**`bulkDelete`**\\\nFor massively parallel sending of deletes to HBase"},"8700":{"id":"/docs/spark-44","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"**`bulkGet`**\\\nFor massively parallel sending of gets to HBase to create a new RDD"},"8701":{"id":"/docs/spark-45","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"**`mapPartition`**\\\nTo do a Spark Map function with a Connection object to allow full\naccess to HBase"},"8702":{"id":"/docs/spark-46","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#spark-streaming","content":"**`hbaseRDD`**\\\nTo simplify a distributed scan to create a RDD"},"8703":{"id":"/docs/spark-47","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulkput-example-with-dstreams","content":"Below is an example of bulkPut with DStreams. It is very close in feel to the RDD\nbulk put."},"8704":{"id":"/docs/spark-48","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulkput-example-with-dstreams","content":"There are three inputs to the `hbaseBulkPut` function.\nThe hbaseContext that carries the configuration broadcast information link\nto the HBase Connections in the executor, the table name of the table we are\nputting data into, and a function that will convert a record in the DStream\ninto an HBase Put object."},"8705":{"id":"/docs/spark-49","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-load","content":"There are two options for bulk loading data into HBase with Spark. There is the\nbasic bulk load functionality that will work for cases where your rows have\nmillions of columns and cases where your columns are not consolidated and\npartitioned before the map side of the Spark bulk load process."},"8706":{"id":"/docs/spark-50","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-load","content":"There is also a thin record bulk load option with Spark. This second option is\ndesigned for tables that have less then 10k columns per row. The advantage\nof this second option is higher throughput and less over-all load on the Spark\nshuffle operation."},"8707":{"id":"/docs/spark-51","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-load","content":"Both implementations work more or less like the MapReduce bulk load process in\nthat a partitioner partitions the rowkeys based on region splits and\nthe row keys are sent to the reducers in order, so that HFiles can be written\nout directly from the reduce phase."},"8708":{"id":"/docs/spark-52","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-load","content":"In Spark terms, the bulk load will be implemented around a Spark\n`repartitionAndSortWithinPartitions` followed by a Spark `foreachPartition`."},"8709":{"id":"/docs/spark-53","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-load","content":"First lets look at an example of using the basic bulk load functionality"},"8710":{"id":"/docs/spark-54","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-loading-example","content":"The following example shows bulk loading with Spark."},"8711":{"id":"/docs/spark-55","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-loading-example","content":"The `hbaseBulkLoad` function takes three required parameters:"},"8712":{"id":"/docs/spark-56","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-loading-example","content":"The table name of the table we intend to bulk load too"},"8713":{"id":"/docs/spark-57","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-loading-example","content":"A function that will convert a record in the RDD to a tuple key value par. With\nthe tuple key being a KeyFamilyQualifer object and the value being the cell value.\nThe KeyFamilyQualifer object will hold the RowKey, Column Family, and Column Qualifier.\nThe shuffle will partition on the RowKey but will sort by all three values."},"8714":{"id":"/docs/spark-58","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-loading-example","content":"The temporary path for the HFile to be written out too"},"8715":{"id":"/docs/spark-59","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#bulk-loading-example","content":"Following the Spark bulk load command, use the HBase's LoadIncrementalHFiles object\nto load the newly created HFiles into HBase."},"8716":{"id":"/docs/spark-60","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#additional-parameters-for-bulk-loading-with-spark","content":"You can set the following attributes with additional parameter options on hbaseBulkLoad."},"8717":{"id":"/docs/spark-61","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#additional-parameters-for-bulk-loading-with-spark","content":"Max file size of the HFiles"},"8718":{"id":"/docs/spark-62","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#additional-parameters-for-bulk-loading-with-spark","content":"A flag to exclude HFiles from compactions"},"8719":{"id":"/docs/spark-63","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#additional-parameters-for-bulk-loading-with-spark","content":"Column Family settings for compression, bloomType, blockSize, and dataBlockEncoding"},"8720":{"id":"/docs/spark-64","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#using-additional-parameters","content":"Now lets look at how you would call the thin record bulk load implementation"},"8721":{"id":"/docs/spark-65","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#using-thin-record-bulk-load","content":"Note that the big difference in using bulk load for thin rows is the function\nreturns a tuple with the first value being the row key and the second value\nbeing an object of FamiliesQualifiersValues, which will contain all the\nvalues for this row for all column families."},"8722":{"id":"/docs/spark-66","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#sparksqldataframes","content":"The hbase-spark integration\nleverages\nDataSource API\n(SPARK-3247)\nintroduced in Spark-1.2.0, which bridges the gap between simple HBase KV store and complex\nrelational SQL queries and enables users to perform complex data analytical work\non top of HBase using Spark. HBase Dataframe is a standard Spark Dataframe, and is able to\ninteract with any other data sources such as Hive, Orc, Parquet, JSON, etc.\nThe hbase-spark integration\napplies critical techniques such as partition pruning, column pruning,\npredicate pushdown and data locality."},"8723":{"id":"/docs/spark-67","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#sparksqldataframes","content":"To use the\nhbase-spark integration\nconnector, users need to define the Catalog for the schema mapping\nbetween HBase and Spark tables, prepare the data and populate the HBase table,\nthen load the HBase DataFrame. After that, users can do integrated query and access records\nin HBase tables with SQL query. The following illustrates the basic procedure."},"8724":{"id":"/docs/spark-68","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#define-catalog","content":"Catalog defines a mapping between HBase and Spark tables. There are two critical parts of this catalog.\nOne is the rowkey definition and the other is the mapping between table column in Spark and\nthe column family and column qualifier in HBase. The above defines a schema for a HBase table\nwith name as table1, row key as key and a number of columns (col1 `-` col8). Note that the rowkey\nalso has to be defined in details as a column (col0), which has a specific cf (rowkey)."},"8725":{"id":"/docs/spark-69","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#save-the-dataframe","content":"`data` prepared by the user is a local Scala collection which has 256 HBaseRecord objects.\n`sc.parallelize(data)` function distributes `data` to form an RDD. `toDF` returns a DataFrame.\n`write` function returns a DataFrameWriter used to write the DataFrame to external storage\nsystems (e.g. HBase here). Given a DataFrame with specified schema `catalog`, `save` function\nwill create an HBase table with 5 regions and save the DataFrame inside."},"8726":{"id":"/docs/spark-70","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#load-the-dataframe","content":"In 'withCatalog' function, sqlContext is a variable of SQLContext, which is the entry point\nfor working with structured data (rows and columns) in Spark.\n`read` returns a DataFrameReader that can be used to read data in as a DataFrame.\n`option` function adds input options for the underlying data source to the DataFrameReader,\nand `format` function specifies the input data source format for the DataFrameReader.\nThe `load()` function loads input in as a DataFrame. The date frame `df` returned\nby `withCatalog` function could be used to access HBase table, such as 4.4 and 4.5."},"8727":{"id":"/docs/spark-71","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#language-integrated-query","content":"DataFrame can do various operations, such as join, sort, select, filter, orderBy and so on.\n`df.filter` above filters rows using the given SQL expression. `select` selects a set of columns:\n`col0`, `col1` and `col4`."},"8728":{"id":"/docs/spark-72","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#sql-query","content":"`registerTempTable` registers `df` DataFrame as a temporary table using the table name `table1`.\nThe lifetime of this temporary table is tied to the SQLContext that was used to create `df`.\n`sqlContext.sql` function allows the user to execute SQL queries."},"8729":{"id":"/docs/spark-73","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#query-with-different-timestamps","content":"In HBaseSparkConf, four parameters related to timestamp can be set. They are TIMESTAMP,\nMIN\\_TIMESTAMP, MAX\\_TIMESTAMP and MAX\\_VERSIONS respectively. Users can query records with\ndifferent timestamps or time ranges with MIN\\_TIMESTAMP and MAX\\_TIMESTAMP. In the meantime,\nuse concrete value instead of tsSpecified and oldMs in the examples below."},"8730":{"id":"/docs/spark-74","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#query-with-different-timestamps","content":"The example below shows how to load df DataFrame with different timestamps.\ntsSpecified is specified by the user.\nHBaseTableCatalog defines the HBase and Relation relation schema.\nwriteCatalog defines catalog for the schema mapping."},"8731":{"id":"/docs/spark-75","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#query-with-different-timestamps","content":"The example below shows how to load df DataFrame with different time ranges.\noldMs is specified by the user."},"8732":{"id":"/docs/spark-76","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#query-with-different-timestamps","content":"After loading df DataFrame, users can query data."},"8733":{"id":"/docs/spark-77","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"The hbase-spark integration\nconnector supports different data formats like Avro, JSON, etc. The use case below\nshows how spark supports Avro. Users can persist the Avro record into HBase directly. Internally,\nthe Avro schema is converted to a native Spark Catalyst data type automatically.\nNote that both key-value parts in an HBase table can be defined in Avro format."},"8734":{"id":"/docs/spark-78","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"Define catalog for the schema mapping:"},"8735":{"id":"/docs/spark-79","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"`catalog` is a schema for a HBase table named `Avrotable`. row key as key and\none column col1. The rowkey also has to be defined in details as a column (col0),\nwhich has a specific cf (rowkey)."},"8736":{"id":"/docs/spark-80","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"Prepare the Data:"},"8737":{"id":"/docs/spark-81","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"`schemaString` is defined first, then it is parsed to get `avroSchema`. `avroSchema` is used to\ngenerate `AvroHBaseRecord`. `data` prepared by users is a local Scala collection\nwhich has 256 `AvroHBaseRecord` objects."},"8738":{"id":"/docs/spark-82","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"Save DataFrame:"},"8739":{"id":"/docs/spark-83","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"Given a data frame with specified schema `catalog`, above will create an HBase table with 5\nregions and save the data frame inside."},"8740":{"id":"/docs/spark-84","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"Load the DataFrame"},"8741":{"id":"/docs/spark-85","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"In `withCatalog` function, `read` returns a DataFrameReader that can be used to read data in as a DataFrame.\nThe `option` function adds input options for the underlying data source to the DataFrameReader.\nThere are two options: one is to set `avroSchema` as `AvroHBaseRecord.schemaString`, and one is to\nset `HBaseTableCatalog.tableCatalog` as `avroCatalog`. The `load()` function loads input in as a DataFrame.\nThe date frame `df` returned by `withCatalog` function could be used to access the HBase table."},"8742":{"id":"/docs/spark-86","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"SQL Query"},"8743":{"id":"/docs/spark-87","page_id":"/docs/spark","tags":["multi-page"],"type":"text","url":"/docs/spark#native-avro-support","content":"After loading df DataFrame, users can query data. registerTempTable registers df DataFrame\nas a temporary table using the table name avrotable. `sqlContext.sql` function allows the\nuser to execute SQL queries."},"8744":{"id":"/docs/sql","page_id":"/docs/sql","type":"page","content":"SQL over HBase","breadcrumbs":["Docs","Multi-Page Documentation","Appendices"],"tags":["multi-page"],"url":"/docs/sql"},"8745":{"id":"/docs/sql-0","page_id":"/docs/sql","tags":["multi-page"],"type":"text","url":"/docs/sql","content":"The following projects offer some support for SQL over HBase."},"8746":{"id":"/docs/sql-1","page_id":"/docs/sql","tags":["multi-page"],"type":"text","url":"/docs/sql","content":"Apache Phoenix"},"8747":{"id":"/docs/sql-2","page_id":"/docs/sql","tags":["multi-page"],"type":"text","url":"/docs/sql","content":"Trafodion: Transactional SQL-on-HBase"},"8748":{"id":"/docs/store-file-tracking","page_id":"/docs/store-file-tracking","type":"page","content":"Store File Tracking","breadcrumbs":["Docs","Multi-Page Documentation","Infrastructure & Tools"],"tags":["multi-page"],"url":"/docs/store-file-tracking"},"8749":{"id":"/docs/store-file-tracking-0","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking","content":"This feature introduces an abstraction layer to track store files still used/needed by store engines, allowing for plugging different approaches of identifying store files required by the given store."},"8750":{"id":"/docs/store-file-tracking-1","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#store-file-tracking-overview","content":"Overview"},"8751":{"id":"/docs/store-file-tracking-2","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#available-implementations","content":"Available Implementations"},"8752":{"id":"/docs/store-file-tracking-3","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#store-file-tracking-default","content":"DEFAULT"},"8753":{"id":"/docs/store-file-tracking-4","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#file","content":"FILE"},"8754":{"id":"/docs/store-file-tracking-5","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#migration","content":"MIGRATION"},"8755":{"id":"/docs/store-file-tracking-6","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#store-file-tracking-usage","content":"Usage"},"8756":{"id":"/docs/store-file-tracking-7","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#configuring-for-table-or-column-family","content":"Configuring for Table or Column Family"},"8757":{"id":"/docs/store-file-tracking-8","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#switching-trackers-at-table-or-column-family","content":"Switching trackers at Table or Column Family"},"8758":{"id":"/docs/store-file-tracking-9","page_id":"/docs/store-file-tracking","type":"heading","tags":["multi-page"],"url":"/docs/store-file-tracking#specifying-trackers-during-snapshot-recovery","content":"Specifying trackers during snapshot recovery"},"8759":{"id":"/docs/store-file-tracking-10","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#store-file-tracking-overview","content":"Historically, HBase internals have relied on creating hfiles on temporary directories first, renaming\nthose files to the actual store directory at operation commit time. That's a simple and convenient\nway to separate transient from already finalised files that are ready to serve client reads with data.\nThis approach works well with strong consistent file systems, but with the popularity of less consistent\nfile systems, mainly Object Store which can be used like file systems, dependency on atomic rename operations starts to introduce performance penalties. The Amazon S3 Object Store, in particular, has been the most affected deployment,\ndue to its lack of atomic renames. The HBase community temporarily bypassed this problem by building a distributed locking layer called HBOSS, to guarantee atomicity of operations against S3."},"8760":{"id":"/docs/store-file-tracking-11","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#store-file-tracking-overview","content":"With **Store File Tracking**, decision on where to originally create new hfiles and how to proceed upon\ncommit is delegated to the specific Store File Tracking implementation.\nThe implementation can be set at the HBase service leve in **hbase-site.xml** or at the\nTable or Column Family via the TableDescriptor configuration."},"8761":{"id":"/docs/store-file-tracking-12","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#store-file-tracking-overview","content":"When the store file tracking implementation is specified in **hbase\\_site.xml**, this configuration\nis also propagated into a tables configuration at table creation time. This is to avoid dangerous\nconfiguration mismatches between processes, which could potentially lead to data loss."},"8762":{"id":"/docs/store-file-tracking-13","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#available-implementations","content":"Store File Tracking initial version provides three builtin implementations:"},"8763":{"id":"/docs/store-file-tracking-14","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#available-implementations","content":"DEFAULT"},"8764":{"id":"/docs/store-file-tracking-15","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#available-implementations","content":"FILE"},"8765":{"id":"/docs/store-file-tracking-16","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#available-implementations","content":"MIGRATION"},"8766":{"id":"/docs/store-file-tracking-17","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#store-file-tracking-default","content":"As per the name, this is the Store File Tracking implementation used by default when no explicit\nconfiguration has been defined. The DEFAULT tracker implements the standard approach using temporary\ndirectories and renames. This is how all previous (implicit) implementation that HBase used to track store files."},"8767":{"id":"/docs/store-file-tracking-18","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#file","content":"A file tracker implementation that creates new files straight in the store directory, avoiding the\nneed for rename operations. It keeps a list of committed hfiles in memory, backed by meta files, in\neach store directory. Whenever a new hfile is committed, the list of *tracked files* in the given\nstore is updated and a new meta file is written with this list contents, discarding the previous\nmeta file now containing an out dated list."},"8768":{"id":"/docs/store-file-tracking-19","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#migration","content":"A special implementation to be used when swapping between Store File Tracking implementations on\npre-existing tables that already contain data, and therefore, files being tracked under an specific\nlogic."},"8769":{"id":"/docs/store-file-tracking-20","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#store-file-tracking-usage","content":"For fresh deployments that don't yet contain any user data, **FILE** implementation can be just set as\nvalue for **hbase.store.file-tracker.impl** property in global **hbase-site.xml** configuration, prior\nto the first hbase start. Omitting this property sets the **DEFAULT** implementation."},"8770":{"id":"/docs/store-file-tracking-21","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#store-file-tracking-usage","content":"For clusters with data that are upgraded to a version of HBase containing the store file tracking\nfeature, the Store File Tracking implementation can only be changed with the **MIGRATION**\nimplementation, so that the *new tracker* can safely build its list of tracked files based on the\nlist of the *current tracker*."},"8771":{"id":"/docs/store-file-tracking-22","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#store-file-tracking-usage","content":"MIGRATION tracker should NOT be set at global configuration. To use it, follow below section about\nsetting Store File Tacking at Table or Column Family configuration."},"8772":{"id":"/docs/store-file-tracking-23","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#configuring-for-table-or-column-family","content":"Setting Store File Tracking configuration globally may not always be possible or desired, for example,\nin the case of upgraded clusters with pre-existing user data.\nStore File Tracking can be set at Table or Column Family level configuration.\nFor example, to specify **FILE** implementation in the table configuration at table creation time,\nthe following should be applied:"},"8773":{"id":"/docs/store-file-tracking-24","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#configuring-for-table-or-column-family","content":"To define **FILE** for an specific Column Family:"},"8774":{"id":"/docs/store-file-tracking-25","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#switching-trackers-at-table-or-column-family","content":"A very common scenario is to set Store File Tracking on pre-existing HBase deployments that have\nbeen upgraded to a version that supports this feature. To apply the FILE tracker, tables effectively\nneed to be migrated from the DEFAULT tracker to the FILE tracker. As explained previously, such\nprocess requires the usage of the special MIGRATION tracker implementation, which can only be\nspecified at table or Column Family level."},"8775":{"id":"/docs/store-file-tracking-26","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#switching-trackers-at-table-or-column-family","content":"For example, to switch *tracker* from **DEFAULT** to **FILE** in a table configuration:"},"8776":{"id":"/docs/store-file-tracking-27","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#switching-trackers-at-table-or-column-family","content":"To apply similar switch at column family level configuration:"},"8777":{"id":"/docs/store-file-tracking-28","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#switching-trackers-at-table-or-column-family","content":"Once all table regions have been onlined again, don't forget to disable MIGRATION, by now setting\n**hbase.store.file-tracker.migration.dst.impl** value as the **hbase.store.file-tracker.impl**. In the above\nexample, that would be as follows:"},"8778":{"id":"/docs/store-file-tracking-29","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#specifying-trackers-during-snapshot-recovery","content":"It's also possible to specify a given store file tracking implementation when recovering a snapshot\nusing the *CLONE\\_SFT* option of *clone\\_snasphot* command. This is useful when recovering old\nsnapshots, taken prior to a change in the global configuration, or if the snapshot has been\nimported from a different cluster that had a different store file tracking setting.\nBecause snapshots preserve table and colum family descriptors, a simple restore would reload\nthe original configuration, requiring the additional steps described above to convert the\ntable/column family to the desired tracker implementation.\nAn example of how to use *clone\\_snapshot* to specify the **FILE** tracker implementation\nis shown below:"},"8779":{"id":"/docs/store-file-tracking-30","page_id":"/docs/store-file-tracking","tags":["multi-page"],"type":"text","url":"/docs/store-file-tracking#specifying-trackers-during-snapshot-recovery","content":"The option to specify the tracker during snapshot recovery is only available for the\n*clone\\_snapshot* command. The *restore\\_snapshot* command does not support this parameter."},"8780":{"id":"/docs/sync-replication","page_id":"/docs/sync-replication","type":"page","content":"Synchronous Replication","breadcrumbs":["Docs","Multi-Page Documentation","Advanced Features"],"tags":["multi-page"],"url":"/docs/sync-replication"},"8781":{"id":"/docs/sync-replication-0","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication","content":"Setting up synchronous replication between HBase clusters for strong consistency and automatic failover capabilities."},"8782":{"id":"/docs/sync-replication-1","page_id":"/docs/sync-replication","type":"heading","tags":["multi-page"],"url":"/docs/sync-replication#sync-replication-background","content":"Background"},"8783":{"id":"/docs/sync-replication-2","page_id":"/docs/sync-replication","type":"heading","tags":["multi-page"],"url":"/docs/sync-replication#design","content":"Design"},"8784":{"id":"/docs/sync-replication-3","page_id":"/docs/sync-replication","type":"heading","tags":["multi-page"],"url":"/docs/sync-replication#operation-and-maintenance","content":"Operation and maintenance"},"8785":{"id":"/docs/sync-replication-4","page_id":"/docs/sync-replication","type":"heading","tags":["multi-page"],"url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"Case.1 Setup two synchronous replication clusters"},"8786":{"id":"/docs/sync-replication-5","page_id":"/docs/sync-replication","type":"heading","tags":["multi-page"],"url":"/docs/sync-replication#case2-how-to-operate-when-standby-cluster-crashed","content":"Case.2 How to operate when standby cluster crashed"},"8787":{"id":"/docs/sync-replication-6","page_id":"/docs/sync-replication","type":"heading","tags":["multi-page"],"url":"/docs/sync-replication#case3-how-to-operate-when-active-cluster-crashed","content":"Case.3 How to operate when active cluster crashed"},"8788":{"id":"/docs/sync-replication-7","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#sync-replication-background","content":"The current Cluster Replication in HBase in asynchronous. So if the master cluster crashes, the slave cluster may not have the\nnewest data. If users want strong consistency then they can not switch to the slave cluster."},"8789":{"id":"/docs/sync-replication-8","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#design","content":"Please see the design doc on HBASE-19064"},"8790":{"id":"/docs/sync-replication-9","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"Add a synchronous peer in both source cluster and peer cluster."},"8791":{"id":"/docs/sync-replication-10","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"For source cluster:"},"8792":{"id":"/docs/sync-replication-11","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"For peer cluster:"},"8793":{"id":"/docs/sync-replication-12","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"For synchronous replication, the current implementation require that we have the same peer id for\nboth source and peer cluster. Another thing that need attention is: the peer does not support\ncluster-level, namespace-level, or cf-level replication, only support table-level replication now."},"8794":{"id":"/docs/sync-replication-13","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"Transit the peer cluster to be STANDBY state"},"8795":{"id":"/docs/sync-replication-14","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"Transit the source cluster to be ACTIVE state"},"8796":{"id":"/docs/sync-replication-15","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case1-setup-two-synchronous-replication-clusters","content":"Now, the synchronous replication has been set up successfully. the HBase client can only request to source cluster, if\nrequest to peer cluster, the peer cluster which is STANDBY state now will reject the read/write requests."},"8797":{"id":"/docs/sync-replication-16","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case2-how-to-operate-when-standby-cluster-crashed","content":"If the standby cluster has been crashed, it will fail to write remote WAL for the active cluster. So we need to transit\nthe source cluster to DOWNGRANDE\\_ACTIVE state, which means source cluster won't write any remote WAL any more, but\nthe normal replication (asynchronous Replication) can still work fine, it queue the newly written WALs, but the\nreplication block until the peer cluster come back."},"8798":{"id":"/docs/sync-replication-17","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case2-how-to-operate-when-standby-cluster-crashed","content":"Once the peer cluster come back, we can just transit the source cluster to ACTIVE, to ensure that the replication will be\nsynchronous."},"8799":{"id":"/docs/sync-replication-18","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case3-how-to-operate-when-active-cluster-crashed","content":"If the active cluster has been crashed (it may be not reachable now), so let's just transit the standby cluster to\nDOWNGRADE\\_ACTIVE state, and after that, we should redirect all the requests from client to the DOWNGRADE\\_ACTIVE cluster."},"8800":{"id":"/docs/sync-replication-19","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case3-how-to-operate-when-active-cluster-crashed","content":"If the crashed cluster come back again, we just need to transit it to STANDBY directly. Otherwise if you transit the\ncluster to DOWNGRADE\\_ACTIVE, the original ACTIVE cluster may have redundant data compared to the current ACTIVE\ncluster. Because we designed to write source cluster WALs and remote cluster WALs concurrently, so it's possible that\nthe source cluster WALs has more data than the remote cluster, which result in data inconsistency. The procedure of\ntransiting ACTIVE to STANDBY has no problem, because we'll skip to replay the original WALs."},"8801":{"id":"/docs/sync-replication-20","page_id":"/docs/sync-replication","tags":["multi-page"],"type":"text","url":"/docs/sync-replication#case3-how-to-operate-when-active-cluster-crashed","content":"After that, we can promote the DOWNGRADE\\_ACTIVE cluster to ACTIVE now, to ensure that the replication will be synchronous."},"8802":{"id":"/docs/thrift-filter-language","page_id":"/docs/thrift-filter-language","type":"page","content":"Thrift API and Filter Language","breadcrumbs":["Docs","Multi-Page Documentation","APIs & Integration"],"tags":["multi-page"],"url":"/docs/thrift-filter-language"},"8803":{"id":"/docs/thrift-filter-language-0","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language","content":"Apache Thrift is a cross-platform, cross-language development framework. HBase includes a Thrift API and filter language. The Thrift API relies on client and server processes."},"8804":{"id":"/docs/thrift-filter-language-1","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#filter-language","content":"Filter Language"},"8805":{"id":"/docs/thrift-filter-language-2","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"General Filter String Syntax"},"8806":{"id":"/docs/thrift-filter-language-3","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#compound-filters-and-operators","content":"Compound Filters and Operators"},"8807":{"id":"/docs/thrift-filter-language-4","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#binary-operators","content":"Binary Operators"},"8808":{"id":"/docs/thrift-filter-language-5","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#unary-operators","content":"Unary Operators"},"8809":{"id":"/docs/thrift-filter-language-6","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#compound-operators","content":"Compound Operators"},"8810":{"id":"/docs/thrift-filter-language-7","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#order-of-evaluation","content":"Order of Evaluation"},"8811":{"id":"/docs/thrift-filter-language-8","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#precedence-example","content":"Precedence Example"},"8812":{"id":"/docs/thrift-filter-language-9","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#compare-operator","content":"Compare Operator"},"8813":{"id":"/docs/thrift-filter-language-10","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#comparator","content":"Comparator"},"8814":{"id":"/docs/thrift-filter-language-11","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#example-comparatorvalues","content":"Example ComparatorValues"},"8815":{"id":"/docs/thrift-filter-language-12","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#example-php-client-program-that-uses-the-filter-language","content":"Example PHP Client Program that uses the Filter Language"},"8816":{"id":"/docs/thrift-filter-language-13","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#example-filter-strings","content":"Example Filter Strings"},"8817":{"id":"/docs/thrift-filter-language-14","page_id":"/docs/thrift-filter-language","type":"heading","tags":["multi-page"],"url":"/docs/thrift-filter-language#individual-filter-syntax","content":"Individual Filter Syntax"},"8818":{"id":"/docs/thrift-filter-language-15","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language","content":"You can configure Thrift for secure authentication at the server and client side, by following the procedures in Client-side Configuration for Secure Operation - Thrift Gateway and Configure the Thrift Gateway to Authenticate on Behalf of the Client."},"8819":{"id":"/docs/thrift-filter-language-16","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language","content":"The rest of this chapter discusses the filter language provided by the Thrift API."},"8820":{"id":"/docs/thrift-filter-language-17","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#filter-language","content":"Thrift Filter Language was introduced in HBase 0.92.\nIt allows you to perform server-side filtering when accessing HBase over Thrift or in the HBase shell.\nYou can find out more about shell integration by using the `scan help` command in the shell."},"8821":{"id":"/docs/thrift-filter-language-18","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#filter-language","content":"You specify a filter as a string, which is parsed on the server to construct the filter."},"8822":{"id":"/docs/thrift-filter-language-19","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"A simple filter expression is expressed as a string:"},"8823":{"id":"/docs/thrift-filter-language-20","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"Keep the following syntax guidelines in mind."},"8824":{"id":"/docs/thrift-filter-language-21","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"Specify the name of the filter followed by the comma-separated argument list in parentheses."},"8825":{"id":"/docs/thrift-filter-language-22","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"If the argument represents a string, it should be enclosed in single quotes (`'`)."},"8826":{"id":"/docs/thrift-filter-language-23","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"Arguments which represent a boolean, an integer, or a comparison operator (such as `<`, `>`, or `!=`), should not be enclosed in quotes"},"8827":{"id":"/docs/thrift-filter-language-24","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"The filter name must be a single word.\nAll ASCII characters are allowed except for whitespace, single quotes and parentheses."},"8828":{"id":"/docs/thrift-filter-language-25","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#general-filter-string-syntax","content":"The filter's arguments can contain any ASCII character.\nIf single quotes are present in the argument, they must be escaped by an additional preceding single quote."},"8829":{"id":"/docs/thrift-filter-language-26","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#binary-operators","content":"**`AND`**\\\nIf the `AND` operator is used, the key-value must satisfy both filters."},"8830":{"id":"/docs/thrift-filter-language-27","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#binary-operators","content":"**`OR`**\\\nIf the `OR` operator is used, the key-value must satisfy at least one of the filters."},"8831":{"id":"/docs/thrift-filter-language-28","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#unary-operators","content":"**`SKIP`**\\\nFor a particular row, if any of the key-values fail the filter condition, the entire row is skipped."},"8832":{"id":"/docs/thrift-filter-language-29","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#unary-operators","content":"**`WHILE`**\\\nFor a particular row, key-values will be emitted until a key-value is reached that fails the filter condition."},"8833":{"id":"/docs/thrift-filter-language-30","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compound-operators","content":"You can combine multiple operators to create a hierarchy of filters, such as the following example:"},"8834":{"id":"/docs/thrift-filter-language-31","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#order-of-evaluation","content":"Parentheses have the highest precedence."},"8835":{"id":"/docs/thrift-filter-language-32","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#order-of-evaluation","content":"The unary operators `SKIP` and `WHILE` are next, and have the same precedence."},"8836":{"id":"/docs/thrift-filter-language-33","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#order-of-evaluation","content":"The binary operators follow. `AND` has highest precedence, followed by `OR`."},"8837":{"id":"/docs/thrift-filter-language-34","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#precedence-example","content":"You can use parentheses to explicitly control the order of evaluation."},"8838":{"id":"/docs/thrift-filter-language-35","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"The following compare operators are provided:"},"8839":{"id":"/docs/thrift-filter-language-36","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"LESS (`<`)"},"8840":{"id":"/docs/thrift-filter-language-37","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"LESS\\_OR\\_EQUAL (`<=`)"},"8841":{"id":"/docs/thrift-filter-language-38","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"EQUAL (`=`)"},"8842":{"id":"/docs/thrift-filter-language-39","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"NOT\\_EQUAL (`!=`)"},"8843":{"id":"/docs/thrift-filter-language-40","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"GREATER\\_OR\\_EQUAL (`>=`)"},"8844":{"id":"/docs/thrift-filter-language-41","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"GREATER (`>`)"},"8845":{"id":"/docs/thrift-filter-language-42","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"NO\\_OP (no operation)"},"8846":{"id":"/docs/thrift-filter-language-43","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#compare-operator","content":"The client should use the symbols (`<`, `<=`, `=`, `!=`, `>`, `>=`) to express compare operators."},"8847":{"id":"/docs/thrift-filter-language-44","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"A comparator can be any of the following:"},"8848":{"id":"/docs/thrift-filter-language-45","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*BinaryComparator* - This lexicographically compares against the specified byte array using Bytes.compareTo(byte\\[], byte\\[])"},"8849":{"id":"/docs/thrift-filter-language-46","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*BinaryPrefixComparator* - This lexicographically compares against a specified byte array.\nIt only compares up to the length of this byte array."},"8850":{"id":"/docs/thrift-filter-language-47","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*RegexStringComparator* - This compares against the specified byte array using the given regular expression.\nOnly EQUAL and NOT\\_EQUAL comparisons are valid with this comparator"},"8851":{"id":"/docs/thrift-filter-language-48","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*SubStringComparator* - This tests if the given substring appears in a specified byte array.\nThe comparison is case insensitive.\nOnly EQUAL and NOT\\_EQUAL comparisons are valid with this comparator"},"8852":{"id":"/docs/thrift-filter-language-49","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"The general syntax of a comparator is: `ComparatorType:ComparatorValue`"},"8853":{"id":"/docs/thrift-filter-language-50","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"The ComparatorType for the various comparators is as follows:"},"8854":{"id":"/docs/thrift-filter-language-51","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*BinaryComparator* - binary"},"8855":{"id":"/docs/thrift-filter-language-52","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*BinaryPrefixComparator* - binaryprefix"},"8856":{"id":"/docs/thrift-filter-language-53","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*RegexStringComparator* - regexstring"},"8857":{"id":"/docs/thrift-filter-language-54","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"*SubStringComparator* - substring"},"8858":{"id":"/docs/thrift-filter-language-55","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#comparator","content":"The ComparatorValue can be any value."},"8859":{"id":"/docs/thrift-filter-language-56","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-comparatorvalues","content":"`binary:abc` will match everything that is lexicographically greater than \"abc\""},"8860":{"id":"/docs/thrift-filter-language-57","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-comparatorvalues","content":"`binaryprefix:abc` will match everything whose first 3 characters are lexicographically equal to \"abc\""},"8861":{"id":"/docs/thrift-filter-language-58","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-comparatorvalues","content":"`regexstring:ab*yz` will match everything that doesn't begin with \"ab\" and ends with \"yz\""},"8862":{"id":"/docs/thrift-filter-language-59","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-comparatorvalues","content":"`substring:abc123` will match everything that begins with the substring \"abc123\""},"8863":{"id":"/docs/thrift-filter-language-60","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"`\"PrefixFilter ('Row') AND PageFilter (1) AND FirstKeyOnlyFilter ()\"` will return all key-value pairs that match the following conditions:"},"8864":{"id":"/docs/thrift-filter-language-61","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"The row containing the key-value should have prefix *Row*"},"8865":{"id":"/docs/thrift-filter-language-62","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"The key-value must be located in the first row of the table"},"8866":{"id":"/docs/thrift-filter-language-63","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"The key-value pair must be the first key-value in the row"},"8867":{"id":"/docs/thrift-filter-language-64","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"`\"(RowFilter (=, 'binary:Row 1') AND TimeStampsFilter (74689, 89734)) OR ColumnRangeFilter ('abc', true, 'xyz', false))\"` will return all key-value pairs that match both the following conditions:"},"8868":{"id":"/docs/thrift-filter-language-65","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"The key-value is in a row having row key *Row 1*"},"8869":{"id":"/docs/thrift-filter-language-66","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"The key-value must have a timestamp of either 74689 or 89734."},"8870":{"id":"/docs/thrift-filter-language-67","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"Or it must match the following condition:"},"8871":{"id":"/docs/thrift-filter-language-68","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"The key-value pair must be in a column that is lexicographically >= abc and \\< xyz"},"8872":{"id":"/docs/thrift-filter-language-69","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#example-filter-strings","content":"`\"SKIP ValueFilter (0)\"` will skip the entire row if any of the values in the row is not 0"},"8873":{"id":"/docs/thrift-filter-language-70","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**KeyOnlyFilter**\\\nThis filter doesn't take any arguments.\nIt returns only the key component of each key-value."},"8874":{"id":"/docs/thrift-filter-language-71","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**FirstKeyOnlyFilter**\\\nThis filter doesn't take any arguments.\nIt returns only the first key-value from each row."},"8875":{"id":"/docs/thrift-filter-language-72","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**PrefixFilter**\\\nThis filter takes one argument – a prefix of a row key.\nIt returns only those key-values present in a row that starts with the specified row prefix"},"8876":{"id":"/docs/thrift-filter-language-73","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**ColumnPrefixFilter**\\\nThis filter takes one argument – a column prefix.\nIt returns only those key-values present in a column that starts with the specified column prefix.\nThe column prefix must be of the form: `\"qualifier\"`."},"8877":{"id":"/docs/thrift-filter-language-74","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**MultipleColumnPrefixFilter**\\\nThis filter takes a list of column prefixes.\nIt returns key-values that are present in a column that starts with any of the specified column prefixes.\nEach of the column prefixes must be of the form: `\"qualifier\"`."},"8878":{"id":"/docs/thrift-filter-language-75","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**ColumnCountGetFilter**\\\nThis filter takes one argument – a limit.\nIt returns the first limit number of columns in the table."},"8879":{"id":"/docs/thrift-filter-language-76","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**PageFilter**\\\nThis filter takes one argument – a page size.\nIt returns page size number of rows from the table."},"8880":{"id":"/docs/thrift-filter-language-77","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**ColumnPaginationFilter**\\\nThis filter takes two arguments – a limit and offset.\nIt returns limit number of columns after offset number of columns.\nIt does this for all the rows."},"8881":{"id":"/docs/thrift-filter-language-78","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**InclusiveStopFilter**\\\nThis filter takes one argument – a row key on which to stop scanning.\nIt returns all key-values present in rows up to and including the specified row."},"8882":{"id":"/docs/thrift-filter-language-79","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**TimeStampsFilter**\\\nThis filter takes a list of timestamps.\nIt returns those key-values whose timestamps matches any of the specified timestamps."},"8883":{"id":"/docs/thrift-filter-language-80","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**RowFilter**\\\nThis filter takes a compare operator and a comparator.\nIt compares each row key with the comparator using the compare operator and if the comparison returns true, it returns all the key-values in that row."},"8884":{"id":"/docs/thrift-filter-language-81","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**Family Filter**\\\nThis filter takes a compare operator and a comparator.\nIt compares each column family name with the comparator using the compare operator and if the comparison returns true, it returns all the Cells in that column family."},"8885":{"id":"/docs/thrift-filter-language-82","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**QualifierFilter**\\\nThis filter takes a compare operator and a comparator.\nIt compares each qualifier name with the comparator using the compare operator and if the comparison returns true, it returns all the key-values in that column."},"8886":{"id":"/docs/thrift-filter-language-83","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**ValueFilter**\\\nThis filter takes a compare operator and a comparator.\nIt compares each value with the comparator using the compare operator and if the comparison returns true, it returns that key-value."},"8887":{"id":"/docs/thrift-filter-language-84","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**DependentColumnFilter**\\\nThis filter takes two arguments – a family and a qualifier.\nIt tries to locate this column in each row and returns all key-values in that row that have the same timestamp.\nIf the row doesn't contain the specified column – none of the key-values in that row will be returned."},"8888":{"id":"/docs/thrift-filter-language-85","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**SingleColumnValueFilter**\\\nThis filter takes a column family, a qualifier, a compare operator and a comparator.\nIf the specified column is not found – all the columns of that row will be emitted.\nIf the column is found and the comparison with the comparator returns true, all the columns of the row will be emitted.\nIf the condition fails, the row will not be emitted."},"8889":{"id":"/docs/thrift-filter-language-86","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**SingleColumnValueExcludeFilter**\\\nThis filter takes the same arguments and behaves same as SingleColumnValueFilter – however, if the column is found and the condition passes, all the columns of the row will be emitted except for the tested column value."},"8890":{"id":"/docs/thrift-filter-language-87","page_id":"/docs/thrift-filter-language","tags":["multi-page"],"type":"text","url":"/docs/thrift-filter-language#individual-filter-syntax","content":"**ColumnRangeFilter**\\\nThis filter is used for selecting only those keys with columns that are between minColumn and maxColumn.\nIt also takes two boolean variables to indicate whether to include the minColumn and maxColumn or not."},"8891":{"id":"/docs/tracing","page_id":"/docs/tracing","type":"page","content":"Tracing","breadcrumbs":["Docs","Multi-Page Documentation","Infrastructure & Tools"],"tags":["multi-page"],"url":"/docs/tracing"},"8892":{"id":"/docs/tracing-0","page_id":"/docs/tracing","tags":["multi-page"],"type":"text","url":"/docs/tracing","content":"HBase used to depend on the HTrace project for tracing. After the Apache HTrace project moved to the Attic/retired, we decided to move to OpenTelemetry in HBASE-22120."},"8893":{"id":"/docs/tracing-1","page_id":"/docs/tracing","type":"heading","tags":["multi-page"],"url":"/docs/tracing#tracing-overview","content":"Overview"},"8894":{"id":"/docs/tracing-2","page_id":"/docs/tracing","type":"heading","tags":["multi-page"],"url":"/docs/tracing#tracing-usage","content":"Usage"},"8895":{"id":"/docs/tracing-3","page_id":"/docs/tracing","type":"heading","tags":["multi-page"],"url":"/docs/tracing#enable-tracing","content":"Enable Tracing"},"8896":{"id":"/docs/tracing-4","page_id":"/docs/tracing","type":"heading","tags":["multi-page"],"url":"/docs/tracing#performance-impact","content":"Performance Impact"},"8897":{"id":"/docs/tracing-5","page_id":"/docs/tracing","tags":["multi-page"],"type":"text","url":"/docs/tracing#tracing-overview","content":"The basic support for tracing has been done, where we added tracing for async client, rpc, region read/write/scan operation, and WAL. We use opentelemetry-api to implement the tracing support manually by code, as our code base is way too complicated to be instrumented through a java agent. But notice that you still need to attach the opentelemetry java agent to enable tracing. Please see the official site for OpenTelemetry and the documentation for opentelemetry-java-instrumentation for more details on how to properly configure opentelemetry instrumentation."},"8898":{"id":"/docs/tracing-6","page_id":"/docs/tracing","tags":["multi-page"],"type":"text","url":"/docs/tracing#enable-tracing","content":"See this section in hbase-env.sh"},"8899":{"id":"/docs/tracing-7","page_id":"/docs/tracing","tags":["multi-page"],"type":"text","url":"/docs/tracing#enable-tracing","content":"Uncomment this line to enable tracing. The default config is to output the tracing data to log. Please see the documentation for opentelemetry-java-instrumentation for more details on how to export tracing data to other tracing system such as OTel collector, jaeger or zipkin, what does the *service.name* mean, and how to change the sampling rate, etc."},"8900":{"id":"/docs/tracing-8","page_id":"/docs/tracing","tags":["multi-page"],"type":"text","url":"/docs/tracing#enable-tracing","content":"The\nLoggingSpanExporter\nuses java.util.logging(jul) for logging tracing data, and the logger is initialized in\nopentelemetry java agent, which seems to be ahead of our jul to slf4j bridge initialization, so it\nwill always log the tracing data to console. We highly suggest that you use other tracing systems\nto collect and view tracing data instead of logging."},"8901":{"id":"/docs/tracing-9","page_id":"/docs/tracing","tags":["multi-page"],"type":"text","url":"/docs/tracing#performance-impact","content":"According to the result in HBASE-25658, the performance impact is minimal. Of course the test cluster is not under heavy load, so if you find out that enabling tracing would impact the performance, try to lower the sampling rate. See documentation for configuring sampler for more details."},"8902":{"id":"/docs/troubleshooting","page_id":"/docs/troubleshooting","type":"page","content":"Troubleshooting and Debugging Apache HBase","breadcrumbs":["Docs","Multi-Page Documentation","Performance & Troubleshooting"],"tags":["multi-page"],"url":"/docs/troubleshooting"},"8903":{"id":"/docs/troubleshooting-0","page_id":"/docs/troubleshooting","tags":["multi-page"],"type":"text","url":"/docs/troubleshooting","content":"Comprehensive guide to troubleshooting and debugging HBase issues including logs, tools, common problems, and solutions."},"8904":{"id":"/docs/troubleshooting-1","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#general-guidelines","content":"General Guidelines"},"8905":{"id":"/docs/troubleshooting-2","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#logs","content":"Logs"},"8906":{"id":"/docs/troubleshooting-3","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#log-locations","content":"Log Locations"},"8907":{"id":"/docs/troubleshooting-4","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#troubleshooting-logs-namenode","content":"NameNode"},"8908":{"id":"/docs/troubleshooting-5","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#troubleshooting-log-locations-datanode","content":"DataNode"},"8909":{"id":"/docs/troubleshooting-6","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#log-levels","content":"Log Levels"},"8910":{"id":"/docs/troubleshooting-7","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#enabling-rpc-level-logging","content":"Enabling RPC-level logging"},"8911":{"id":"/docs/troubleshooting-8","page_id":"/docs/troubleshooting","type":"heading","tags":["multi-page"],"url":"/docs/troubleshooting#handling-multiple-slf4j-bindings-to-prevent-overridden-log-configurations","content":"Handling Multiple SLF4J Bindi