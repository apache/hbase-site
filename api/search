ti-page"],"url":"/docs/building-and-developing/releasing#build-the-source-tarball","content":"Build the source tarball."},"2073":{"id":"/docs/building-and-developing/releasing-10","page_id":"/docs/building-and-developing/releasing","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/releasing#build-the-binary-tarball","content":"Build the binary tarball."},"2074":{"id":"/docs/building-and-developing/releasing-11","page_id":"/docs/building-and-developing/releasing","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/releasing#deploy-to-the-maven-repository","content":"Deploy to the Maven Repository."},"2075":{"id":"/docs/building-and-developing/releasing-12","page_id":"/docs/building-and-developing/releasing","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"Make the Release Candidate available."},"2076":{"id":"/docs/building-and-developing/releasing-13","page_id":"/docs/building-and-developing/releasing","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/releasing#publishing-a-snapshot-to-maven","content":"Publishing a SNAPSHOT to maven"},"2077":{"id":"/docs/building-and-developing/releasing-14","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing","content":"See old refguides for how to build HBase 1.x. The below is for building hbase2."},"2078":{"id":"/docs/building-and-developing/releasing-15","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Only committers can make releases of hbase artifacts."},"2079":{"id":"/docs/building-and-developing/releasing-16","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"**Before You Begin**"},"2080":{"id":"/docs/building-and-developing/releasing-17","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Check to be sure recent builds have been passing for the branch from where you\nare going to take your release. You should also have tried recent branch tips\nout on a cluster under load, perhaps by running the `hbase-it` integration test\nsuite for a few hours to 'burn in' the near-candidate bits."},"2081":{"id":"/docs/building-and-developing/releasing-18","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"You will need a published signing key added to the hbase\nKEYS file.\n(For how to add a KEY, see &#x2A;Step 1.* in How To Release,\nthe Hadoop version of this document)."},"2082":{"id":"/docs/building-and-developing/releasing-19","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Next make sure JIRA is properly primed, that all issues targeted against\nthe prospective release have been resolved and are present in git on the\nparticular branch. If any outstanding issues, move them out of the release by\nadjusting the fix version to remove this pending release as a target.\nAny JIRA with a fix version that matches the release candidate\ntarget release will be included in the generated *CHANGES.md/RELEASENOTES.md*\nfiles that ship with the release so make sure JIRA is correct before you begin."},"2083":{"id":"/docs/building-and-developing/releasing-20","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"After doing the above, you can move to the manufacture of an RC."},"2084":{"id":"/docs/building-and-developing/releasing-21","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Building an RC is involved so we've scripted it. The script builds in a Docker\ncontainer to ensure we have a consistent environment building. It will ask you\nfor passwords for apache and for your gpg signing key so it can sign and commit\non your behalf. The passwords are passed to gpg-agent in the container and\npurged along with the container when the build is done."},"2085":{"id":"/docs/building-and-developing/releasing-22","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"The script will:"},"2086":{"id":"/docs/building-and-developing/releasing-23","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Set version to the release version"},"2087":{"id":"/docs/building-and-developing/releasing-24","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Updates RELEASENOTES.md and CHANGES.md"},"2088":{"id":"/docs/building-and-developing/releasing-25","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Tag the RC"},"2089":{"id":"/docs/building-and-developing/releasing-26","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Set version to next SNAPSHOT version."},"2090":{"id":"/docs/building-and-developing/releasing-27","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Builds, signs, and hashes all artifacts."},"2091":{"id":"/docs/building-and-developing/releasing-28","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Generates the api compatibility report"},"2092":{"id":"/docs/building-and-developing/releasing-29","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Pushes release tgzs to the dev dir in a apache dist."},"2093":{"id":"/docs/building-and-developing/releasing-30","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Pushes to repository.apache.org staging."},"2094":{"id":"/docs/building-and-developing/releasing-31","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Creates vote email template."},"2095":{"id":"/docs/building-and-developing/releasing-32","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"The *dev-support/create-release/do-release-docker.sh* Release Candidate (RC)\nGenerating script is maintained in the master branch but can generate RCs\nfor any 2.x+ branch (The script does not work against branch-1). Check out\nand update the master branch when making RCs. See\n*dev-support/create-release/README.txt* for how to configure your\nenvironment and run the script."},"2096":{"id":"/docs/building-and-developing/releasing-33","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"*dev-support/create-release/do-release-docker.sh* supercedes the previous *dev-support/make\\_rc.sh*\nscript. It is more comprehensive automating all steps, rather than a portion, building a RC."},"2097":{"id":"/docs/building-and-developing/releasing-34","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#release-candidate-procedure","content":"Here we outline the steps involved generating a Release Candidate, the steps\nautomated by the *dev-support/create-release/do-release-docker.sh* script\ndescribed in the previous section. Running these steps manually tends to\nbe error-prone so is not recommended. The below is informational only."},"2098":{"id":"/docs/building-and-developing/releasing-35","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#release-candidate-procedure","content":"The process below makes use of various tools, mainly *git* and *maven*."},"2099":{"id":"/docs/building-and-developing/releasing-36","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#release-candidate-procedure","content":"You may run into OutOfMemoryErrors building, particularly building the site and\ndocumentation. Up the heap for Maven by setting the `MAVEN_OPTS` variable.\nYou can prefix the variable to the Maven command, as in the following example:"},"2100":{"id":"/docs/building-and-developing/releasing-37","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#release-candidate-procedure","content":"You could also set this in an environment variable or alias in your shell."},"2101":{"id":"/docs/building-and-developing/releasing-38","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#example-m2settingsxml-file","content":"Publishing to maven requires you sign the artifacts you want to upload.\nFor the build to sign them for you, you a properly configured *settings.xml&#x2A;\nin your local repository under *.m2*, such as the following."},"2102":{"id":"/docs/building-and-developing/releasing-39","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#update-the-changesmd-and-releasenotesmd-files-and-the-pom-files","content":"Update *CHANGES.md* with the changes since the last release. Be careful with where you put\nheadings and license. Respect the instructions and warning you find in current\n*CHANGES.md* and *RELEASENOTES.md* since these two files are processed by tooling that is\nlooking for particular string sequences. See HBASE-21399\nfor description on how to make use of yetus generating additions to\n*CHANGES.md* and *RELEASENOTES.md* (RECOMMENDED!). Adding JIRA fixes, make sure the\nURL to the JIRA points to the proper location which lists fixes for this release."},"2103":{"id":"/docs/building-and-developing/releasing-40","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#update-the-changesmd-and-releasenotesmd-files-and-the-pom-files","content":"Next, adjust the version in all the POM files appropriately.\nIf you are making a release candidate, you must remove the `-SNAPSHOT` label from all versions\nin all pom.xml files.\nIf you are running this receipe to publish a snapshot, you must keep the `-SNAPSHOT` suffix on the hbase version.\nThe Versions Maven Plugin can be of use here.\nTo set a version in all the many poms of the hbase multi-module project, use a command like the following:"},"2104":{"id":"/docs/building-and-developing/releasing-41","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#update-the-changesmd-and-releasenotesmd-files-and-the-pom-files","content":"Make sure all versions in poms are changed! Checkin the *CHANGES.md*, *RELEASENOTES.md*, and\nany maven version changes."},"2105":{"id":"/docs/building-and-developing/releasing-42","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#update-the-documentation","content":"Update the documentation under &#x2A;hbase-website/app/page/\\_docs/docs/\\_mdx/(multi-page)*.\nThis usually involves copying the latest from master branch and making version-particular\nadjustments to suit this release candidate version. Commit your changes."},"2106":{"id":"/docs/building-and-developing/releasing-43","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#run-apache-rat","content":"Check licenses are good"},"2107":{"id":"/docs/building-and-developing/releasing-44","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#run-apache-rat","content":"If the above fails, check the rat log."},"2108":{"id":"/docs/building-and-developing/releasing-45","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#create-a-release-tag","content":"Presuming you have run basic tests, the rat check, passes and all is\nlooking good, now is the time to tag the release candidate (You\nalways remove the tag if you need to redo). To tag, do\nwhat follows substituting in the version appropriate to your build.\nAll tags should be signed tags; i.e. pass the *-s* option (See\nSigning Your Work\nfor how to set up your git environment for signing)."},"2109":{"id":"/docs/building-and-developing/releasing-46","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#create-a-release-tag","content":"Or, if you are making a release, tags should have a &#x2A;rel/* prefix to ensure\nthey are preserved in the Apache repo as in:"},"2110":{"id":"/docs/building-and-developing/releasing-47","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#create-a-release-tag","content":"Push the (specific) tag (only) so others have access."},"2111":{"id":"/docs/building-and-developing/releasing-48","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#create-a-release-tag","content":"For how to delete tags, see\nHow to Delete a Tag. Covers\ndeleting tags that have not yet been pushed to the remote Apache\nrepo as well as delete of tags pushed to Apache."},"2112":{"id":"/docs/building-and-developing/releasing-49","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#build-the-source-tarball","content":"Now, build the source tarball. Lets presume we are building the source\ntarball for the tag *2.0.0-alpha4-RC0&#x2A; into &#x2A;/tmp/hbase-2.0.0-alpha4-RC0/*\n(This step requires that the mvn and git clean steps described above have just been done)."},"2113":{"id":"/docs/building-and-developing/releasing-50","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#build-the-source-tarball","content":"Above we generate the hbase-2.0.0-alpha4-src.tar.gz tarball into the\n*/tmp/hbase-2.0.0-alpha4-RC0* build output directory (We don't want the *RC0* in the name or prefix.\nThese bits are currently a release candidate but if the VOTE passes, they will become the release so we do not taint\nthe artifact names with *RCX*)."},"2114":{"id":"/docs/building-and-developing/releasing-51","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#build-the-binary-tarball","content":"Next, build the binary tarball. Add the `-Prelease` profile when building.\nIt runs the license apache-rat check among other rules that help ensure\nall is wholesome. Do it in two steps."},"2115":{"id":"/docs/building-and-developing/releasing-52","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#build-the-binary-tarball","content":"First install into the local repository"},"2116":{"id":"/docs/building-and-developing/releasing-53","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#build-the-binary-tarball","content":"Next, generate documentation and assemble the tarball. Be warned,\nthis next step can take a good while, a couple of hours generating site\ndocumentation."},"2117":{"id":"/docs/building-and-developing/releasing-54","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#build-the-binary-tarball","content":"Otherwise, the build complains that hbase modules are not in the maven repository\nwhen you try to do it all in one step, especially on a fresh repository.\nIt seems that you need the install goal in both steps."},"2118":{"id":"/docs/building-and-developing/releasing-55","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#build-the-binary-tarball","content":"Extract the generated tarball — you'll find it under\n*hbase-assembly/target* and check it out.\nLook at the documentation, see if it runs, etc.\nIf good, copy the tarball beside the source tarball in the\nbuild output directory."},"2119":{"id":"/docs/building-and-developing/releasing-56","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#deploy-to-the-maven-repository","content":"Next, deploy HBase to the Apache Maven repository. Add the\napache-release`profile when running the`mvn deploy\\` command.\nThis profile comes from the Apache parent pom referenced by our pom files.\nIt does signing of your artifacts published to Maven, as long as the\n*settings.xml* is configured correctly, as described in Example \\~/.m2/settings.xml File.\nThis step depends on the local repository having been populate\nby the just-previous bin tarball build."},"2120":{"id":"/docs/building-and-developing/releasing-57","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#deploy-to-the-maven-repository","content":"This command copies all artifacts up to a temporary staging Apache mvn repository in an 'open' state.\nMore work needs to be done on these maven artifacts to make them generally available."},"2121":{"id":"/docs/building-and-developing/releasing-58","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#deploy-to-the-maven-repository","content":"We do not release HBase tarball to the Apache Maven repository. To avoid deploying the tarball, do not\ninclude the `assembly:single` goal in your `mvn deploy` command. Check the deployed artifacts as described in the next section."},"2122":{"id":"/docs/building-and-developing/releasing-59","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#deploy-to-the-maven-repository","content":"If you ran the old *dev-support/make\\_rc.sh* script, this is as far as it takes you. To finish the\nrelease, take up the script from here on out."},"2123":{"id":"/docs/building-and-developing/releasing-60","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"The artifacts are in the maven repository in the staging area in the 'open' state.\nWhile in this 'open' state you can check out what you've published to make sure all is good.\nTo do this, log in to Apache's Nexus at repository.apache.org using your Apache ID.\nFind your artifacts in the staging repository. Click on 'Staging Repositories' and look for a new one ending in \"hbase\" with a status of 'Open', select it.\nUse the tree view to expand the list of repository contents and inspect if the artifacts you expect are present. Check the POMs.\nAs long as the staging repo is open you can re-upload if something is missing or built incorrectly."},"2124":{"id":"/docs/building-and-developing/releasing-61","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"If something is seriously wrong and you would like to back out the upload, you can use the 'Drop' button to drop and delete the staging repository.\nSometimes the upload fails in the middle. This is another reason you might have to 'Drop' the upload from the staging repository."},"2125":{"id":"/docs/building-and-developing/releasing-62","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"If it checks out, close the repo using the 'Close' button. The repository must be closed before a public URL to it becomes available. It may take a few minutes for the repository to close. Once complete you'll see a public URL to the repository in the Nexus UI. You may also receive an email with the URL. Provide the URL to the temporary staging repository in the email that announces the release candidate.\n(Folks will need to add this repo URL to their local poms or to their local *settings.xml* file to pull the published release candidate artifacts.)"},"2126":{"id":"/docs/building-and-developing/releasing-63","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"When the release vote concludes successfully, return here and click the 'Release' button to release the artifacts to central. The release process will automatically drop and delete the staging repository."},"2127":{"id":"/docs/building-and-developing/releasing-64","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"See the hbase-downstreamer test for a simple\nexample of a project that is downstream of HBase an depends on it. Check it out and run its simple\ntest to make sure maven artifacts are properly deployed to the maven repository. Be sure to edit\nthe pom to point to the proper staging repository. Make sure you are pulling from the repository\nwhen tests run and that you are not getting from your local repository, by either passing the `-U`\nflag or deleting your local repo content and check maven is pulling from remote out of the staging\nrepository."},"2128":{"id":"/docs/building-and-developing/releasing-65","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"See Publishing Maven Artifacts for some pointers on this maven staging process."},"2129":{"id":"/docs/building-and-developing/releasing-66","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"If the HBase version ends in `-SNAPSHOT`, the artifacts go elsewhere.\nThey are put into the Apache snapshots repository directly and are immediately available.\nMaking a SNAPSHOT release, this is what you want to happen."},"2130":{"id":"/docs/building-and-developing/releasing-67","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"At this stage, you have two tarballs in your 'build output directory' and a set of artifacts\nin a staging area of the maven repository, in the 'closed' state.\nNext sign, fingerprint and then 'stage' your release candiate build output directory via svnpubsub by committing\nyour directory to The dev distribution directory\n(See comments on HBASE-10554 Please delete old releases from mirroring system\nbut in essence it is an svn checkout of dev/hbase — releases are at\nrelease/hbase). In the *version directory* run the following commands:"},"2131":{"id":"/docs/building-and-developing/releasing-68","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"Ensure it actually gets published by checking https\\://dist.apache.org/repos/dist/dev/hbase/."},"2132":{"id":"/docs/building-and-developing/releasing-69","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#make-the-release-candidate-available","content":"Announce the release candidate on the mailing list and call a vote."},"2133":{"id":"/docs/building-and-developing/releasing-70","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#publishing-a-snapshot-to-maven","content":"Make sure your *settings.xml* is set up properly (see Example \\~/.m2/settings.xml File).\nMake sure the hbase version includes `-SNAPSHOT` as a suffix.\nFollowing is an example of publishing SNAPSHOTS of a release that had an hbase version of 0.96.0 in its poms."},"2134":{"id":"/docs/building-and-developing/releasing-71","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing#publishing-a-snapshot-to-maven","content":"The *make\\_rc.sh* script mentioned above (see Making a Release Candidate) can help you publish `SNAPSHOTS`.\nMake sure your `hbase.version` has a `-SNAPSHOT` suffix before running the script.\nIt will put a snapshot up into the apache snapshot repository for you."},"2135":{"id":"/docs/building-and-developing/repositories","page_id":"/docs/building-and-developing/repositories","type":"page","content":"Apache HBase Repositories","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/repositories"},"2136":{"id":"/docs/building-and-developing/repositories-0","page_id":"/docs/building-and-developing/repositories","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/repositories","content":"List of Apache HBase Git repositories including main HBase, connectors, operator tools, website, and third-party libraries."},"2137":{"id":"/docs/building-and-developing/repositories-1","page_id":"/docs/building-and-developing/repositories","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/repositories","content":"Apache HBase consists of multiple repositories which are hosted on Apache GitBox.\nThese are the following:"},"2138":{"id":"/docs/building-and-developing/repositories-2","page_id":"/docs/building-and-developing/repositories","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/repositories","content":"hbase - main Apache HBase repository"},"2139":{"id":"/docs/building-and-developing/repositories-3","page_id":"/docs/building-and-developing/repositories","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/repositories","content":"hbase-connectors - connectors to Apache Kafka and Apache Spark"},"2140":{"id":"/docs/building-and-developing/repositories-4","page_id":"/docs/building-and-developing/repositories","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/repositories","content":"hbase-operator-tools - operability and supportability tools, such as HBase HBCK2"},"2141":{"id":"/docs/building-and-developing/repositories-5","page_id":"/docs/building-and-developing/repositories","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/repositories","content":"hbase-site - hbase.apache.org website"},"2142":{"id":"/docs/building-and-developing/repositories-6","page_id":"/docs/building-and-developing/repositories","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/repositories","content":"hbase-thirdparty - relocated versions of popular third-party libraries"},"2143":{"id":"/docs/building-and-developing/tests","page_id":"/docs/building-and-developing/tests","type":"page","content":"Tests","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/tests"},"2144":{"id":"/docs/building-and-developing/tests-0","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests","content":"Writing and running HBase unit tests, integration tests, and ChaosMonkey destructive tests for comprehensive test coverage."},"2145":{"id":"/docs/building-and-developing/tests-1","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#apache-hbase-modules","content":"Apache HBase Modules"}