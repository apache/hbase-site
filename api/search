ge-2172","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"✅"},"11973":{"id":"/docs/single-page-2173","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"⚠️"},"11974":{"id":"/docs/single-page-2174","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"❌"},"11975":{"id":"/docs/single-page-2175","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"❌"},"11976":{"id":"/docs/single-page-2176","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"❌"},"11977":{"id":"/docs/single-page-2177","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"HBase 0.94"},"11978":{"id":"/docs/single-page-2178","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"✅"},"11979":{"id":"/docs/single-page-2179","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"✅"},"11980":{"id":"/docs/single-page-2180","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"❌"},"11981":{"id":"/docs/single-page-2181","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"❌"},"11982":{"id":"/docs/single-page-2182","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"❌"},"11983":{"id":"/docs/single-page-2183","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"❌"},"11984":{"id":"/docs/single-page-2184","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"Preliminary support for JDK 11 was introduced with HBase 2.3.0, and for JDK 17 with HBase 2.5.x. JDK 11 and JDK 17 have precommit and nightly coverage on applicable branches. We mark support as ✅ after running some integration tests with that JDK version and confirming that community members use it in production clusters."},"11985":{"id":"/docs/single-page-2185","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"For JDK 11/JDK 17 support in HBase, please refer to HBASE-22972 and HBASE-26038"},"11986":{"id":"/docs/single-page-2186","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"For JDK 11/JDK 17 support in Hadoop, which may also affect HBase, please refer to HADOOP-15338 and HADOOP-17177"},"11987":{"id":"/docs/single-page-2187","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"See HBASE-29546 for JDK 21 compatibility work and HBASE-30354 for nightly coverage. HBase's precommit checks do not yet test JDK 21."},"11988":{"id":"/docs/single-page-2188","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"JDK 21 validation for HBase 2.5 remains incomplete."},"11989":{"id":"/docs/single-page-2189","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"JDK 25 is not currently supported. See\nHBASE-29728 for progress on JDK 25 support."},"11990":{"id":"/docs/single-page-2190","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-support-by-release-line","content":"You must set `JAVA_HOME` on each node of your cluster. *hbase-env.sh* provides a handy mechanism\nto do this."},"11991":{"id":"/docs/single-page-2191","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ssh","content":"HBase uses the Secure Shell (ssh) command and utilities extensively to communicate between cluster nodes. Each server in the cluster must be running `ssh` so that the Hadoop and HBase daemons can be managed. You must be able to connect to all nodes via SSH, including the local node, from the Master as well as any backup Master, using a shared key rather than a password. You can see the basic methodology for such a set-up in Linux or Unix systems at \"Procedure: Configure Passwordless SSH Access\" chapter. If your cluster nodes use OS X, see the section, SSH: Setting up Remote Desktop and Enabling Self-Login on the Hadoop wiki."},"11992":{"id":"/docs/single-page-2192","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dns","content":"HBase uses the local hostname to self-report its IP address."},"11993":{"id":"/docs/single-page-2193","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ntp","content":"The clocks on cluster nodes should be synchronized. A small amount of variation is acceptable, but larger amounts of skew can cause erratic and unexpected behavior. Time synchronization is one of the first things to check if you see unexplained problems in your cluster. It is recommended that you run a Network Time Protocol (NTP) service, or another time-synchronization mechanism on your cluster and that all nodes look to the same service for time synchronization. See the Basic NTP Configuration at &#x2A;The Linux Documentation Project (TLDP)* to set up NTP."},"11994":{"id":"/docs/single-page-2194","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#limits-on-number-of-files-and-processes-ulimit","content":"Apache HBase is a database. It requires the ability to open a large number of files at once. Many Linux distributions limit the number of files a single user is allowed to open to `1024` (or `256` on older versions of OS X). You can check this limit on your servers by running the command `ulimit -n` when logged in as the user which runs HBase. See the Troubleshooting section for some of the problems you may experience if the limit is too low. You may also notice errors such as the following:"},"11995":{"id":"/docs/single-page-2195","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#limits-on-number-of-files-and-processes-ulimit","content":"It is recommended to raise the ulimit to at least 10,000, but more likely 10,240, because the value is usually expressed in multiples of 1024. Each ColumnFamily has at least one StoreFile, and possibly more than six StoreFiles if the region is under load. The number of open files required depends upon the number of ColumnFamilies and the number of regions. The following is a rough formula for calculating the potential number of open files on a RegionServer."},"11996":{"id":"/docs/single-page-2196","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#limits-on-number-of-files-and-processes-ulimit","content":"**Calculate the Potential Number of Open Files:**"},"11997":{"id":"/docs/single-page-2197","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#limits-on-number-of-files-and-processes-ulimit","content":"For example, assuming that a schema had 3 ColumnFamilies per region with an average of 3 StoreFiles per ColumnFamily, and there are 100 regions per RegionServer, the JVM will open `3 * 3 * 100 = 900` file descriptors, not counting open JAR files, configuration files, and others. Opening a file does not take many resources, and the risk of allowing a user to open too many files is minimal."},"11998":{"id":"/docs/single-page-2198","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#limits-on-number-of-files-and-processes-ulimit","content":"Another related setting is the number of processes a user is allowed to run at once. In Linux and Unix, the number of processes is set using the `ulimit -u` command. This should not be confused with the `nproc` command, which controls the number of CPUs available to a given user. Under load, a `ulimit -u` that is too low can cause OutOfMemoryError exceptions."},"11999":{"id":"/docs/single-page-2199","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#limits-on-number-of-files-and-processes-ulimit","content":"Configuring the maximum number of file descriptors and processes for the user who is running the HBase process is an operating system configuration, rather than an HBase configuration. It is also important to be sure that the settings are changed for the user that actually runs HBase. To see which user started HBase, and that user's ulimit configuration, look at the first line of the HBase log for that instance."},"12000":{"id":"/docs/single-page-2200","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-ulimit-settings-on-ubuntu-toc","content":"To configure ulimit settings on Ubuntu, edit */etc/security/limits.conf*, which is a space-delimited file with four columns. Refer to the man page for *limits.conf* for details about the format of this file. In the following example, the first line sets both soft and hard limits for the number of open files (nofile) to 32768 for the operating system user with the username hadoop. The second line sets the number of processes to 32000 for the same user."},"12001":{"id":"/docs/single-page-2201","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-ulimit-settings-on-ubuntu-toc","content":"The settings are only applied if the Pluggable Authentication Module (PAM) environment is directed to use them. To configure PAM to use these limits, be sure that the */etc/pam.d/common-session* file contains the following line:"},"12002":{"id":"/docs/single-page-2202","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#linux-shell","content":"All of the shell scripts that come with HBase rely on the GNU Bash shell."},"12003":{"id":"/docs/single-page-2203","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#windows","content":"Running production systems on Windows machines is not recommended."},"12004":{"id":"/docs/single-page-2204","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"The following table summarizes the versions of Hadoop supported with each version of HBase. Older versions not appearing in this table are considered unsupported and likely missing necessary features, while newer versions are untested but may be suitable."},"12005":{"id":"/docs/single-page-2205","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"Based on the version of HBase, you should select the most appropriate version of Hadoop. You can use Apache Hadoop, or a vendor's distribution of Hadoop. No distinction is made here. See the Hadoop wiki for information about vendors of Hadoop."},"12006":{"id":"/docs/single-page-2206","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"Comparing to Hadoop 1.x, Hadoop 2.x is faster and includes features, such as short-circuit reads (see Leveraging local data), which will help improve your HBase random read profile. Hadoop 2.x also includes important bug fixes that will improve your overall HBase experience. HBase does not support running with earlier versions of Hadoop. See the table below for requirements specific to different HBase versions."},"12007":{"id":"/docs/single-page-2207","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"Today, Hadoop 3.x is recommended as the last Hadoop 2.x release 2.10.2 was released years ago, and there is no release for Hadoop 2.x for a very long time, although the Hadoop community does not officially EOL Hadoop 2.x yet."},"12008":{"id":"/docs/single-page-2208","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"Use the following legend to interpret these tables:"},"12009":{"id":"/docs/single-page-2209","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"✅ = Tested to be fully-functional"},"12010":{"id":"/docs/single-page-2210","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"❌ = Known to not be fully-functional, or there are CVEs so we drop the support in newer minor releases"},"12011":{"id":"/docs/single-page-2211","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"⚠️ = Not tested, may/may-not function"},"12012":{"id":"/docs/single-page-2212","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"HBase-2.5.x"},"12013":{"id":"/docs/single-page-2213","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"HBase-2.6.x"},"12014":{"id":"/docs/single-page-2214","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"Hadoop-2.10.\\[0-1]"},"12015":{"id":"/docs/single-page-2215","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop","content":"❌"},"12016":{"id":"/