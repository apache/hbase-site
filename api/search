matrix-toc","content":"Y"},"9692":{"id":"/docs/upgrading/version-number-93","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"→ Unstable"},"9693":{"id":"/docs/upgrading/version-number-94","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"N"},"9694":{"id":"/docs/upgrading/version-number-95","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"N"},"9695":{"id":"/docs/upgrading/version-number-96","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"N"},"9696":{"id":"/docs/upgrading/version-number-97","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"Dependency Compatibility"},"9697":{"id":"/docs/upgrading/version-number-98","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"N"},"9698":{"id":"/docs/upgrading/version-number-99","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"Y"},"9699":{"id":"/docs/upgrading/version-number-100","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"Y"},"9700":{"id":"/docs/upgrading/version-number-101","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"Operational Compatibility"},"9701":{"id":"/docs/upgrading/version-number-102","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"N"},"9702":{"id":"/docs/upgrading/version-number-103","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"N"},"9703":{"id":"/docs/upgrading/version-number-104","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"Y"},"9704":{"id":"/docs/upgrading/version-number-105","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#compatibility-matrix-toc","content":"HBase 1.7.0 release violated client-server wire compatibility guarantees and was subsequently\nwithdrawn after the incompatibilities were reported and fixed in 1.7.1. If you are considering an\nupgrade to 1.7.x line, see Upgrading to 1.7.1+."},"9705":{"id":"/docs/upgrading/version-number-106","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"HBase has a lot of API points, but for the compatibility matrix above, we differentiate between Client API, Limited Private API, and Private API. HBase uses Apache Yetus Audience Annotations to guide downstream expectations for stability."},"9706":{"id":"/docs/upgrading/version-number-107","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"InterfaceAudience (javadocs): captures the intended audience, possible values include:"},"9707":{"id":"/docs/upgrading/version-number-108","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"Public: safe for end users and external projects"},"9708":{"id":"/docs/upgrading/version-number-109","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"LimitedPrivate: used for internals we expect to be pluggable, such as coprocessors"},"9709":{"id":"/docs/upgrading/version-number-110","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"Private: strictly for use within HBase itself Classes which are defined as `IA.Private` may be used as parameters or return values for interfaces which are declared `IA.LimitedPrivate`. Treat the `IA.Private` object as opaque; do not try to access its methods or fields directly."},"9710":{"id":"/docs/upgrading/version-number-111","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"InterfaceStability (javadocs): describes what types of interface changes are permitted. Possible values include:"},"9711":{"id":"/docs/upgrading/version-number-112","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"Stable: the interface is fixed and is not expected to change"},"9712":{"id":"/docs/upgrading/version-number-113","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"Evolving: the interface may change in future minor versions"},"9713":{"id":"/docs/upgrading/version-number-114","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"Unstable: the interface may change at any time"},"9714":{"id":"/docs/upgrading/version-number-115","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"Please keep in mind the following interactions between the `InterfaceAudience` and `InterfaceStability` annotations within the HBase project:"},"9715":{"id":"/docs/upgrading/version-number-116","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"`IA.Public` classes are inherently stable and adhere to our stability guarantees relating to the type of upgrade (major, minor, or patch)."},"9716":{"id":"/docs/upgrading/version-number-117","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"`IA.LimitedPrivate` classes should always be annotated with one of the given `InterfaceStability` values. If they are not, you should presume they are `IS.Unstable`."},"9717":{"id":"/docs/upgrading/version-number-118","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-api-surface","content":"`IA.Private` classes should be considered implicitly unstable, with no guarantee of stability between releases."},"9718":{"id":"/docs/upgrading/version-number-119","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-client-api","content":"HBase Client API consists of all the classes or methods that are marked with InterfaceAudience.Public interface. All main classes in hbase-client and dependent modules have either InterfaceAudience.Public, InterfaceAudience.LimitedPrivate, or InterfaceAudience.Private marker. Not all classes in other modules (hbase-server, etc) have the marker. If a class is not annotated with one of these, it is assumed to be a InterfaceAudience.Private class."},"9719":{"id":"/docs/upgrading/version-number-120","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-limitedprivate-api","content":"LimitedPrivate annotation comes with a set of target consumers for the interfaces. Those consumers are coprocessors, phoenix, replication endpoint implementations or similar. At this point, HBase only guarantees source and binary compatibility for these interfaces between patch versions."},"9720":{"id":"/docs/upgrading/version-number-121","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#hbase-private-api","content":"All classes annotated with InterfaceAudience.Private or all classes that do not have the annotation are for HBase internal use only. The interfaces and method signatures can change at any point in time. If you are relying on a particular interface that is marked Private, you should open a jira to propose changing the interface to be Public or LimitedPrivate, or an interface exposed for this purpose."},"9721":{"id":"/docs/upgrading/version-number-122","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#binary-compatibility","content":"When we say two HBase versions are compatible, we mean that the versions are wire and binary compatible. Compatible HBase versions means that clients can talk to compatible but differently versioned servers. It means too that you can just swap out the jars of one version and replace them with the jars of another, compatible version and all will just work. Unless otherwise specified, HBase point versions are (mostly) binary compatible. You can safely do rolling upgrades between binary compatible versions; i.e. across maintenance releases: e.g. from 1.4.4 to 1.4.6. See \"Does compatibility between versions also mean binary compatibility?\" discussion on the HBase dev mailing list."},"9722":{"id":"/docs/upgrading/version-number-123","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#binary-compatibility","content":"See 'Source Compatibility' https\\://wiki.openjdk.org/spaces/csr/pages/32342052/Kinds+of+Compatibility"},"9723":{"id":"/docs/upgrading/version-number-124","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#binary-compatibility","content":"See http\\://docs.oracle.com/javase/specs/jls/se8/html/jls-13.html."},"9724":{"id":"/docs/upgrading/version-number-125","page_id":"/docs/upgrading/version-number","tags":["multi-page"],"type":"text","url":"/docs/upgrading/version-number#binary-compatibility","content":"Running an offline upgrade tool without downgrade might be needed. We will typically only support migrating data from major version X to major version X+1."},"9725":{"id":"/docs/ycsb","page_id":"/docs/ycsb","type":"page","content":"YCSB","breadcrumbs":["Docs","Multi-Page Documentation","Appendices"],"tags":["multi-page"],"url":"/docs/ycsb"},"9726":{"id":"/docs/ycsb-0","page_id":"/docs/ycsb","tags":["multi-page"],"type":"text","url":"/docs/ycsb","content":"Documentation for YCSB (The Yahoo! Cloud Serving Benchmark)"},"9727":{"id":"/docs/ycsb-1","page_id":"/docs/ycsb","tags":["multi-page"],"type":"text","url":"/docs/ycsb","content":"YCSB: The Yahoo! Cloud Serving Benchmark and HBase"},"9728":{"id":"/docs/ycsb-2","page_id":"/docs/ycsb","tags":["multi-page"],"type":"text","url":"/docs/ycsb","content":"TODO: Describe how YCSB is poor for putting up a decent cluster load."},"9729":{"id":"/docs/ycsb-3","page_id":"/docs/ycsb","tags":["multi-page"],"type":"text","url":"/docs/ycsb","content":"TODO: Describe setup of YCSB for HBase. In particular, presplit your tables before you start a run. See HBASE-4163 Create Split Strategy for YCSB Benchmark for why and a little shell command for how to do it."},"9730":{"id":"/docs/zookeeper","page_id":"/docs/zookeeper","type":"page","content":"ZooKeeper","breadcrumbs":["Docs","Multi-Page Documentation","Infrastructure & Tools"],"tags":["multi-page"],"url":"/docs/zookeeper"},"9731":{"id":"/docs/zookeeper-0","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"A distributed Apache HBase installation depends on a running ZooKeeper cluster. All participating nodes and clients need to be able to access the running ZooKeeper ensemble."},"9732":{"id":"/docs/zookeeper-1","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#using-existing-zookeeper-ensemble","content":"Using existing ZooKeeper ensemble"},"9733":{"id":"/docs/zookeeper-2","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#sasl-authentication-with-zookeeper","content":"SASL Authentication with ZooKeeper"},"9734":{"id":"/docs/zookeeper-3","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#operating-system-prerequisites","content":"Operating System Prerequisites"},"9735":{"id":"/docs/zookeeper-4","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"HBase-managed ZooKeeper Configuration"},"9736":{"id":"/docs/zookeeper-5","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#external-zookeeper-configuration","content":"External ZooKeeper Configuration"},"9737":{"id":"/docs/zookeeper-6","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#zookeeper-server-authentication-log-output","content":"ZooKeeper Server Authentication Log Output"},"9738":{"id":"/docs/zookeeper-7","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#zookeeper-client-authentication-log-output","content":"ZooKeeper Client Authentication Log Output"},"9739":{"id":"/docs/zookeeper-8","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#configuration-from-scratch","content":"Configuration from Scratch"},"9740":{"id":"/docs/zookeeper-9","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#future-improvements","content":"Future improvements"},"9741":{"id":"/docs/zookeeper-10","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#fix-targetcached_classpathtxt","content":"Fix target/cached_classpath.txt"},"9742":{"id":"/docs/zookeeper-11","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#set-jaas-configuration-programmatically","content":"Set JAAS configuration programmatically"},"9743":{"id":"/docs/zookeeper-12","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#elimination-of-kerberosremovehostfromprincipal-andkerberosremoverealmfromprincipal","content":"Elimination of `kerberos.removeHostFromPrincipal` and`kerberos.removeRealmFromPrincipal`"},"9744":{"id":"/docs/zookeeper-13","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#tls-connection-to-zookeeper","content":"TLS connection to ZooKeeper"},"9745":{"id":"/docs/zookeeper-14","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#java-system-properties","content":"Java system properties"},"9746":{"id":"/docs/zookeeper-15","page_id":"/docs/zookeeper","type":"heading","tags":["multi-page"],"url":"/docs/zookeeper#hbase-configuration","content":"HBase configuration"},"9747":{"id":"/docs/zookeeper-16","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"Apache HBase by default manages a ZooKeeper \"cluster\" for you.\nIt will start and stop the ZooKeeper ensemble as part of the HBase start/stop process.\nYou can also manage the ZooKeeper ensemble independent of HBase and just point HBase at the cluster it should use.\nTo toggle HBase management of ZooKeeper, use the `HBASE_MANAGES_ZK` variable in *conf/hbase-env.sh*.\nThis variable, which defaults to `true`, tells HBase whether to start/stop the ZooKeeper ensemble servers as part of HBase start/stop."},"9748":{"id":"/docs/zookeeper-17","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"When HBase manages the ZooKeeper ensemble, you can specify ZooKeeper configuration directly in *conf/hbase-site.xml*.\nA ZooKeeper configuration option can be set as a property in the HBase *hbase-site.xml* XML configuration file by prefacing the ZooKeeper option name with `hbase.zookeeper.property`.\nFor example, the `clientPort` setting in ZooKeeper can be changed by setting the `hbase.zookeeper.property.clientPort` property.\nFor all default values used by HBase, including ZooKeeper configuration, see hbase default configurations.\nLook for the `hbase.zookeeper.property` prefix.\nFor the full list of ZooKeeper configurations, see ZooKeeper's *zoo.cfg*.\nHBase does not ship with a *zoo.cfg* so you will need to browse the *conf* directory in an appropriate ZooKeeper download."},"9749":{"id":"/docs/zookeeper-18","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"You must at least list the ensemble servers in *hbase-site.xml* using the `hbase.zookeeper.quorum` property.\nThis property defaults to a single ensemble member at `localhost` which is not suitable for a fully distributed HBase.\n(It binds to the local machine only and remote clients will not be able to connect)."},"9750":{"id":"/docs/zookeeper-19","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"You can run a ZooKeeper ensemble that comprises 1 node only but in production it is recommended that you run a ZooKeeper ensemble of 3, 5 or 7 machines; the more members an ensemble has, the more tolerant the ensemble is of host failures.\nAlso, run an odd number of machines.\nIn ZooKeeper, an even number of peers is supported, but it is normally not used because an even sized ensemble requires, proportionally, more peers to form a quorum than an odd sized ensemble requires.\nFor example, an ensemble with 4 peers requires 3 to form a quorum, while an ensemble with 5 also requires 3 to form a quorum.\nThus, an ensemble of 5 allows 2 peers to fail, and thus is more fault tolerant than the ensemble of 4, which allows only 1 down peer."},"9751":{"id":"/docs/zookeeper-20","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"Give each ZooKeeper server around 1GB of RAM, and if possible, its own dedicated disk (A dedicated disk is the best thing you can do to ensure a performant ZooKeeper ensemble). For very heavily loaded clusters, run ZooKeeper servers on separate machines from RegionServers (DataNodes and TaskTrackers)."},"9752":{"id":"/docs/zookeeper-21","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"For example, to have HBase manage a ZooKeeper quorum on nodes *rs\\{1,2,3,4,5}.example.com*, bound to port 2222 (the default is 2181) ensure `HBASE_MANAGE_ZK` is commented out or set to `true` in *conf/hbase-env.sh* and then edit *conf/hbase-site.xml* and set `hbase.zookeeper.property.clientPort` and `hbase.zookeeper.quorum`.\nYou should also set `hbase.zookeeper.property.dataDir&#x60; to other than the default as the default has ZooKeeper persist data under */tmp&#x2A; which is often cleared on system restart.\nIn the example below we have ZooKeeper persist to */user/local/zookeeper*."},"9753":{"id":"/docs/zookeeper-22","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"The newer version, the better. ZooKeeper 3.4.x is required as of HBase 1.0.0"},"9754":{"id":"/docs/zookeeper-23","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper","content":"Be sure to set up the data dir cleaner described under ZooKeeper\nMaintenance else you\ncould have 'interesting' problems a couple of months in; i.e. zookeeper could start dropping\nsessions if it has to run through a directory of hundreds of thousands of logs which is wont to do\naround leader reelection time — a process rare but run on occasion whether because a machine is\ndropped or happens to hiccup."},"9755":{"id":"/docs/zookeeper-24","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#using-existing-zookeeper-ensemble","content":"To point HBase at an existing ZooKeeper cluster, one that is not managed by HBase, set `HBASE_MANAGES_ZK` in *conf/hbase-env.sh* to false"},"9756":{"id":"/docs/zookeeper-25","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#using-existing-zookeeper-ensemble","content":"Next set ensemble locations and client port, if non-standard, in *hbase-site.xml*."},"9757":{"id":"/docs/zookeeper-26","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#using-existing-zookeeper-ensemble","content":"When HBase manages ZooKeeper, it will start/stop the ZooKeeper servers as a part of the regular start/stop scripts.\nIf you would like to run ZooKeeper yourself, independent of HBase start/stop, you would do the following"},"9758":{"id":"/docs/zookeeper-27","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#using-existing-zookeeper-ensemble","content":"Note that you can use HBase in this manner to spin up a ZooKeeper cluster, unrelated to HBase.\nJust make sure to set `HBASE_MANAGES_ZK` to `false` if you want it to stay up across HBase restarts so that when HBase shuts down, it doesn't take ZooKeeper down with it."},"9759":{"id":"/docs/zookeeper-28","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#using-existing-zookeeper-ensemble","content":"For more information about running a distinct ZooKeeper cluster, see the ZooKeeper Getting Started Guide.\nAdditionally, see the ZooKeeper Wiki or the ZooKeeper documentation for more information on ZooKeeper sizing."},"9760":{"id":"/docs/zookeeper-29","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#sasl-authentication-with-zookeeper","content":"Newer releases of Apache HBase (>= 0.92) will support connecting to a ZooKeeper Quorum that supports SASL authentication (which is available in ZooKeeper versions 3.4.0 or later)."},"9761":{"id":"/docs/zookeeper-30","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#sasl-authentication-with-zookeeper","content":"This describes how to set up HBase to mutually authenticate with a ZooKeeper Quorum.\nZooKeeper/HBase mutual authentication (HBASE-2418) is required as part of a complete secure HBase configuration (HBASE-3025). For simplicity of explication, this section ignores additional configuration required (Secure HDFS and Coprocessor configuration). It's recommended to begin with an HBase-managed ZooKeeper configuration (as opposed to a standalone ZooKeeper quorum) for ease of learning."},"9762":{"id":"/docs/zookeeper-31","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#operating-system-prerequisites","content":"You need to have a working Kerberos KDC setup.\nFor each `$HOST` that will run a ZooKeeper server, you should have a principle `zookeeper/$HOST`.\nFor each such host, add a service key (using the `kadmin` or `kadmin.local` tool's `ktadd` command) for `zookeeper/$HOST` and copy this file to `$HOST`, and make it readable only to the user that will run zookeeper on `$HOST&#x60;.\nNote the location of this file, which we will use below as *\\$PATH\\_TO\\_ZOOKEEPER\\_KEYTAB*."},"9763":{"id":"/docs/zookeeper-32","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#operating-system-prerequisites","content":"Similarly, for each `$HOST` that will run an HBase server (master or regionserver), you should have a principle: `hbase/$HOST`.\nFor each host, add a keytab file called *hbase.keytab* containing a service key for `hbase/$HOST`, copy this file to `$HOST`, and make it readable only to the user that will run an HBase service on `$HOST&#x60;.\nNote the location of this file, which we will use below as *\\$PATH\\_TO\\_HBASE\\_KEYTAB*."},"9764":{"id":"/docs/zookeeper-33","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#operating-system-prerequisites","content":"Each user who will be an HBase client should also be given a Kerberos principal.\nThis principal should usually have a password assigned to it (as opposed to, as with the HBase servers, a keytab file) which only this user knows.\nThe client's principal's `maxrenewlife` should be set so that it can be renewed enough so that the user can complete their HBase client processes.\nFor example, if a user runs a long-running HBase client process that takes at most 3 days, we might create this user's principal within `kadmin` with: `addprinc -maxrenewlife 3days`.\nThe ZooKeeper client and server libraries manage their own ticket refreshment by running threads that wake up periodically to do the refreshment."},"9765":{"id":"/docs/zookeeper-34","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#operating-system-prerequisites","content":"On each host that will run an HBase client (e.g. `hbase shell`), add the following file to the HBase home directory's *conf* directory:"},"9766":{"id":"/docs/zookeeper-35","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#operating-system-prerequisites","content":"We'll refer to this JAAS configuration file as *\\$CLIENT\\_CONF* below."},"9767":{"id":"/docs/zookeeper-36","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"On each node that will run a zookeeper, a master, or a regionserver, create a JAAS configuration file in the conf directory of the node's *HBASE\\_HOME* directory that looks like the following:"},"9768":{"id":"/docs/zookeeper-37","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"where the *\\$PATH\\_TO\\_HBASE\\_KEYTAB&#x2A; and *\\$PATH\\_TO\\_ZOOKEEPER\\_KEYTAB* files are what you created above, and `$HOST` is the hostname for that node."},"9769":{"id":"/docs/zookeeper-38","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"The `Server` section will be used by the ZooKeeper quorum server, while the `Client&#x60; section will be used by the HBase master and regionservers.\nThe path to this file should be substituted for the text *\\$HBASE\\_SERVER\\_CONF* in the *hbase-env.sh* listing below."},"9770":{"id":"/docs/zookeeper-39","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"The path to this file should be substituted for the text *\\$CLIENT\\_CONF* in the *hbase-env.sh* listing below."},"9771":{"id":"/docs/zookeeper-40","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"Modify your *hbase-env.sh* to include the following:"},"9772":{"id":"/docs/zookeeper-41","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"where *\\$HBASE\\_SERVER\\_CONF&#x2A; and *\\$CLIENT\\_CONF* are the full paths to the JAAS configuration files created above."},"9773":{"id":"/docs/zookeeper-42","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"Modify your *hbase-site.xml* on each node that will run zookeeper, master or regionserver to contain:"},"9774":{"id":"/docs/zookeeper-43","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"where `$ZK_NODES` is the comma-separated list of hostnames of the ZooKeeper Quorum hosts."},"9775":{"id":"/docs/zookeeper-44","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-managed-zookeeper-configuration","content":"Start your hbase cluster by running one or more of the following set of commands on the appropriate hosts:"},"9776":{"id":"/docs/zookeeper-45","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"Add a JAAS configuration file that looks like:"},"9777":{"id":"/docs/zookeeper-46","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"where the *\\$PATH\\_TO\\_HBASE\\_KEYTAB* is the keytab created above for HBase services to run on this host, and `$HOST&#x60; is the hostname for that node.\nPut this in the HBase home's configuration directory.\nWe'll refer to this file's full pathname as *\\$HBASE\\_SERVER\\_CONF* below."},"9778":{"id":"/docs/zookeeper-47","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"Modify your hbase-env.sh to include the following:"},"9779":{"id":"/docs/zookeeper-48","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"Modify your *hbase-site.xml* on each node that will run a master or regionserver to contain:"},"9780":{"id":"/docs/zookeeper-49","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"where `$ZK_NODES` is the comma-separated list of hostnames of the ZooKeeper Quorum hosts."},"9781":{"id":"/docs/zookeeper-50","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"Also on each of these hosts, create a JAAS configuration file containing:"},"9782":{"id":"/docs/zookeeper-51","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"where `$HOST&#x60; is the hostname of each Quorum host.\nWe will refer to the full pathname of this file as *\\$ZK\\_SERVER\\_CONF* below."},"9783":{"id":"/docs/zookeeper-52","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"Start your ZooKeepers on each ZooKeeper Quorum host with:"},"9784":{"id":"/docs/zookeeper-53","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#external-zookeeper-configuration","content":"Start your HBase cluster by running one or more of the following set of commands on the appropriate nodes:"},"9785":{"id":"/docs/zookeeper-54","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#zookeeper-server-authentication-log-output","content":"If the configuration above is successful, you should see something similar to the following in your ZooKeeper server logs:"},"9786":{"id":"/docs/zookeeper-55","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#zookeeper-client-authentication-log-output","content":"On the ZooKeeper client side (HBase master or regionserver), you should see something similar to the following:"},"9787":{"id":"/docs/zookeeper-56","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#configuration-from-scratch","content":"This has been tested on the current standard Amazon Linux AMI.\nFirst setup KDC and principals as described above.\nNext checkout code and run a sanity check."},"9788":{"id":"/docs/zookeeper-57","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#configuration-from-scratch","content":"Then configure HBase as described above.\nManually edit target/cached\\_classpath.txt (see below):"},"9789":{"id":"/docs/zookeeper-58","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#fix-targetcached_classpathtxt","content":"You must override the standard hadoop-core jar file from the `target/cached_classpath.txt` file with the version containing the HADOOP-7070 fix.\nYou can use the following script to do this:"},"9790":{"id":"/docs/zookeeper-59","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#set-jaas-configuration-programmatically","content":"This would avoid the need for a separate Hadoop jar that fixes HADOOP-7070."},"9791":{"id":"/docs/zookeeper-60","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#tls-connection-to-zookeeper","content":"Apache ZooKeeper also supports SSL/TLS client connections to encrypt the data in transmission. This is particularly\nuseful when the ZooKeeper ensemble is running on a host different from HBase and data has to be sent\nover the wire."},"9792":{"id":"/docs/zookeeper-61","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#java-system-properties","content":"The ZooKeeper client supports the following Java system properties to set up TLS connection:"},"9793":{"id":"/docs/zookeeper-62","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#java-system-properties","content":"Setting up KeyStore is optional and only required if ZooKeeper server requests for client certificate."},"9794":{"id":"/docs/zookeeper-63","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#java-system-properties","content":"Find more detailed information in the ZooKeeper SSL User Guide."},"9795":{"id":"/docs/zookeeper-64","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#java-system-properties","content":"These're standard Java properties which should be set in the HBase command line and are effective\nin the entire Java process. All ZooKeeper clients running in the same process will pick them up\nincluding co-processors."},"9796":{"id":"/docs/zookeeper-65","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#java-system-properties","content":"Since ZooKeeper version 3.8 the following two properties are useful to store the keystore and\ntruststore passwords in protected text files rather than exposing them in the command line."},"9797":{"id":"/docs/zookeeper-66","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-configuration","content":"By adding HBASE-28038, ZooKeeper client TLS\nsettings are also available in *hbase-site.xml* via `hbase.zookeeper.property` prefix. In contrast\nto Java system properties this could be more convenient under some circumstances."},"9798":{"id":"/docs/zookeeper-67","page_id":"/docs/zookeeper","tags":["multi-page"],"type":"text","url":"/docs/zookeeper#hbase-configuration","content":"These settings are eventually transformed into Java system properties, it's just a convenience\nfeature. So, the same rules that mentioned in the previous point, applies to them as well."},"9799":{"id":"/docs/single-page","page_id":"/docs/single-page","type":"page","content":"Apache HBase Documentation","breadcrumbs":["Docs","Single-Page Documentation"],"tags":["single-page"],"url":"/docs/single-page"},"9800":{"id":"/docs/single-page-0","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page","content":"Complete Apache HBase documentation in one continuous page."},"9801":{"id":"/docs/single-page-1","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/single-page#preface","content":"Preface"},"9802":{"id":"/docs/single-page-2","page_id":"/docs/single-page","type":"heading","tags":["single-page"],"url":"/docs/sing