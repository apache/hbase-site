-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#test-timeouts","content":"Test Timeouts"},"2163":{"id":"/docs/building-and-developing/tests-19","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#test-resource-checker","content":"Test Resource Checker"},"2164":{"id":"/docs/building-and-developing/tests-20","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#writing-tests","content":"Writing Tests"},"2165":{"id":"/docs/building-and-developing/tests-21","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#general-rules","content":"General rules"},"2166":{"id":"/docs/building-and-developing/tests-22","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#categories-and-execution-time","content":"Categories and execution time"},"2167":{"id":"/docs/building-and-developing/tests-23","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#sleeps-in-tests","content":"Sleeps in tests"},"2168":{"id":"/docs/building-and-developing/tests-24","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#tests-using-a-cluster","content":"Tests using a cluster"},"2169":{"id":"/docs/building-and-developing/tests-25","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#tests-skeleton-code","content":"Tests Skeleton Code"},"2170":{"id":"/docs/building-and-developing/tests-26","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"Integration Tests"},"2171":{"id":"/docs/building-and-developing/tests-27","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#running-integration-tests-against-mini-cluster","content":"Running integration tests against mini cluster"},"2172":{"id":"/docs/building-and-developing/tests-28","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#running-a-subset-of-integration-tests","content":"Running a subset of Integration tests"},"2173":{"id":"/docs/building-and-developing/tests-29","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#running-integration-tests-against-distributed-cluster","content":"Running integration tests against distributed cluster"},"2174":{"id":"/docs/building-and-developing/tests-30","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#destructive-integration--system-tests-chaosmonkey","content":"Destructive integration / system tests (ChaosMonkey)"},"2175":{"id":"/docs/building-and-developing/tests-31","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#actions","content":"Actions:"},"2176":{"id":"/docs/building-and-developing/tests-32","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#policies","content":"Policies:"},"2177":{"id":"/docs/building-and-developing/tests-33","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#chaosmonkey-without-ssh","content":"ChaosMonkey without SSH"},"2178":{"id":"/docs/building-and-developing/tests-34","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#available-policies","content":"Available Policies"},"2179":{"id":"/docs/building-and-developing/tests-35","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#configuring-individual-chaosmonkey-actions","content":"Configuring Individual ChaosMonkey Actions"},"2180":{"id":"/docs/building-and-developing/tests-36","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#example-chaosmonkey-properties-file","content":"Example ChaosMonkey Properties File"},"2181":{"id":"/docs/building-and-developing/tests-37","page_id":"/docs/building-and-developing/tests","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/tests#customizing-destructive-chaosmonkey-actions","content":"Customizing Destructive ChaosMonkey Actions"},"2182":{"id":"/docs/building-and-developing/tests-38","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests","content":"Developers, at a minimum, should familiarize themselves with the unit test detail; unit tests in HBase have a character not usually seen in other projects."},"2183":{"id":"/docs/building-and-developing/tests-39","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests","content":"This information is about unit tests for HBase itself.\nFor developing unit tests for your HBase applications, see Unit Testing HBase Applications."},"2184":{"id":"/docs/building-and-developing/tests-40","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#apache-hbase-modules","content":"As of 0.96, Apache HBase is split into multiple modules.\nThis creates \"interesting\" rules for how and where tests are written.\nIf you are writing code for `hbase-server`, see Unit Tests for how to write your tests.\nThese tests can spin up a minicluster and will need to be categorized.\nFor any other module, for example `hbase-common`, the tests must be strict unit tests and just test the class under test - no use of the HBaseTestingUtility or minicluster is allowed (or even possible given the dependency tree)."},"2185":{"id":"/docs/building-and-developing/tests-41","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#apache-hbase-modules","content":"Starting from 3.0.0, HBaseTestingUtility is renamed to HBaseTestingUtil and marked as IA.Private. Of course the API is still the same."},"2186":{"id":"/docs/building-and-developing/tests-42","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#testing-the-hbase-shell","content":"The HBase shell and its tests are predominantly written in jruby."},"2187":{"id":"/docs/building-and-developing/tests-43","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#testing-the-hbase-shell","content":"In order to make these tests run as a part of the standard build, there are a few JUnit test classes that take care of loading the jruby implemented tests and running them.\nThe tests were split into separate classes to accomodate class level timeouts (see Unit Tests for specifics).\nYou can run all of these tests from the top level with:"},"2188":{"id":"/docs/building-and-developing/tests-44","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#testing-the-hbase-shell","content":"If you have previously done a `mvn install`, then you can instruct maven to run only the tests in the hbase-shell module with:"},"2189":{"id":"/docs/building-and-developing/tests-45","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#testing-the-hbase-shell","content":"Alternatively, you may limit the shell tests that run using the system variable `shell.test`.\nThis value should specify the ruby literal equivalent of a particular test case by name.\nFor example, the tests that cover the shell commands for altering tables are contained in the test case `AdminAlterTableTest` and you can run them with:"},"2190":{"id":"/docs/building-and-developing/tests-46","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#testing-the-hbase-shell","content":"You may also use a Ruby Regular Expression\nliteral (in the `/pattern/` style) to select a set of test cases.\nYou can run all of the HBase admin related tests, including both the normal administration and the security administration, with the command:"},"2191":{"id":"/docs/building-and-developing/tests-47","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#testing-the-hbase-shell","content":"In the event of a test failure, you can see details by examining the XML version of the surefire report results"},"2192":{"id":"/docs/building-and-developing/tests-48","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-in-other-modules","content":"If the module you are developing in has no other dependencies on other HBase modules, then you can cd into that module and just run:"},"2193":{"id":"/docs/building-and-developing/tests-49","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-in-other-modules","content":"which will just run the tests IN THAT MODULE.\nIf there are other dependencies on other modules, then you will have run the command from the ROOT HBASE DIRECTORY.\nThis will run the tests in the other modules, unless you specify to skip the tests in that module.\nFor instance, to skip the tests in the hbase-server module, you would run:"},"2194":{"id":"/docs/building-and-developing/tests-50","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-in-other-modules","content":"from the top level directory to run all the tests in modules other than hbase-server.\nNote that you can specify to skip tests in multiple modules as well as just for a single module.\nFor example, to skip the tests in `hbase-server` and `hbase-common`, you would run:"},"2195":{"id":"/docs/building-and-developing/tests-51","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-in-other-modules","content":"Also, keep in mind that if you are running tests in the `hbase-server` module you will need to apply the maven profiles discussed in Running tests to get the tests to run properly."},"2196":{"id":"/docs/building-and-developing/tests-52","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"Apache HBase runs its unit tests with JUnit 5. Every unit\ntest must carry a sizing tag, applied with the JUnit 5 `@Tag` annotation. Here is an\nexample of what a Test Class looks like:"},"2197":{"id":"/docs/building-and-developing/tests-53","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"Here the Test Class is `TestHRegionInfo`, tagged as a `SmallTests` (plus the functional\ntag `RegionServerTests`). Prior to the JUnit 5 migration, tests were categorized with\n`@Category(...)` and, as of `hbase-2.0.0`, had to declare an `HBaseClassTestRule`\n`@ClassRule` — both are gone now. The cross-cutting facilities the old `ClassRule`\nprovided are now applied automatically by the `HBaseJupiterExtension`:"},"2198":{"id":"/docs/building-and-developing/tests-54","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"it enforces a per-class timeout derived from the sizing tag (three minutes for `small`,\nsix for `medium`, and a hard limit of thirteen! minutes — 780 seconds — for `large`;\n`integration` tests have no timeout);"},"2199":{"id":"/docs/building-and-developing/tests-55","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"it dumps a thread stack to the log output when a test class times out;"},"2200":{"id":"/docs/building-and-developing/tests-56","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"it runs the resource-leak checker (see the Test Resource Checker section below);"},"2201":{"id":"/docs/building-and-developing/tests-57","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"and, for every test class selected for execution, it verifies that the class has exactly\none sizing tag."},"2202":{"id":"/docs/building-and-developing/tests-58","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"`HBaseJupiterExtension` is auto-registered for the Surefire unit-test runs in every module\nthrough the JUnit 5 `ServiceLoader` mechanism\n(`junit.jupiter.extensions.autodetection.enabled=true` in the Surefire configuration plus a\n`META-INF/services/org.junit.jupiter.api.extension.Extension` entry), so individual test\nclasses no longer need any `@ClassRule` boilerplate. Integration tests (run under Failsafe\nor the `IntegrationTestsDriver`) do not currently enable this auto-registration."},"2203":{"id":"/docs/building-and-developing/tests-59","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"Tags can be arbitrary and provided as a list, but each test MUST carry one from the\nfollowing list of sizings: `small`, `medium`, `large`, and `integration`. The test sizing\nis designated with a JUnit 5\ntag\nreferencing one of `SmallTests`, `MediumTests`, `LargeTests`, or `IntegrationTests` — use\nthe `TAG` constant on each of those interfaces in the\n`org.apache.hadoop.hbase.testclassification` package (a special extension checks for the\npresence of exactly one sizing `@Tag` in every test class selected for execution; it does\nnot inspect classes excluded by tag filters)."},"2204":{"id":"/docs/building-and-developing/tests-60","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"The first three categories, `small`, `medium`, and `large`, are for test cases which run when you\ntype `$ mvn test`.\nIn other words, these three categorizations are for HBase unit tests.\nThe `integration` category is not for unit tests, but for integration tests.\nThese are normally run when you invoke `$ mvn verify`.\nIntegration tests are described in Integration Tests."},"2205":{"id":"/docs/building-and-developing/tests-61","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests","content":"Keep reading to figure which annotation of the set `small`, `medium`, and `large`\nto put on your new HBase test case."},"2206":{"id":"/docs/building-and-developing/tests-62","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#small-tests","content":"*Small* test cases are executed in separate JVM and each test suite/test class should\nrun in 15 seconds or less; i.e. a junit test fixture, a java object made\nup of test methods, should finish in under 15 seconds, no matter how many or how few test methods\nit has. These test cases should not use a minicluster as a minicluster starts many services,\nmost unrelated to what is being tested."},"2207":{"id":"/docs/building-and-developing/tests-63","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#medium-tests","content":"*Medium* test cases are executed in separate JVM and individual test suites or test classes or in\njunit parlance, test fixture, should run in 50 seconds\nor less. These test cases can use a mini cluster. Since we start up a JVM per test fixture (and\noften a cluster too), be sure to make the startup pay by writing test fixtures that do a lot of\ntesting running tens of seconds perhaps combining test rather than spin up a jvm (and cluster)\nper test method; this practice will help w/ overall test times."},"2208":{"id":"/docs/building-and-developing/tests-64","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#large-tests","content":"*Large* test cases are everything else. They are typically large-scale tests, regression tests\nfor specific bugs, timeout tests, or performance tests. No large test suite can take longer than\nthirteen minutes. It will be killed as timed out. Cast your test as an Integration Test if it needs\nto run longer."},"2209":{"id":"/docs/building-and-developing/tests-65","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-unit-tests-categorizing-tests-integration-tests","content":"*Integration* tests are system level tests.\nSee Integration Tests for more info.\nIf you invoke `$ mvn test` on integration tests, there is no timeout for the test."},"2210":{"id":"/docs/building-and-developing/tests-66","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests","content":"The state of tests on the hbase branches varies. Some branches keep good test hygiene and all tests pass\nreliably with perhaps an unlucky sporadic flakey test failure. On other branches, the case may be less so with\nfrequent flakies and even broken tests in need of attention that fail 100% of the time. Try and figure\nthe state of tests on the branch you are currently interested in; the current state of nightly\napache jenkins builds is a good\nplace to start. Tests on master branch are generally not in the best of condition as releases\nare less frequent off master. This can make it hard landing patches especially given our dictum that\npatches land on master branch first."},"2211":{"id":"/docs/building-and-developing/tests-67","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests","content":"The full test suite can take from 5-6 hours on an anemic VM with 4 CPUs and minimal\nparallelism to 50 minutes or less on a linux machine with dozens of CPUs and plenty of\nRAM."},"2212":{"id":"/docs/building-and-developing/tests-68","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests","content":"When you go to run the full test suite, make sure you up the test runner user nproc\n(`ulimit -u` — make sure it > 6000 or more if more parallelism) and the number of\nopen files (`ulimit -n` — make sure it > 10240 or more) limits on your system.\nErrors because the test run hits\nlimits are often only opaquely related to the constraint. You can see the current\nuser settings by running `ulimit -a`."},"2213":{"id":"/docs/building-and-developing/tests-69","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#default-small-and-medium-category-tests","content":"Running `mvn test` will execute all small tests in a single JVM (no fork) and then medium tests in a\nforked, separate JVM for each test instance (For definition of 'small' test and so on, see\nUnit Tests). Medium tests are NOT executed if there is an error in a\nsmall test. Large tests are NOT executed."},"2214":{"id":"/docs/building-and-developing/tests-70","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-all-tests","content":"Running `mvn test -P runAllTests` will execute small tests in a single JVM, then medium and large tests\nin a forked, separate JVM for each test. Medium and large tests are NOT executed if there is an error in\na small test."},"2215":{"id":"/docs/building-and-developing/tests-71","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-a-single-test-or-all-tests-in-a-package","content":"To run an individual test, e.g. `MyTest`, rum `mvn test -Dtest=MyTest` You can also pass multiple,\nindividual tests as a comma-delimited list:"},"2216":{"id":"/docs/building-and-developing/tests-72","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-a-single-test-or-all-tests-in-a-package","content":"You can also pass a package, which will run all tests under the package:"},"2217":{"id":"/docs/building-and-developing/tests-73","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-a-single-test-or-all-tests-in-a-package","content":"When `-Dtest` is specified, the `localTests` profile will be used.\nEach junit test is executed in a separate JVM (A fork per test class).\nThere is no parallelization when tests are running in this mode.\nYou will see a new message at the end of the -report: `\"[INFO] Tests are skipped\"`.\nIt's harmless. However, you need to make sure the sum of\n`Tests run:` in the `Results:` section of test reports matching the number of tests\nyou specified because no error will be reported when a non-existent test case is specified."},"2218":{"id":"/docs/building-and-developing/tests-74","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#other-test-invocation-permutations","content":"Running `mvn test -P runSmallTests` will execute \"small\" tests only, using a single JVM."},"2219":{"id":"/docs/building-and-developing/tests-75","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#other-test-invocation-permutations","content":"Running `mvn test -P runMediumTests` will execute \"medium\" tests only, launching a new JVM for each test-class."},"2220":{"id":"/docs/building-and-developing/tests-76","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#other-test-invocation-permutations","content":"Running `mvn test -P runLargeTests` will execute \"large\" tests only, launching a new JVM for each test-class."},"2221":{"id":"/docs/building-and-developing/tests-77","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#other-test-invocation-permutations","content":"For convenience, you can run `mvn test -P runDevTests` to execute both small and medium tests, using a single JVM."},"2222":{"id":"/docs/building-and-developing/tests-78","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-faster","content":"By default, `$ mvn test -P runAllTests` runs all tests using a quarter of the CPUs available on machine\nhosting the test run (see `surefire.firstPartForkCount` and `surefire.secondPartForkCount` in the top-level\nhbase `pom.xml` which default to 0.25C, or 1/4 of CPU count). Up these counts to get the build to run faster.\nYou can also have hbase modules\nrun their tests in parrallel when the dependency graph allows by passing `--threads=N` when you invoke\nmaven, where `N` is the amount of parallelism wanted.\nmaven, where `N` is the amount of *module* parallelism wanted."},"2223":{"id":"/docs/building-and-developing/tests-79","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-faster","content":"For example, allowing that you want to use all cores on a machine to run tests,\nyou could start up the maven test run with:"},"2224":{"id":"/docs/building-and-developing/tests-80","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-faster","content":"If a 32 core machine, you should see periods during which 32 forked jvms appear in your process listing each running unit tests.\nYour milage may vary. Dependent on hardware, overcommittment of CPU and/or memory can bring the test suite crashing down,\nusually complaining with a spew of test system exits and incomplete test report xml files. Start gently, with the default fork\nand move up gradually."},"2225":{"id":"/docs/building-and-developing/tests-81","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-faster","content":"Adding the `--threads=N`, maven will run N maven modules in parallel (when module inter-dependencies allow). Be aware, if you have\nset the forkcount to `1.0C`, and the `--threads` count to '2', the number of concurrent test runners can approach\n2 \\* CPU, a count likely to overcommit the host machine (with attendant test exits failures)."},"2226":{"id":"/docs/building-and-developing/tests-82","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-tests-faster","content":"You will need \\~2.2GB of memory per forked JVM plus the memory used by maven itself (3-4G)."},"2227":{"id":"/docs/building-and-developing/tests-83","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#ram-disk","content":"To increase the speed, you can as well use a ramdisk. 2-3G should be sufficient. Be sure to\ndelete the files between each test run. The typical way to configure a ramdisk on Linux is:"},"2228":{"id":"/docs/building-and-developing/tests-84","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#ram-disk","content":"You can then use it to run all HBase tests on 2.0 with the command:"},"2229":{"id":"/docs/building-and-developing/tests-85","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#hbasetestssh","content":"It's also possible to use the script `hbasetests.sh`.\nThis script runs the medium and large tests in parallel with two maven instances, and provides a single report.\nThis script does not use the hbase version of surefire so no parallelization is being done other than the two maven instances the script sets up.\nIt must be executed from the directory which contains the *pom.xml*."},"2230":{"id":"/docs/building-and-developing/tests-86","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#hbasetestssh","content":"For example running `./dev-support/hbasetests.sh` will execute small and medium tests.\nRunning `./dev-support/hbasetests.sh runAllTests` will execute all tests.\nRunning `./dev-support/hbasetests.sh replayFailed` will rerun the failed tests a second time, in a separate jvm and without parallelisation."},"2231":{"id":"/docs/building-and-developing/tests-87","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#test-timeouts","content":"`HBaseJupiterExtension` enforces a per-class timeout based on the sizing tag: three minutes\nfor `small`, six minutes for `medium`, and thirteen minutes for `large` tests\n(`integration` tests have no timeout). When a test class exceeds its deadline it is failed\nand a thread dump is logged. Independently, Surefire kills any forked JVM that runs longer\nthan `surefire.timeout` (900 seconds by default)."},"2232":{"id":"/docs/building-and-developing/tests-88","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#test-timeouts","content":"As of hbase-2.0.0, we have purged the old JUnit 4 per-test-method timeouts, i.e."},"2233":{"id":"/docs/building-and-developing/tests-89","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#test-timeouts","content":"Blanket per-method timeouts are discouraged and don't make much sense given we are timing\nbased on how long the whole Test Fixture/Class/Suite takes and\nthat the variance in how long a test method takes varies wildly\ndependent upon context (loaded Apache Infrastructure versus\ndeveloper machine with nothing else running on it). JUnit 5's `@Timeout` may still be\napplied sparingly to an individual method that genuinely needs its own deadline."},"2234":{"id":"/docs/building-and-developing/tests-90","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#test-resource-checker","content":"The `ResourceChecker`, wired in through `HBaseJupiterExtension`'s `BeforeEachCallback`/`AfterEachCallback`, checks a number of resources before and after each HBase unit test runs and logs its findings in the test output files which can be found in *target/surefire-reports&#x2A; per Maven module (Tests write test reports named for the test class into this directory.\nCheck the *\\*-out.txt* files). The resources counted are the number of threads, the number of file descriptors, etc.\nIf the number has increased, it adds a &#x2A;LEAK?* comment in the logs.\nAs you can have an HBase instance running in the background, some threads can be deleted/created without any specific action in the test.\nHowever, if the test does not work as expected, or if the test should not impact these resources, it's worth checking these log lines `...hbase.ResourceChecker(157): before...` and `...hbase.ResourceChecker(157): after...`.\nFor example:"},"2235":{"id":"/docs/building-and-developing/tests-91","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#general-rules","content":"As much as possible, tests should be written as category small tests."},"2236":{"id":"/docs/building-and-developing/tests-92","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#general-rules","content":"All tests must be written to support parallel execution on the same machine, hence they should not use shared resources as fixed ports or fixed file names."},"2237":{"id":"/docs/building-and-developing/tests-93","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#general-rules","content":"Tests should not overlog.\nMore than 100 lines/second makes the logs complex to read and use i/o that are hence not available for the other tests."},"2238":{"id":"/docs/building-and-developing/tests-94","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#general-rules","content":"Tests can be written with `HBaseTestingUtility`.\nThis class offers helper functions to create a temp directory and do the cleanup, or to start a cluster."},"2239":{"id":"/docs/building-and-developing/tests-95","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#categories-and-execution-time","content":"All tests must be categorized, if not they could be skipped."},"2240":{"id":"/docs/building-and-developing/tests-96","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#categories-and-execution-time","content":"All tests should be written to be as fast as possible."},"2241":{"id":"/docs/building-and-developing/tests-97","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#categories-and-execution-time","content":"See Unit Tests for test case categories and corresponding timeouts.\nThis should ensure a good parallelization for people using it, and ease the analysis when the test fails."},"2242":{"id":"/docs/building-and-developing/tests-98","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#sleeps-in-tests","content":"Whenever possible, tests should not use `Thread.sleep`, but rather waiting for the real event they need.\nThis is faster and clearer for the reader.\nTests should not do a `Thread.sleep` without testing an ending condition.\nThis allows understanding what the test is waiting for.\nMoreover, the test will work whatever the machine performance is.\nSleep should be minimal to be as fast as possible.\nWaiting for a variable should be done in a 40ms sleep loop.\nWaiting for a socket operation should be done in a 200 ms sleep loop."},"2243":{"id":"/docs/building-and-developing/tests-99","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#tests-using-a-cluster","content":"Tests using a HRegion do not have to start a cluster: A region can use the local file system.\nStart/stopping a cluster cost around 10 seconds.\nThey should not be started per test method but per test class.\nStarted cluster must be shutdown using `HBaseTestingUtility#shutdownMiniCluster`, which cleans the directories.\nAs most as possible, tests should use the default settings for the cluster.\nWhen they don't, they should document it.\nThis will allow to share the cluster later."},"2244":{"id":"/docs/building-and-developing/tests-100","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#tests-skeleton-code","content":"Here is a test skeleton code with sizing tags to copy and paste and use as basis for test contribution."},"2245":{"id":"/docs/building-and-developing/tests-101","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"HBase integration/system tests are tests that are beyond HBase unit tests.\nThey are generally long-lasting, sizeable (the test can be asked to 1M rows or 1B rows), targetable (they can take configuration that will point them at the ready-made cluster they are to run against; integration tests do not include cluster start/stop code), and verifying success, integration tests rely on public APIs only; they do not attempt to examine server internals asserting success/fail.\nIntegration tests are what you would run when you need to more elaborate proofing of a release candidate beyond what unit tests can do.\nThey are not generally run on the Apache Continuous Integration build server, however, some sites opt to run integration tests as a part of their continuous testing on an actual cluster."},"2246":{"id":"/docs/building-and-developing/tests-102","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"Integration tests currently live under the *src/test&#x2A; directory in the hbase-it submodule and will match the regex: **IntegrationTest*.java*.\nAll integration tests are also annotated with `@Tag(IntegrationTests.TAG)`."},"2247":{"id":"/docs/building-and-developing/tests-103","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"Integration tests can be run in two modes: using a mini cluster, or against an actual distributed cluster.\nMaven failsafe is used to run the tests using the mini cluster.\nIntegrationTestsDriver class is used for executing the tests against a distributed cluster.\nIntegration tests SHOULD NOT assume that they are running against a mini cluster, and SHOULD NOT use private API's to access cluster state.\nTo interact with the distributed or mini cluster uniformly, `IntegrationTestingUtility`, and `HBaseCluster` classes, and public client API's can be used."},"2248":{"id":"/docs/building-and-developing/tests-104","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"On a distributed cluster, integration tests that use ChaosMonkey or otherwise manipulate services thru cluster manager (e.g.\nrestart regionservers) use SSH to do it.\nTo run these, test process should be able to run commands on remote end, so ssh should be configured accordingly (for example, if HBase runs under hbase user in your cluster, you can set up passwordless ssh for that user and run the test also under it). To facilitate that, `hbase.it.clustermanager.ssh.user`, `hbase.it.clustermanager.ssh.opts` and `hbase.it.clustermanager.ssh.cmd` configuration settings can be used.\n\"User\" is the remote user that cluster manager should use to perform ssh commands.\n\"Opts\" contains additional options that are passed to SSH (for example, \"-i /tmp/my-key\"). Finally, if you have some custom environment setup, \"cmd\" is the override format for the entire tunnel (ssh) command.\nThe default string is \\{`/usr/bin/ssh %1$s %2$s%3$s%4$s \"%5$s\"`} and is a good starting point.\nThis is a standard Java format string with 5 arguments that is used to execute the remote command.\nThe argument 1 (%1\\$s) is SSH options set the via opts setting or via environment variable, 2 is SSH user name, 3 is \"@\" if username is set or \"\" otherwise, 4 is the target host name, and 5 is the logical command to execute (that may include single quotes, so don't use them). For example, if you run the tests under non-hbase user and want to ssh as that user and change to hbase on remote machine, you can use:"},"2249":{"id":"/docs/building-and-developing/tests-105","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"That way, to kill RS (for example) integration tests may run:"},"2250":{"id":"/docs/building-and-developing/tests-106","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"The command is logged in the test logs, so you can verify it is correct for your environment."},"2251":{"id":"/docs/building-and-developing/tests-107","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#building-and-developing-integration-tests","content":"To disable the running of Integration Tests, pass the following profile on the command line `-PskipIntegrationTests`.\nFor example,"},"2252":{"id":"/docs/building-and-developing/tests-108","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-mini-cluster","content":"HBase 0.92 added a `verify` maven target.\nInvoking it, for example by doing `mvn verify`, will run all the phases up to and including the verify phase via the maven failsafe\nplugin, running all the above mentioned HBase unit tests as well as tests that are in the HBase integration test group.\nAfter you have completed `mvn install -DskipTests` You can run just the integration tests by invoking:"},"2253":{"id":"/docs/building-and-developing/tests-109","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-mini-cluster","content":"If you just want to run the integration tests in top-level, you need to run two commands.\nFirst:"},"2254":{"id":"/docs/building-and-developing/tests-110","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-mini-cluster","content":"This actually runs ALL the integration tests."},"2255":{"id":"/docs/building-and-developing/tests-111","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-mini-cluster","content":"This command will always output `BUILD SUCCESS` even if there are test failures."},"2256":{"id":"/docs/building-and-developing/tests-112","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-mini-cluster","content":"At this point, you could grep the output by hand looking for failed tests.\nHowever, maven will do this for us; just use:"},"2257":{"id":"/docs/building-and-developing/tests-113","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-mini-cluster","content":"The above command basically looks at all the test results (so don't remove the 'target' directory) for test failures and reports the results."},"2258":{"id":"/docs/building-and-developing/tests-114","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-a-subset-of-integration-tests","content":"This is very similar to how you specify running a subset of unit tests (see above), but use the property `it.test` instead of `test`.\nTo just run `IntegrationTestClassXYZ.java`, use:"},"2259":{"id":"/docs/building-and-developing/tests-115","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-a-subset-of-integration-tests","content":"The next thing you might want to do is run groups of integration tests, say all integration tests that are named IntegrationTestClassX\\*.java:"},"2260":{"id":"/docs/building-and-developing/tests-116","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-a-subset-of-integration-tests","content":"This runs everything that is an integration test that matches **ClassX*&#x2A;. This means anything matching: \"**\\*/IntegrationTest\\*ClassX**\". You can also run multiple groups of integration tests using comma-delimited lists (similar to unit tests). Using a list of matches still supports full regex matching for each of the groups. This would look something like:"},"2261":{"id":"/docs/building-and-developing/tests-117","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-distributed-cluster","content":"If you have an already-setup HBase cluster, you can launch the integration tests by invoking the class `IntegrationTestsDriver`.\nYou may have to run test-compile first.\nThe configuration will be picked by the bin/hbase script."},"2262":{"id":"/docs/building-and-developing/tests-118","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-distributed-cluster","content":"Then launch the tests with:"},"2263":{"id":"/docs/building-and-developing/tests-119","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-distributed-cluster","content":"Pass `-h` to get usage on this sweet tool.\nRunning the IntegrationTestsDriver without any argument will launch tests found under `hbase-it/src/test`, having `@Tag(IntegrationTests.TAG)` annotation, and a name starting with `IntegrationTest`.\nSee the usage, by passing -h, to see how to filter test classes.\nYou can pass a regex which is checked against the full class name; so, part of class name can be used.\nIntegrationTestsDriver uses JUnit 5 to run the tests.\nCurrently there is no support for running integration tests against a distributed cluster using maven (see HBASE-6201)."},"2264":{"id":"/docs/building-and-developing/tests-120","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-distributed-cluster","content":"The tests interact with the distributed cluster by using the methods in the `DistributedHBaseCluster` (implementing `HBaseCluster`) class, which in turn uses a pluggable `ClusterManager`.\nConcrete implementations provide actual functionality for carrying out deployment-specific and environment-dependent tasks (SSH, etc). The default `ClusterManager` is `HBaseClusterManager`, which uses SSH to remotely execute start/stop/kill/signal commands, and assumes some posix commands (ps, etc). Also assumes the user running the test has enough \"power\" to start/stop servers on the remote machines.\nBy default, it picks up `HBASE_SSH_OPTS`, `HBASE_HOME`, `HBASE_CONF_DIR` from the env, and uses `bin/hbase-daemon.sh` to carry out the actions.\nCurrently tarball deployments, deployments which uses *hbase-daemons.sh*, and Apache Ambar&#x69; deployments are supported.\n&#x2A;/etc/init.d/* scripts are not supported for now, but it can be easily added.\nFor other deployment options, a ClusterManager can be implemented and plugged in."},"2265":{"id":"/docs/building-and-developing/tests-121","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-distributed-cluster","content":"Some integration tests define a *main* method as entry point, and can be run on its' own, rather than using the test driver. For example, the *itbll* test can be run as follows:"},"2266":{"id":"/docs/building-and-developing/tests-122","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#running-integration-tests-against-distributed-cluster","content":"The *hbase* script assumes all integration tests with exposed *main* methods to be run against a\ndistributed cluster will follow the **IntegrationTest** regex naming pattern mentioned above, in\norder to proper set test dependencies into the classpath."},"2267":{"id":"/docs/building-and-developing/tests-123","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#destructive-integration--system-tests-chaosmonkey","content":"HBase 0.96 introduced a tool named `ChaosMonkey`, modeled after\nsame-named tool by Netflix's Chaos Monkey tool.\nChaosMonkey simulates real-world\nfaults in a running cluster by killing or disconnecting random servers, or injecting\nother failures into the environment. You can use ChaosMonkey as a stand-alone tool\nto run a policy while other tests are running. In some environments, ChaosMonkey is\nalways running, in order to constantly check that high availability and fault tolerance\nare working as expected."},"2268":{"id":"/docs/building-and-developing/tests-124","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#destructive-integration--system-tests-chaosmonkey","content":"ChaosMonkey defines **Actions** and **Policies**."},"2269":{"id":"/docs/building-and-developing/tests-125","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Actions are predefined sequences of events, such as the following:"},"2270":{"id":"/docs/building-and-developing/tests-126","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Restart active master (sleep 5 sec)"},"2271":{"id":"/docs/building-and-developing/tests-127","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Restart random regionserver (sleep 5 sec)"},"2272":{"id":"/docs/building-and-developing/tests-128","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Restart random regionserver (sleep 60 sec)"},"2273":{"id":"/docs/building-and-developing/tests-129","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Restart META regionserver (sleep 5 sec)"},"2274":{"id":"/docs/building-and-developing/tests-130","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Restart ROOT regionserver (sleep 5 sec)"},"2275":{"id":"/docs/building-and-developing/tests-131","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Batch restart of 50% of regionservers (sleep 5 sec)"},"2276":{"id":"/docs/building-and-developing/tests-132","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#actions","content":"Rolling restart of 100% of regionservers (sleep 5 sec)"},"2277":{"id":"/docs/building-and-developing/tests-133","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#policies","content":"A policy is a strategy for executing one or more actions. The default policy\nexecutes a random action every minute based on predefined action weights.\nA given policy will be executed until ChaosMonkey is interrupted."},"2278":{"id":"/docs/building-and-developing/tests-134","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#policies","content":"Most ChaosMonkey actions are configured to have reasonable defaults, so you can run\nChaosMonkey against an existing cluster without any additional configuration. The\nfollowing example runs ChaosMonkey with the default configuration:"},"2279":{"id":"/docs/building-and-developing/tests-135","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#policies","content":"The output indicates that ChaosMonkey started the default `PeriodicRandomActionPolicy`\npolicy, which is configured with all the available actions. It chose to run `RestartActiveMaster` and `RestartRandomRs` actions."},"2280":{"id":"/docs/building-and-developing/tests-136","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#chaosmonkey-without-ssh","content":"Chaos monkey can be run without SSH using the Chaos service and ZNode cluster manager. HBase ships\nwith many cluster managers, available in the `hbase-it/src/test/java/org/apache/hadoop/hbase/` directory."},"2281":{"id":"/docs/building-and-developing/tests-137","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#chaosmonkey-without-ssh","content":"Set the following property in hbase configuration to switch to `ZNodeClusterManager`:"},"2282":{"id":"/docs/building-and-developing/tests-138","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#chaosmonkey-without-ssh","content":"Start chaos agent on all hosts where you want to test chaos scenarios."},"2283":{"id":"/docs/building-and-developing/tests-139","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#chaosmonkey-without-ssh","content":"Start chaos monkey runner from any one host, preferrably an edgenode.\nAn example log while running chaos monkey with default policy `PeriodicRandomActionPolicy` is as shown below:"},"2284":{"id":"/docs/building-and-developing/tests-140","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#chaosmonkey-without-ssh","content":"For info on more customisations we can see help for the `ChaosMonkeyRunner`. For example we can pass the table name on which the chaos operations to be performed etc.\nBelow is the output of the help command, listing all the supported options."},"2285":{"id":"/docs/building-and-developing/tests-141","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#chaosmonkey-without-ssh","content":"For example, running the following will start `ServerKillingMonkeyFactory` that chooses among actions to rolling batch restart RS, graceful rolling restart RS one at a time, restart active master, force balancer run etc."},"2286":{"id":"/docs/building-and-developing/tests-142","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#available-policies","content":"HBase ships with several ChaosMonkey policies, available in the\n`hbase/hbase-it/src/test/java/org/apache/hadoop/hbase/chaos/policies/` directory."},"2287":{"id":"/docs/building-and-developing/tests-143","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#configuring-individual-chaosmonkey-actions","content":"ChaosMonkey integration tests can be configured per test run.\nCreate a Java properties file in the HBase CLASSPATH and pass it to ChaosMonkey using\nthe `-monkeyProps` configuration flag. Configurable properties, along with their default\nvalues if applicable, are listed in the `org.apache.hadoop.hbase.chaos.factories.MonkeyConstants`\nclass. For properties that have defaults, you can override them by including them\nin your properties file."},"2288":{"id":"/docs/building-and-developing/tests-144","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#configuring-individual-chaosmonkey-actions","content":"The following example uses a properties file called `monkey.properties`."},"2289":{"id":"/docs/building-and-developing/tests-145","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#configuring-individual-chaosmonkey-actions","content":"The above command will start the integration tests and chaos monkey. It will look for the\nproperties file *monkey.properties* on the HBase CLASSPATH; e.g. inside the HBASE *conf* dir."},"2290":{"id":"/docs/building-and-developing/tests-146","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#configuring-individual-chaosmonkey-actions","content":"Here is an example chaos monkey file:"},"2291":{"id":"/docs/building-and-developing/tests-147","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#example-chaosmonkey-properties-file","content":"Periods/time are expressed in milliseconds."},"2292":{"id":"/docs/building-and-developing/tests-148","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#example-chaosmonkey-properties-file","content":"HBase 1.0.2 and newer adds the ability to restart HBase's underlying ZooKeeper quorum or\nHDFS nodes. To use these actions, you need to configure some new properties, which\nhave no reasonable defaults because they are deployment-specific, in your ChaosMonkey\nproperties file, which may be `hbase-site.xml` or a different properties file."},"2293":{"id":"/docs/building-and-developing/tests-149","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#customizing-destructive-chaosmonkey-actions","content":"The session above shows how to setup custom configurations for the *slowDeterministic* monkey\npolicy. This is a policy that pre-defines a set of destructive actions of varying gravity for a\nrunning cluster. These actions are grouped into three categories: *light weight*, *mid weight* and\n*heavy weight*. Although it's possible to define some properties for the different actions\n(such as timeouts, frequency, etc), the actions themselves are not configurable."},"2294":{"id":"/docs/building-and-developing/tests-150","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#customizing-destructive-chaosmonkey-actions","content":"For certain deployments, it may be interesting to define its own test strategy, either less or more\naggressive than the pre-defined set of actions provided by *slowDeterministic*. For such cases,\nthe *configurableSlowDeterministic* policy can be used. It allows for a customizable set of\n*heavy weight* actions to be defined in the *monkey.properties* properties file:"},"2295":{"id":"/docs/building-and-developing/tests-151","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#customizing-destructive-chaosmonkey-actions","content":"The above properties file definition instructs chaos monkey to perform a RegionServer crash every 8 minutes,\na random region move every 6 minutes, and at least one split of all table regions."},"2296":{"id":"/docs/building-and-developing/tests-152","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#customizing-destructive-chaosmonkey-actions","content":"To run this policy, just specify *configurableSlowDeterministic* as the monkey policy to run, together\nwith a property file containing the *heavy.actions* property definition:"},"2297":{"id":"/docs/building-and-developing/tests-153","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#customizing-destructive-chaosmonkey-actions","content":"When specifying monkey actions, make sure to define all required constructor parameters. For actions\nthat require a table name parameter, the *\\$table\\_name* placeholder can be specified, and it will\nautomatically resort to the table created by the integration test run."},"2298":{"id":"/docs/building-and-developing/tests-154","page_id":"/docs/building-and-developing/tests","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/tests#customizing-destructive-chaosmonkey-actions","content":"If *heavy.actions* property is omitted in the properties file, *configurableSlowDeterministic* will\njust run as the *slowDeterministic* policy\n(it will execute all the heavy weight actions defined by *slowDeterministic* policy)."},"2299":{"id":"/docs/building-and-developing/updating-landing","page_id":"/docs/building-and-developing/updating-landing","type":"page","content":"Updating hbase.apache.org","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/updating-landing"},"2300":{"id":"/docs/building-and-developing/updating-landing-0","page_id":"/docs/building-and-developing/updating-landing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/updating-landing","content":"Contributing to and publishing the HBase website and documentation using gitpubsub mechanism."},"2301":{"id":"/docs/building-and-developing/updating-landing-1","page_id":"/docs/building-and-developing/updating-landing","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/updating-landing#contributing-to-hbaseapacheorg","content":"Contributing to hbase.apache.org"},"2302":{"id":"/docs/building-and-developing/updating-landing-2","page_id":"/docs/building-and-developing/updating-landing","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/updating-landing#publishing-hbaseapacheorg","content":"Publishing hbase.apache.org"},"2303":{"id":"/docs/building-and-developing/updating-landing-3","page_id":"/docs/building-and-developing/updating-landing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/updating-landing#contributing-to-hbaseapacheorg","content":"See appendix contributing to documentation for more information on contributing to the documentation or website."},"2304":{"id":"/docs/building-and-developing/updating-landing-4","page_id":"/docs/building-and-developing/updating-landing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/updating-landing#publishing-hbaseapacheorg","content":"See Publishing the HBase Website and Documentation for instructions on publishing the website and documentation."},"2305":{"id":"/docs/building-and-developing/voting","page_id":"/docs/building-and-developing/voting","type":"page","content":"Voting on Release Candidates","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/voting"},"2306":{"id":"/docs/building-and-developing/voting-0","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting","content":"Baseline and additional verification procedures for voting on HBase release candidates including checksums, signatures, and testing."},"2307":{"id":"/docs/building-and-developing/voting-1","page_id":"/docs/building-and-developing/voting","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"Baseline Verifications for Voting Release Candidates"},"2308":{"id":"/docs/building-and-developing/voting-2","page_id":"/docs/building-and-developing/voting","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/voting#additional-verifications-for-voting-release-candidates","content":"Additional Verifications for Voting Release Candidates"},"2309":{"id":"/docs/building-and-developing/voting-3","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting","content":"Everyone is encouraged to try and vote on HBase release candidates.\nOnly the votes of PMC members are binding.\nPMC members, please read this WIP doc on policy voting for a release candidate, Release Policy."},"2310":{"id":"/docs/building-and-developing/voting-4","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting","content":"> Before casting +1 binding votes, individuals are required to\n> download the signed source code package onto their own hardware, compile it as\n> provided, and test the resulting executable on their own platform, along with also\n> validating cryptographic signatures and verifying that the package meets the\n> requirements of the ASF policy on releases."},"2311":{"id":"/docs/building-and-developing/voting-5","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting","content":"Regards the latter, run `mvn apache-rat:check` to verify all files are suitably licensed.\nSee HBase, mail # dev - On recent discussion clarifying ASF release policy\nfor how we arrived at this process."},"2312":{"id":"/docs/building-and-developing/voting-6","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting","content":"To help with the release verification, please follow the guideline below and vote based on the your verification."},"2313":{"id":"/docs/building-and-developing/voting-7","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"Although contributors have their own checklist for verifications, the following items are usually used for voting on release candidates."},"2314":{"id":"/docs/building-and-developing/voting-8","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"CHANGES.md if any"},"2315":{"id":"/docs/building-and-developing/voting-9","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"RELEASENOTES.md (release notes) if any"},"2316":{"id":"/docs/building-and-developing/voting-10","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"Generated API compatibility report"},"2317":{"id":"/docs/building-and-developing/voting-11","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"For what should be compatible please refer the versioning guideline, especially for items with marked as high severity"},"2318":{"id":"/docs/building-and-developing/voting-12","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"Use `hbase-vote.sh` to perform sanity checks for checksum, signatures, files are licensed, built from source, and unit tests."},"2319":{"id":"/docs/building-and-developing/voting-13","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"`hbase-vote.sh` shell script is available under `dev-support` directory of HBase source. Following are the usage details."},"2320":{"id":"/docs/building-and-developing/voting-14","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#baseline-verifications-for-voting-release-candidates","content":"If you see any unit test failures, please call out the solo test result and whether it's part of flaky (nightly) tests dashboard, e.g. dashboard of master branch (please change the test branch accordingly)."},"2321":{"id":"/docs/building-and-developing/voting-15","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#additional-verifications-for-voting-release-candidates","content":"Other than the common verifications, contributors may call out additional concerns, e.g. for a specific feature by running end to end tests on a distributed environment. This is optional and always encouraged."},"2322":{"id":"/docs/building-and-developing/voting-16","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#additional-verifications-for-voting-release-candidates","content":"Start a distributed HBase cluster and call out the test result of specific workload on cluster. e.g."},"2323":{"id":"/docs/building-and-developing/voting-17","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#additional-verifications-for-voting-release-candidates","content":"Run basic table operations, e.g. `create/put/get/scan/flush/list/disable/drop`"},"2324":{"id":"/docs/building-and-developing/voting-18","page_id":"/docs/building-and-developing/voting","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/voting#additional-verifications-for-voting-release-candidates","content":"Run built-in tests, e.g. `LoadTestTool` (LTT) and `IntegrationTestBigLinkedList` (ITBLL)"},"2325":{"id":"/docs/bulk-data-generator-tool","page_id":"/docs/bulk-data-generator-tool","type":"page","content":"Bulk Data Generator Tool","breadcrumbs":["Docs","Multi-Page Documentation","Infrastructure & Tools"],"tags":["multi-page"],"url":"/docs/bulk-data-generator-tool"},"2326":{"id":"/docs/bulk-data-generator-tool-0","page_id":"/docs/bulk-data-generator-tool","tags":["multi-page"],"type":"text","url":"/docs/bulk-data-generator-tool","content":"This is a random data generator tool for HBase tables leveraging Hbase bulk load. It can create pre-splited HBase table and the generated data is uniformly distributed to all the regions of the table."},"2327":{"id":"/docs/bulk-data-generator-tool-1","page_id":"/docs/bulk-data-generator-tool","type":"heading","tags":["multi-page"],"url":"/docs/bulk-data-generator-tool#bulk-data-generator-tool-usage","content":"Usage"},"2328":{"id":"/docs/bulk-data-generator-tool-2","page_id":"/docs/bulk-data-generator-tool","type":"heading","tags":["multi-page"],"url":"/docs/bulk-data-generator-tool#bulk-data-generator-tool-overview","content":"Overview"},"2329":{"id":"/docs/bulk-data-generator-tool-3","page_id":"/docs/bulk-data-generator-tool","type":"heading","tags":["multi-page"],"url":"/docs/bulk-data-generator-tool#table-schema","content":"Table Schema"},"2330":{"id":"/docs/bulk-data-generator-tool-4","page_id":"/docs/bulk-data-generator-tool","type":"heading","tags":["multi-page"],"url":"/docs/bulk-data-generator-tool#table-creation","content":"Table Creation"},"2331":{"id":"/docs/bulk-data-generator-tool-5","page_id":"/docs/bulk-data-generator-tool","type":"heading","tags":["multi-page"],"url":"/docs/bulk-data-generator-tool#data-generation","content":"Data Generation"},"2332":{"id":"/docs/bulk-data-generator-tool-6","page_id":"/docs/bulk-data-generator-tool","type":"heading","tags":["multi-page"],"url":"/docs/bulk-data-generator-tool#experiments","content":"Experiments"},"2333":{"id":"/docs/bulk-data-generator-tool-7","page_id":"/docs/bulk-data-generator-tool","tags":["multi-page"],"type":"text","url":"/docs/bulk-data-generator-tool#bulk-data-generat