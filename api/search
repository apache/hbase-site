gle-page"],"type":"text","url":"/docs/single-page#cp-examples","content":"9000"},"15597":{"id":"/docs/single-page-5797","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cp-examples","content":"3000"},"15598":{"id":"/docs/single-page-5798","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"The following Observer coprocessor prevents the details of the user `admin` from being\nreturned in a `Get` or `Scan` of the `users` table."},"15599":{"id":"/docs/single-page-5799","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Write a class that implements the\nRegionCoprocessor,\nRegionObserver\nclass."},"15600":{"id":"/docs/single-page-5800","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Override the `preGetOp()` method (the `preGet()` method is deprecated) to check\nwhether the client has queried for the rowkey with value `admin`. If so, return an\nempty result. Otherwise, process the request as normal."},"15601":{"id":"/docs/single-page-5801","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Put your code and dependencies in a JAR file."},"15602":{"id":"/docs/single-page-5802","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Place the JAR in HDFS where HBase can locate it."},"15603":{"id":"/docs/single-page-5803","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Load the Coprocessor."},"15604":{"id":"/docs/single-page-5804","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Write a simple program to test it."},"15605":{"id":"/docs/single-page-5805","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Following are the implementation of the above steps:"},"15606":{"id":"/docs/single-page-5806","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"Overriding the `preGetOp()` will only work for `Get` operations. You also need to override\nthe `preScannerOpen()` method to filter the `admin` row from scan results."},"15607":{"id":"/docs/single-page-5807","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#observer-example","content":"This method works but there is a *side effect*. If the client has used a filter in\nits scan, that filter will be replaced by this filter. Instead, you can explicitly\nremove any `admin` results from the scan:"},"15608":{"id":"/docs/single-page-5808","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"Still using the `users` table, this example implements a coprocessor to calculate\nthe sum of all employee salaries, using an endpoint coprocessor."},"15609":{"id":"/docs/single-page-5809","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"Create a '.proto' file defining your service."},"15610":{"id":"/docs/single-page-5810","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"Execute the `protoc` command to generate the Java code from the above .proto' file."},"15611":{"id":"/docs/single-page-5811","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"This will generate a class call `Sum.java`."},"15612":{"id":"/docs/single-page-5812","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"Write a class that extends the generated service class, implement the `Coprocessor`\nand `CoprocessorService` classes, and override the service method."},"15613":{"id":"/docs/single-page-5813","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"If you load a coprocessor from `hbase-site.xml` and then load the same coprocessor\nagain using HBase Shell, it will be loaded a second time. The same class will\nexist twice, and the second instance will have a higher ID (and thus a lower priority).\nThe effect is that the duplicate coprocessor is effectively ignored."},"15614":{"id":"/docs/single-page-5814","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"Load the Coprocessor."},"15615":{"id":"/docs/single-page-5815","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#endpoint-example","content":"Write a client code to call the Coprocessor."},"15616":{"id":"/docs/single-page-5816","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-deploying-a-coprocessor","content":"**Bundling Coprocessors**\\\nYou can bundle all classes for a coprocessor into a\nsingle JAR on the RegionServer's classpath, for easy deployment. Otherwise,\nplace all dependencies on the RegionServer's classpath so that they can be\nloaded during RegionServer start-up. The classpath for a RegionServer is set\nin the RegionServer's `hbase-env.sh` file."},"15617":{"id":"/docs/single-page-5817","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-deploying-a-coprocessor","content":"**Automating Deployment**\\\nYou can use a tool such as Puppet, Chef, or\nAnsible to ship the JAR for the coprocessor to the required location on your\nRegionServers' filesystems and restart each RegionServer, to automate\ncoprocessor deployment. Details for such set-ups are out of scope of this\ndocument."},"15618":{"id":"/docs/single-page-5818","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-deploying-a-coprocessor","content":"**Updating a Coprocessor**\\\nDeploying a new version of a given coprocessor is not as simple as disabling it,\nreplacing the JAR, and re-enabling the coprocessor. This is because you cannot\nreload a class in a JVM unless you delete all the current references to it.\nSince the current JVM has reference to the existing coprocessor, you must restart\nthe JVM, by restarting the RegionServer, in order to replace it. This behavior\nis not expected to change."},"15619":{"id":"/docs/single-page-5819","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-deploying-a-coprocessor","content":"**Coprocessor Logging**\\\nThe Coprocessor framework does not provide an API for logging beyond standard Java\nlogging."},"15620":{"id":"/docs/single-page-5820","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-deploying-a-coprocessor","content":"**Coprocessor Configuration**\\\nIf you do not want to load coprocessors from the HBase Shell, you can add their configuration\nproperties to `hbase-site.xml`. In Using HBase Shell, two arguments are\nset: `arg1=1,arg2=2`. These could have been added to `hbase-site.xml` as follows:"},"15621":{"id":"/docs/single-page-5821","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-deploying-a-coprocessor","content":"Then you can read the configuration using code like the following:"},"15622":{"id":"/docs/single-page-5822","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"Restricting arbitrary user coprocessors can be a big concern in multitenant environments. HBase provides a continuum of options for ensuring only expected coprocessors are running:"},"15623":{"id":"/docs/single-page-5823","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.enabled`: Enables or disables all coprocessors. This will limit the functionality of HBase, as disabling all coprocessors will disable some security providers. An example coproccessor so affected is `org.apache.hadoop.hbase.security.access.AccessController`."},"15624":{"id":"/docs/single-page-5824","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.user.enabled`: Enables or disables loading coprocessors on tables (i.e. user coprocessors)."},"15625":{"id":"/docs/single-page-5825","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"One can statically load coprocessors, and optionally tune their priorities, via the following tunables in `hbase-site.xml`:"},"15626":{"id":"/docs/single-page-5826","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.regionserver.classes`: A comma-separated list of coprocessors that are loaded by region servers"},"15627":{"id":"/docs/single-page-5827","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.region.classes`: A comma-separated list of RegionObserver and Endpoint coprocessors"},"15628":{"id":"/docs/single-page-5828","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.user.region.classes`: A comma-separated list of coprocessors that are loaded by all regions"},"15629":{"id":"/docs/single-page-5829","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.master.classes`: A comma-separated list of coprocessors that are loaded by the master (MasterObserver coprocessors)"},"15630":{"id":"/docs/single-page-5830","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.wal.classes`: A comma-separated list of WALObserver coprocessors to load"},"15631":{"id":"/docs/single-page-5831","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.abortonerror`: Whether to abort the daemon which has loaded the coprocessor if the coprocessor should error other than `IOError`. If this is set to false and an access controller coprocessor should have a fatal error the coprocessor will be circumvented, as such in secure installations this is advised to be `true`; however, one may override this on a per-table basis for user coprocessors, to ensure they do not abort their running region server and are instead unloaded on error."},"15632":{"id":"/docs/single-page-5832","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`hbase.coprocessor.region.whitelist.paths`: A comma separated list available for those loading `org.apache.hadoop.hbase.security.access.CoprocessorWhitelistMasterObserver` whereby one can use the following options to white-list paths from which coprocessors may be loaded."},"15633":{"id":"/docs/single-page-5833","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"Coprocessors on the classpath are implicitly white-listed"},"15634":{"id":"/docs/single-page-5834","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"`*` to wildcard all coprocessor paths"},"15635":{"id":"/docs/single-page-5835","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"An entire filesystem (e.g. `hdfs://my-cluster/`)"},"15636":{"id":"/docs/single-page-5836","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"A wildcard path to be evaluated by FilenameUtils.wildcardMatch"},"15637":{"id":"/docs/single-page-5837","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restricting-coprocessor-usage","content":"Note: Path can specify scheme or not (e.g. `file:///usr/hbase/lib/coprocessors` or for all filesystems `/usr/hbase/lib/coprocessors`)"},"15638":{"id":"/docs/single-page-5838","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#memory","content":"RAM, RAM, RAM. Don't starve HBase."},"15639":{"id":"/docs/single-page-5839","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#64-bit","content":"Use a 64-bit platform (and 64-bit JVM)."},"15640":{"id":"/docs/single-page-5840","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#swapping","content":"Watch out for swapping. Set `swappiness` to 0."},"15641":{"id":"/docs/single-page-5841","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cpu","content":"Make sure you have set up your Hadoop to use native, hardware checksumming. See hadoop.native.lib."},"15642":{"id":"/docs/single-page-5842","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-network","content":"Perhaps the most important factor in avoiding network issues degrading Hadoop and HBase performance is the switching hardware that is used, decisions made early in the scope of the project can cause major problems when you double or triple the size of your cluster (or more)."},"15643":{"id":"/docs/single-page-5843","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-network","content":"Important items to consider:"},"15644":{"id":"/docs/single-page-5844","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-network","content":"Switching capacity of the device"},"15645":{"id":"/docs/single-page-5845","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-network","content":"Number of systems connected"},"15646":{"id":"/docs/single-page-5846","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-network","content":"Uplink capacity"},"15647":{"id":"/docs/single-page-5847","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#single-switch","content":"The single most important factor in this configuration is that the switching capacity of the hardware is capable of handling the traffic which can be generated by all systems connected to the switch. Some lower priced commodity hardware can have a slower switching capacity than could be utilized by a full switch."},"15648":{"id":"/docs/single-page-5848","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-switches","content":"Multiple switches are a potential pitfall in the architecture. The most common configuration of lower priced hardware is a simple 1Gbps uplink from one switch to another. This often overlooked pinch point can easily become a bottleneck for cluster communication. Especially with MapReduce jobs that are both reading and writing a lot of data the communication across this uplink could be saturated."},"15649":{"id":"/docs/single-page-5849","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-switches","content":"Mitigation of this issue is fairly simple and can be accomplished in multiple ways:"},"15650":{"id":"/docs/single-page-5850","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-switches","content":"Use appropriate hardware for the scale of the cluster which you're attempting to build."},"15651":{"id":"/docs/single-page-5851","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-switches","content":"Use larger single switch configurations i.e. single 48 port as opposed to 2x 24 port"},"15652":{"id":"/docs/single-page-5852","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-switches","content":"Configure port trunking for uplinks to utilize multiple interfaces to increase cross switch bandwidth."},"15653":{"id":"/docs/single-page-5853","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-racks","content":"Multiple rack configurations carry the same potential issues as multiple switches, and can suffer performance degradation from two main areas:"},"15654":{"id":"/docs/single-page-5854","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-racks","content":"Poor switch capacity performance"},"15655":{"id":"/docs/single-page-5855","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-racks","content":"Insufficient uplink to another rack"},"15656":{"id":"/docs/single-page-5856","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-racks","content":"If the switches in your rack have appropriate switching capacity to handle all the hosts at full speed, the next most likely issue will be caused by homing more of your cluster across racks. The easiest way to avoid issues when spanning multiple racks is to use port trunking to create a bonded uplink to other racks. The downside of this method however, is in the overhead of ports that could potentially be used. An example of this is, creating an 8Gbps port channel from rack A to rack B, using 8 of your 24 ports to communicate between racks gives you a poor ROI, using too few however can mean you're not getting the most out of your cluster."},"15657":{"id":"/docs/single-page-5857","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-racks","content":"Using 10Gbe links between racks will greatly increase performance, and assuming your switches support a 10Gbe uplink or allow for an expansion card will allow you to save your ports for machines as opposed to uplinks."},"15658":{"id":"/docs/single-page-5858","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-network-interfaces","content":"Are all the network interfaces functioning correctly? Are you sure? See the Troubleshooting Case Study in Case Study #1 (Performance Issue On A Single Node)."},"15659":{"id":"/docs/single-page-5859","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-consistency-and-partition-tolerance","content":"The CAP Theorem states that a distributed system can maintain two out of the following three characteristics:"},"15660":{"id":"/docs/single-page-5860","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-consistency-and-partition-tolerance","content":"***C***&#x6F;nsistency — all nodes see the same data."},"15661":{"id":"/docs/single-page-5861","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-consistency-and-partition-tolerance","content":"***A***&#x76;ailability — every request receives a response about whether it succeeded or failed."},"15662":{"id":"/docs/single-page-5862","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-consistency-and-partition-tolerance","content":"***P***&#x61;rtition tolerance — the system continues to operate even if some of its components become unavailable to the others."},"15663":{"id":"/docs/single-page-5863","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-consistency-and-partition-tolerance","content":"HBase favors consistency and partition tolerance, where a decision has to be made. Coda Hale explains why partition tolerance is so important, in http\\://codahale.com/you-cant-sacrifice-partition-tolerance/."},"15664":{"id":"/docs/single-page-5864","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-consistency-and-partition-tolerance","content":"Robert Yokota used an automated testing framework called Jepson to test HBase's partition tolerance in the face of network partitions, using techniques modeled after Aphyr's Call Me Maybe series. The results, available as a blog post and an addendum, show that HBase performs correctly."},"15665":{"id":"/docs/single-page-5865","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-gc-pauses","content":"In his presentation, Avoiding Full GCs with MemStore-Local Allocation Buffers, Todd Lipcon describes two cases of stop-the-world garbage collections common in HBase, especially during loading; CMS failure modes and old generation heap fragmentation brought."},"15666":{"id":"/docs/single-page-5866","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-gc-pauses","content":"To address the first, start the CMS earlier than default by adding `-XX:CMSInitiatingOccupancyFraction` and setting it down from defaults. Start at 60 or 70 percent (The lower you bring down the threshold, the more GCing is done, the more CPU used). To address the second fragmentation issue, Todd added an experimental facility, (MSLAB), that must be explicitly enabled in Apache HBase 0.90.x (It's defaulted to be *on* in Apache 0.92.x HBase). Set `hbase.hregion.memstore.mslab.enabled` to true in your `Configuration`. See the cited slides for background and detail. The latest JVMs do better regards fragmentation so make sure you are running a recent release. Read down in the message, Identifying concurrent mode failures caused by fragmentation. Be aware that when enabled, each MemStore instance will occupy at least an MSLAB instance of memory. If you have thousands of regions or lots of regions each with many column families, this allocation of MSLAB may be responsible for a good portion of your heap allocation and in an extreme case cause you to OOME. Disable MSLAB in this case, or lower the amount of memory it uses or float less regions per server."},"15667":{"id":"/docs/single-page-5867","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-gc-pauses","content":"If you have a write-heavy workload, check out HBASE-8163 MemStoreChunkPool: An improvement for JAVA GC when using MSLAB. It describes configurations to lower the amount of young GC during write-heavy loadings. If you do not have HBASE-8163 installed, and you are trying to improve your young GC times, one trick to consider — courtesy of our Liang Xie — is to set the GC config `-XX:PretenureSizeThreshold` in *hbase-env.sh* to be just smaller than the size of `hbase.hregion.memstore.mslab.chunksize` so MSLAB allocations happen in the tenured space directly rather than first in the young gen. You'd do this because these MSLAB allocations are going to likely make it to the old gen anyways and rather than pay the price of a copies between s0 and s1 in eden space followed by the copy up from young to old gen after the MSLABs have achieved sufficient tenure, save a bit of YGC churn and allocate in the old gen directly."},"15668":{"id":"/docs/single-page-5868","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-gc-pauses","content":"Other sources of long GCs can be the JVM itself logging. See Eliminating Large JVM GC Pauses Caused by Background IO Traffic"},"15669":{"id":"/docs/single-page-5869","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-gc-pauses","content":"For more information about GC logs, see JVM Garbage Collection Logs."},"15670":{"id":"/docs/single-page-5870","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-gc-pauses","content":"Consider also enabling the off-heap Block Cache. This has been shown to mitigate GC pause times. See Block Cache"},"15671":{"id":"/docs/single-page-5871","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-configurations","content":"See Recommended Configurations."},"15672":{"id":"/docs/single-page-5872","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#improving-the-99th-percentile","content":"Try hedged\\_reads."},"15673":{"id":"/docs/single-page-5873","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#managing-compactions","content":"For larger systems, managing compactions and splits may be something you want to consider."},"15674":{"id":"/docs/single-page-5874","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-hbaseregionserverhandlercount","content":"See hbase.regionserver.handler.count."},"15675":{"id":"/docs/single-page-5875","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hfileblockcachesize","content":"See hfile.block.cache.size. A memory setting for the RegionServer process."},"15676":{"id":"/docs/single-page-5876","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#prefetch-option-for-blockcache","content":"HBASE-9857 adds a new option to prefetch HFile contents when opening the BlockCache, if a Column family or RegionServer property is set. This option is available for HBase 0.98.3 and later. The purpose is to warm the BlockCache as rapidly as possible after the cache is opened, using in-memory table data, and not counting the prefetching as cache misses. This is great for fast reads, but is not a good idea if the data to be preloaded will not fit into the BlockCache. It is useful for tuning the IO impact of prefetching versus the time before all data blocks are in cache."},"15677":{"id":"/docs/single-page-5877","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#prefetch-option-for-blockcache","content":"To enable prefetching on a given column family, you can use HBase Shell or use the API."},"15678":{"id":"/docs/single-page-5878","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#prefetch-option-for-blockcache","content":"**Enable Prefetch Using HBase Shell**"},"15679":{"id":"/docs/single-page-5879","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#prefetch-option-for-blockcache","content":"**Enable Prefetch Using the API**"},"15680":{"id":"/docs/single-page-5880","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#prefetch-option-for-blockcache","content":"See the API documentation for CacheConfig."},"15681":{"id":"/docs/single-page-5881","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#prefetch-option-for-blockcache","content":"To see prefetch in operation, enable TRACE level logging on `org.apache.hadoop.hbase.io.hfile.HFileReaderImpl` in hbase-2.0+ or on `org.apache.hadoop.hbase.io.hfile.HFileReaderV2` in earlier versions, hbase-1.x, of HBase."},"15682":{"id":"/docs/single-page-5882","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseregionserverglobalmemstoresize","content":"See hbase.regionserver.global.memstore.size. This memory setting is often adjusted for the RegionServer process depending on needs."},"15683":{"id":"/docs/single-page-5883","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseregionserverglobalmemstoresizelowerlimit","content":"See hbase.regionserver.global.memstore.size.lower.limit. This memory setting is often adjusted for the RegionServer process depending on needs."},"15684":{"id":"/docs/single-page-5884","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbasehstoreblockingstorefiles","content":"See hbase.hstore.blockingStoreFiles. If there is blocking in the RegionServer logs, increasing this can help."},"15685":{"id":"/docs/single-page-5885","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbasehregionmemstoreblockmultiplier","content":"See hbase.hregion.memstore.block.multiplier. If there is enough RAM, increasing this can help."},"15686":{"id":"/docs/single-page-5886","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseregionserverchecksumverify","content":"Have HBase write the checksum into the datablock and save having to do the checksum seek whenever you read."},"15687":{"id":"/docs/single-page-5887","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseregionserverchecksumverify","content":"See hbase.regionserver.checksum.verify, hbase.hstore.bytes.per.checksum and hbase.hstore.checksum.algorithm. For more information see the release note on HBASE-5074 support checksums in HBase block cache."},"15688":{"id":"/docs/single-page-5888","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"HBASE-11355 introduces several callQueue tuning mechanisms which can increase performance. See the JIRA for some benchmarking information."},"15689":{"id":"/docs/single-page-5889","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"To increase the number of callqueues, set `hbase.ipc.server.num.callqueue` to a value greater than `1`. To split the callqueue into separate read and write queues, set `hbase.ipc.server.callqueue.read.ratio` to a value between `0` and `1`. This factor weights the queues toward writes (if below .5) or reads (if above .5). Another way to say this is that the factor determines what percentage of the split queues are used for reads. The following examples illustrate some of the possibilities. Note that you always have at least one write queue, no matter what setting you use."},"15690":{"id":"/docs/single-page-5890","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"The default value of `0` does not split the queue."},"15691":{"id":"/docs/single-page-5891","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `.3` uses 30% of the queues for reading and 70% for writing. Given a value of `10` for `hbase.ipc.server.num.callqueue`, 3 queues would be used for reads and 7 for writes."},"15692":{"id":"/docs/single-page-5892","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `.5` uses the same number of read queues and write queues. Given a value of `10` for `hbase.ipc.server.num.callqueue`, 5 queues would be used for reads and 5 for writes."},"15693":{"id":"/docs/single-page-5893","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `.6` uses 60% of the queues for reading and 40% for writing. Given a value of `10` for `hbase.ipc.server.num.callqueue`, 6 queues would be used for reads and 4 for writes."},"15694":{"id":"/docs/single-page-5894","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `1.0` uses one queue to process write requests, and all other queues process read requests. A value higher than `1.0` has the same effect as a value of `1.0`. Given a value of `10` for `hbase.ipc.server.num.callqueue`, 9 queues would be used for reads and 1 for writes."},"15695":{"id":"/docs/single-page-5895","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"You can also split the read queues so that separate queues are used for short reads (from Get operations) and long reads (from Scan operations), by setting the `hbase.ipc.server.callqueue.scan.ratio` option. This option is a factor between 0 and 1, which determine the ratio of read queues used for Gets and Scans. More queues are used for Gets if the value is below `.5` and more are used for scans if the value is above `.5`. No matter what setting you use, at least one read queue is used for Get operations."},"15696":{"id":"/docs/single-page-5896","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `0` does not split the read queue."},"15697":{"id":"/docs/single-page-5897","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `.3` uses 70% of the read queues for Gets and 30% for Scans. Given a value of `20` for `hbase.ipc.server.num.callqueue` and a value of `.5` for `hbase.ipc.server.callqueue.read.ratio`, 10 queues would be used for reads, out of those 10, 7 would be used for Gets and 3 for Scans."},"15698":{"id":"/docs/single-page-5898","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `.5` uses half the read queues for Gets and half for Scans. Given a value of `20` for `hbase.ipc.server.num.callqueue` and a value of `.5` for `hbase.ipc.server.callqueue.read.ratio`, 10 queues would be used for reads, out of those 10, 5 would be used for Gets and 5 for Scans."},"15699":{"id":"/docs/single-page-5899","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `.7` uses 30% of the read queues for Gets and 70% for Scans. Given a value of `20` for `hbase.ipc.server.num.callqueue` and a value of `.5` for `hbase.ipc.server.callqueue.read.ratio`, 10 queues would be used for reads, out of those 10, 3 would be used for Gets and 7 for Scans."},"15700":{"id":"/docs/single-page-5900","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `1.0` uses all but one of the read queues for Scans. Given a value of `20` for `hbase.ipc.server.num.callqueue` and a value of `.5` for `hbase.ipc.server.callqueue.read.ratio`, 10 queues would be used for reads, out of those 10, 1 would be used for Gets and 9 for Scans."},"15701":{"id":"/docs/single-page-5901","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"You can use the new option `hbase.ipc.server.callqueue.handler.factor` to programmatically tune the number of queues:"},"15702":{"id":"/docs/single-page-5902","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `0` uses a single shared queue between all the handlers."},"15703":{"id":"/docs/single-page-5903","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value of `1` uses a separate queue for each handler."},"15704":{"id":"/docs/single-page-5904","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"A value between `0` and `1` tunes the number of queues against the number of handlers. For instance, a value of `.5` shares one queue between each two handlers.\\\nHaving more queues, such as in a situation where you have one queue per handler, reduces contention when adding a task to a queue or selecting it from a queue. The trade-off is that if you have some queues with long-running tasks, a handler may end up waiting to execute from that queue rather than processing another queue which has waiting tasks."},"15705":{"id":"/docs/single-page-5905","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tuning-callqueue-options","content":"For these values to take effect on a given RegionServer, the RegionServer must be restarted. These parameters are intended for testing purposes and should be used carefully."},"15706":{"id":"/docs/single-page-5906","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-zookeeper","content":"See ZooKeeper for information on configuring ZooKeeper, and see the part about having a dedicated disk."},"15707":{"id":"/docs/single-page-5907","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-column-families","content":"See On the number of column families."},"15708":{"id":"/docs/single-page-5908","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#key-and-attribute-lengths","content":"See Try to minimize row and column sizes. See also However... for compression caveats."},"15709":{"id":"/docs/single-page-5909","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-regionsize","content":"The regionsize can be set on a per-table basis via `setMaxFileSize` on TableDescriptorBuilder in the event where certain tables require different regionsizes than the configured default regionsize."},"15710":{"id":"/docs/single-page-5910","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-regionsize","content":"See Determining region count and size for more information."},"15711":{"id":"/docs/single-page-5911","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters","content":"A Bloom filter, named for its creator, Burton Howard Bloom, is a data structure which is designed to predict whether a given element is a member of a set of data. A positive result from a Bloom filter is not always accurate, but a negative result is guaranteed to be accurate. Bloom filters are designed to be \"accurate enough\" for sets of data which are so large that conventional hashing mechanisms would be impractical. For more information about Bloom filters in general, refer to http\\://en.wikipedia.org/wiki/Bloom\\_filter."},"15712":{"id":"/docs/single-page-5912","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters","content":"In terms of HBase, Bloom filters provide a lightweight in-memory structure to reduce the number of disk reads for a given Get operation (Bloom filters do not work with Scans) to only the StoreFiles likely to contain the desired Row. The potential performance gain increases with the number of parallel reads."},"15713":{"id":"/docs/single-page-5913","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters","content":"The Bloom filters themselves are stored in the metadata of each HFile and never need to be updated. When an HFile is opened because a region is deployed to a RegionServer, the Bloom filter is loaded into memory."},"15714":{"id":"/docs/single-page-5914","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters","content":"HBase includes some tuning mechanisms for folding the Bloom filter to reduce the size and keep the false positive rate within a desired range."},"15715":{"id":"/docs/single-page-5915","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters","content":"Bloom filters were introduced in HBASE-1200. Since HBase 0.96, row-based Bloom filters are enabled by default. (HBASE-8450)"},"15716":{"id":"/docs/single-page-5916","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters","content":"For more information on Bloom filters in relation to HBase, see Bloom Filters for more information, or the following Quora discussion: How are bloom filters used in HBase?."},"15717":{"id":"/docs/single-page-5917","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#when-to-use-bloom-filters","content":"Since HBase 0.96, row-based Bloom filters are enabled by default. You may choose to disable them or to change some tables to use row+column Bloom filters, depending on the characteristics of your data and how it is loaded into HBase."},"15718":{"id":"/docs/single-page-5918","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#when-to-use-bloom-filters","content":"To determine whether Bloom filters could have a positive impact, check the value of `blockCacheHitRatio` in the RegionServer metrics. If Bloom filters are enabled, the value of `blockCacheHitRatio` should increase, because the Bloom filter is filtering out blocks that are definitely not needed."},"15719":{"id":"/docs/single-page-5919","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#when-to-use-bloom-filters","content":"You can choose to enable Bloom filters for a row or for a row+column combination. If you generally scan entire rows, the row+column combination will not provide any benefit. A row-based Bloom filter can operate on a row+column Get, but not the other way around. However, if you have a large number of column-level Puts, such that a row may be present in every StoreFile, a row-based filter will always return a positive result and provide no benefit. Unless you have one column per row, row+column Bloom filters require more space, in order to store more keys. Bloom filters work best when the size of each data entry is at least a few kilobytes in size."},"15720":{"id":"/docs/single-page-5920","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#when-to-use-bloom-filters","content":"Overhead will be reduced when your data is stored in a few larger StoreFiles, to avoid extra disk IO during low-level scans to find a specific row."},"15721":{"id":"/docs/single-page-5921","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#when-to-use-bloom-filters","content":"Bloom filters need to be rebuilt upon deletion, so may not be appropriate in environments with a large number of deletions."},"15722":{"id":"/docs/single-page-5922","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-bloom-filters","content":"Bloom filters are enabled on a Column Family. You can do this by using the setBloomFilterType method of HColumnDescriptor or using the HBase API. Valid values are `NONE`, `ROW` (default), or `ROWCOL`. See When To Use Bloom Filters for more information on `ROW` versus `ROWCOL`. See also the API documentation for ColumnFamilyDescriptorBuilder."},"15723":{"id":"/docs/single-page-5923","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-bloom-filters","content":"The following example creates a table and enables a ROWCOL Bloom filter on the `colfam1` column family."},"15724":{"id":"/docs/single-page-5924","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"You can configure the following settings in the *hbase-site.xml*."},"15725":{"id":"/docs/single-page-5925","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"Parameter"},"15726":{"id":"/docs/single-page-5926","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"Default"},"15727":{"id":"/docs/single-page-5927","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"Description"},"15728":{"id":"/docs/single-page-5928","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"io.storefile.bloom.enabled"},"15729":{"id":"/docs/single-page-5929","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"yes"},"15730":{"id":"/docs/single-page-5930","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"Set to no to kill bloom filters server-wide if something goes wrong"},"15731":{"id":"/docs/single-page-5931","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"io.storefile.bloom.error.rate"},"15732":{"id":"/docs/single-page-5932","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":".01"},"15733":{"id":"/docs/single-page-5933","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"The average false positive rate for bloom filters. Folding is used to maintain the false positive rate. Expressed as a decimal representation of a percentage."},"15734":{"id":"/docs/single-page-5934","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"io.storefile.bloom.max.fold"},"15735":{"id":"/docs/single-page-5935","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"7"},"15736":{"id":"/docs/single-page-5936","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"The guaranteed maximum fold rate. Changing this setting should not be necessary and is not recommended."},"15737":{"id":"/docs/single-page-5937","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"io.storefile.bloom.max.keys"},"15738":{"id":"/docs/single-page-5938","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"128000000"},"15739":{"id":"/docs/single-page-5939","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"For default (single-block) Bloom filters, this specifies the maximum number of keys."},"15740":{"id":"/docs/single-page-5940","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"io.storefile.delete.family.bloom.enabled"},"15741":{"id":"/docs/single-page-5941","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"true"},"15742":{"id":"/docs/single-page-5942","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"Master switch to enable Delete Family Bloom filters and store them in the StoreFile."},"15743":{"id":"/docs/single-page-5943","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"io.storefile.bloom.block.size"},"15744":{"id":"/docs/single-page-5944","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"131072"},"15745":{"id":"/docs/single-page-5945","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"Target Bloom block size. Bloom filter blocks of approximately this size are interleaved with data blocks."},"15746":{"id":"/docs/single-page-5946","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"hfile.block.bloom.cacheonwrite"},"15747":{"id":"/docs/single-page-5947","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"false"},"15748":{"id":"/docs/single-page-5948","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-server-wide-behavior-of-bloom-filters","content":"Enables cache-on-write for inline blocks of a compound Bloom filter."},"15749":{"id":"/docs/single-page-5949","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#columnfamily-blocksize","content":"The blocksize can be configured for each ColumnFamily in a table, and defaults to 64k. Larger cell values require larger blocksizes. There is an inverse relationship between blocksize and the resulting StoreFile indexes (i.e., if the blocksize is doubled then the resulting indexes should be roughly halved)."},"15750":{"id":"/docs/single-page-5950","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#columnfamily-blocksize","content":"See ColumnFamilyDescriptorBuilder and Store for more information."},"15751":{"id":"/docs/single-page-5951","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#in-memory-columnfamilies","content":"ColumnFamilies can optionally be defined as in-memory. Data is still persisted to disk, just like any other ColumnFamily. In-memory blocks have the highest priority in the Block Cache, but it is not a guarantee that the entire table will be in memory."},"15752":{"id":"/docs/single-page-5952","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#in-memory-columnfamilies","content":"See ColumnFamilyDescriptorBuilder for more information."},"15753":{"id":"/docs/single-page-5953","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-schema-design-compression","content":"Production systems should use compression with their ColumnFamily definitions. See Compression and Data Block Encoding In HBase for more information."},"15754":{"id":"/docs/single-page-5954","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#however","content":"Compression deflates data *on disk*. When it's in-memory (e.g., in the MemStore) or on the wire (e.g., transferring between RegionServer and Client) it's inflated. So while using ColumnFamily compression is a best practice, but it's not going to completely eliminate the impact of over-sized Keys, over-sized ColumnFamily names, or over-sized Column names."},"15755":{"id":"/docs/single-page-5955","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#however","content":"See Try to minimize row and column sizes on for schema design tips, and KeyValue for more information on HBase stores data internally."},"15756":{"id":"/docs/single-page-5956","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#constants","content":"When people get started with HBase they have a tendency to write code that looks like this:"},"15757":{"id":"/docs/single-page-5957","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#constants","content":"But especially when inside loops (and MapReduce jobs), converting the columnFamily and column-names to byte-arrays repeatedly is surprisingly expensive. It's better to use constants for the byte-arrays, like this:"},"15758":{"id":"/docs/single-page-5958","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#batch-loading","content":"Use the bulk load tool if you can. See Bulk Loading. Otherwise, pay attention to the below."},"15759":{"id":"/docs/single-page-5959","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-creation-pre-creating-regions","content":"Tables in HBase are initially created with one region by default. For bulk imports, this means that all clients will write to the same region until it is large enough to split and become distributed across the cluster. A useful pattern to speed up the bulk import process is to pre-create empty regions. Be somewhat conservative in this, because too-many regions can actually degrade performance."},"15760":{"id":"/docs/single-page-5960","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-creation-pre-creating-regions","content":"There are two different approaches to pre-creating splits using the HBase API. The first approach is to rely on the default `Admin` strategy (which is implemented in `Bytes.split`)..."},"15761":{"id":"/docs/single-page-5961","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-creation-pre-creating-regions","content":"And the other approach, using the HBase API, is to define the splits yourself..."},"15762":{"id":"/docs/single-page-5962","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-creation-pre-creating-regions","content":"You can achieve a similar effect using the HBase Shell to create tables by specifying split options."},"15763":{"id":"/docs/single-page-5963","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-creation-pre-creating-regions","content":"See Relationship Between RowKeys and Region Splits for issues related to understanding your keyspace and pre-creating regions. See manual region splitting decisions for discussion on manually pre-splitting regions. See Pre-splitting tables with the HBase Shell for more details of using the HBase Shell to pre-split tables."},"15764":{"id":"/docs/single-page-5964","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-creation-deferred-log-flush","content":"The default behavior for Puts using the Write Ahead Log (WAL) is that `WAL` edits will be written immediately. If deferred log flush is used, WAL edits are kept in memory until the flush period. The benefit is aggregated and asynchronous `WAL`- writes, but the potential downside is that if the RegionServer goes down the yet-to-be-flushed edits are lost. This is safer, however, than not using WAL at all with Puts."},"15765":{"id":"/docs/single-page-5965","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-creation-deferred-log-flush","content":"Deferred log flush can be configured on tables via TableDescriptorBuilder. The default value of `hbase.regionserver.optionallogflushinterval` is 1000ms."},"15766":{"id":"/docs/single-page-5966","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-client-turn-off-wal-on-puts","content":"A frequent request is to disable the WAL to increase performance of Puts. This is only appropriate for bulk loads, as it puts your data at risk by removing the protection of the WAL in the event of a region server crash. Bulk loads can be re-run in the event of a crash, with little risk of data loss."},"15767":{"id":"/docs/single-page-5967","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-client-turn-off-wal-on-puts","content":"If you disable the WAL for anything other than bulk loads, your data is at risk."},"15768":{"id":"/docs/single-page-5968","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-client-turn-off-wal-on-puts","content":"In general, it is best to use WAL for Puts, and where loading throughput is a concern to use bulk loading techniques instead. For normal Puts, you are not likely to see a performance improvement which would outweigh the risk. To disable the WAL, see Disabling the WAL."},"15769":{"id":"/docs/single-page-5969","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-client-group-puts-by-regionserver","content":"In addition to using the writeBuffer, grouping `Put`s by RegionServer can reduce the number of client RPC calls per writeBuffer flush. There is a utility `HTableUtil` currently on MASTER that does this, but you can either copy that or implement your own version for those still on 0.90.x or earlier."},"15770":{"id":"/docs/single-page-5970","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapreduce-skip-the-reducer","content":"When writing a lot of data to an HBase table from a MR job (e.g., with TableOutputFormat), and specifically where Puts are being emitted from the Mapper, skip the Reducer step. When a Reducer step is used, all of the output (Puts) from the Mapper will get spooled to disk, then sorted/shuffled to other Reducers that will most likely be off-node. It's far more efficient to just write directly to HBase."},"15771":{"id":"/docs/single-page-5971","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapreduce-skip-the-reducer","content":"For summary jobs where HBase is used as a source and a sink, then writes will be coming from the Reducer step (e.g., summarize values then write out result). This is a different processing problem than from the above case."},"15772":{"id":"/docs/single-page-5972","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#anti-pattern-one-hot-region","content":"If all your data is being written to one region at a time, then re-read the section on processing timeseries data."},"15773":{"id":"/docs/single-page-5973","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#anti-pattern-one-hot-region","content":"Also, if you are pre-splitting regions and all your data is *still* winding up in a single region even though your keys aren't monotonically increasing, confirm that your keyspace actually works with the split strategy. There are a variety of reasons that regions may appear \"well split\" but won't work with your data. As the HBase client communicates directly with the RegionServers, this can be obtained via RegionLocator.getRegionLocation."},"15774":{"id":"/docs/single-page-5974","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#anti-pattern-one-hot-region","content":"See Table Creation: Pre-Creating Regions, as well as HBase Configurations"},"15775":{"id":"/docs/single-page-5975","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reading-from-hbase","content":"The mailing list can help if you are having performance issues."},"15776":{"id":"/docs/single-page-5976","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#scan-caching","content":"If HBase is used as an input source for a MapReduce job, for example, make sure that the input Scan instance to the MapReduce job has `setCaching` set to something greater than the default (which is 1). Using the default value means that the map-task will make call back to the region-server for every record processed. Setting this value to 500, for example, will transfer 500 rows at a time to the client to be processed. There is a cost/benefit to have the cache value be large because it costs more in memory for both client and RegionServer, so bigger isn't always better."},"15777":{"id":"/docs/single-page-5977","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#scan-caching-in-mapreduce-jobs","content":"Scan settings in MapReduce jobs deserve special attention. Timeouts can result (e.g., UnknownScannerException) in Map tasks if it takes longer to process a batch of records before the client goes back to the RegionServer for the next set of data. This problem can occur because there is non-trivial processing occurring per row. If you process rows quickly, set caching higher. If you process rows more slowly (e.g., lots of transformations per row, writes), then set caching lower."},"15778":{"id":"/docs/single-page-5978","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#scan-caching-in-mapreduce-jobs","content":"Timeouts can also happen in a non-MapReduce use case (i.e., single threaded HBase client doing a Scan), but the processing that is often performed in MapReduce jobs tends to exacerbate this issue."},"15779":{"id":"/docs/single-page-5979","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#scan-attribute-selection","content":"Whenever a Scan is used to process large numbers of rows (and especially when used as a MapReduce source), be aware of which attributes are selected. If `scan.addFamily` is called then *all* of the attributes in the specified ColumnFamily will be returned to the client. If only a small number of the available attributes are to be processed, then only those attributes should be specified in the input scan because attribute over-selection is a non-trivial performance penalty over large datasets."},"15780":{"id":"/docs/single-page-5980","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#avoid-scan-seeks","content":"When columns are selected explicitly with `scan.addColumn`, HBase will schedule seek operations to seek between the selected columns. When rows have few columns and each column has only a few versions this can be inefficient. A seek operation is generally slower if does not seek at least past 5-10 columns/versions or 512-1024 bytes."},"15781":{"id":"/docs/single-page-5981","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#avoid-scan-seeks","content":"In order to opportunistically look ahead a few columns/versions to see if the next column/version can be found that way before a seek operation is scheduled, a new attribute `Scan.HINT_LOOKAHEAD` can be set on the Scan object. The following code instructs the RegionServer to attempt two iterations of next before a seek is scheduled:"},"15782":{"id":"/docs/single-page-5982","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mapreduce---input-splits","content":"For MapReduce jobs that use HBase tables as a source, if there a pattern where the \"slow\" map tasks seem to have the same Input Split (i.e., the RegionServer serving the data), see the Troubleshooting Case Study in Case Study #1 (Performance Issue On A Single Node)."},"15783":{"id":"/docs/single-page-5983","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#close-resultscanners","content":"This isn't so much about improving performance but rather *avoiding* performance problems. If you forget to close ResultScanners you can cause problems on the RegionServers. Always have ResultScanner processing enclosed in try/catch blocks."},"15784":{"id":"/docs/single-page-5984","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-reading-from-hbase-block-cache","content":"Scan instances can be set to use the block cache in the RegionServer via the `setCacheBlocks` method. For input Scans to MapReduce jobs, this should be `false`. For frequently accessed rows, it is advisable to use the block cache."},"15785":{"id":"/docs/single-page-5985","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-reading-from-hbase-block-cache","content":"Cache more data by moving your Block Cache off-heap. See Off-heap Block Cache"},"15786":{"id":"/docs/single-page-5986","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#optimal-loading-of-row-keys","content":"When performing a table scan where only the row keys are needed (no families, qualifiers, values or timestamps), add a FilterList with a `MUST_PASS_ALL` operator to the scanner using `setFilter`. The filter list should include both a FirstKeyOnlyFilter and a KeyOnlyFilter. Using this filter combination will result in a worst case scenario of a RegionServer reading a single value from disk and minimal network traffic to the client for a single row."},"15787":{"id":"/docs/single-page-5987","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#concurrency-monitor-data-spread","content":"When performing a high number of concurrent reads, monitor the data spread of the target tables. If the target table(s) have too few regions then the reads could likely be served from too few nodes."},"15788":{"id":"/docs/single-page-5988","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#concurrency-monitor-data-spread","content":"See Table Creation: Pre-Creating Regions, as well as HBase Configurations"},"15789":{"id":"/docs/single-page-5989","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters-1","content":"Enabling Bloom Filters can save your having to go to disk and can help improve read latencies."},"15790":{"id":"/docs/single-page-5990","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters-1","content":"Bloom filters were developed over in HBase-1200 Add bloomfilters. For description of the development process — why static blooms rather than dynamic — and for an overview of the unique properties that pertain to blooms in HBase, as well as possible future directions, see the *Development Process* section of the document BloomFilters in HBase attached to HBASE-1200. The bloom filters described here are actually version two of blooms in HBase. In versions up to 0.19.x, HBase had a dynamic bloom option based on work done by the European Commission One-Lab Project 034819. The core of the HBase bloom work was later pulled up into Hadoop to implement org.apache.hadoop.io.BloomMapFile. Version 1 of HBase blooms never worked that well. Version 2 is a rewrite from scratch though again it starts with the one-lab work."},"15791":{"id":"/docs/single-page-5991","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filters-1","content":"See also Bloom Filters."},"15792":{"id":"/docs/single-page-5992","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-storefile-footprint","content":"Bloom filters add an entry to the `StoreFile` general `FileInfo` data structure and then two extra entries to the `StoreFile` metadata section."},"15793":{"id":"/docs/single-page-5993","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-storefile-footprint","content":"**BloomFilter in the `StoreFile` `FileInfo` data structure**\\\n`FileInfo` has a `BLOOM_FILTER_TYPE` entry which is set to `NONE`, `ROW` or `ROWCOL.`"},"15794":{"id":"/docs/single-page-5994","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-storefile-footprint","content":"**BloomFilter entries in `StoreFile` metadata**\\\n`BLOOM_FILTER_META` holds Bloom Size, Hash Function used, etc. It's small in size and is cached on `StoreFile.Reader` load.\\\n`BLOOM_FILTER_DATA` is the actual bloomfilter data. Obtained on-demand. Stored in the LRU cache, if it is enabled (It's enabled by default)."},"15795":{"id":"/docs/single-page-5995","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filter-configuration","content":"**`io.storefile.bloom.enabled` global kill switch**\\\n`io.storefile.bloom.enabled` in `Configuration` serves as the kill switch in case something goes wrong. Default = `true`."},"15796":{"id":"/docs/single-page-5996","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filter-configuration","content":"`io.storefile.bloom.error.rate`\\\n`io.storefile.bloom.error.rate` = average false positive rate. Default = 1%. Decrease rate by ½ (e.g. to .5%) == +1 bit per bloom entry."},"15797":{"id":"/docs/single-page-5997","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bloom-filter-configuration","content":"`io.storefile.bloom.max.fold`\\\n`io.storefile.bloom.max.fold` = guaranteed minimum fold rate. Most people should leave this alone. Default = 7, or can collapse to at least 1/128th of original size. See the *Development Process* section of the document BloomFilters in HBase for more on what this option means."},"15798":{"id":"/docs/single-page-5998","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"Hedged reads are a feature of HDFS, introduced in Hadoop 2.4.0 with HDFS-5776. Normally, a single thread is spawned for each read request. However, if hedged reads are enabled, the client waits some configurable amount of time, and if the read does not return, the client spawns a second read request, against a different block replica of the same data. Whichever read returns first is used, and the other read request is discarded."},"15799":{"id":"/docs/single-page-5999","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"Hedged reads are \"...very good at eliminating outlier datanodes, which in turn makes them very good choice for latency sensitive setups. But, if you are looking for maximizing throughput, hedged reads tend to create load amplification as things get slower in general. In short, the thing to watch out for is the non-graceful performance degradation when you are running close a certain throughput threshold.\" (Quote from Ashu Pachauri in HBASE-17083)."},"15800":{"id":"/docs/single-page-6000","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"Other concerns to keep in mind while running with hedged reads enabled include:"},"15801":{"id":"/docs/single-page-6001","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"They may lead to network congestion. See HBASE-17083"},"15802":{"id":"/docs/single-page-6002","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"Make sure you set the thread pool large enough so as blocking on the pool does not become a bottleneck (Again see HBASE-17083)"},"15803":{"id":"/docs/single-page-6003","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"(From Yu Li up in HBASE-17083)"},"15804":{"id":"/docs/single-page-6004","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"Because an HBase RegionServer is a HDFS client, you can enable hedged reads in HBase, by adding the following properties to the RegionServer's hbase-site.xml and tuning the values to suit your environment."},"15805":{"id":"/docs/single-page-6005","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"**Configuration for Hedged Reads**"},"15806":{"id":"/docs/single-page-6006","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"`dfs.client.hedged.read.threadpool.size` - the number of threads dedicated to servicing hedged reads. If this is set to 0 (the default), hedged reads are disabled."},"15807":{"id":"/docs/single-page-6007","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"`dfs.client.hedged.read.threshold.millis` - the number of milliseconds to wait before spawning a second read thread."},"15808":{"id":"/docs/single-page-6008","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"**Hedged Reads Configuration Example**"},"15809":{"id":"/docs/single-page-6009","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"Use the following metrics to tune the settings for hedged reads on your cluster. See HBase Metrics for more information."},"15810":{"id":"/docs/single-page-6010","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"**Metrics for Hedged Reads**"},"15811":{"id":"/docs/single-page-6011","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"hedgedReadOps - the number of times hedged read threads have been triggered. This could indicate that read requests are often slow, or that hedged reads are triggered too quickly."},"15812":{"id":"/docs/single-page-6012","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"hedgeReadOpsWin - the number of times the hedged read thread was faster than the original thread. This could indicate that a given RegionServer is having trouble servicing requests."},"15813":{"id":"/docs/single-page-6013","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hedged-reads","content":"hedgedReadOpsInCurThread - the number of times hedged read was rejected from executor and needed to fallback to be executed in current thread. This could indicate that current hedged read thread pool size is not appropriate."},"15814":{"id":"/docs/single-page-6014","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-hbase-tables-as-queues","content":"HBase tables are sometimes used as queues. In this case, special care must be taken to regularly perform major compactions on tables used in this manner. As is documented in Data Model, marking rows as deleted creates additional StoreFiles which then need to be processed on reads. Tombstones only get cleaned up with major compactions."},"15815":{"id":"/docs/single-page-6015","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-hbase-tables-as-queues","content":"See also Compaction and Admin.majorCompact."},"15816":{"id":"/docs/single-page-6016","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#delete-rpc-behavior","content":"Be aware that `Table.delete(Delete)` doesn't use the writeBuffer. It will execute an RegionServer RPC with each invocation. For a large number of deletes, consider `Table.delete(List)`."},"15817":{"id":"/docs/single-page-6017","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#delete-rpc-behavior","content":"See hbase.client.Delete"},"15818":{"id":"/docs/single-page-6018","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-hdfs","content":"Because HBase runs on HDFS it is important to understand how it works and how it affects HBase."},"15819":{"id":"/docs/single-page-6019","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#current-issues-with-low-latency-reads","content":"The original use-case for HDFS was batch processing. As such, there low-latency reads were historically not a priority. With the increased adoption of Apache HBase this is changing, and several improvements are already in development. See the Umbrella Jira Ticket for HDFS Improvements for HBase."},"15820":{"id":"/docs/single-page-6020","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#leveraging-local-data","content":"Since Hadoop 1.0.0 (also 0.22.1, 0.23.1, CDH3u3 and HDP 1.0) via HDFS-2246, it is possible for the DFSClient to take a \"short circuit\" and read directly from the disk instead of going through the DataNode when the data is local. What this means for HBase is that the RegionServers can read directly off their machine's disks instead of having to open a socket to talk to the DataNode, the former being generally much faster. See JD's Performance Talk. Also see HBase, mail # dev - read short circuit thread for more discussion around short circuit reads."},"15821":{"id":"/docs/single-page-6021","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#leveraging-local-data","content":"To enable \"short circuit\" reads, it will depend on your version of Hadoop. The original shortcircuit read patch was much improved upon in Hadoop 2 in HDFS-347. See http\\://blog.cloudera.com/blog/2013/08/how-improved-short-circuit-local-reads-bring-better-performance-and-security-to-hadoop/ for details on the difference between the old and new implementations. See Hadoop shortcircuit reads configuration page for how to enable the latter, better version of shortcircuit. For example, here is a minimal config. enabling short-circuit reads added to *hbase-site.xml*:"},"15822":{"id":"/docs/single-page-6022","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#leveraging-local-data","content":"Be careful about permissions for the directory that hosts the shared domain socket; dfsclient will complain if open to other than the hbase user."},"15823":{"id":"/docs/single-page-6023","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#leveraging-local-data","content":"If you are running on an old Hadoop, one that is without HDFS-347 but that has HDFS-2246, you must set two configurations. First, the hdfs-site.xml needs to be amended. Set the property `dfs.block.local-path-access.user` to be the *only* user that can use the shortcut. This has to be the user that started HBase. Then in hbase-site.xml, set `dfs.client.read.shortcircuit` to be `true`"},"15824":{"id":"/docs/single-page-6024","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#leveraging-local-data","content":"Services — at least the HBase RegionServers — will need to be restarted in order to pick up the new configurations."},"15825":{"id":"/docs/single-page-6025","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#leveraging-local-data","content":"The default for this value is too high when running on a highly trafficked HBase. In HBase, if\nthis value has not been set, we set it down from the default of 1M to 128k (Since HBase 0.98.0 and\n0.96.1). See HBASE-8143 HBase on Hadoop 2 with local short circuit reads (ssr) causes\nOOM. The Hadoop DFSClient in HBase will\nallocate a direct byte buffer of this size for *each* block it has open; given HBase keeps its\nHDFS files open all the time, this can add up quickly."},"15826":{"id":"/docs/single-page-6026","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-comparisons-of-hbase-vs-hdfs","content":"A fairly common question on the dist-list is why HBase isn't as performant as HDFS files in a batch context (e.g., as a MapReduce source or sink). The short answer is that HBase is doing a lot more than HDFS (e.g., reading the KeyValues, returning the most current row or specified timestamps, etc.), and as such HBase is 4-5 times slower than HDFS in this processing context. There is room for improvement and this gap will, over time, be reduced, but HDFS will always be faster in this use-case."},"15827":{"id":"/docs/single-page-6027","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-amazon-ec2","content":"Performance questions are common on Amazon EC2 environments because it is a shared environment. You will not see the same throughput as a dedicated server. In terms of running tests on EC2, run them several times for the same reason (i.e., it's a shared environment and you don't know what else is happening on the server)."},"15828":{"id":"/docs/single-page-6028","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-amazon-ec2","content":"If you are running on EC2 and post performance questions on the dist-list, please state this fact up-front that because EC2 issues are practically a separate class of performance issues."},"15829":{"id":"/docs/single-page-6029","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#collocating-hbase-and-mapreduce","content":"It is often recommended to have different clusters for HBase and MapReduce. A better qualification of this is: don't collocate an HBase that serves live requests with a heavy MR workload. OLTP and OLAP-optimized systems have conflicting requirements and one will lose to the other, usually the former. For example, short latency-sensitive disk reads will have to wait in line behind longer reads that are trying to squeeze out as much throughput as possible. MR jobs that write to HBase will also generate flushes and compactions, which will in turn invalidate blocks in the Block Cache."},"15830":{"id":"/docs/single-page-6030","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#collocating-hbase-and-mapreduce","content":"If you need to process the data from your live HBase cluster in MR, you can ship the deltas with CopyTable or use replication to get the new data in real time on the OLAP cluster. In the worst case, if you really need to collocate both, set MR to use less Map and Reduce slots than you'd normally configure, possibly just one."},"15831":{"id":"/docs/single-page-6031","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#collocating-hbase-and-mapreduce","content":"When HBase is used for OLAP operations, it's preferable to set it up in a hardened way like configuring the ZooKeeper session timeout higher and giving more memory to the MemStores (the argument being that the Block Cache won't be used much since the workloads are usually long scans)."},"15832":{"id":"/docs/single-page-6032","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-case-studies","content":"For Performance and Troubleshooting Case Studies, see Apache HBase Case Studies."},"15833":{"id":"/docs/single-page-6033","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-background","content":"HBASE-21926 introduced a new servlet that\nsupports integrated, on-demand profiling via the\nAsync Profiler project."},"15834":{"id":"/docs/single-page-6034","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-prerequisites","content":"Go to the Async Profiler Home Page, download\na release appropriate for your platform, and install on every cluster host. If running a Linux\nkernel v4.6 or later, be sure to set proc variables as per the\nBasic Usage section. Not doing\nso will result in flame graphs that contain no content."},"15835":{"id":"/docs/single-page-6035","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-prerequisites","content":"Set `ASYNC_PROFILER_HOME` in the environment (put it in hbase-env.sh) to the root directory of the\nasync-profiler install location, or pass it on the HBase daemon's command line as a system property\nas `-Dasync.profiler.home=/path/to/async-profiler`."},"15836":{"id":"/docs/single-page-6036","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"Once the prerequisites are satisfied, access to async-profiler is available by way of the HBase UI\nor direct interaction with the infoserver."},"15837":{"id":"/docs/single-page-6037","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"Examples:"},"15838":{"id":"/docs/single-page-6038","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"To collect 30 second CPU profile of current process (returns FlameGraph svg)\n`curl http://localhost:16030/prof`"},"15839":{"id":"/docs/single-page-6039","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"To collect 1 minute CPU profile of current process and output in tree format (html)\n`curl http://localhost:16030/prof?output=tree&duration=60`"},"15840":{"id":"/docs/single-page-6040","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"To collect 30 second heap allocation profile of current process (returns FlameGraph svg)\n`curl http://localhost:16030/prof?event=alloc`"},"15841":{"id":"/docs/single-page-6041","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"To collect lock contention profile of current process (returns FlameGraph svg)\n`curl http://localhost:16030/prof?event=lock`"},"15842":{"id":"/docs/single-page-6042","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"The following event types are supported by async-profiler. Use the 'event' parameter to specify. Default is 'cpu'. Not all operating systems will support all types."},"15843":{"id":"/docs/single-page-6043","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"Perf events:"},"15844":{"id":"/docs/single-page-6044","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"cpu"},"15845":{"id":"/docs/single-page-6045","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"page-faults"},"15846":{"id":"/docs/single-page-6046","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"context-switches"},"15847":{"id":"/docs/single-page-6047","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"cycles"},"15848":{"id":"/docs/single-page-6048","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"instructions"},"15849":{"id":"/docs/single-page-6049","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"cache-references"},"15850":{"id":"/docs/single-page-6050","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"cache-misses"},"15851":{"id":"/docs/single-page-6051","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"branches"},"15852":{"id":"/docs/single-page-6052","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"branch-misses"},"15853":{"id":"/docs/single-page-6053","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"bus-cycles"},"15854":{"id":"/docs/single-page-6054","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"L1-dcache-load-misses"},"15855":{"id":"/docs/single-page-6055","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"LLC-load-misses"},"15856":{"id":"/docs/single-page-6056","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"dTLB-load-misses"},"15857":{"id":"/docs/single-page-6057","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"Java events:"},"15858":{"id":"/docs/single-page-6058","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"alloc"},"15859":{"id":"/docs/single-page-6059","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"lock"},"15860":{"id":"/docs/single-page-6060","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"The following output formats are supported. Use the 'output' parameter to specify. Default is 'flamegraph'."},"15861":{"id":"/docs/single-page-6061","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"Output formats:"},"15862":{"id":"/docs/single-page-6062","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"summary: A dump of basic profiling statistics."},"15863":{"id":"/docs/single-page-6063","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"traces: Call traces."},"15864":{"id":"/docs/single-page-6064","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"flat: Flat profile (top N hot methods)."},"15865":{"id":"/docs/single-page-6065","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"collapsed: Collapsed call traces in the format used by FlameGraph script. This is a collection of call stacks, where each line is a semicolon separated list of frames followed by a counter."},"15866":{"id":"/docs/single-page-6066","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"svg: FlameGraph in SVG format."},"15867":{"id":"/docs/single-page-6067","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"tree: Call tree in HTML format."},"15868":{"id":"/docs/single-page-6068","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"jfr: Call traces in Java Flight Recorder format."},"15869":{"id":"/docs/single-page-6069","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-usage","content":"The 'duration' parameter specifies how long to collect trace data before generating output, specified in seconds. The default is 10 seconds."},"15870":{"id":"/docs/single-page-6070","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-ui","content":"In the UI, there is a new entry 'Profiler' in the top menu that will run the default action, which is to profile the CPU usage of the local process for thirty seconds and then produce FlameGraph SVG output."},"15871":{"id":"/docs/single-page-6071","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#profiler-notes","content":"The query parameter `pid` can be used to specify the process id of a specific process to be profiled. If this parameter is missing the local process in which the infoserver is embedded will be profiled. Profile targets that are not JVMs might work but is not specifically supported. There are security implications. Access to the infoserver should be appropriately restricted."},"15872":{"id":"/docs/single-page-6072","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-guidelines","content":"Always start with the master log (TODO: Which lines?). Normally it's just printing the same lines over and over again. If not, then there's an issue. Google should return some hits for those exceptions you're seeing."},"15873":{"id":"/docs/single-page-6073","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-guidelines","content":"An error rarely comes alone in Apache HBase, usually when something gets screwed up what will follow may be hundreds of exceptions and stack traces coming from all over the place. The best way to approach this type of problem is to walk the log up to where it all began, for example one trick with RegionServers is that they will print some metrics when aborting so grepping for *Dump* should get you around the start of the problem."},"15874":{"id":"/docs/single-page-6074","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-guidelines","content":"RegionServer suicides are 'normal', as this is what they do when something goes wrong. For example, if ulimit and max transfer threads (the two most important initial settings, see \\[ulimit] and `dfs.datanode.max.transfer.threads`) aren't changed, it will make it impossible at some point for DataNodes to create new threads that from the HBase point of view is seen as if HDFS was gone. Think about what would happen if your MySQL database was suddenly unable to access files on your local file system, well it's the same with HBase and HDFS. Another very common reason to see RegionServers committing seppuku is when they enter prolonged garbage collection pauses that last longer than the default ZooKeeper session timeout. For more information on GC pauses, see the 3 part blog post by Todd Lipcon and Long GC pauses above."},"15875":{"id":"/docs/single-page-6075","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"The key process logs are as follows... (replace `<user>` with the user that started the service, and `<hostname>` for the machine name)"},"15876":{"id":"/docs/single-page-6076","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"NameNode: *\\$HADOOP\\_HOME/logs/hadoop-\\<user>-namenode-\\<hostname>.log*"},"15877":{"id":"/docs/single-page-6077","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"DataNode: *\\$HADOOP\\_HOME/logs/hadoop-\\<user>-datanode-\\<hostname>.log*"},"15878":{"id":"/docs/single-page-6078","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"JobTracker: *\\$HADOOP\\_HOME/logs/hadoop-\\<user>-jobtracker-\\<hostname>.log*"},"15879":{"id":"/docs/single-page-6079","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"TaskTracker: *\\$HADOOP\\_HOME/logs/hadoop-\\<user>-tasktracker-\\<hostname>.log*"},"15880":{"id":"/docs/single-page-6080","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"HMaster: *\\$HBASE\\_HOME/logs/hbase-\\<user>-master-\\<hostname>.log*"},"15881":{"id":"/docs/single-page-6081","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"RegionServer: *\\$HBASE\\_HOME/logs/hbase-\\<user>-regionserver-\\<hostname>.log*"},"15882":{"id":"/docs/single-page-6082","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs","content":"ZooKeeper: *TODO*"},"15883":{"id":"/docs/single-page-6083","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#log-locations","content":"For stand-alone deployments the logs are obviously going to be on a single machine, however this is a development configuration only. Production deployments need to run on a cluster."},"15884":{"id":"/docs/single-page-6084","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-logs-namenode","content":"The NameNode log is on the NameNode server. The HBase Master is typically run on the NameNode server, and well as ZooKeeper."},"15885":{"id":"/docs/single-page-6085","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-logs-namenode","content":"For smaller clusters the JobTracker/ResourceManager is typically run on the NameNode server as well."},"15886":{"id":"/docs/single-page-6086","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-log-locations-datanode","content":"Each DataNode server will have a DataNode log for HDFS, as well as a RegionServer log for HBase."},"15887":{"id":"/docs/single-page-6087","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-log-locations-datanode","content":"Additionally, each DataNode server will also have a TaskTracker/NodeManager log for MapReduce task execution."},"15888":{"id":"/docs/single-page-6088","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-rpc-level-logging","content":"Enabling the RPC-level logging on a RegionServer can often give insight on timings at the server. Once enabled, the amount of log spewed is voluminous. It is not recommended that you leave this logging on for more than short bursts of time. To enable RPC-level logging, browse to the RegionServer UI and click on *Log Level*. Set the log level to `TRACE` for the package `org.apache.hadoop.hbase.ipc`, then tail the RegionServers log. Analyze."},"15889":{"id":"/docs/single-page-6089","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-rpc-level-logging","content":"To disable, set the logging level back to `INFO` level."},"15890":{"id":"/docs/single-page-6090","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-rpc-level-logging","content":"The same log settings also work on Master and for the client."},"15891":{"id":"/docs/single-page-6091","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#handling-multiple-slf4j-bindings-to-prevent-overridden-log-configurations","content":"If you have a local installation of Hadoop (e.g., installed via Homebrew on macOS), you may encounter a \"multiple SLF4J bindings\" warning when starting HBase in standalone mode using `bin/start-hbase.sh`. For example, you may see the following when starting HBase on your machine:"},"15892":{"id":"/docs/single-page-6092","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#handling-multiple-slf4j-bindings-to-prevent-overridden-log-configurations","content":"This is happening because the `bin/hbase` script automatically detects local Hadoop installations and adds their classpath to HBase. If your Hadoop installation uses the legacy Reload4j (or Log4j 1.2) binder, SLF4J may prioritize it over the HBase Log4j2 binder. When this happens, your `conf/log4j2.properties` file and `HBASE_ROOT_LOGGER` environment variable are completely ignored."},"15893":{"id":"/docs/single-page-6093","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#handling-multiple-slf4j-bindings-to-prevent-overridden-log-configurations","content":"To get around this issue, you can set `HBASE_DISABLE_HADOOP_CLASSPATH_LOOKUP` to `true`. You can modify this directly in `conf/hbase-env.sh` by uncommenting the following line:"},"15894":{"id":"/docs/single-page-6094","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#handling-multiple-slf4j-bindings-to-prevent-overridden-log-configurations","content":"Note: Setting `HBASE_DISABLE_HADOOP_CLASSPATH_LOOKUP` does not fix the issue when HBase is in distributed mode. There may be a different warning instead."},"15895":{"id":"/docs/single-page-6095","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"All example Garbage Collection logs in this section are based on Java 8 output. The introduction\nof Unified Logging in Java 9 and newer will result in very different looking logs."},"15896":{"id":"/docs/single-page-6096","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"HBase is memory intensive, and using the default GC you can see long pauses in all threads including the *Juliet Pause* aka \"GC of Death\". To help debug this or confirm this is happening GC logging can be turned on in the Java virtual machine."},"15897":{"id":"/docs/single-page-6097","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"To enable, in *hbase-env.sh*, uncomment one of the below lines :"},"15898":{"id":"/docs/single-page-6098","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"At this point you should see logs like so:"},"15899":{"id":"/docs/single-page-6099","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"In this section, the first line indicates a 0.0007360 second pause for the CMS to initially mark. This pauses the entire VM, all threads for that period of time."},"15900":{"id":"/docs/single-page-6100","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"The third line indicates a \"minor GC\", which pauses the VM for 0.0101110 seconds - aka 10 milliseconds. It has reduced the \"ParNew\" from about 5.5m to 576k. Later on in this cycle we see:"},"15901":{"id":"/docs/single-page-6101","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"The first line indicates that the CMS concurrent mark (finding garbage) has taken 2.4 seconds. But this is a *concurrent* 2.4 seconds, Java has not been paused at any point in time."},"15902":{"id":"/docs/single-page-6102","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"There are a few more minor GCs, then there is a pause at the 2nd last line:"},"15903":{"id":"/docs/single-page-6103","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"The pause here is 0.0049380 seconds (aka 4.9 milliseconds) to 'remark' the heap."},"15904":{"id":"/docs/single-page-6104","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"At this point the sweep starts, and you can watch the heap size go down:"},"15905":{"id":"/docs/single-page-6105","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"At this point, the CMS sweep took 3.332 seconds, and heap went from about \\~ 2.8 GB to 1.3 GB (approximate)."},"15906":{"id":"/docs/single-page-6106","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"The key points here is to keep all these pauses low. CMS pauses are always low, but if your ParNew starts growing, you can see minor GC pauses approach 100ms, exceed 100ms and hit as high at 400ms."},"15907":{"id":"/docs/single-page-6107","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"This can be due to the size of the ParNew, which should be relatively small. If your ParNew is very large after running HBase for a while, in one example a ParNew was about 150MB, then you might have to constrain the size of ParNew (The larger it is, the longer the collections take but if it's too small, objects are promoted to old gen too quickly). In the below we constrain new gen size to 64m."},"15908":{"id":"/docs/single-page-6108","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"Add the below line in *hbase-env.sh*:"},"15909":{"id":"/docs/single-page-6109","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"Similarly, to enable GC logging for client processes, uncomment one of the below lines in *hbase-env.sh*:"},"15910":{"id":"/docs/single-page-6110","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-garbage-collection-logs","content":"For more information on GC pauses, see the 3 part blog post by Todd Lipcon and Long GC pauses above."},"15911":{"id":"/docs/single-page-6111","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-resources-mailing-lists","content":"Ask a question on the Apache HBase mailing lists. The 'dev' mailing list is aimed at the community of developers actually building Apache HBase and for features currently under development, and 'user' is generally used for questions on released versions of Apache HBase. Before going to the mailing list, make sure your question has not already been answered by searching the mailing list archives first. For those who prefer to communicate in Chinese, they can use the 'user-zh' mailing list instead of the 'user' list. Take some time crafting your question. See Getting Answers for ideas on crafting good questions. A quality question that includes all context and exhibits evidence the author has tried to find answers in the manual and out on lists is more likely to get a prompt response."},"15912":{"id":"/docs/single-page-6112","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-resources-slack","content":"\\#hbase on https\\://the-asf.slack.com/"},"15913":{"id":"/docs/single-page-6113","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#irc","content":"(You will probably get a more prompt response on the Slack channel)"},"15914":{"id":"/docs/single-page-6114","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#irc","content":"\\#hbase on irc.freenode.net"},"15915":{"id":"/docs/single-page-6115","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-resources-jira","content":"JIRA is also really helpful when looking for Hadoop/HBase-specific issues."},"15916":{"id":"/docs/single-page-6116","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-web-interface","content":"The Master starts a web-interface on port 16010 by default."},"15917":{"id":"/docs/single-page-6117","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-web-interface","content":"The Master web UI lists created tables and their definition (e.g., ColumnFamilies, blocksize, etc.). Additionally, the available RegionServers in the cluster are listed along with selected high-level metrics (requests, number of regions, usedHeap, maxHeap). The Master web UI allows navigation to each RegionServer's web UI."},"15918":{"id":"/docs/single-page-6118","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-web-interface","content":"RegionServers starts a web-interface on port 16030 by default."},"15919":{"id":"/docs/single-page-6119","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-web-interface","content":"The RegionServer web UI lists online regions and their start/end keys, as well as point-in-time RegionServer metrics (requests, regions, storeFileIndexSize, compactionQueueSize, etc.)."},"15920":{"id":"/docs/single-page-6120","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-web-interface","content":"See HBase Metrics for more information in metric definitions."},"15921":{"id":"/docs/single-page-6121","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zkcli","content":"`zkcli` is a very useful tool for investigating ZooKeeper-related issues. To invoke:"},"15922":{"id":"/docs/single-page-6122","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zkcli","content":"The commands (and arguments) are:"},"15923":{"id":"/docs/single-page-6123","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maintenance-mode","content":"If the cluster has gotten stuck in some state and the standard techniques aren't making progress, it is possible to restart the cluster in \"maintenance mode.\" This mode features drastically reduced capabilities and surface area, making it easier to enact very low-level changes such as repairing/recovering the `hbase:meta` table."},"15924":{"id":"/docs/single-page-6124","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maintenance-mode","content":"To enter maintenance mode, set `hbase.master.maintenance_mode` to `true` either in your `hbase-site.xml` or via system propery when starting the master process (`-D...=true`). Entering and exiting this mode requires a service restart, however the typical use will be when HBase Master is already facing startup difficulties."},"15925":{"id":"/docs/single-page-6125","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maintenance-mode","content":"When maintenance mode is enabled, the master will host all system tables - ensure that it has enough memory to do so. RegionServers will not be assigned any regions from user-space tables; in fact, they will go completely unused while in maintenance mode. Additionally, the master will not load any coprocessors, will not run any normalization or merge/split operations, and will not enforce quotas."},"15926":{"id":"/docs/single-page-6126","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tail","content":"`tail` is the command line tool that lets you look at the end of a file. Add the `-f` option and it will refresh when new data is available. It's useful when you are wondering what's happening, for example, when a cluster is taking a long time to shutdown or startup as you can just fire a new terminal and tail the master log (and maybe a few RegionServers)."},"15927":{"id":"/docs/single-page-6127","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#top","content":"`top` is probably one of the most important tools when first trying to see what's running on a machine and how the resources are consumed. Here's an example from production system:"},"15928":{"id":"/docs/single-page-6128","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#top","content":"Here we can see that the system load average during the last five minutes is 3.75, which very roughly means that on average 3.75 threads were waiting for CPU time during these 5 minutes. In general, the *perfect* utilization equals to the number of cores, under that number the machine is under utilized and over that the machine is over utilized. This is an important concept, see this article to understand it more: http\\://www\\.linuxjournal.com/article/9001."},"15929":{"id":"/docs/single-page-6129","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#top","content":"Apart from load, we can see that the system is using almost all its available RAM but most of it is used for the OS cache (which is good). The swap only has a few KBs in it and this is wanted, high numbers would indicate swapping activity which is the nemesis of performance of Java systems. Another way to detect swapping is when the load average goes through the roof (although this could also be caused by things like a dying disk, among others)."},"15930":{"id":"/docs/single-page-6130","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#top","content":"The list of processes isn't super useful by default, all we know is that 3 java processes are using about 111% of the CPUs. To know which is which, simply type `c` and each line will be expanded. Typing `1` will give you the detail of how each CPU is used instead of the average for all of them like shown here."},"15931":{"id":"/docs/single-page-6131","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"`jps` is shipped with every JDK and gives the java process ids for the current user (if root, then it gives the ids for all users). Example:"},"15932":{"id":"/docs/single-page-6132","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"In order, we see a:"},"15933":{"id":"/docs/single-page-6133","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"Hadoop TaskTracker, manages the local Childs"},"15934":{"id":"/docs/single-page-6134","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"HBase RegionServer, serves regions"},"15935":{"id":"/docs/single-page-6135","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"Child, its MapReduce task, cannot tell which type exactly"},"15936":{"id":"/docs/single-page-6136","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"Hadoop TaskTracker, manages the local Childs"},"15937":{"id":"/docs/single-page-6137","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"Hadoop DataNode, serves blocks"},"15938":{"id":"/docs/single-page-6138","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"HQuorumPeer, a ZooKeeper ensemble member"},"15939":{"id":"/docs/single-page-6139","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"Jps, well... it's the current process"},"15940":{"id":"/docs/single-page-6140","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"ThriftServer, it's a special one will be running only if thrift was started"},"15941":{"id":"/docs/single-page-6141","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"jmx, this is a local process that's part of our monitoring platform ( poorly named maybe). You probably don't have that."},"15942":{"id":"/docs/single-page-6142","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jps","content":"You can then do stuff like checking out the full command line that started the process:"},"15943":{"id":"/docs/single-page-6143","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jstack","content":"`jstack` is one of the most important tools when trying to figure out what a java process is doing apart from looking at the logs. It has to be used in conjunction with jps in order to give it a process id. It shows a list of threads, each one has a name, and they appear in the order that they were created (so the top ones are the most recent threads). Here are a few example:"},"15944":{"id":"/docs/single-page-6144","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jstack","content":"The main thread of a RegionServer waiting for something to do from the master:"},"15945":{"id":"/docs/single-page-6145","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jstack","content":"The MemStore flusher thread that is currently flushing to a file:"},"15946":{"id":"/docs/single-page-6146","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jstack","content":"A handler thread that's waiting for stuff to do (like put, delete, scan, etc.):"},"15947":{"id":"/docs/single-page-6147","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jstack","content":"And one that's busy doing an increment of a counter (it's in the phase where it's trying to create a scanner in order to read the last value):"},"15948":{"id":"/docs/single-page-6148","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jstack","content":"A thread that receives data from HDFS:"},"15949":{"id":"/docs/single-page-6149","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jstack","content":"And here is a master trying to recover a lease after a RegionServer died:"},"15950":{"id":"/docs/single-page-6150","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#opentsdb","content":"OpenTSDB is an excellent alternative to Ganglia as it uses Apache HBase to store all the time series and doesn't have to downsample. Monitoring your own HBase cluster that hosts OpenTSDB is a good exercise."},"15951":{"id":"/docs/single-page-6151","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#opentsdb","content":"Here's an example of a cluster that's suffering from hundreds of compactions launched almost all around the same time, which severely affects the IO performance: (TODO: insert graph plotting compactionQueueSize)"},"15952":{"id":"/docs/single-page-6152","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#opentsdb","content":"It's a good practice to build dashboards with all the important graphs per machine and per cluster so that debugging issues can be done with a single quick look. For example, at StumbleUpon there's one dashboard per cluster with the most important metrics from both the OS and Apache HBase. You can then go down at the machine level and get even more detailed metrics."},"15953":{"id":"/docs/single-page-6153","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#clustersshtop","content":"clusterssh+top, it's like a poor man's monitoring system and it can be quite useful when you have only a few machines as it's very easy to setup. Starting clusterssh will give you one terminal per machine and another terminal in which whatever you type will be retyped in every window. This means that you can type `top` once and it will start it for all of your machines at the same time giving you full view of the current state of your cluster. You can also tail all the logs at the same time, edit files, etc."},"15954":{"id":"/docs/single-page-6154","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-client","content":"For more information on the HBase client, see client."},"15955":{"id":"/docs/single-page-6155","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#scannertimeoutexception-or-unknownscannerexception-toc","content":"This is thrown if the time between RPC calls from the client to RegionServer exceeds the scan timeout. For example, if `Scan.setCaching` is set to 500, then there will be an RPC call to fetch the next batch of rows every 500 `.next()` calls on the ResultScanner because data is being transferred in blocks of 500 rows to the client. Reducing the setCaching value may be an option, but setting this value too low makes for inefficient processing on numbers of rows."},"15956":{"id":"/docs/single-page-6156","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#scannertimeoutexception-or-unknownscannerexception-toc","content":"See Scan Caching."},"15957":{"id":"/docs/single-page-6157","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-differences-in-thrift-and-java-apis-toc","content":"Poor performance, or even `ScannerTimeoutExceptions`, can occur if `Scan.setCaching` is too high, as discussed in ScannerTimeoutException or UnknownScannerException. If the Thrift client uses the wrong caching settings for a given workload, performance can suffer compared to the Java API. To set caching for a given scan in the Thrift client, use the `scannerGetList(scannerId, numRows)` method, where `numRows` is an integer representing the number of rows to cache. In one case, it was found that reducing the cache for Thrift scans from 1000 to 100 increased performance to near parity with the Java API given the same queries."},"15958":{"id":"/docs/single-page-6158","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#performance-differences-in-thrift-and-java-apis-toc","content":"See also Jesse Andersen's blog post about using Scans with Thrift."},"15959":{"id":"/docs/single-page-6159","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#leaseexception-when-calling-scannernext-toc","content":"In some situations clients that fetch data from a RegionServer get a LeaseException instead of the usual ScannerTimeoutException or UnknownScannerException. Usually the source of the exception is `org.apache.hadoop.hbase.regionserver.Leases.removeLease(Leases.java:230)` (line number may vary). It tends to happen in the context of a slow/freezing `RegionServer#next` call. It can be prevented by having `hbase.rpc.timeout` > `hbase.client.scanner.timeout.period`. Harsh J investigated the issue as part of the mailing list thread HBase, mail # user - Lease does not exist exceptions"},"15960":{"id":"/docs/single-page-6160","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#shell-or-client-application-throws-lots-of-scary-exceptions-during-normal-operation-toc","content":"Since 0.20.0 the default log level for `org.apache.hadoop.hbase.*` is DEBUG."},"15961":{"id":"/docs/single-page-6161","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#shell-or-client-application-throws-lots-of-scary-exceptions-during-normal-operation-toc","content":"On your clients, edit *\\$HBASE\\_HOME/conf/log4j.properties* and change this: `log4j.logger.org.apache.hadoop.hbase=DEBUG` to this: `log4j.logger.org.apache.hadoop.hbase=INFO`, or even `log4j.logger.org.apache.hadoop.hbase=WARN`."},"15962":{"id":"/docs/single-page-6162","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-client-pauses-with-compression-toc","content":"This is a fairly frequent question on the Apache HBase dist-list. The scenario is that a client is typically inserting a lot of data into a relatively un-optimized HBase cluster. Compression can exacerbate the pauses, although it is not the source of the problem."},"15963":{"id":"/docs/single-page-6163","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-client-pauses-with-compression-toc","content":"See Table Creation: Pre-Creating Regions on the pattern for pre-creating regions and confirm that the table isn't starting with a single region."},"15964":{"id":"/docs/single-page-6164","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-client-pauses-with-compression-toc","content":"See HBase Configurations for cluster configuration, particularly `hbase.hstore.blockingStoreFiles`, `hbase.hregion.memstore.block.multiplier`, `MAX_FILESIZE` (region size), and `MEMSTORE_FLUSHSIZE.`"},"15965":{"id":"/docs/single-page-6165","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-client-pauses-with-compression-toc","content":"A slightly longer explanation of why pauses can happen is as follows: Puts are sometimes blocked on the MemStores which are blocked by the flusher thread which is blocked because there are too many files to compact because the compactor is given too many small files to compact and has to compact the same data repeatedly. This situation can occur even with minor compactions. Compounding this situation, Apache HBase doesn't compress data in memory. Thus, the 64MB that lives in the MemStore could become a 6MB file after compression - which results in a smaller StoreFile. The upside is that more data is packed into the same region, but performance is achieved by being able to write larger files - which is why HBase waits until the flushsize before writing a new StoreFile. And smaller StoreFiles become targets for compaction. Without compression the files are much bigger and don't need as much compaction, however this is at the expense of I/O."},"15966":{"id":"/docs/single-page-6166","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-connect-caused-by-gssexception-no-valid-credentials-provided-toc","content":"You may encounter the following error:"},"15967":{"id":"/docs/single-page-6167","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-connect-caused-by-gssexception-no-valid-credentials-provided-toc","content":"This issue is caused by bugs in the MIT Kerberos replay\\_cache component, #1201 and #5924. These bugs caused the old version of krb5-server to erroneously block subsequent requests sent from a Principal. This caused krb5-server to block the connections sent from one Client (one HTable instance with multi-threading connection instances for each RegionServer); Messages, such as `Request is a replay (34)`, are logged in the client log You can ignore the messages, because HTable will retry 5 \\* 10 (50) times for each failed connection by default. HTable will throw IOException if any connection to the RegionServer fails after the retries, so that the user client code for HTable instance can handle it further. NOTE: `HTable` is deprecated in HBase 1.0, in favor of `Table`."},"15968":{"id":"/docs/single-page-6168","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-connect-caused-by-gssexception-no-valid-credentials-provided-toc","content":"Alternatively, update krb5-server to a version which solves these issues, such as krb5-server-1.10.3. See JIRA HBASE-10379 for more details."},"15969":{"id":"/docs/single-page-6169","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-client-connection-errors-toc","content":"Errors like this..."},"15970":{"id":"/docs/single-page-6170","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-client-connection-errors-toc","content":"...are either due to ZooKeeper being down, or unreachable due to network issues."},"15971":{"id":"/docs/single-page-6171","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-client-connection-errors-toc","content":"The utility zkcli may help investigate ZooKeeper issues."},"15972":{"id":"/docs/single-page-6172","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#client-running-out-of-memory-though-heap-size-seems-to-be-stable-but-the-off-heapdirect-heap-keeps-growing-toc","content":"You are likely running into the issue that is described and worked through in the mail thread HBase, mail # user - Suspected memory leak and continued over in HBase, mail # dev - FeedbackRe: Suspected memory leak. A workaround is passing your client-side JVM a reasonable value for `-XX:MaxDirectMemorySize`. By default, the `MaxDirectMemorySize` is equal to your `-Xmx` max heapsize setting (if `-Xmx` is set). Try setting it to something smaller (for example, one user had success setting it to `1g` when they had a client-side heap of `12g`). If you set it too small, it will bring on `FullGCs` so keep it a bit hefty. You want to make this setting client-side only especially if you are running the new experimental server-side off-heap cache since this feature depends on being able to use big direct buffers (You may have to keep separate client-side and server-side config dirs)."},"15973":{"id":"/docs/single-page-6173","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-cannot-connect-caused-by-gssexception-no-valid-credentials-providedmechanism-level-failed-to-find-any-kerberos-tgt-toc","content":"There can be several causes that produce this symptom."},"15974":{"id":"/docs/single-page-6174","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-cannot-connect-caused-by-gssexception-no-valid-credentials-providedmechanism-level-failed-to-find-any-kerberos-tgt-toc","content":"First, check that you have a valid Kerberos ticket. One is required in order to set up communication with a secure Apache HBase cluster. Examine the ticket currently in the credential cache, if any, by running the `klist` command line utility. If no ticket is listed, you must obtain a ticket by running the `kinit` command with either a keytab specified, or by interactively entering a password for the desired principal."},"15975":{"id":"/docs/single-page-6175","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-cannot-connect-caused-by-gssexception-no-valid-credentials-providedmechanism-level-failed-to-find-any-kerberos-tgt-toc","content":"Then, consult the Java Security Guide troubleshooting section. The most common problem addressed there is resolved by setting `javax.security.auth.useSubjectCredsOnly` system property value to `false`."},"15976":{"id":"/docs/single-page-6176","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-cannot-connect-caused-by-gssexception-no-valid-credentials-providedmechanism-level-failed-to-find-any-kerberos-tgt-toc","content":"Because of a change in the format in which MIT Kerberos writes its credentials cache, there is a bug in the Oracle JDK 6 Update 26 and earlier that causes Java to be unable to read the Kerberos credentials cache created by versions of MIT Kerberos 1.8.1 or higher. If you have this problematic combination of components in your environment, to work around this problem, first log in with `kinit` and then immediately refresh the credential cache with `kinit -R`. The refresh will rewrite the credential cache without the problematic formatting."},"15977":{"id":"/docs/single-page-6177","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-cannot-connect-caused-by-gssexception-no-valid-credentials-providedmechanism-level-failed-to-find-any-kerberos-tgt-toc","content":"Prior to JDK 1.4, the JCE was an unbundled product, and as such, the JCA and JCE were regularly referred to as separate, distinct components. As JCE is now bundled in the JDK 7.0, the distinction is becoming less apparent. Since the JCE uses the same architecture as the JCA, the JCE should be more properly thought of as a part of the JCA."},"15978":{"id":"/docs/single-page-6178","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-cannot-connect-caused-by-gssexception-no-valid-credentials-providedmechanism-level-failed-to-find-any-kerberos-tgt-toc","content":"You may need to install the Java Cryptography Extension, or JCE because of JDK 1.5 or earlier version. Insure the JCE jars are on the classpath on both server and client systems."},"15979":{"id":"/docs/single-page-6179","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#secure-client-cannot-connect-caused-by-gssexception-no-valid-credentials-providedmechanism-level-failed-to-find-any-kerberos-tgt-toc","content":"You may also need to download the unlimited strength JCE policy file&#x73;. Uncompress and extract the downloaded file, and install the policy jars into *\\<java-home>/lib/security*."},"15980":{"id":"/docs/single-page-6180","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trouble-shooting-master-registry-issues-toc","content":"For connectivity issues, usually an exception like \"MasterRegistryFetchException: Exception making rpc to masters...\" is logged in the client logs. The logging includes the list of master end points that were attempted by the client. The bottom part of the stack trace should include the underlying reason. If you suspect connectivity issues (ConnectionRefused?), make sure the master end points are accessible from client."},"15981":{"id":"/docs/single-page-6181","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trouble-shooting-master-registry-issues-toc","content":"If there is a suspicion of higher load on the masters due to hedging of RPCs, it can be controlled by either reducing the hedging fan out (via *hbase.rpc.hedged.fanout*) or by restricting the set of masters that clients can access for the master registry purposes (via *hbase.masters*)."},"15982":{"id":"/docs/single-page-6182","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trouble-shooting-master-registry-issues-toc","content":"Refer to Master Registry (new as of 2.3.0) and Client configuration and dependencies connecting to an HBase cluster for more details."},"15983":{"id":"/docs/single-page-6183","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#you-think-youre-on-the-cluster-but-youre-actually-local-toc","content":"This following stacktrace happened using `ImportTsv`, but things like this can happen on any job with a mis-configuration."},"15984":{"id":"/docs/single-page-6184","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#you-think-youre-on-the-cluster-but-youre-actually-local-toc","content":"...see the critical portion of the stack? It's..."},"15985":{"id":"/docs/single-page-6185","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#you-think-youre-on-the-cluster-but-youre-actually-local-toc","content":"LocalJobRunner means the job is running locally, not on the cluster."},"15986":{"id":"/docs/single-page-6186","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#you-think-youre-on-the-cluster-but-youre-actually-local-toc","content":"To solve this problem, you should run your MR job with your `HADOOP_CLASSPATH` set to include the HBase dependencies. The \"hbase classpath\" utility can be used to do this easily. For example (substitute VERSION with your HBase version):"},"15987":{"id":"/docs/single-page-6187","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#you-think-youre-on-the-cluster-but-youre-actually-local-toc","content":"See HBase, MapReduce, and the CLASSPATH for more information on HBase MapReduce jobs and classpaths."},"15988":{"id":"/docs/single-page-6188","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#launching-a-job-you-get-javalangillegalaccesserror-comgoogleprotobufhbasezerocopybytestring-or-class-comgoogleprotobufzerocopyliteralbytestring-cannot-access-its-superclass-comgoogleprotobufliteralbytestring-toc","content":"See HBASE-10304 Running an hbase job jar: IllegalAccessError: class com.google.protobuf.ZeroCopyLiteralByteString cannot access its superclass com.google.protobuf.LiteralByteString and HBASE-11118 non environment variable solution for \"IllegalAccessError: class com.google.protobuf.ZeroCopyLiteralByteString cannot access its superclass com.google.protobuf.LiteralByteString\". The issue can also show up when trying to run spark jobs. See HBASE-10877 HBase non-retriable exception list should be expanded."},"15989":{"id":"/docs/single-page-6189","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-namenode","content":"For more information on the NameNode, see HDFS."},"15990":{"id":"/docs/single-page-6190","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hdfs-utilization-of-tables-and-regions","content":"To determine how much space HBase is using on HDFS use the `hadoop` shell commands from the NameNode. For example..."},"15991":{"id":"/docs/single-page-6191","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hdfs-utilization-of-tables-and-regions","content":"...returns the summarized disk utilization for all HBase objects."},"15992":{"id":"/docs/single-page-6192","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hdfs-utilization-of-tables-and-regions","content":"...returns the summarized disk utilization for the HBase table 'myTable'."},"15993":{"id":"/docs/single-page-6193","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hdfs-utilization-of-tables-and-regions","content":"...returns a list of the regions under the HBase table 'myTable' and their disk utilization."},"15994":{"id":"/docs/single-page-6194","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hdfs-utilization-of-tables-and-regions","content":"For more information on HDFS shell commands, see the HDFS FileSystem Shell documentation."},"15995":{"id":"/docs/single-page-6195","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#browsing-hdfs-for-hbase-objects","content":"Sometimes it will be necessary to explore the HBase objects that exist on HDFS. These objects could include the WALs (Write Ahead Logs), tables, regions, StoreFiles, etc. The easiest way to do this is with the NameNode web application that runs on port 50070. The NameNode web application will provide links to the all the DataNodes in the cluster so that they can be browsed seamlessly."},"15996":{"id":"/docs/single-page-6196","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#browsing-hdfs-for-hbase-objects","content":"The HDFS directory structure of HBase tables in the cluster is..."},"15997":{"id":"/docs/single-page-6197","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#browsing-hdfs-for-hbase-objects","content":"The HDFS directory structure of HBase WAL is.."},"15998":{"id":"/docs/single-page-6198","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#browsing-hdfs-for-hbase-objects","content":"See the HDFS User Guide for other non-shell diagnostic utilities like `fsck`."},"15999":{"id":"/docs/single-page-6199","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zero-size-wals-with-data-in-them-toc","content":"Problem: when getting a listing of all the files in a RegionServer's *WALs* directory, one file has a size of 0 but it contains data."},"16000":{"id":"/docs/single-page-6200","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zero-size-wals-with-data-in-them-toc","content":"Answer: It's an HDFS quirk. A file that's currently being written to will appear to have a size of 0 but once it's closed it will show its true size"},"16001":{"id":"/docs/single-page-6201","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#use-cases-toc","content":"Two common use-cases for querying HDFS for HBase objects is research the degree of uncompaction of a table. If there are a large number of StoreFiles for each ColumnFamily it could indicate the need for a major compaction. Additionally, after a major compaction if the resulting StoreFile is \"small\" it could indicate the need for a reduction of ColumnFamilies for the table."},"16002":{"id":"/docs/single-page-6202","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unexpected-filesystem-growth","content":"If you see an unexpected spike in filesystem usage by HBase, two possible culprits are snapshots and WALs."},"16003":{"id":"/docs/single-page-6203","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unexpected-filesystem-growth","content":"**Snapshots**\\\nWhen you create a snapshot, HBase retains everything it needs to recreate the table's state at that time of the snapshot. This includes deleted cells or expired versions. For this reason, your snapshot usage pattern should be well-planned, and you should prune snapshots that you no longer need. Snapshots are stored in `/hbase/.hbase-snapshot`, and archives needed to restore snapshots are stored in `/hbase/archive/<tablename>/<region>/<column_family>/`."},"16004":{"id":"/docs/single-page-6204","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unexpected-filesystem-growth","content":"**Do not** manage snapshots or archives manually via HDFS. HBase provides APIs and HBase Shell\ncommands for managing them. For more information, see\nops.snapshots."},"16005":{"id":"/docs/single-page-6205","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unexpected-filesystem-growth","content":"**WAL**\\\nWrite-ahead logs (WALs) are stored in subdirectories of the HBase root directory, typically `/hbase/`, depending on their status. Already-processed WALs are stored in `/hbase/oldWALs/` and corrupt WALs are stored in `/hbase/.corrupt/` for examination. If the size of one of these subdirectories is growing, examine the HBase server logs to find the root cause for why WALs are not being processed correctly.\\\nIf you use replication and `/hbase/oldWALs/` is using more space than you expect, remember that WALs are saved when replication is disabled, as long as there are peers."},"16006":{"id":"/docs/single-page-6206","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unexpected-filesystem-growth","content":"**Do not** manage WALs manually via HDFS."},"16007":{"id":"/docs/single-page-6207","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-spikes","content":"If you are seeing periodic network spikes you might want to check the `compactionQueues` to see if major compactions are happening."},"16008":{"id":"/docs/single-page-6208","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#network-spikes","content":"See Managed Compactions for more information on managing compactions."},"16009":{"id":"/docs/single-page-6209","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#loopback-ip","content":"HBase expects the loopback IP Address to be 127.0.0.1."},"16010":{"id":"/docs/single-page-6210","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-network-interfaces","content":"Are all the network interfaces functioning correctly? Are you sure? See the Troubleshooting Case Study in Case Studies."},"16011":{"id":"/docs/single-page-6211","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-regionserver","content":"For more information on the RegionServers, see RegionServer."},"16012":{"id":"/docs/single-page-6212","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-starts-but-regionservers-do-not-toc","content":"The Master believes the RegionServers have the IP of 127.0.0.1 - which is localhost and resolves to the master's own localhost."},"16013":{"id":"/docs/single-page-6213","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-starts-but-regionservers-do-not-toc","content":"The RegionServers are erroneously informing the Master that their IP addresses are 127.0.0.1."},"16014":{"id":"/docs/single-page-6214","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-starts-but-regionservers-do-not-toc","content":"Modify */etc/hosts* on the region servers, from..."},"16015":{"id":"/docs/single-page-6215","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-starts-but-regionservers-do-not-toc","content":"... to (removing the master node's name from localhost)..."},"16016":{"id":"/docs/single-page-6216","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#compression-link-errors-toc","content":"Since compression algorithms such as LZO need to be installed and configured on each cluster this is a frequent source of startup error. If you see messages like this..."},"16017":{"id":"/docs/single-page-6217","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#compression-link-errors-toc","content":"... then there is a path issue with the compression libraries. See the Configuration section on LZO compression configuration."},"16018":{"id":"/docs/single-page-6218","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-aborts-due-to-lack-of-hsync-for-filesystem-toc","content":"In order to provide data durability for writes to the cluster HBase relies on the ability to durably save state in a write ahead log. When using a version of Apache Hadoop Common's filesystem API that supports checking on the availability of needed calls, HBase will proactively abort the cluster if it finds it can't operate safely."},"16019":{"id":"/docs/single-page-6219","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-aborts-due-to-lack-of-hsync-for-filesystem-toc","content":"For RegionServer roles, the failure will show up in logs like this:"},"16020":{"id":"/docs/single-page-6220","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-aborts-due-to-lack-of-hsync-for-filesystem-toc","content":"If you are attempting to run in standalone mode and see this error, please walk back through the section Quick Start - Standalone HBase and ensure you have included **all** the given configuration settings."},"16021":{"id":"/docs/single-page-6221","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-aborts-due-to-can-not-initialize-access-to-hdfs-toc","content":"We will try to use *AsyncFSWAL* for HBase-2.x as it has better performance while consuming less resources. But the problem for *AsyncFSWAL* is that it hacks into the internal of the DFSClient implementation, so it will easily be broken when upgrading hadoop, even for a simple patch release."},"16022":{"id":"/docs/single-page-6222","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-aborts-due-to-can-not-initialize-access-to-hdfs-toc","content":"If you do not specify the wal provider, we will try to fall back to the old *FSHLog* if we fail to initialize *AsyncFSWAL*, but it may not always work. The failure will show up in logs like this:"},"16023":{"id":"/docs/single-page-6223","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-aborts-due-to-can-not-initialize-access-to-hdfs-toc","content":"If you hit this error, please specify *FSHLog*, i.e, *filesystem*, explicitly in your config file."},"16024":{"id":"/docs/single-page-6224","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-aborts-due-to-can-not-initialize-access-to-hdfs-toc","content":"And do not forget to send an email to the `user@hbase.apache.org` or `dev@hbase.apache.org` to report the failure and also your hadoop version, we will try to fix the problem ASAP in the next release."},"16025":{"id":"/docs/single-page-6225","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-hanging-toc","content":"Are you running an old JVM (`< `1.6.0*u21?)? When you look at a thread dump, does it look like threads are BLOCKED but no one holds the lock all are blocked on? See HBASE 3622 Deadlock in HBaseServer (JVM bug?). Adding `-XX:+UseMembar` to the HBase `HBASE_OPTS` in \\_conf/hbase-env.sh* may fix it."},"16026":{"id":"/docs/single-page-6226","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#javaioioexceptiontoo-many-open-files-toc","content":"If you see log messages like this..."},"16027":{"id":"/docs/single-page-6227","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#javaioioexceptiontoo-many-open-files-toc","content":"... see the Getting Started section on ulimit and nproc configuration."},"16028":{"id":"/docs/single-page-6228","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#xceivercount-258-exceeds-the-limit-of-concurrent-xcievers-256-toc","content":"This typically shows up in the DataNode logs."},"16029":{"id":"/docs/single-page-6229","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#xceivercount-258-exceeds-the-limit-of-concurrent-xcievers-256-toc","content":"TODO: add link.\nSee the Getting Started section on xceivers configuration."},"16030":{"id":"/docs/single-page-6230","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#system-instability-and-the-presence-of-javalangoutofmemoryerror-unable-to-createnew-native-thread-in-exceptions-hdfs-datanode-logs-or-that-of-any-system-daemon-toc","content":"See the Getting Started section on ulimit and nproc configuration. The default on recent Linux distributions is 1024 - which is far too low for HBase."},"16031":{"id":"/docs/single-page-6231","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dfs-instability-andor-regionserver-lease-timeouts-toc","content":"If you see warning messages like this..."},"16032":{"id":"/docs/single-page-6232","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dfs-instability-andor-regionserver-lease-timeouts-toc","content":"... or see full GC compactions then you may be experiencing full GC's."},"16033":{"id":"/docs/single-page-6233","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#no-live-nodes-contain-current-block-andor-youaredeadexception-toc","content":"These errors can happen either when running out of OS file handles or in periods of severe network problems where the nodes are unreachable."},"16034":{"id":"/docs/single-page-6234","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#no-live-nodes-contain-current-block-andor-youaredeadexception-toc","content":"See the Getting Started section on ulimit and nproc configuration and check your network."},"16035":{"id":"/docs/single-page-6235","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"Master or RegionServers shutting down with messages like those in the logs:"},"16036":{"id":"/docs/single-page-6236","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"The JVM is doing a long running garbage collecting which is pausing every threads (aka \"stop the world\"). Since the RegionServer's local ZooKeeper client cannot send heartbeats, the session times out. By design, we shut down any node that isn't able to contact the ZooKeeper ensemble after getting a timeout so that it stops serving data that may already be assigned elsewhere."},"16037":{"id":"/docs/single-page-6237","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"Make sure you give plenty of RAM (in *hbase-env.sh*), the default of 1GB won't be able to sustain long running imports."},"16038":{"id":"/docs/single-page-6238","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"Make sure you don't swap, the JVM never behaves well under swapping."},"16039":{"id":"/docs/single-page-6239","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"Make sure you are not CPU starving the RegionServer thread. For example, if you are running a MapReduce job using 6 CPU-intensive tasks on a machine with 4 cores, you are probably starving the RegionServer enough to create longer garbage collection pauses."},"16040":{"id":"/docs/single-page-6240","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"Increase the ZooKeeper session timeout"},"16041":{"id":"/docs/single-page-6241","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"If you wish to increase the session timeout, add the following to your *hbase-site.xml* to increase the timeout from the default of 60 seconds to 120 seconds."},"16042":{"id":"/docs/single-page-6242","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"Be aware that setting a higher timeout means that the regions served by a failed RegionServer will take at least that amount of time to be transferred to another RegionServer. For a production system serving live requests, we would instead recommend setting it lower than 1 minute and over-provision your cluster in order the lower the memory load on each machines (hence having less garbage to collect per machine)."},"16043":{"id":"/docs/single-page-6243","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"If this is happening during an upload which only happens once (like initially loading all your data into HBase), consider bulk loading."},"16044":{"id":"/docs/single-page-6244","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-sessionexpired-events-toc","content":"See ZooKeeper, The Cluster Canary for other general information about ZooKeeper troubleshooting."},"16045":{"id":"/docs/single-page-6245","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#notservingregionexception-toc","content":"This exception is \"normal\" when found in the RegionServer logs at DEBUG level. This exception is returned back to the client and then the client goes back to `hbase:meta` to find the new location of the moved region."},"16046":{"id":"/docs/single-page-6246","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#notservingregionexception-toc","content":"However, if the NotServingRegionException is logged ERROR, then the client ran out of retries and something probably wrong."},"16047":{"id":"/docs/single-page-6247","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logs-flooded-with-2011-01-10-124048407-info-orgapachehadoopiocompresscodecpool-gotbrand-new-compressor-messages-toc","content":"We are not using the native versions of compression libraries. See HBASE-1900 Put back native support when hadoop 0.21 is released. Copy the native libs from hadoop under HBase lib dir or symlink them into place and the message should go away."},"16048":{"id":"/docs/single-page-6248","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#server-handler-x-on-60020-caught-javaniochannelsclosedchannelexception-toc","content":"If you see this type of message it means that the region server was trying to read/send data from/to a client but it already went away. Typical causes for this are if the client was killed (you see a storm of messages like this when a MapReduce job is killed or fails) or if the client receives a SocketTimeoutException. It's harmless, but you should consider digging in a bit more if you aren't doing something to trigger them."},"16049":{"id":"/docs/single-page-6249","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-errors-due-to-reverse-dns","content":"Several operations within HBase, including snapshots, rely on properly configured reverse DNS. Some environments, such as Amazon EC2, have trouble with reverse DNS. If you see errors like the following on your RegionServers, check your reverse DNS configuration:"},"16050":{"id":"/docs/single-page-6250","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-errors-due-to-reverse-dns","content":"In general, the hostname reported by the RegionServer needs to be the same as the hostname the Master is trying to reach. You can see a hostname mismatch by looking for the following type of message in the RegionServer's logs at start-up."},"16051":{"id":"/docs/single-page-6251","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-master","content":"For more information on the Master, see master."},"16052":{"id":"/docs/single-page-6252","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-says-that-you-need-to-run-the-hbase-migrations-script-toc","content":"Upon running that, the HBase migrations script says no files in root directory."},"16053":{"id":"/docs/single-page-6253","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-says-that-you-need-to-run-the-hbase-migrations-script-toc","content":"HBase expects the root directory to either not exist, or to have already been initialized by HBase running a previous time. If you create a new directory for HBase using Hadoop DFS, this error will occur. Make sure the HBase root directory does not currently exist or has been initialized by a previous run of HBase. Sure fire solution is to just use Hadoop dfs to delete the HBase root and let HBase create and initialize the directory itself."},"16054":{"id":"/docs/single-page-6254","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#packet-len6080218-is-out-of-range-toc","content":"If you have many regions on your cluster and you see an error like that reported above in this sections title in your logs, see HBASE-4246 Cluster with too many regions cannot withstand some master failover scenarios."},"16055":{"id":"/docs/single-page-6255","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-fails-to-become-active-due-to-lack-of-hsync-for-filesystem-toc","content":"HBase's internal framework for cluster operations requires the ability to durably save state in a write ahead log. When using a version of Apache Hadoop Common's filesystem API that supports checking on the availability of needed calls, HBase will proactively abort the cluster if it finds it can't operate safely."},"16056":{"id":"/docs/single-page-6256","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-fails-to-become-active-due-to-lack-of-hsync-for-filesystem-toc","content":"For Master roles, the failure will show up in logs like this:"},"16057":{"id":"/docs/single-page-6257","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-fails-to-become-active-due-to-lack-of-hsync-for-filesystem-toc","content":"If you are attempting to run in standalone mode and see this error, please walk back through the section Quick Start - Standalone HBase and ensure you have included **all** the given configuration settings."},"16058":{"id":"/docs/single-page-6258","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#could-not-find-my-address-xyz-in-list-of-zookeeper-quorum-servers-toc","content":"A ZooKeeper server wasn't able to start, throws that error. xyz is the name of your server."},"16059":{"id":"/docs/single-page-6259","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#could-not-find-my-address-xyz-in-list-of-zookeeper-quorum-servers-toc","content":"This is a name lookup problem. HBase tries to start a ZooKeeper server on some machine but that machine isn't able to find itself in the `hbase.zookeeper.quorum` configuration."},"16060":{"id":"/docs/single-page-6260","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#could-not-find-my-address-xyz-in-list-of-zookeeper-quorum-servers-toc","content":"Use the hostname presented in the error message instead of the value you used. If you have a DNS server, you can set `hbase.zookeeper.dns.interface` and `hbase.zookeeper.dns.nameserver` in *hbase-site.xml* to make sure it resolves to the correct FQDN."},"16061":{"id":"/docs/single-page-6261","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-the-cluster-canary","content":"ZooKeeper is the cluster's \"canary in the mineshaft\". It'll be the first to notice issues if any so making sure its happy is the short-cut to a humming cluster."},"16062":{"id":"/docs/single-page-6262","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-the-cluster-canary","content":"See the ZooKeeper Operating Environment Troubleshooting page. It has suggestions and tools for checking disk and networking performance; i.e. the operating environment your ZooKeeper and HBase are running in."},"16063":{"id":"/docs/single-page-6263","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-the-cluster-canary","content":"Additionally, the utility zkcli may help investigate ZooKeeper issues."},"16064":{"id":"/docs/single-page-6264","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-does-not-seem-to-work-on-amazon-ec2","content":"HBase does not start when deployed as Amazon EC2 instances. Exceptions like the below appear in the Master and/or RegionServer logs:"},"16065":{"id":"/docs/single-page-6265","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper-does-not-seem-to-work-on-amazon-ec2","content":"Security group policy is blocking the ZooKeeper port on a public address. Use the internal EC2 host names when configuring the ZooKeeper quorum peer list."},"16066":{"id":"/docs/single-page-6266","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#instability-on-amazon-ec2","content":"Questions on HBase and Amazon EC2 come up frequently on the HBase dist-list."},"16067":{"id":"/docs/single-page-6267","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remote-java-connection-into-ec2-cluster-not-working","content":"See Andrew's answer here, up on the user list: Remote Java client connection into EC2 instance."},"16068":{"id":"/docs/single-page-6268","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cannot-communicate-with-client-version","content":"If you see something like the following in your logs ... 2012-09-24 10:20:52,168 FATAL org.apache.hadoop.hbase.master.HMaster: Unhandled exception. Starting shutdown. org.apache.hadoop.ipc.RemoteException: Server IPC version 7 cannot communicate with client version 4 ... ...are you trying to talk to an Hadoop 2.0.x from an HBase that has an Hadoop 1.0.x client? Use the HBase built against Hadoop 2.0 or rebuild your HBase passing the -Dhadoop.profile=2.0 attribute to Maven (See Building against various Hadoop versions for more)."},"16069":{"id":"/docs/single-page-6269","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-and-hdfs","content":"General configuration guidance for Apache HDFS is out of the scope of this guide. Refer to the documentation available at https\\://hadoop.apache.org/ for extensive information about configuring HDFS. This section deals with HDFS in terms of HBase."},"16070":{"id":"/docs/single-page-6270","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-and-hdfs","content":"In most cases, HBase stores its data in Apache HDFS. This includes the HFiles containing the data, as well as the write-ahead logs (WALs) which store data before it is written to the HFiles and protect against RegionServer crashes. HDFS provides reliability and protection to data in HBase because it is distributed. To operate with the most efficiency, HBase needs data to be available locally. Therefore, it is a good practice to run an HDFS DataNode on each RegionServer."},"16071":{"id":"/docs/single-page-6271","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**HBase is a client of HDFS.**\\\nHBase is an HDFS client, using the HDFS `DFSClient` class, and references to this class appear in HBase logs with other HDFS client log messages."},"16072":{"id":"/docs/single-page-6272","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**Configuration is necessary in multiple places.**\\\nSome HDFS configurations relating to HBase need to be done at the HDFS (server) side. Others must be done within HBase (at the client side). Other settings need to be set at both the server and client side."},"16073":{"id":"/docs/single-page-6273","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**Write errors which affect HBase may be logged in the HDFS logs rather than HBase logs.**\\\nWhen writing, HDFS pipelines communications from one DataNode to another. HBase communicates to both the HDFS NameNode and DataNode, using the HDFS client classes. Communication problems between DataNodes are logged in the HDFS logs, not the HBase logs."},"16074":{"id":"/docs/single-page-6274","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**HBase communicates with HDFS using two different ports.**\\\nHBase communicates with DataNodes using the `ipc.Client` interface and the `DataNode` class. References to these will appear in HBase logs. Each of these communication channels use a different port (50010 and 50020 by default). The ports are configured in the HDFS configuration, via the `dfs.datanode.address` and `dfs.datanode.ipc.address` parameters."},"16075":{"id":"/docs/single-page-6275","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**Errors may be logged in HBase, HDFS, or both.**\\\nWhen troubleshooting HDFS issues in HBase, check logs in both places for errors."},"16076":{"id":"/docs/single-page-6276","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**HDFS takes a while to mark a node as dead. You can configure HDFS to avoid using stale DataNodes.**\\\nBy default, HDFS does not mark a node as dead until it is unreachable for 630 seconds. In Hadoop 1.1 and Hadoop 2.x, this can be alleviated by enabling checks for stale DataNodes, though this check is disabled by default. You can enable the check for reads and writes separately, via `dfs.namenode.avoid.read.stale.datanode` and `dfs.namenode.avoid.write.stale.datanode settings`. A stale DataNode is one that has not been reachable for `dfs.namenode.stale.datanode.interval` (default is 30 seconds). Stale datanodes are avoided, and marked as the last possible target for a read or write operation. For configuration details, see the HDFS documentation."},"16077":{"id":"/docs/single-page-6277","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**Settings for HDFS retries and timeouts are important to HBase.**\\\nYou can configure settings for various retries and timeouts. Always refer to the HDFS documentation for current recommendations and defaults. Some of the settings important to HBase are listed here. Defaults are current as of Hadoop 2.3. Check the Hadoop documentation for the most current values and recommendations."},"16078":{"id":"/docs/single-page-6278","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"**The HBase Balancer and HDFS Balancer are incompatible**\\\nThe HDFS balancer attempts to spread HDFS blocks evenly among DataNodes. HBase relies on compactions to restore locality after a region split or failure. These two types of balancing do not work well together."},"16079":{"id":"/docs/single-page-6279","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"In the past, the generally accepted advice was to turn off the HDFS load balancer and rely on the HBase balancer, since the HDFS balancer would degrade locality. This advice is still valid if your HDFS version is lower than 2.7.1."},"16080":{"id":"/docs/single-page-6280","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"HDFS-6133 provides the ability to exclude favored-nodes (pinned) blocks from the HDFS load balancer, by setting the `dfs.datanode.block-pinning.enabled` property to `true` in the HDFS service configuration."},"16081":{"id":"/docs/single-page-6281","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"HBase can be enabled to use the HDFS favored-nodes feature by switching the HBase balancer class (conf: `hbase.master.loadbalancer.class`) to `org.apache.hadoop.hbase.favored.FavoredNodeLoadBalancer` which is documented here."},"16082":{"id":"/docs/single-page-6282","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#important-information-and-guidelines-for-hbase-and-hdfs","content":"HDFS-6133 is available in HDFS 2.7.0 and higher, but HBase does not support running on HDFS 2.7.0,\nso you must be using HDFS 2.7.1 or higher to use this feature with HBase."},"16083":{"id":"/docs/single-page-6283","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection-timeouts","content":"Connection timeouts occur between the client (HBASE) and the HDFS DataNode. They may occur when establishing a connection, attempting to read, or attempting to write. The two settings below are used in combination, and affect connections between the DFSClient and the DataNode, the ipc.cClient and the DataNode, and communication between two DataNodes."},"16084":{"id":"/docs/single-page-6284","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection-timeouts","content":"`dfs.client.socket-timeout` (default: 60000)\\\nThe amount of time before a client connection times out when establishing a connection or reading. The value is expressed in milliseconds, so the default is 60 seconds."},"16085":{"id":"/docs/single-page-6285","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#connection-timeouts","content":"`dfs.datanode.socket.write.timeout` (default: 480000)\\\nThe amount of time before a write operation times out. The default is 8 minutes, expressed as milliseconds."},"16086":{"id":"/docs/single-page-6286","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#typical-error-logs","content":"The following types of errors are often seen in the logs."},"16087":{"id":"/docs/single-page-6287","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#typical-error-logs","content":"`INFO HDFS.DFSClient: Failed to connect to /xxx50010, add to deadNodes and continue java.net.SocketTimeoutException: 60000 millis timeout while waiting for channel to be ready for connect. ch : java.nio.channels.SocketChannel[connection-pending remote=/region-server-1:50010]`:: All DataNodes for a block are dead, and recovery is not possible. Here is the sequence of events that leads to this error:"},"16088":{"id":"/docs/single-page-6288","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#typical-error-logs","content":"`INFO org.apache.hadoop.HDFS.DFSClient: Exception in createBlockOutputStream java.net.SocketTimeoutException: 69000 millis timeout while waiting for channel to be ready for connect. ch : java.nio.channels.SocketChannel[connection-pending remote=/ xxx:50010]`:: This type of error indicates a write issue. In this case, the master wants to split the log. It does not have a local DataNodes so it tries to connect to a remote DataNode, but the DataNode is dead."},"16089":{"id":"/docs/single-page-6289","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#runtime-exceptions-from-minidfscluster-when-running-tests","content":"If you see something like the following"},"16090":{"id":"/docs/single-page-6290","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#runtime-exceptions-from-minidfscluster-when-running-tests","content":"or"},"16091":{"id":"/docs/single-page-6291","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#runtime-exceptions-from-minidfscluster-when-running-tests","content":"... then try issuing the command umask 022 before launching tests. This is a workaround for HDFS-2556"},"16092":{"id":"/docs/single-page-6292","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#troubleshooting-case-studies","content":"For Performance and Troubleshooting Case Studies, see Apache HBase Case Studies."},"16093":{"id":"/docs/single-page-6293","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sunsecuritypkcs11wrapperpkcs11exception-ckr_arguments_bad-toc","content":"This problem manifests as exceptions ultimately caused by:"},"16094":{"id":"/docs/single-page-6294","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sunsecuritypkcs11wrapperpkcs11exception-ckr_arguments_bad-toc","content":"This problem appears to affect some versions of OpenJDK 7 shipped by some Linux vendors. NSS is configured as the default provider. If the host has an x86\\_64 architecture, depending on if the vendor packages contain the defect, the NSS provider will not function correctly."},"16095":{"id":"/docs/single-page-6295","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sunsecuritypkcs11wrapperpkcs11exception-ckr_arguments_bad-toc","content":"To work around this problem, find the JRE home directory and edit the file *lib/security/java.security*. Edit the file to comment out the line:"},"16096":{"id":"/docs/single-page-6296","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sunsecuritypkcs11wrapperpkcs11exception-ckr_arguments_bad-toc","content":"Then renumber the remaining providers accordingly."},"16097":{"id":"/docs/single-page-6297","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#page-allocation-failure-toc","content":"This issue is known to affect CentOS 6.2 and possibly CentOS 6.5. It may also affect some versions\nof Red Hat Enterprise Linux, according to\nhttps\\://bugzilla.redhat.com/show\\_bug.cgi?id=770545."},"16098":{"id":"/docs/single-page-6298","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#page-allocation-failure-toc","content":"Some users have reported seeing the following error:"},"16099":{"id":"/docs/single-page-6299","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#page-allocation-failure-toc","content":"Raising the value of `min_free_kbytes` was reported to fix this problem. This parameter is set to a percentage of the amount of RAM on your system, and is described in more detail at https\\://docs.kernel.org/admin-guide/sysctl/vm.html#min-free-kbytes."},"16100":{"id":"/docs/single-page-6300","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#page-allocation-failure-toc","content":"To find the current value on your system, run the following command:"},"16101":{"id":"/docs/single-page-6301","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#page-allocation-failure-toc","content":"Next, raise the value. Try doubling, then quadrupling the value. Note that setting the value too low or too high could have detrimental effects on your system. Consult your operating system vendor for specific recommendations."},"16102":{"id":"/docs/single-page-6302","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#page-allocation-failure-toc","content":"Use the following command to modify the value of `min_free_kbytes`, substituting *VALUE* with your intended value:"},"16103":{"id":"/docs/single-page-6303","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#nosuchmethoderror-javautilconcurrentconcurrenthashmapkeyset-toc","content":"If you see this in your logs:"},"16104":{"id":"/docs/single-page-6304","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#nosuchmethoderror-javautilconcurrentconcurrenthashmapkeyset-toc","content":"then check if you compiled with jdk8 and tried to run it on jdk7. If so, this won't work. Run on jdk8 or recompile with jdk7. See HBASE-10607 JDK8 NoSuchMethodError involving ConcurrentHashMap.keySet if running on JRE 7."},"16105":{"id":"/docs/single-page-6305","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"The default size of chunk used by mslab is 2MB, when using G1, if heapRegionSize equals 4MB, these chunks are allocated as humongous objects, exclusively allocating one region, then the remaining 2MB become memory fragment."},"16106":{"id":"/docs/single-page-6306","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"Lots of memory fragment may lead to full gc even if the percent of used heap not high enough."},"16107":{"id":"/docs/single-page-6307","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"The G1HeapRegionSize calculated by initial\\_heap\\_size and max\\_heap\\_size, here are some cases for better understand:"},"16108":{"id":"/docs/single-page-6308","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"xmx=10G -> region size 2M"},"16109":{"id":"/docs/single-page-6309","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"xms=10G, xmx=10G -> region size 4M"},"16110":{"id":"/docs/single-page-6310","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"xmx=20G -> region size 4M"},"16111":{"id":"/docs/single-page-6311","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"xms=20G, xmx=20G -> region size 8M"},"16112":{"id":"/docs/single-page-6312","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"xmx=30G -> region size 4M"},"16113":{"id":"/docs/single-page-6313","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"xmx=32G -> region size 8M"},"16114":{"id":"/docs/single-page-6314","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-gc-caused-by-mslab-when-using-g1-toc","content":"You can avoid this problem by reducing the chunk size a bit to 2047KB as below."},"16115":{"id":"/docs/single-page-6315","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#case-studies-overview","content":"This chapter will describe a variety of performance and troubleshooting case studies that can provide a useful blueprint on diagnosing Apache HBase cluster issues."},"16116":{"id":"/docs/single-page-6316","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#case-studies-overview","content":"For more information on Performance and Troubleshooting, see Apache HBase Performance Tuning and Troubleshooting and Debugging Apache HBase."},"16117":{"id":"/docs/single-page-6317","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#case-studies-schema-design","content":"See the schema design case studies here: Schema Design Case Studies"},"16118":{"id":"/docs/single-page-6318","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#scenario","content":"Following a scheduled reboot, one data node began exhibiting unusual behavior.\nRoutine MapReduce jobs run against HBase tables which regularly completed in five or six minutes began taking 30 or 40 minutes to finish.\nThese jobs were consistently found to be waiting on map and reduce tasks assigned to the troubled data node (e.g., the slow map tasks all had the same Input Split). The situation came to a head during a distributed copy, when the copy was severely prolonged by the lagging node."},"16119":{"id":"/docs/single-page-6319","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"Datanodes:"},"16120":{"id":"/docs/single-page-6320","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"Two 12-core processors"},"16121":{"id":"/docs/single-page-6321","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"Six Enterprise SATA disks"},"16122":{"id":"/docs/single-page-6322","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"24GB of RAM"},"16123":{"id":"/docs/single-page-6323","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"Two bonded gigabit NICs"},"16124":{"id":"/docs/single-page-6324","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"Network:"},"16125":{"id":"/docs/single-page-6325","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"10 Gigabit top-of-rack switches"},"16126":{"id":"/docs/single-page-6326","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hardware","content":"20 Gigabit bonded interconnects between racks."},"16127":{"id":"/docs/single-page-6327","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hypotheses","content":"**HBase \"Hot Spot\" Region**\\\nWe hypothesized that we were experiencing a familiar point of pain: a \"hot spot\" region in an HBase table, where uneven key-space distribution can funnel a huge number of requests to a single HBase region, bombarding the RegionServer process and cause slow response time.\nExamination of the HBase Master status page showed that the number of HBase requests to the troubled node was almost zero.\nFurther, examination of the HBase logs showed that there were no region splits, compactions, or other region transitions in progress.\nThis effectively ruled out a \"hot spot\" as the root cause of the observed slowness."},"16128":{"id":"/docs/single-page-6328","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hypotheses","content":"**HBase Region With Non-Local Data**\\\nOur next hypothesis was that one of the MapReduce tasks was requesting data from HBase that was not local to the DataNode, thus forcing HDFS to request data blocks from other servers over the network.\nExamination of the DataNode logs showed that there were very few blocks being requested over the network, indicating that the HBase region was correctly assigned, and that the majority of the necessary data was located on the node.\nThis ruled out the possibility of non-local data causing a slowdown."},"16129":{"id":"/docs/single-page-6329","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hypotheses","content":"**Excessive I/O Wait Due To Swapping Or An Over-Worked Or Failing Hard Disk**\\\nAfter concluding that the Hadoop and HBase were not likely to be the culprits, we moved on to troubleshooting the DataNode's hardware.\nJava, by design, will periodically scan its entire memory space to do garbage collection.\nIf system memory is heavily overcommitted, the Linux kernel may enter a vicious cycle, using up all of its resources swapping Java heap back and forth from disk to RAM as Java tries to run garbage collection.\nFurther, a failing hard disk will often retry reads and/or writes many times before giving up and returning an error.\nThis can manifest as high iowait, as running processes wait for reads and writes to complete.\nFinally, a disk nearing the upper edge of its performance envelope will begin to cause iowait as it informs the kernel that it cannot accept any more data, and the kernel queues incoming data into the dirty write pool in memory.\nHowever, using `vmstat(1)` and `free(1)`, we could see that no swap was being used, and the amount of disk IO was only a few kilobytes per second."},"16130":{"id":"/docs/single-page-6330","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hypotheses","content":"**Slowness Due To High Processor Usage**\\\nNext, we checked to see whether the system was performing slowly simply due to very high computational load. `top(1)` showed that the system load was higher than normal, but `vmstat(1)` and `mpstat(1)` showed that the amount of processor being used for actual computation was low."},"16131":{"id":"/docs/single-page-6331","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hypotheses","content":"**Network Saturation (The Winner)**\\\nSince neither the disks nor the processors were being utilized heavily, we moved on to the performance of the network interfaces.\nThe DataNode had two gigabit ethernet adapters, bonded to form an active-standby interface. `ifconfig(8)` showed some unusual anomalies, namely interface errors, overruns, framing errors.\nWhile not unheard of, these kinds of errors are exceedingly rare on modern hardware which is operating as it should:"},"16132":{"id":"/docs/single-page-6332","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hypotheses","content":"These errors immediately lead us to suspect that one or more of the ethernet interfaces might have negotiated the wrong line speed.\nThis was confirmed both by running an ICMP ping from an external host and observing round-trip-time in excess of 700ms, and by running `ethtool(8)` on the members of the bond interface and discovering that the active interface was operating at 100Mbs/, full duplex."},"16133":{"id":"/docs/single-page-6333","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hypotheses","content":"In normal operation, the ICMP ping round trip time should be around 20ms, and the interface speed and duplex should read, \"1000MB/s\", and, \"Full\", respectively."},"16134":{"id":"/docs/single-page-6334","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#resolution","content":"After determining that the active ethernet adapter was at the incorrect speed, we used the `ifenslave(8)` command to make the standby interface the active interface, which yielded an immediate improvement in MapReduce performance, and a 10 times improvement in network throughput:"},"16135":{"id":"/docs/single-page-6335","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#resolution","content":"On the next trip to the datacenter, we determined that the line speed issue was ultimately caused by a bad network cable, which was replaced."},"16136":{"id":"/docs/single-page-6336","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#case-study-2-performance-research-2012","content":"Investigation results of a self-described \"we're not sure what's wrong, but it seems slow\" problem. http\\://gbif.blogspot.com/2012/03/hbase-performance-evaluation-continued.html"},"16137":{"id":"/docs/single-page-6337","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#case-study-3-performance-research-2010","content":"Investigation results of general cluster performance from 2010.\nAlthough this research is on an older version of the codebase, this writeup is still very useful in terms of approach. https\\://web.archive.org/web/20180503124332/http\\://hstack.org/hbase-performance-testing/"},"16138":{"id":"/docs/single-page-6338","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#case-study-4-maxtransferthreads-config","content":"Case study of configuring `max.transfer.threads` (previously known as `xcievers`) and diagnosing errors from misconfigurations. http\\://www\\.larsgeorge.com/2012/03/hadoop-hbase-and-xceivers.html"},"16139":{"id":"/docs/single-page-6339","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#case-study-4-maxtransferthreads-config","content":"See also `dfs.datanode.max.transfer.threads`."},"16140":{"id":"/docs/single-page-6340","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management","content":"The subject of operations is related to the topics of Troubleshooting and Debugging Apache HBase, Apache HBase Performance Tuning, and Apache HBase Configuration but is a distinct topic in itself."},"16141":{"id":"/docs/single-page-6341","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tools","content":"HBase provides several tools for administration, analysis, and debugging of your cluster. The entry-point to most of these tools is the *bin/hbase* command, though some tools are available in the &#x2A;dev-support/* directory."},"16142":{"id":"/docs/single-page-6342","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tools","content":"To see usage instructions for *bin/hbase* command, run it with no arguments, or with the `-h` argument. These are the usage instructions for HBase 0.98.x. Some commands, such as `version`, `pe`, `ltt`, `clean`, are not available in previous versions."},"16143":{"id":"/docs/single-page-6343","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tools","content":"Some of the tools and utilities below are Java classes which are passed directly to the *bin/hbase* command, as referred to in the last line of the usage instructions. Others, such as `hbase shell` (The Apache HBase Shell), `hbase upgrade` (Upgrading), and `hbase thrift` (Thrift API and Filter Language), are documented elsewhere in this guide."},"16144":{"id":"/docs/single-page-6344","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"The Canary tool can help users \"canary-test\" the HBase cluster status. The default \"region mode\" fetches a row from every column-family of every regions. In \"regionserver mode\", the Canary tool will fetch a row from a random region on each of the cluster's RegionServers. In \"zookeeper mode\", the Canary will read the root znode on each member of the zookeeper ensemble."},"16145":{"id":"/docs/single-page-6345","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"To see usage, pass the `-help` parameter (if you pass no parameters, the Canary tool starts executing in the default region \"mode\" fetching a row from every region in the cluster)."},"16146":{"id":"/docs/single-page-6346","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"The `Sink` class is instantiated using the `hbase.canary.sink.class` configuration property."},"16147":{"id":"/docs/single-page-6347","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"This tool will return non zero error codes to user for collaborating with other monitoring tools, such as Nagios. The error code definitions are:"},"16148":{"id":"/docs/single-page-6348","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"Here are some examples based on the following given case: given two Table objects called test-01 and test-02 each with two column family cf1 and cf2 respectively, deployed on 3 RegionServers. See the following table."},"16149":{"id":"/docs/single-page-6349","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"RegionServer"},"16150":{"id":"/docs/single-page-6350","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"test-01"},"16151":{"id":"/docs/single-page-6351","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"test-02"},"16152":{"id":"/docs/single-page-6352","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"rs1"},"16153":{"id":"/docs/single-page-6353","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"r1"},"16154":{"id":"/docs/single-page-6354","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"r2"},"16155":{"id":"/docs/single-page-6355","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"rs2"},"16156":{"id":"/docs/single-page-6356","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"r2"},"16157":{"id":"/docs/single-page-6357","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"rs3"},"16158":{"id":"/docs/single-page-6358","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"r2"},"16159":{"id":"/docs/single-page-6359","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"r1"},"16160":{"id":"/docs/single-page-6360","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary","content":"Following are some example outputs based on the previous given case."},"16161":{"id":"/docs/single-page-6361","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary-test-for-every-column-family-store-of-every-region-of-every-table","content":"So you can see, table test-01 has two regions and two column families, so the Canary tool in the default \"region mode\" will pick 4 small piece of data from 4 (2 region \\* 2 store) different stores. This is a default behavior."},"16162":{"id":"/docs/single-page-6362","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary-test-for-every-column-family-store-of-every-region-of-a-specific-tables","content":"You can also test one or more specific tables by passing table names."},"16163":{"id":"/docs/single-page-6363","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary-test-with-regionserver-granularity","content":"In \"regionserver mode\", the Canary tool will pick one small piece of data from each RegionServer (You can also pass one or more RegionServer names as arguments to the canary-test when in \"regionserver mode\")."},"16164":{"id":"/docs/single-page-6364","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#canary-test-with-regular-expression-pattern","content":"You can pass regexes for table names when in \"region mode\" or for servernames when in \"regionserver mode\". The below will test both table test-01 and test-02."},"16165":{"id":"/docs/single-page-6365","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#run-canary-test-as-a-daemon","content":"Run repeatedly with an interval defined via the option `-interval` (default value is 60 seconds). This daemon will stop itself and return non-zero error code if any error occur. To have the daemon keep running across errors, pass the -f flag with its value set to false (see usage above)."},"16166":{"id":"/docs/single-page-6366","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#run-canary-test-as-a-daemon","content":"To run repeatedly with 5 second intervals and not stop on errors, do the following."},"16167":{"id":"/docs/single-page-6367","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#force-timeout-if-canary-test-stuck","content":"In some cases the request is stuck and no response is sent back to the client. This can happen with dead RegionServers which the master has not yet noticed. Because of this we provide a timeout option to kill the canary test and return a non-zero error code. The below sets the timeout value to 60 seconds (the default value is 600 seconds)."},"16168":{"id":"/docs/single-page-6368","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enable-write-sniffing-in-canary","content":"By default, the canary tool only checks read operations. To enable the write sniffing, you can run the canary with the `-writeSniffing` option set. When write sniffing is enabled, the canary tool will create an hbase table and make sure the regions of the table are distributed to all region servers. In each sniffing period, the canary will try to put data to these regions to check the write availability of each region server."},"16169":{"id":"/docs/single-page-6369","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enable-write-sniffing-in-canary","content":"The default write table is `hbase:canary` and can be specified with the option `-writeTable`."},"16170":{"id":"/docs/single-page-6370","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enable-write-sniffing-in-canary","content":"The default value size of each put is 10 bytes. You can set it via the config key: `hbase.canary.write.value.size`."},"16171":{"id":"/docs/single-page-6371","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#treat-read--write-failure-as-error","content":"By default, the canary tool only logs read failures — due to e.g. RetriesExhaustedException, etc. — and will return the 'normal' exit code. To treat read/write failure as errors, you can run canary with the `-treatFailureAsError` option. When enabled, read/write failures will result in an error exit code."},"16172":{"id":"/docs/single-page-6372","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"To run the Canary in a Kerberos-enabled cluster, configure the following two properties in *hbase-site.xml*:"},"16173":{"id":"/docs/single-page-6373","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"`hbase.client.keytab.file`"},"16174":{"id":"/docs/single-page-6374","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"`hbase.client.kerberos.principal`"},"16175":{"id":"/docs/single-page-6375","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"Kerberos credentials are refreshed every 30 seconds when Canary runs in daemon mode."},"16176":{"id":"/docs/single-page-6376","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"To configure the DNS interface for the client, configure the following optional properties in *hbase-site.xml*."},"16177":{"id":"/docs/single-page-6377","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"`hbase.client.dns.interface`"},"16178":{"id":"/docs/single-page-6378","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"`hbase.client.dns.nameserver`"},"16179":{"id":"/docs/single-page-6379","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-canary-in-a-kerberos-enabled-cluster","content":"**Example Canary in a Kerberos-Enabled Cluster**\\\nThis example shows each of the properties with valid values."},"16180":{"id":"/docs/single-page-6380","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionsplitter","content":"For additional detail, see Manual Region Splitting."},"16181":{"id":"/docs/single-page-6381","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#health-checker","content":"You can configure HBase to run a script periodically and if it fails N times (configurable), have the server exit. See *HBASE-7351 Periodic health check script* for configurations and detail."},"16182":{"id":"/docs/single-page-6382","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"Several frequently-accessed utilities are provided as `Driver` classes, and executed by the *bin/hbase* command. These utilities represent MapReduce jobs which run on your cluster. They are run in the following way, replacing *UtilityName* with the utility you want to run. This command assumes you have set the environment variable `HBASE_HOME` to the directory where HBase is unpacked on your server."},"16183":{"id":"/docs/single-page-6383","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"The following utilities are available:"},"16184":{"id":"/docs/single-page-6384","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`LoadIncrementalHFiles`\\\nComplete a bulk data load."},"16185":{"id":"/docs/single-page-6385","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`CopyTable`\\\nExport a table from the local cluster to a peer cluster."},"16186":{"id":"/docs/single-page-6386","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`Export`\\\nWrite table data to HDFS."},"16187":{"id":"/docs/single-page-6387","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`Import`\\\nImport data written by a previous `Export` operation."},"16188":{"id":"/docs/single-page-6388","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`ImportTsv`\\\nImport data in TSV format."},"16189":{"id":"/docs/single-page-6389","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`RowCounter`\\\nCount rows in an HBase table."},"16190":{"id":"/docs/single-page-6390","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`CellCounter`\\\nCount cells in an HBase table."},"16191":{"id":"/docs/single-page-6391","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"`replication.VerifyReplication`\\\nCompare the data from tables in two different clusters. WARNING: It doesn't work for incrementColumnValues'd cells since the timestamp is changed. Note that this command is in a different package than the others."},"16192":{"id":"/docs/single-page-6392","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#driver","content":"Each command except `RowCounter` and `CellCounter` accept a single `--help` argument to print usage instructions."},"16193":{"id":"/docs/single-page-6393","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-hbck","content":"The `hbck` tool that shipped with hbase-1.x has been made read-only in hbase-2.x. It is not able to repair hbase-2.x clusters as hbase internals have changed. Nor should its assessments in read-only mode be trusted as it does not understand hbase-2.x operation."},"16194":{"id":"/docs/single-page-6394","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-hbck","content":"A new tool, HBase `HBCK2`, described in the next section, replaces `hbck`."},"16195":{"id":"/docs/single-page-6395","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-hbck2","content":"`HBCK2` is the successor to HBase `HBCK`, the hbase-1.x fix tool (A.K.A `hbck1`). Use it in place of `hbck1` making repairs against hbase-2.x installs."},"16196":{"id":"/docs/single-page-6396","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-hbck2","content":"`HBCK2` does not ship as part of hbase. It can be found as a subproject of the companion hbase-operator-tools repository at Apache HBase HBCK2 Tool. `HBCK2` was moved out of hbase so it could evolve at a cadence apart from that of hbase core."},"16197":{"id":"/docs/single-page-6397","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-hbck2","content":"See the HBCK2 Home Page for how `HBCK2` differs from `hbck1`, and for how to build and use it."},"16198":{"id":"/docs/single-page-6398","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-hbck2","content":"Once built, you can run `HBCK2` as follows:"},"16199":{"id":"/docs/single-page-6399","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-hbck2","content":"This will generate `HBCK2` usage describing commands and options."},"16200":{"id":"/docs/single-page-6400","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-tools-hfile-tool","content":"See HFile Tool."},"16201":{"id":"/docs/single-page-6401","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#wal-tools","content":"For bulk replaying WAL files or *recovered.edits* files, see WALPlayer. For reading/verifying individual files, read on."},"16202":{"id":"/docs/single-page-6402","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walprettyprinter","content":"The `WALPrettyPrinter` is a tool with configurable options to print the contents of a WAL or a *recovered.edits* file. You can invoke it via the HBase cli with the 'wal' command."},"16203":{"id":"/docs/single-page-6403","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walprettyprinter","content":"Prior to version 2.0, the `WALPrettyPrinter` was called the `HLogPrettyPrinter`, after an internal name for HBase's write ahead log. In those versions, you can print the contents of a WAL using the same configuration as above, but with the 'hlog' command."},"16204":{"id":"/docs/single-page-6404","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#compression-tool","content":"See compression.test."},"16205":{"id":"/docs/single-page-6405","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#copytable","content":"CopyTable is a utility that can copy part or of all of a table, either to the same cluster or another cluster. The target table must first exist. The usage is as follows:"},"16206":{"id":"/docs/single-page-6406","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#copytable","content":"Starting from 3.0.0, we introduce a `peer.uri` option so the `peer.adr` option is deprecated. Please use connection URI for specifying HBase clusters. For all previous versions, you should still use the `peer.adr` option."},"16207":{"id":"/docs/single-page-6407","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#copytable","content":"Caching for the input Scan is configured via `hbase.client.scanner.caching` in the job\nconfiguration."},"16208":{"id":"/docs/single-page-6408","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#copytable","content":"By default, CopyTable utility only copies the latest version of row cells unless `--versions=n` is\nexplicitly specified in the command."},"16209":{"id":"/docs/single-page-6409","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#copytable","content":"CopyTable does not perform a diff, it copies all Cells in between the specified startrow/stoprow\nstarttime/endtime range. This means that already existing cells with same values will still be\ncopied."},"16210":{"id":"/docs/single-page-6410","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#copytable","content":"See Jonathan Hsieh's Online HBase Backups with CopyTable blog post for more on `CopyTable`."},"16211":{"id":"/docs/single-page-6411","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hashtablesynctable","content":"HashTable/SyncTable is a two steps tool for synchronizing table data, where each of the steps are implemented as MapReduce jobs. Similarly to CopyTable, it can be used for partial or entire table data syncing, under same or remote cluster. However, it performs the sync in a more efficient way than CopyTable. Instead of copying all cells in specified row key/time period range, HashTable (the first step) creates hashed indexes for batch of cells on source table and output those as results. On the next stage, SyncTable scans the source table and now calculates hash indexes for table cells, compares these hashes with the outputs of HashTable, then it just scans (and compares) cells for diverging hashes, only updating mismatching cells. This results in less network traffic/data transfers, which can be impacting when syncing large tables on remote clusters."},"16212":{"id":"/docs/single-page-6412","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-1-hashtable","content":"First, run HashTable on the source table cluster (this is the table whose state will be copied to its counterpart)."},"16213":{"id":"/docs/single-page-6413","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-1-hashtable","content":"Usage:"},"16214":{"id":"/docs/single-page-6414","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-1-hashtable","content":"The **batchsize** property defines how much cell data for a given region will be hashed together in a single hash value. Sizing this properly has a direct impact on the sync efficiency, as it may lead to less scans executed by mapper tasks of SyncTable (the next step in the process). The rule of thumb is that, the smaller the number of cells out of sync (lower probability of finding a diff), larger batch size values can be determined."},"16215":{"id":"/docs/single-page-6415","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"Once HashTable has completed on source cluster, SyncTable can be ran on target cluster. Just like replication and other synchronization jobs, it requires that all RegionServers/DataNodes on source cluster be accessible by NodeManagers on the target cluster (where SyncTable job tasks will be running)."},"16216":{"id":"/docs/single-page-6416","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"Usage:"},"16217":{"id":"/docs/single-page-6417","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"Starting from 3.0.0, we introduce `sourceuri` and `targeturi` options so `sourcezkcluster` and `targetzkcluster` are deprecated. Please use connection URI for specifying HBase clusters. For all previous versions, you should still use `sourcezkcluster` and `targetzkcluster`."},"16218":{"id":"/docs/single-page-6418","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"Cell comparison takes ROW/FAMILY/QUALIFIER/TIMESTAMP/VALUE into account for equality. When syncing at the target, missing cells will be added with original timestamp value from source. That may cause unexpected results after SyncTable completes, for example, if missing cells on target have a delete marker with a timestamp T2 (say, a bulk delete performed by mistake), but source cells timestamps have an older value T1, then those cells would still be unavailable at target because of the newer delete marker timestamp. Since cell timestamps might not be relevant to all use cases, *ignoreTimestamps* option adds the flexibility to avoid using cells timestamp in the comparison. When using *ignoreTimestamps* set to true, this option must be specified for both HashTable and SyncTable steps."},"16219":{"id":"/docs/single-page-6419","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"The **dryrun** option is useful when a read only, diff report is wanted, as it will produce only COUNTERS indicating the differences, but will not perform any actual changes. It can be used as an alternative to VerifyReplication tool."},"16220":{"id":"/docs/single-page-6420","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"By default, SyncTable will cause target table to become an exact copy of source table (at least, for the specified startrow/stoprow or/and starttime/endtime)."},"16221":{"id":"/docs/single-page-6421","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"Setting doDeletes to false modifies default behaviour to not delete target cells that are missing on source. Similarly, setting doPuts to false modifies default behaviour to not add missing cells on target. Setting both doDeletes and doPuts to false would give same effect as setting dryrun to true."},"16222":{"id":"/docs/single-page-6422","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"\"doDeletes/doPuts\" were only added by\nHBASE-20305, so these may not be available on\nall released versions. For major 1.x versions, minimum minor release including it is **1.4.10**.\nFor major 2.x versions, minimum minor release including it is **2.1.5**."},"16223":{"id":"/docs/single-page-6423","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"\"ignoreTimestamps\" was only added by\nHBASE-24302, so it may not be available on\nall released versions. For major 1.x versions, minimum minor release including it is **1.4.14**.\nFor major 2.x versions, minimum minor release including it is **2.2.5**."},"16224":{"id":"/docs/single-page-6424","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"On Two-Way Replication or other scenarios where both source and target clusters can have data\ningested, it's advisable to always set doDeletes option to false, as any additional cell inserted\non SyncTable target cluster and not yet replicated to source would be deleted, and potentially\nlost permanently."},"16225":{"id":"/docs/single-page-6425","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"Although not required, if sourcezkcluster is not set, SyncTable will connect to local HBase\ncluster for both source and target, which does not give any meaningful result."},"16226":{"id":"/docs/single-page-6426","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#step-2-synctable","content":"Often, remote clusters may be deployed on different Kerberos Realms.\nHBASE-20586 added SyncTable support for cross\nrealm authentication, allowing a SyncTable process running on target cluster to connect to source\ncluster and read both HashTable output files and the given HBase table when performing the\nrequired comparisons."},"16227":{"id":"/docs/single-page-6427","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Export is a utility that will dump the contents of table to HDFS in a sequence file. The Export can be run via a Coprocessor Endpoint or MapReduce. Invoke via:"},"16228":{"id":"/docs/single-page-6428","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"**mapreduce-based Export**"},"16229":{"id":"/docs/single-page-6429","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"**endpoint-based Export**"},"16230":{"id":"/docs/single-page-6430","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Make sure the Export coprocessor is enabled by adding `org.apache.hadoop.hbase.coprocessor.Export`\nto `hbase.coprocessor.region.classes`."},"16231":{"id":"/docs/single-page-6431","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"The outputdir is a HDFS directory that does not exist prior to the export. When done, the exported files will be owned by the user invoking the export command."},"16232":{"id":"/docs/single-page-6432","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"**The Comparison of Endpoint-based Export And Mapreduce-based Export**"},"16233":{"id":"/docs/single-page-6433","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Endpoint-based Export"},"16234":{"id":"/docs/single-page-6434","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Mapreduce-based Export"},"16235":{"id":"/docs/single-page-6435","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"HBase version requirement"},"16236":{"id":"/docs/single-page-6436","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"2.0+"},"16237":{"id":"/docs/single-page-6437","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"0.2.1+"},"16238":{"id":"/docs/single-page-6438","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Maven dependency"},"16239":{"id":"/docs/single-page-6439","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"hbase-endpoint"},"16240":{"id":"/docs/single-page-6440","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"hbase-mapreduce (2.0+), hbase-server(prior to 2.0)"},"16241":{"id":"/docs/single-page-6441","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Requirement before dump"},"16242":{"id":"/docs/single-page-6442","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"mount the endpoint.Export on the target table"},"16243":{"id":"/docs/single-page-6443","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"deploy the MapReduce framework"},"16244":{"id":"/docs/single-page-6444","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Read latency"},"16245":{"id":"/docs/single-page-6445","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"low, directly read the data from region"},"16246":{"id":"/docs/single-page-6446","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"normal, traditional RPC scan"},"16247":{"id":"/docs/single-page-6447","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Read Scalability"},"16248":{"id":"/docs/single-page-6448","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"depend on number of regions"},"16249":{"id":"/docs/single-page-6449","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"depend on number of mappers (see TableInputFormatBase#getSplits)"},"16250":{"id":"/docs/single-page-6450","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Timeout"},"16251":{"id":"/docs/single-page-6451","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"operation timeout. configured by hbase.client.operation.timeout"},"16252":{"id":"/docs/single-page-6452","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"scan timeout. configured by hbase.client.scanner.timeout.period"},"16253":{"id":"/docs/single-page-6453","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Permission requirement"},"16254":{"id":"/docs/single-page-6454","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"READ, EXECUTE"},"16255":{"id":"/docs/single-page-6455","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"READ"},"16256":{"id":"/docs/single-page-6456","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Fault tolerance"},"16257":{"id":"/docs/single-page-6457","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"no"},"16258":{"id":"/docs/single-page-6458","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"depend on MapReduce"},"16259":{"id":"/docs/single-page-6459","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"To see usage instructions, run the command with no options. Available options include specifying\ncolumn families and applying filters during the export."},"16260":{"id":"/docs/single-page-6460","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"By default, the `Export&#x60; tool only exports the newest version of a given cell, regardless of the number of versions stored. To export more than one version, replace &#x2A;**\\<versions>*** with the desired number of versions."},"16261":{"id":"/docs/single-page-6461","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"For mapreduce based Export, if you want to export cell tags then set the following config property `hbase.client.rpc.codec` to `org.apache.hadoop.hbase.codec.KeyValueCodecWithTags`"},"16262":{"id":"/docs/single-page-6462","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export","content":"Note: caching for the input Scan is configured via `hbase.client.scanner.caching` in the job configuration."},"16263":{"id":"/docs/single-page-6463","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#import","content":"Import is a utility that will load data that has been exported back into HBase. Invoke via:"},"16264":{"id":"/docs/single-page-6464","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#import","content":"To import 0.94 exported files in a 0.96 cluster or onwards, you need to set system property \"hbase.import.version\" when running the import command as below:"},"16265":{"id":"/docs/single-page-6465","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#import","content":"If you want to import cell tags then set the following config property `hbase.client.rpc.codec` to `org.apache.hadoop.hbase.codec.KeyValueCodecWithTags`"},"16266":{"id":"/docs/single-page-6466","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv","content":"ImportTsv is a utility that will load data in TSV format into HBase. It has two distinct usages: loading data from TSV format in HDFS into HBase via Puts, and preparing StoreFiles to be loaded via the `completebulkload`."},"16267":{"id":"/docs/single-page-6467","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv","content":"To load data via Puts (i.e., non-bulk loading):"},"16268":{"id":"/docs/single-page-6468","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv","content":"To generate StoreFiles for bulk-loading:"},"16269":{"id":"/docs/single-page-6469","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv","content":"These generated StoreFiles can be loaded into HBase via completebulkload."},"16270":{"id":"/docs/single-page-6470","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv-options","content":"Running `ImportTsv` with no arguments prints brief usage information:"},"16271":{"id":"/docs/single-page-6471","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv-example","content":"For example, assume that we are loading data into a table called 'datatsv' with a ColumnFamily called 'd' with two columns \"c1\" and \"c2\"."},"16272":{"id":"/docs/single-page-6472","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv-example","content":"Assume that an input file exists as follows:"},"16273":{"id":"/docs/single-page-6473","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv-example","content":"For ImportTsv to use this input file, the command line needs to look like this:"},"16274":{"id":"/docs/single-page-6474","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv-example","content":"... and in this example the first column is the rowkey, which is why the HBASE\\_ROW\\_KEY is used. The second and third columns in the file will be imported as \"d:c1\" and \"d:c2\", respectively."},"16275":{"id":"/docs/single-page-6475","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv-warning","content":"If you have preparing a lot of data for bulk loading, make sure the target HBase table is pre-split appropriately."},"16276":{"id":"/docs/single-page-6476","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#importtsv-see-also","content":"For more information about bulk-loading HFiles into HBase, see arch.bulk.load"},"16277":{"id":"/docs/single-page-6477","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#completebulkload","content":"The `completebulkload` utility will move generated StoreFiles into an HBase table. This utility is often used in conjunction with output from importtsv."},"16278":{"id":"/docs/single-page-6478","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#completebulkload","content":"There are two ways to invoke this utility, with explicit classname and via the driver:"},"16279":{"id":"/docs/single-page-6479","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#completebulkload","content":"**Explicit Classname**"},"16280":{"id":"/docs/single-page-6480","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#completebulkload","content":"**Driver**"},"16281":{"id":"/docs/single-page-6481","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#completebulkload-warning","content":"Data generated via MapReduce is often created with file permissions that are not compatible with the running HBase process. Assuming you're running HDFS with permissions enabled, those permissions will need to be updated before you run CompleteBulkLoad."},"16282":{"id":"/docs/single-page-6482","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#completebulkload-warning","content":"For more information about bulk-loading HFiles into HBase, see arch.bulk.load."},"16283":{"id":"/docs/single-page-6483","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"WALPlayer is a utility to replay WAL files into HBase."},"16284":{"id":"/docs/single-page-6484","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"The WAL can be replayed for a set of tables or all tables, and a timerange can be provided (in milliseconds). The WAL is filtered to this set of tables. The output can optionally be mapped to another set of tables."},"16285":{"id":"/docs/single-page-6485","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"WALPlayer can also generate HFiles for later bulk importing, in that case only a single table and no mapping can be specified."},"16286":{"id":"/docs/single-page-6486","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"Finally, you can use WALPlayer to replay the content of a Regions `recovered.edits` directory (the files under `recovered.edits` directory have the same format as WAL files)."},"16287":{"id":"/docs/single-page-6487","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"To read or verify single WAL files or *recovered.edits* files, since they share the WAL format,\nsee WAL Tools."},"16288":{"id":"/docs/single-page-6488","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"Invoke via:"},"16289":{"id":"/docs/single-page-6489","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"For example:"},"16290":{"id":"/docs/single-page-6490","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer","content":"WALPlayer, by default, runs as a mapreduce job. To NOT run WALPlayer as a mapreduce job on your cluster, force it to run all in the local process by adding the flags `-Dmapreduce.jobtracker.address=local` on the command line."},"16291":{"id":"/docs/single-page-6491","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#walplayer-options","content":"Running `WALPlayer` with no arguments prints brief usage information:"},"16292":{"id":"/docs/single-page-6492","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rowcounter","content":"RowCounter is a mapreduce job to count all the rows of a table. This is a good utility to use as a sanity check to ensure that HBase can read all the blocks of a table if there are any concerns of metadata inconsistency. It will run the mapreduce all in a single process but it will run faster if you have a MapReduce cluster in place for it to exploit. It is possible to limit the time range of data to be scanned by using the `--starttime=[starttime]` and `--endtime=[endtime]` flags. The scanned data can be limited based on keys using the `--range=[startKey],[endKey][;[startKey],[endKey]...]` option."},"16293":{"id":"/docs/single-page-6493","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rowcounter","content":"RowCounter only counts one version per cell."},"16294":{"id":"/docs/single-page-6494","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rowcounter","content":"For performance consider to use `-Dhbase.client.scanner.caching=100` and `-Dmapreduce.map.speculative=false` options."},"16295":{"id":"/docs/single-page-6495","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"HBase ships another diagnostic mapreduce job called CellCounter. Like RowCounter, it gathers more fine-grained statistics about your table. The statistics gathered by CellCounter are more fine-grained and include:"},"16296":{"id":"/docs/single-page-6496","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Total number of rows in the table."},"16297":{"id":"/docs/single-page-6497","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Total number of CFs across all rows."},"16298":{"id":"/docs/single-page-6498","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Total qualifiers across all rows."},"16299":{"id":"/docs/single-page-6499","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Total occurrence of each CF."},"16300":{"id":"/docs/single-page-6500","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Total occurrence of each qualifier."},"16301":{"id":"/docs/single-page-6501","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Total number of versions of each qualifier."},"16302":{"id":"/docs/single-page-6502","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"The program allows you to limit the scope of the run. Provide a row regex or prefix to limit the rows to analyze. Specify a time range to scan the table by using the `--starttime=<starttime>` and `--endtime=<endtime>` flags."},"16303":{"id":"/docs/single-page-6503","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Use `hbase.mapreduce.scan.column.family` to specify scanning a single column family."},"16304":{"id":"/docs/single-page-6504","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cellcounter","content":"Note: just like RowCounter, caching for the input Scan is configured via `hbase.client.scanner.caching` in the job configuration."},"16305":{"id":"/docs/single-page-6505","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mlockall","content":"It is possible to optionally pin your servers in physical memory making them less likely to be swapped out in oversubscribed environments by having the servers call mlockall on startup. See HBASE-4391 Add ability to start RS as root and call mlockall for how to build the optional library and have it run on startup."},"16306":{"id":"/docs/single-page-6506","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"**CompactionTool** provides a way of running compactions (either minor or major) as an independent process from the RegionServer. It reuses same internal implementation classes executed by RegionServer compaction feature. However, since this runs on a complete separate independent java process, it releases RegionServers from the overhead involved in rewrite a set of hfiles, which can be critical for latency sensitive use cases."},"16307":{"id":"/docs/single-page-6507","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"Usage:"},"16308":{"id":"/docs/single-page-6508","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"As shown by usage options above, **CompactionTool** can run as a standalone client or a mapreduce job. When running as mapreduce job, each family dir is handled as an input split, and is processed by a separate map task."},"16309":{"id":"/docs/single-page-6509","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"The **compactionOnce** parameter controls how many compaction cycles will be performed until **CompactionTool** program decides to finish its work. If omitted, it will assume it should keep running compactions on each specified family as determined by the given compaction policy configured. For more info on compaction policy, see compaction."},"16310":{"id":"/docs/single-page-6510","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"If a major compaction is desired, **major** flag can be specified. If omitted, **CompactionTool** will assume minor compaction is wanted by default."},"16311":{"id":"/docs/single-page-6511","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"It also allows for configuration overrides with `-D` flag. In the usage section above, for example, `-Dhbase.compactiontool.delete=false` option will instruct compaction engine to not delete original files from temp folder."},"16312":{"id":"/docs/single-page-6512","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"Files targeted for compaction must be specified as parent hdfs dirs. It allows for multiple dirs definition, as long as each for these dirs are either a **family**, a **region**, or a **table** dir. If a table or region dir is passed, the program will recursively iterate through related sub-folders, effectively running compaction for each family found below the table/region level."},"16313":{"id":"/docs/single-page-6513","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"Since these dirs are nested under **hbase** hdfs directory tree, **CompactionTool** requires hbase super user permissions in order to have access to required hfiles."},"16314":{"id":"/docs/single-page-6514","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"MapReduce mode offers the ability to process each family dir in parallel, as a separate map task.\nGenerally, it would make sense to run in this mode when specifying one or more table dirs as\ntargets for compactions. The caveat, though, is that if number of families to be compacted become\ntoo large, the related mapreduce job may have indirect impacts on **RegionServers** performance .\nSince **NodeManagers** are normally co-located with RegionServers, such large jobs could compete\nfor IO/Bandwidth resources with the **RegionServers**."},"16315":{"id":"/docs/single-page-6515","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"**Major compactions** can be a costly operation (see\ncompaction), and can indeed impact performance on\nRegionServers, leading operators to completely disable it for critical low latency application.\n**CompactionTool** could be used as an alternative in such scenarios, although, additional custom\napplication logic would need to be implemented, such as deciding scheduling and selection of\ntables/regions/families target for a given compaction run."},"16316":{"id":"/docs/single-page-6516","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#offline-compaction-tool","content":"For additional details about CompactionTool, see also CompactionTool."},"16317":{"id":"/docs/single-page-6517","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-clean","content":"The `hbase clean` command cleans HBase data from ZooKeeper, HDFS, or both. It is appropriate to use for testing. Run it with no options for usage instructions. The `hbase clean` command was introduced in HBase 0.98."},"16318":{"id":"/docs/single-page-6518","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-pe","content":"The `hbase pe` command runs the PerformanceEvaluation tool, which is used for testing."},"16319":{"id":"/docs/single-page-6519","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-pe","content":"The PerformanceEvaluation tool accepts many different options and commands. For usage instructions, run the command with no options."},"16320":{"id":"/docs/single-page-6520","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-pe","content":"The PerformanceEvaluation tool has received many updates in recent HBase releases, including support for namespaces, support for tags, cell-level ACLs and visibility labels, multiget support for RPC calls, increased sampling sizes, an option to randomly sleep during testing, and ability to \"warm up\" the cluster before testing starts."},"16321":{"id":"/docs/single-page-6521","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-ltt","content":"The `hbase ltt` command runs the LoadTestTool utility, which is used for testing."},"16322":{"id":"/docs/single-page-6522","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-ltt","content":"You must specify either `-init_only` or at least one of `-write`, `-update`, or `-read`. For general usage instructions, pass the `-h` option."},"16323":{"id":"/docs/single-page-6523","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-ltt","content":"The LoadTestTool has received many updates in recent HBase releases, including support for namespaces, support for tags, cell-level ACLS and visibility labels, testing security-related features, ability to specify the number of regions per server, tests for multi-get RPC calls, and tests relating to replication."},"16324":{"id":"/docs/single-page-6524","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pre-upgrade-validator","content":"Pre-Upgrade validator tool can be used to check the cluster for known incompatibilities before upgrading from HBase 1 to HBase 2."},"16325":{"id":"/docs/single-page-6525","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coprocessor-validation","content":"HBase supports co-processors for a long time, but the co-processor API can be changed between major releases. Co-processor validator tries to determine whether the old co-processors are still compatible with the actual HBase version."},"16326":{"id":"/docs/single-page-6526","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coprocessor-validation","content":"The co-processor classes can be explicitly declared by `-class` option, or they can be obtained from HBase configuration by `-config` option. Table level co-processors can be also checked by `-table` option. The tool searches for co-processors on its classpath, but it can be extended by the `-jar` option. It is possible to test multiple classes with multiple `-class`, multiple tables with multiple `-table` options as well as adding multiple jars to the classpath with multiple `-jar` options."},"16327":{"id":"/docs/single-page-6527","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coprocessor-validation","content":"The tool can report errors and warnings. Errors mean that HBase won't be able to load the coprocessor, because it is incompatible with the current version of HBase. Warnings mean that the co-processors can be loaded, but they won't work as expected. If `-e` option is given, then the tool will also fail for warnings."},"16328":{"id":"/docs/single-page-6528","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coprocessor-validation","content":"Please note that this tool cannot validate every aspect of jar files, it just does some static checks."},"16329":{"id":"/docs/single-page-6529","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coprocessor-validation","content":"For example:"},"16330":{"id":"/docs/single-page-6530","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coprocessor-validation","content":"It validates `MyMasterObserver` and `MyRegionObserver` classes which are located in `my-coprocessor.jar`."},"16331":{"id":"/docs/single-page-6531","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#coprocessor-validation","content":"It validates every table level co-processors where the table name matches to `.*` regular expression."},"16332":{"id":"/docs/single-page-6532","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#datablockencoding-validation","content":"HBase 2.0 removed `PREFIX_TREE` Data Block Encoding from column families. For further information please check *prefix-tree* encoding removed. To verify that none of the column families are using incompatible Data Block Encodings in the cluster run the following command."},"16333":{"id":"/docs/single-page-6533","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#datablockencoding-validation","content":"This check validates all column families and print out any incompatibilities. For example:"},"16334":{"id":"/docs/single-page-6534","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#datablockencoding-validation","content":"Which means that Data Block Encoding of table `t`, column family `f` is incompatible. To fix, use `alter` command in HBase shell:"},"16335":{"id":"/docs/single-page-6535","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#datablockencoding-validation","content":"Please also validate HFiles, which is described in the next section."},"16336":{"id":"/docs/single-page-6536","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hfile-content-validation","content":"Even though Data Block Encoding is changed from `PREFIX_TREE` it is still possible to have HFiles that contain data encoded that way. To verify that HFiles are readable with HBase 2 please use *HFile content validator*."},"16337":{"id":"/docs/single-page-6537","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hfile-content-validation","content":"The tool will log the corrupt HFiles and details about the root cause. If the problem is about PREFIX\\_TREE encoding it is necessary to change encodings before upgrading to HBase 2."},"16338":{"id":"/docs/single-page-6538","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hfile-content-validation","content":"The following log message shows an example of incorrect HFiles."},"16339":{"id":"/docs/single-page-6539","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#fixing-prefix_tree-errors","content":"It's possible to get `PREFIX_TREE` errors after changing Data Block Encoding to a supported one. It can happen because there are some HFiles which still encoded with `PREFIX_TREE` or there are still some snapshots."},"16340":{"id":"/docs/single-page-6540","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#fixing-prefix_tree-errors","content":"For fixing HFiles, please run a major compaction on the table (it was `default:t` according to the log message):"},"16341":{"id":"/docs/single-page-6541","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#fixing-prefix_tree-errors","content":"HFiles can be referenced from snapshots, too. It's the case when the HFile is located under `archive/data`. The first step is to determine which snapshot references that HFile (the name of the file was `29c641ae91c34fc3bee881f45436b6d1` according to the logs):"},"16342":{"id":"/docs/single-page-6542","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#fixing-prefix_tree-errors","content":"The output of this shell script is:"},"16343":{"id":"/docs/single-page-6543","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#fixing-prefix_tree-errors","content":"Which means `t_snap` snapshot references the incompatible HFile. If the snapshot is still needed, then it has to be recreated with HBase shell:"},"16344":{"id":"/docs/single-page-6544","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#fixing-prefix_tree-errors","content":"For further information, please refer to HBASE-20649."},"16345":{"id":"/docs/single-page-6545","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#data-block-encoding-tool","content":"Tests various compression algorithms with different data block encoder for key compression on an existing HFile. Useful for testing, debugging and benchmarking."},"16346":{"id":"/docs/single-page-6546","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#data-block-encoding-tool","content":"You must specify `-f` which is the full path of the HFile."},"16347":{"id":"/docs/single-page-6547","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#data-block-encoding-tool","content":"The result shows both the performance (MB/s) of compression/decompression and encoding/decoding, and the data savings on the HFile."},"16348":{"id":"/docs/single-page-6548","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-conf-tool","content":"HBase Conf tool can be used to print out the current value of a configuration. It can be used by passing the configuration key on the command-line."},"16349":{"id":"/docs/single-page-6549","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"You can stop an individual RegionServer by running the following script in the HBase directory on the particular node:"},"16350":{"id":"/docs/single-page-6550","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"The RegionServer will first close all regions and then shut itself down. On shutdown, the RegionServer's ephemeral node in ZooKeeper will expire. The master will notice the RegionServer gone and will treat it as a 'crashed' server; it will reassign the nodes the RegionServer was carrying."},"16351":{"id":"/docs/single-page-6551","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"If the load balancer runs while a node is shutting down, then there could be contention between\nthe Load Balancer and the Master's recovery of the just decommissioned RegionServer. Avoid any\nproblems by disabling the balancer first. See the \"Load Balancer\" info section below."},"16352":{"id":"/docs/single-page-6552","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"In hbase-2.0, in the bin directory, we added a script named *considerAsDead.sh* that can be used\nto kill a regionserver. Hardware issues could be detected by specialized monitoring tools before\nthe zookeeper timeout has expired. *considerAsDead.sh* is a simple function to mark a RegionServer\nas dead. It deletes all the znodes of the server, starting the recovery process. Plug in the\nscript into your monitoring/fault detection tools to initiate faster failover. Be careful how you\nuse this disruptive tool. Copy the script if you need to make use of it in a version of hbase\nprevious to hbase-2.0."},"16353":{"id":"/docs/single-page-6553","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"A downside to the above stop of a RegionServer is that regions could be offline for a good period of time. Regions are closed in order. If many regions on the server, the first region to close may not be back online until all regions close and after the master notices the RegionServer's znode gone. A node can be asked to gradually shed its load and then shutdown itself using the *graceful\\_stop.sh* script. Here is its usage:"},"16354":{"id":"/docs/single-page-6554","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"To decommission a loaded RegionServer, run the following: \\$ ./bin/graceful\\_stop.sh HOSTNAME where `HOSTNAME` is the host carrying the RegionServer you would decommission."},"16355":{"id":"/docs/single-page-6555","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"The `HOSTNAME` passed to *graceful\\_stop.sh* must match the hostname that hbase is using to\nidentify RegionServers. HBase uses fully-qualified domain names usually. Check the list of\nRegionServers in the master UI for how HBase is referring to servers. Whatever HBase is using,\nthis is what you should pass the *graceful\\_stop.sh* decommission script. If you pass IPs, the\nscript is not yet smart enough to make a hostname (or FQDN) of it and so it will fail when it\nchecks if server is currently running; the graceful unloading of regions will not run."},"16356":{"id":"/docs/single-page-6556","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"The *graceful\\_stop.sh* script will move the regions off the decommissioned RegionServer one at a time to minimize region churn. It will verify the region deployed in the new location before it will moves the next region and so on until the decommissioned server is carrying zero regions. At this point, the *graceful\\_stop.sh* tells the RegionServer `stop`. The master will at this point notice the RegionServer gone but all regions will have already been redeployed and because the RegionServer went down cleanly, there will be no WAL logs to split."},"16357":{"id":"/docs/single-page-6557","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"It is assumed that the Region Load Balancer is disabled while the `graceful_stop` script runs (otherwise the balancer and the decommission script will end up fighting over region deployments). Use the shell to disable the balancer:"},"16358":{"id":"/docs/single-page-6558","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"This turns the balancer OFF. To reenable, do:"},"16359":{"id":"/docs/single-page-6559","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#node-decommission","content":"The `graceful_stop` will check the balancer and if enabled, will turn it off before it goes to work. If it exits prematurely because of error, it will not have reset the balancer. Hence, it is better to manage the balancer apart from `graceful_stop` reenabling it after you are done w/ graceful\\_stop."},"16360":{"id":"/docs/single-page-6560","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#decommissioning-several-regions-servers-concurrently","content":"If you have a large cluster, you may want to decommission more than one machine at a time by gracefully stopping multiple RegionServers concurrently. To gracefully drain multiple regionservers at the same time, RegionServers can be put into a \"draining\" state. This is done by marking a RegionServer as a draining node by creating an entry in ZooKeeper under the *hbase\\_root/draining* znode. This znode has format `name,port,startcode` just like the regionserver entries under *hbase\\_root/rs* znode."},"16361":{"id":"/docs/single-page-6561","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#decommissioning-several-regions-servers-concurrently","content":"Without this facility, decommissioning multiple nodes may be non-optimal because regions that are being drained from one region server may be moved to other regionservers that are also draining. Marking RegionServers to be in the draining state prevents this from happening. See this blog post for more details."},"16362":{"id":"/docs/single-page-6562","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bad-or-failing-disk","content":"It is good having dfs.datanode.failed.volumes.tolerated set if you have a decent number of disks per machine for the case where a disk plain dies. But usually disks do the \"John Wayne\" — i.e. take a while to go down spewing errors in *dmesg* — or for some reason, run much slower than their companions. In this case you want to decommission the disk. You have two options. You can decommission the datanode or, less disruptive in that only the bad disks data will be rereplicated, can stop the datanode, unmount the bad volume (You can't umount a volume while the datanode is using it), and then restart the datanode (presuming you have set dfs.datanode.failed.volumes.tolerated > 0). The regionserver will throw some errors in its logs as it recalibrates where to get its data from — it will likely roll its WAL log too — but in general but for some latency spikes, it should keep on chugging."},"16363":{"id":"/docs/single-page-6563","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#bad-or-failing-disk","content":"If you are doing short-circuit reads, you will have to move the regions off the regionserver\nbefore you stop the datanode; when short-circuiting reading, though chmod'd so regionserver cannot\nhave access, because it already has the files open, it will be able to keep reading the file\nblocks from the bad disk even though the datanode is down. Move the regions back after you restart\nthe datanode."},"16364":{"id":"/docs/single-page-6564","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rolling-restart","content":"Some cluster configuration changes require either the entire cluster, or the RegionServers, to be restarted in order to pick up the changes. In addition, rolling restarts are supported for upgrading to a minor or maintenance release, and to a major release if at all possible. See the release notes for release you want to upgrade to, to find out about limitations to the ability to perform a rolling upgrade."},"16365":{"id":"/docs/single-page-6565","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rolling-restart","content":"There are multiple ways to restart your cluster nodes, depending on your situation. These methods are detailed below."},"16366":{"id":"/docs/single-page-6566","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-the-rolling-restartsh-script","content":"HBase ships with a script, *bin/rolling-restart.sh*, that allows you to perform rolling restarts on the entire cluster, the master only, or the RegionServers only. The script is provided as a template for your own script, and is not explicitly tested. It requires password-less SSH login to be configured and assumes that you have deployed using a tarball. The script requires you to set some environment variables before running it. Examine the script and modify it to suit your needs."},"16367":{"id":"/docs/single-page-6567","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-the-rolling-restartsh-script","content":"***rolling-restart.sh* General Usage**"},"16368":{"id":"/docs/single-page-6568","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-the-rolling-restartsh-script","content":"**Rolling Restart on RegionServers Only**\\\nTo perform a rolling restart on the RegionServers only, use the `--rs-only` option. This might be necessary if you need to reboot the individual RegionServer or if you make a configuration change that only affects RegionServers and not the other HBase processes."},"16369":{"id":"/docs/single-page-6569","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-the-rolling-restartsh-script","content":"**Rolling Restart on Masters Only**\\\nTo perform a rolling restart on the active and backup Masters, use the `--master-only` option. You might use this if you know that your configuration change only affects the Master and not the RegionServers, or if you need to restart the server where the active Master is running."},"16370":{"id":"/docs/single-page-6570","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-the-rolling-restartsh-script","content":"**Graceful Restart**\\\nIf you specify the `--graceful` option, RegionServers are restarted using the *bin/graceful\\_stop.sh* script, which moves regions off a RegionServer before restarting it. This is safer, but can delay the restart."},"16371":{"id":"/docs/single-page-6571","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-the-rolling-restartsh-script","content":"Limiting the Number of Threads\\\nTo limit the rolling restart to using only a specific number of threads, use the `--maxthreads` option."},"16372":{"id":"/docs/single-page-6572","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#manual-rolling-restart","content":"To retain more control over the process, you may wish to manually do a rolling restart across your cluster. This uses the `graceful-stop.sh` command decommission. In this method, you can restart each RegionServer individually and then move its old regions back into place, retaining locality. If you also need to restart the Master, you need to do it separately, and restart the Master before restarting the RegionServers using this method. The following is an example of such a command. You may need to tailor it to your environment. This script does a rolling restart of RegionServers only. It disables the load balancer before moving the regions."},"16373":{"id":"/docs/single-page-6573","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#manual-rolling-restart","content":"Monitor the output of the */tmp/log.txt* file to follow the progress of the script."},"16374":{"id":"/docs/single-page-6574","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logic-for-crafting-your-own-rolling-restart-script","content":"Use the following guidelines if you want to create your own rolling restart script."},"16375":{"id":"/docs/single-page-6575","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logic-for-crafting-your-own-rolling-restart-script","content":"Extract the new release, verify its configuration, and synchronize it to all nodes of your cluster using `rsync`, `scp`, or another secure synchronization mechanism."},"16376":{"id":"/docs/single-page-6576","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logic-for-crafting-your-own-rolling-restart-script","content":"Restart the master first. You may need to modify these commands if your new HBase directory is different from the old one, such as for an upgrade."},"16377":{"id":"/docs/single-page-6577","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logic-for-crafting-your-own-rolling-restart-script","content":"Gracefully restart each RegionServer, using a script such as the following, from the Master."},"16378":{"id":"/docs/single-page-6578","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logic-for-crafting-your-own-rolling-restart-script","content":"If you are running Thrift or REST servers, pass the --thrift or --rest options. For other available options, run the `bin/graceful-stop.sh --help` command."},"16379":{"id":"/docs/single-page-6579","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logic-for-crafting-your-own-rolling-restart-script","content":"It is important to drain HBase regions slowly when restarting multiple RegionServers. Otherwise, multiple regions go offline simultaneously and must be reassigned to other nodes, which may also go offline soon. This can negatively affect performance. You can inject delays into the script above, for instance, by adding a Shell command such as `sleep`. To wait for 5 minutes between each RegionServer restart, modify the above script to the following:"},"16380":{"id":"/docs/single-page-6580","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logic-for-crafting-your-own-rolling-restart-script","content":"Restart the Master again, to clear out the dead servers list and re-enable the load balancer."},"16381":{"id":"/docs/single-page-6581","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#adding-a-new-node","content":"Adding a new regionserver in HBase is essentially free, you simply start it like this: `$ ./bin/hbase-daemon.sh start regionserver` and it will register itself with the master. Ideally you also started a DataNode on the same machine so that the RS can eventually start to have local files. If you rely on ssh to start your daemons, don't forget to add the new hostname in *conf/regionservers* on the master."},"16382":{"id":"/docs/single-page-6582","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#adding-a-new-node","content":"At this point the region server isn't serving data because no regions have moved to it yet. If the balancer is enabled, it will start moving regions to the new RS. On a small/medium cluster this can have a very adverse effect on latency as a lot of regions will be offline at the same time. It is thus recommended to disable the balancer the same way it's done when decommissioning a node and move the regions manually (or even better, using a script that moves them one by one)."},"16383":{"id":"/docs/single-page-6583","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#adding-a-new-node","content":"The moved regions will all have 0% locality and won't have any blocks in cache so the region server will have to use the network to serve requests. Apart from resulting in higher latency, it may also be able to use all of your network card's capacity. For practical purposes, consider that a standard 1GigE NIC won't be able to read much more than *100MB/s*. In this case, or if you are in a OLAP environment and require having locality, then it is recommended to major compact the moved regions."},"16384":{"id":"/docs/single-page-6584","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-metrics","content":"HBase emits metrics which adhere to the Hadoop Metrics API. Starting with HBase 0.95 [^5], HBase is configured to emit a default set of metrics with a default sampling period of every 10 seconds. You can use HBase metrics in conjunction with Ganglia. You can also filter which metrics are emitted and extend the metrics framework to capture custom metrics appropriate for your environment."},"16385":{"id":"/docs/single-page-6585","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#metric-setup","content":"For HBase 0.95 and newer, HBase ships with a default metrics configuration, or &#x2A;**sink***. This includes a wide variety of individual metrics, and emits them every 10 seconds by default. To configure metrics for a given region server, edit the *conf/hadoop-metrics2-hbase.properties* file. Restart the region server for the changes to take effect."},"16386":{"id":"/docs/single-page-6586","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#metric-setup","content":"To change the sampling rate for the default sink, edit the line beginning with `*.period`. To filter which metrics are emitted or to extend the metrics framework, see https\\://hadoop.apache.org/docs/current/api/org/apache/hadoop/metrics2/package-summary.html"},"16387":{"id":"/docs/single-page-6587","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#metric-setup","content":"By default, HBase emits a large number of metrics per region server. Ganglia may have difficulty\nprocessing all these metrics. Consider increasing the capacity of the Ganglia server or reducing\nthe number of metrics emitted by HBase. See Metrics\nFiltering."},"16388":{"id":"/docs/single-page-6588","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#disabling-metrics","content":"To disable metrics for a region server, edit the *conf/hadoop-metrics2-hbase.properties* file and comment out any uncommented lines. Restart the region server for the changes to take effect."},"16389":{"id":"/docs/single-page-6589","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-metrics-servlets","content":"HBase exposes the metrics in many formats such as JSON, prometheus-format through different servlets (`/jmx`, `/metrics`, `/prometheus`). Any of these servlets can be enabled or disabled by the configuration property `hbase.http.metrics.servlets`. The value for the property should be a comma separated list of the servlet aliases which are `{jmx, metrics, prometheus}`. `/jmx`, `/metrics`, `/prometheus` are enabled by default. To get metrics using these servlets access the URL `http://SERVER_HOSTNAME:SERVER_WEB_UI_PORT/endpoint`. Where endpoint is one of `/jmx`, `/metrics`, or `/prometheus`. Eg. `http://my.rs.xyz.com:16030/prometheus`"},"16390":{"id":"/docs/single-page-6590","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#prometheus-servlets","content":"HBase exposes the metrics in prometheus friendly format through a servlet, `/prometheus`. Currently `/prometheus` exposes all the available metrics."},"16391":{"id":"/docs/single-page-6591","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"Rather than listing each metric which HBase emits by default, you can browse through the available metrics, either as a JSON output or via JMX. Different metrics are exposed for the Master process and each region server process."},"16392":{"id":"/docs/single-page-6592","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"**Procedure: Access a JSON Output of Available Metrics**"},"16393":{"id":"/docs/single-page-6593","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"After starting HBase, access the region server's web UI, at http\\://REGIONSERVER\\_HOSTNAME:16030 by default."},"16394":{"id":"/docs/single-page-6594","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"Click the **Metrics Dump** link near the top. The metrics for the region server are presented as a dump of the JMX bean in JSON format. This will dump out all metrics names and their values. To include metrics descriptions in the listing — this can be useful when you are exploring what is available — add a query string of `?description=true` so your URL becomes http\\://REGIONSERVER\\_HOSTNAME:16030/jmx?description=true. Not all beans and attributes have descriptions."},"16395":{"id":"/docs/single-page-6595","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"To view metrics for the Master, connect to the Master's web UI instead (defaults to http\\://localhost:16010) and click its **Metrics Dump** link. To include metrics descriptions in the listing — this can be useful when you are exploring what is available — add a query string of `?description=true` so your URL becomes http\\://REGIONSERVER\\_HOSTNAME:16010/jmx?description=true. Not all beans and attributes have descriptions."},"16396":{"id":"/docs/single-page-6596","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"You can use many different tools to view JMX content by browsing MBeans. This procedure uses `jvisualvm`, which is an application usually available in the JDK."},"16397":{"id":"/docs/single-page-6597","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"**Procedure: Browse the JMX Output of Available Metrics**"},"16398":{"id":"/docs/single-page-6598","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"Start HBase, if it is not already running."},"16399":{"id":"/docs/single-page-6599","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"Run the command `jvisualvm` command on a host with a GUI display. You can launch it from the command line or another method appropriate for your operating system."},"16400":{"id":"/docs/single-page-6600","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"Be sure the **VisualVM-MBeans** plugin is installed. Browse to **Tools → Plugins**. Click **Installed** and check whether the plugin is listed. If not, click **Available Plugins**, select it, and click Install. When finished, click Close."},"16401":{"id":"/docs/single-page-6601","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"To view details for a given HBase process, double-click the process in the **Local** sub-tree in the left-hand panel. A detailed view opens in the right-hand panel. Click the **MBeans** tab which appears as a tab in the top of the right-hand panel."},"16402":{"id":"/docs/single-page-6602","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"To access the HBase metrics, navigate to the appropriate sub-bean: .\\* Master: .\\* RegionServer:"},"16403":{"id":"/docs/single-page-6603","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#discovering-available-metrics","content":"The name of each metric and its current value is displayed in the **Attributes** tab. For a view which includes more details, including the description of each attribute, click the **Metadata** tab."},"16404":{"id":"/docs/single-page-6604","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#units-of-measure-for-metrics","content":"Different metrics are expressed in different units, as appropriate. Often, the unit of measure is in the name (as in the metric `shippedKBs`). Otherwise, use the following guidelines. When in doubt, you may need to examine the source for a given metric."},"16405":{"id":"/docs/single-page-6605","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#units-of-measure-for-metrics","content":"Metrics that refer to a point in time are usually expressed as a timestamp."},"16406":{"id":"/docs/single-page-6606","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#units-of-measure-for-metrics","content":"Metrics that refer to an age (such as `ageOfLastShippedOp`) are usually expressed in milliseconds."},"16407":{"id":"/docs/single-page-6607","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#units-of-measure-for-metrics","content":"Metrics that refer to memory sizes are in bytes."},"16408":{"id":"/docs/single-page-6608","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#units-of-measure-for-metrics","content":"Sizes of queues (such as `sizeOfLogQueue`) are expressed as the number of items in the queue. Determine the size by multiplying by the block size (default is 64 MB in HDFS)."},"16409":{"id":"/docs/single-page-6609","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#units-of-measure-for-metrics","content":"Metrics that refer to things like the number of a given type of operations (such as `logEditsRead`) are expressed as an integer."},"16410":{"id":"/docs/single-page-6610","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-master-metrics","content":"Note: Counts are usually over the last metrics reporting interval."},"16411":{"id":"/docs/single-page-6611","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-master-metrics","content":"**hbase.master.numRegionServers**\\\nNumber of live regionservers"},"16412":{"id":"/docs/single-page-6612","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-master-metrics","content":"**hbase.master.numDeadRegionServers**\\\nNumber of dead regionservers"},"16413":{"id":"/docs/single-page-6613","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-master-metrics","content":"**hbase.master.ritCount**\\\nThe number of regions in transition"},"16414":{"id":"/docs/single-page-6614","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-master-metrics","content":"**hbase.master.ritCountOverThreshold**\\\nThe number of regions that have been in transition longer than a threshold time (default: 60 seconds)"},"16415":{"id":"/docs/single-page-6615","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-master-metrics","content":"**hbase.master.ritOldestAge**\\\nThe age of the longest region in transition, in milliseconds"},"16416":{"id":"/docs/single-page-6616","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"The active, initialized Master exposes numeric switch-state gauges under\n`Hadoop:service=HBase,name=Master,sub=Server`. A value of `1` means enabled and\n`0` means disabled. The gauges are absent on backup Masters and before the Master\nis initialized.\nEnabled states indicate that an operation is permitted, rather than that it is\ncurrently running."},"16417":{"id":"/docs/single-page-6617","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"Gauge"},"16418":{"id":"/docs/single-page-6618","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"HBase shell command"},"16419":{"id":"/docs/single-page-6619","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`balancerEnabled`"},"16420":{"id":"/docs/single-page-6620","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`balance_switch true\\|false`"},"16421":{"id":"/docs/single-page-6621","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`normalizerEnabled`"},"16422":{"id":"/docs/single-page-6622","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`normalizer_switch true\\|false`"},"16423":{"id":"/docs/single-page-6623","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`splitEnabled`"},"16424":{"id":"/docs/single-page-6624","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`splitormerge_switch 'SPLIT', true\\|false`"},"16425":{"id":"/docs/single-page-6625","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`mergeEnabled`"},"16426":{"id":"/docs/single-page-6626","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`splitormerge_switch 'MERGE', true\\|false`"},"16427":{"id":"/docs/single-page-6627","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`cleanerChoreEnabled`"},"16428":{"id":"/docs/single-page-6628","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`cleaner_chore_switch true\\|false`"},"16429":{"id":"/docs/single-page-6629","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`catalogJanitorEnabled`"},"16430":{"id":"/docs/single-page-6630","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`catalogjanitor_switch true\\|false`"},"16431":{"id":"/docs/single-page-6631","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`snapshotCleanupEnabled`"},"16432":{"id":"/docs/single-page-6632","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`snapshot_cleanup_switch true\\|false`"},"16433":{"id":"/docs/single-page-6633","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`replicationPeerModificationEnabled`"},"16434":{"id":"/docs/single-page-6634","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`peer_modification_switch true\\|false`"},"16435":{"id":"/docs/single-page-6635","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`rpcThrottleEnabled`"},"16436":{"id":"/docs/single-page-6636","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"`enable_rpc_throttle` / `disable_rpc_throttle`"},"16437":{"id":"/docs/single-page-6637","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"The gauges follow the corresponding enabled-state queries. Maintenance mode\ndisables the balancer, normalizer, split, and merge states. Per-table settings can\nfurther restrict these operations. The cleaner state covers the default HFile\ncleaner and the WAL cleaner. The existing `tag.isBalancerActive` tag under\n`Master,sub=Balancer` remains available."},"16438":{"id":"/docs/single-page-6638","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-switch-states","content":"All switch states are read from memory during metrics collection.\nWhen quota support is disabled, `rpcThrottleEnabled` is `0`. With quota support\nenabled, it is omitted while the quota manager is unavailable, including in\nMaster maintenance mode."},"16439":{"id":"/docs/single-page-6639","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"Note: Counts are usually over the last metrics reporting interval."},"16440":{"id":"/docs/single-page-6640","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.regionCount**\\\nThe number of regions hosted by the regionserver"},"16441":{"id":"/docs/single-page-6641","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.storeFileCount**\\\nThe number of store files on disk currently managed by the regionserver"},"16442":{"id":"/docs/single-page-6642","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.storeFileSize**\\\nAggregate size of the store files on disk"},"16443":{"id":"/docs/single-page-6643","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.hlogFileCount**\\\nThe number of write ahead logs not yet archived"},"16444":{"id":"/docs/single-page-6644","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.totalRequestCount**\\\nThe total number of requests received"},"16445":{"id":"/docs/single-page-6645","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.readRequestCount**\\\nThe number of read requests received"},"16446":{"id":"/docs/single-page-6646","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.writeRequestCount**\\\nThe number of write requests received"},"16447":{"id":"/docs/single-page-6647","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.numOpenConnections**\\\nThe number of open connections at the RPC layer"},"16448":{"id":"/docs/single-page-6648","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.numActiveHandler**\\\nThe number of RPC handlers actively servicing requests"},"16449":{"id":"/docs/single-page-6649","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.numCallsInGeneralQueue**\\\nThe number of currently enqueued user requests"},"16450":{"id":"/docs/single-page-6650","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.numCallsInReplicationQueue**\\\nThe number of currently enqueued operations received from replication"},"16451":{"id":"/docs/single-page-6651","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.numCallsInPriorityQueue**\\\nThe number of currently enqueued priority (internal housekeeping) requests"},"16452":{"id":"/docs/single-page-6652","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.flushQueueLength**\\\nCurrent depth of the memstore flush queue. If increasing, we are falling behind with clearing memstores out to HDFS."},"16453":{"id":"/docs/single-page-6653","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.updatesBlockedTime**\\\nNumber of milliseconds updates have been blocked so the memstore can be flushed"},"16454":{"id":"/docs/single-page-6654","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.compactionQueueLength**\\\nCurrent depth of the compaction request queue. If increasing, we are falling behind with storefile compaction."},"16455":{"id":"/docs/single-page-6655","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.blockCacheHitCount**\\\nThe number of block cache hits"},"16456":{"id":"/docs/single-page-6656","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.blockCacheMissCount**\\\nThe number of block cache misses"},"16457":{"id":"/docs/single-page-6657","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.blockCacheExpressHitPercent**\\\nThe percent of the time that requests with the cache turned on hit the cache"},"16458":{"id":"/docs/single-page-6658","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.percentFilesLocal**\\\nPercent of store file data that can be read from the local DataNode, 0-100"},"16459":{"id":"/docs/single-page-6659","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.\\<op>\\_\\<measure>**\\\nOperation latencies, where \\<op> is one of Append, Delete, Mutate, Get, Replay, Increment; and where \\<measure> is one of min, max, mean, median, 75th\\_percentile, 95th\\_percentile, 99th\\_percentile"},"16460":{"id":"/docs/single-page-6660","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.slow\\<op>Count**\\\nThe number of operations we thought were slow, where \\<op> is one of the list above"},"16461":{"id":"/docs/single-page-6661","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.GcTimeMillis**\\\nTime spent in garbage collection, in milliseconds"},"16462":{"id":"/docs/single-page-6662","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.GcTimeMillisParNew**\\\nTime spent in garbage collection of the young generation, in milliseconds"},"16463":{"id":"/docs/single-page-6663","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.GcTimeMillisConcurrentMarkSweep**\\\nTime spent in garbage collection of the old generation, in milliseconds"},"16464":{"id":"/docs/single-page-6664","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.authenticationSuccesses**\\\nNumber of client connections where authentication succeeded"},"16465":{"id":"/docs/single-page-6665","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.authenticationFailures**\\\nNumber of client connection authentication failures"},"16466":{"id":"/docs/single-page-6666","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#most-important-regionserver-metrics","content":"**hbase.regionserver.mutationsWithoutWALCount**\\\nCount of writes submitted with a flag indicating they should bypass the write ahead log"},"16467":{"id":"/docs/single-page-6667","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"HBase meta table metrics collection feature is available in HBase 1.4+ but it is disabled by default, as it can affect the performance of the cluster. When it is enabled, it helps to monitor client access patterns by collecting the following statistics:"},"16468":{"id":"/docs/single-page-6668","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"number of get, put and delete operations on the `hbase:meta` table"},"16469":{"id":"/docs/single-page-6669","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"number of get, put and delete operations made by the top-N clients"},"16470":{"id":"/docs/single-page-6670","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"number of operations related to each table"},"16471":{"id":"/docs/single-page-6671","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"number of operations related to the top-N regions\\\n**When to use the feature**\\\nThis feature can help to identify hot spots in the meta table by showing the regions or tables where the meta info is modified (e.g. by create, drop, split or move tables) or retrieved most frequently. It can also help to find misbehaving client applications by showing which clients are using the meta table most heavily, which can for example suggest the lack of meta table buffering or the lack of re-using open client connections in the client application."},"16472":{"id":"/docs/single-page-6672","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"Having large number of clients and regions in the cluster can cause the registration and tracking\nof a large amount of metrics, which can increase the memory and CPU footprint of the HBase region\nserver handling the `hbase:meta` table. It can also cause the significant increase of the JMX dump\nsize, which can affect the monitoring or log aggregation system you use beside HBase. It is\nrecommended to turn on this feature only during debugging."},"16473":{"id":"/docs/single-page-6673","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"**Where to find the metrics in JMX**\\\nEach metric attribute name will start with the ‘MetaTable\\_' prefix. For all the metrics you will see five different JMX attributes: count, mean rate, 1 minute rate, 5 minute rate and 15 minute rate. You will find these metrics in JMX under the following MBean: `Hadoop → HBase → RegionServer → Coprocessor.Region.CP_org.apache.hadoop.hbase.coprocessor.MetaTableMetrics`."},"16474":{"id":"/docs/single-page-6674","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"**Examples: some Meta Table metrics you can see in your JMX dump**"},"16475":{"id":"/docs/single-page-6675","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"**Configuration**\\\nTo turn on this feature, you have to enable a custom coprocessor by adding the following section to hbase-site.xml. This coprocessor will run on all the HBase RegionServers, but will be active (i.e. consume memory / CPU) only on the server, where the `hbase:meta` table is located. It will produce JMX metrics which can be downloaded from the web UI of the given RegionServer or by a simple REST call. These metrics will not be present in the JMX dump of the other RegionServers."},"16476":{"id":"/docs/single-page-6676","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"**Enabling the Meta Table Metrics feature**"},"16477":{"id":"/docs/single-page-6677","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"The 'top-N' type of metrics will be counted using the Lossy Counting Algorithm (as defined in Motwani, R; Manku, G.S (2002). \"Approximate frequency counts over data streams\"), which is designed to identify elements in a data stream whose frequency count exceed a user-given threshold. The frequency computed by this algorithm is not always accurate but has an error threshold that can be specified by the user as a configuration parameter. The run time space required by the algorithm is inversely proportional to the specified error threshold, hence larger the error parameter, the smaller the footprint and the less accurate are the metrics."},"16478":{"id":"/docs/single-page-6678","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"You can specify the error rate of the algorithm as a floating-point value between 0 and 1 (exclusive), it's default value is 0.02. Having the error rate set to `E` and having `N` as the total number of meta table operations, then (assuming the uniform distribution of the activity of low frequency elements) at most `7 / E` meters will be kept and each kept element will have a frequency higher than `E * N`."},"16479":{"id":"/docs/single-page-6679","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#meta-table-load-metrics","content":"An example: Let's assume we are interested in the HBase clients that are most active in accessing the meta table. When there was 1,000,000 operations on the meta table so far and the error rate parameter is set to 0.02, then we can assume that only at most 350 client IP address related counters will be present in JMX and each of these clients accessed the meta table at least 20,000 times."},"16480":{"id":"/docs/single-page-6680","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-monitoring-overview","content":"The following metrics are arguably the most important to monitor for each RegionServer for \"macro monitoring\", preferably with a system like OpenTSDB. If your cluster is having performance issues it's likely that you'll see something unusual with this group."},"16481":{"id":"/docs/single-page-6681","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-toc","content":"See rs metrics"},"16482":{"id":"/docs/single-page-6682","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#os-toc","content":"IO Wait"},"16483":{"id":"/docs/single-page-6683","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#os-toc","content":"User CPU"},"16484":{"id":"/docs/single-page-6684","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#java-toc","content":"GC"},"16485":{"id":"/docs/single-page-6685","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#slow-query-log","content":"The HBase slow query log consists of parseable JSON structures describing the properties of those client operations (Gets, Puts, Deletes, etc.) that either took too long to run, or produced too much output. The thresholds for \"too long to run\" and \"too much output\" are configurable, as described below. The output is produced inline in the main region server logs so that it is easy to discover further details from context with other logged events. It is also prepended with identifying tags `(responseTooSlow)`, `(responseTooLarge)`, `(operationTooSlow)`, and `(operationTooLarge)` in order to enable easy filtering with grep, in case the user desires to see only slow queries."},"16486":{"id":"/docs/single-page-6686","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-metrics-and-monitoring-overview-configuration","content":"There are four configuration knobs that can be used to adjust the thresholds for when queries are logged. Two of these knobs control the size and time thresholds for all queries. Because Scans can often be larger and slower than other types of queries, there are two additional knobs which can control size and time thresholds for Scans specifically."},"16487":{"id":"/docs/single-page-6687","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.time` Maximum number of milliseconds that a query can be run without being logged. Defaults to 10000, or 10 seconds. Can be set to -1 to disable logging by time."},"16488":{"id":"/docs/single-page-6688","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.size` Maximum byte size of response that a query can return without being logged. Defaults to 100 megabytes. Can be set to -1 to disable logging by size."},"16489":{"id":"/docs/single-page-6689","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.time.scan` Maximum number of milliseconds that a Scan can be run without being logged. Defaults to the `hbase.ipc.warn.response.time` value. Can be set to -1 to disable logging by time."},"16490":{"id":"/docs/single-page-6690","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.size.scan` Maximum byte size of response that a Scan can return without being logged. Defaults to the `hbase.ipc.warn.response.size` value. Can be set to -1 to disable logging by size."},"16491":{"id":"/docs/single-page-6691","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-hbase-monitoring-slow-query-log-metrics","content":"The slow query log exposes to metrics to JMX."},"16492":{"id":"/docs/single-page-6692","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-hbase-monitoring-slow-query-log-metrics","content":"`hadoop.regionserver_rpc_slowResponse` a global metric reflecting the durations of all responses that triggered logging."},"16493":{"id":"/docs/single-page-6693","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-hbase-monitoring-slow-query-log-metrics","content":"`hadoop.regionserver_rpc_methodName.aboveOneSec` A metric reflecting the durations of all responses that lasted for more than one second."},"16494":{"id":"/docs/single-page-6694","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#output","content":"The output is tagged with operation e.g. `(operationTooSlow)` if the call was a client operation, such as a Put, Get, or Delete, which we expose detailed fingerprint information for. If not, it is tagged `(responseTooSlow)` and still produces parseable JSON output, but with less verbose information solely regarding its duration and size in the RPC itself. `TooLarge` is substituted for `TooSlow` if the response size triggered the logging, with `TooLarge` appearing even in the case that both size and duration triggered logging."},"16495":{"id":"/docs/single-page-6695","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-hbase-monitoring-slow-query-log-example","content":"Note that everything inside the \"tables\" structure is output produced by MultiPut's fingerprint, while the rest of the information is RPC-specific, such as processing time and client IP/port. Other client operations follow the same pattern and the same general structure, with necessary differences due to the nature of the individual operations. In the case that the call is not a client operation, that detailed fingerprint information will be completely absent."},"16496":{"id":"/docs/single-page-6696","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-hbase-monitoring-slow-query-log-example","content":"This particular example, for example, would indicate that the likely cause of slowness is simply a very large (on the order of 100MB) multiput, as we can tell by the \"vlen,\" or value length, fields of each put in the multiPut."},"16497":{"id":"/docs/single-page-6697","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"When an individual RPC exceeds a configurable time bound we log a complaint by way of the logging subsystem"},"16498":{"id":"/docs/single-page-6698","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"e.g."},"16499":{"id":"/docs/single-page-6699","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"Unfortunately often the request parameters are truncated as per above Example. The truncation is unfortunate because it eliminates much of the utility of the warnings. For example, the region name, the start and end keys, and the filter hierarchy are all important clues for debugging performance problems caused by moderate to low selectivity queries or queries made at a high rate."},"16500":{"id":"/docs/single-page-6700","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"HBASE-22978 introduces maintaining an in-memory ring buffer of requests that were judged to be too slow in addition to the responseTooSlow logging. The in-memory representation can be complete. There is some chance a high rate of requests will cause information on other interesting requests to be overwritten before it can be read. This is an acceptable trade off."},"16501":{"id":"/docs/single-page-6701","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"In order to enable the in-memory ring buffer at RegionServers, we need to enable config:"},"16502":{"id":"/docs/single-page-6702","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"One more config determines the size of the ring buffer:"},"16503":{"id":"/docs/single-page-6703","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"Check the config section for the detailed description."},"16504":{"id":"/docs/single-page-6704","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"This config would be disabled by default. Turn it on and these shell commands would provide expected results from the ring-buffers."},"16505":{"id":"/docs/single-page-6705","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"shell commands to retrieve slowlog responses from RegionServers:"},"16506":{"id":"/docs/single-page-6706","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"All of above queries with filters have default OR operation applied i.e. all records with any of the provided filters applied will be returned. However, we can also apply AND operator i.e. all records that match all (not any) of the provided filters should be returned."},"16507":{"id":"/docs/single-page-6707","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"Since OR is the default filter operator, without providing 'FILTER\\_BY\\_OP', query will have same result as providing 'FILTER\\_BY\\_OP' ⇒ 'OR'."},"16508":{"id":"/docs/single-page-6708","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"Sometimes output can be long pretty printed json for user to scroll in a single screen and hence user might prefer redirecting output of get\\_slowlog\\_responses to a file."},"16509":{"id":"/docs/single-page-6709","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"Example:"},"16510":{"id":"/docs/single-page-6710","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"Similar to slow RPC logs, client can also retrieve large RPC logs. Sometimes, slow logs important to debug perf issues turn out to be larger in size."},"16511":{"id":"/docs/single-page-6711","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slow-response-log-from-shell","content":"shell command to clear slow/largelog responses from RegionServer:"},"16512":{"id":"/docs/single-page-6712","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"The above section provides details about Admin APIs:"},"16513":{"id":"/docs/single-page-6713","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"get\\_slowlog\\_responses"},"16514":{"id":"/docs/single-page-6714","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"get\\_largelog\\_responses"},"16515":{"id":"/docs/single-page-6715","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"clear\\_slowlog\\_responses"},"16516":{"id":"/docs/single-page-6716","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"All of the above APIs access online in-memory ring buffers from individual RegionServers and accumulate logs from ring buffers to display to end user. However, since the logs are stored in memory, after RegionServer is restarted, all the objects held in memory of that RegionServer will be cleaned up and previous logs are lost. What if we want to persist all these logs forever? What if we want to store them in such a manner that operator can get all historical records with some filters? e.g get me all large/slow RPC logs that are triggered by user1 and are related to region: cluster\\_test,cccccccc,1589635796466.aa45e1571d533f5ed0bb31cdccaaf9cf. ?"},"16517":{"id":"/docs/single-page-6717","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"If we have a system table that stores such logs in increasing (not so strictly though) order of time, it can definitely help operators debug some historical events (scan, get, put, compaction, flush etc) with detailed inputs."},"16518":{"id":"/docs/single-page-6718","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"Config which enabled system table to be created and store all log events is `hbase.regionserver.slowlog.systable.enabled`."},"16519":{"id":"/docs/single-page-6719","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"The default value for this config is `false`. If provided `true` (Note: `hbase.regionserver.slowlog.buffer.enabled` should also be `true`), a cron job running in every RegionServer will persist the slow/large logs into table hbase:slowlog. By default cron job runs every 10 min. Duration can be configured with key: `hbase.slowlog.systable.chore.duration`. By default, RegionServer will store upto 1000(config key: `hbase.regionserver.slowlog.systable.queue.size`) slow/large logs in an internal queue and the chore will retrieve these logs from the queue and perform batch insertion in hbase:slowlog."},"16520":{"id":"/docs/single-page-6720","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"hbase:slowlog has single ColumnFamily: `info` `info` contains multiple qualifiers which are the same attributes present as part of `get_slowlog_responses` API response."},"16521":{"id":"/docs/single-page-6721","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:call\\_details"},"16522":{"id":"/docs/single-page-6722","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:client\\_address"},"16523":{"id":"/docs/single-page-6723","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:method\\_name"},"16524":{"id":"/docs/single-page-6724","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:param"},"16525":{"id":"/docs/single-page-6725","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:processing\\_time"},"16526":{"id":"/docs/single-page-6726","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:queue\\_time"},"16527":{"id":"/docs/single-page-6727","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:region\\_name"},"16528":{"id":"/docs/single-page-6728","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:response\\_size"},"16529":{"id":"/docs/single-page-6729","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:server\\_class"},"16530":{"id":"/docs/single-page-6730","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:start\\_time"},"16531":{"id":"/docs/single-page-6731","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:type"},"16532":{"id":"/docs/single-page-6732","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:username"},"16533":{"id":"/docs/single-page-6733","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"And example of 2 rows from hbase:slowlog scan result:"},"16534":{"id":"/docs/single-page-6734","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"Operator can use ColumnValueFilter to filter records based on region\\_name, username, client\\_address etc."},"16535":{"id":"/docs/single-page-6735","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"Time range based queries will also be very useful. Example:"},"16536":{"id":"/docs/single-page-6736","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#block-cache-monitoring","content":"Starting with HBase 0.98, the HBase Web UI includes the ability to monitor and report on the performance of the block cache. To view the block cache reports, see the Block Cache section of the region server UI. Following are a few examples of the reporting capabilities."},"16537":{"id":"/docs/single-page-6737","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#block-cache-monitoring","content":"***Basic Info shows the cache implementation.***"},"16538":{"id":"/docs/single-page-6738","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#block-cache-monitoring","content":"***Config shows all cache configuration options.***"},"16539":{"id":"/docs/single-page-6739","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#block-cache-monitoring","content":"***Stats shows statistics about the performance of the cache.***"},"16540":{"id":"/docs/single-page-6740","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#block-cache-monitoring","content":"***L1 and L2 show information about the L1 and L2 caches.***"},"16541":{"id":"/docs/single-page-6741","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#block-cache-monitoring","content":"This is not an exhaustive list of all the screens and reports available. Have a look in the Web UI."},"16542":{"id":"/docs/single-page-6742","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"Starting with HBase 0.95, Snapshot usage information on individual snapshots was shown in the HBase Master Web UI. This was further enhanced starting with HBase 1.3 to show the total Storefile size of the Snapshot Set. The following metrics are shown in the Master Web UI with HBase 1.3 and later."},"16543":{"id":"/docs/single-page-6743","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"Shared Storefile Size is the Storefile size shared between snapshots and active tables."},"16544":{"id":"/docs/single-page-6744","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"Mob Storefile Size is the Mob Storefile size shared between snapshots and active tables."},"16545":{"id":"/docs/single-page-6745","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"Archived Storefile Size is the Storefile size in Archive."},"16546":{"id":"/docs/single-page-6746","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"The format of Archived Storefile Size is NNN(MMM). NNN is the total Storefile size in Archive, MMM is the total Storefile size in Archive that is specific to the snapshot (not shared with other snapshots and tables)."},"16547":{"id":"/docs/single-page-6747","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"***Master Snapshot Overview***"},"16548":{"id":"/docs/single-page-6748","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"***Snapshot Storefile Stats Example 1***"},"16549":{"id":"/docs/single-page-6749","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"***Snapshot Storefile Stats Example 2***"},"16550":{"id":"/docs/single-page-6750","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"***Empty Snapshot Storfile Stats Example***"},"16551":{"id":"/docs/single-page-6751","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshot-space-usage-monitoring","content":"The Metrics system was redone in HBase 0.96. See Migration to the New Metrics Hotness – Metrics2 by Elliot Clark for detail."},"16552":{"id":"/docs/single-page-6752","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"HBase provides a cluster replication mechanism which allows you to keep one cluster's state synchronized with that of another cluster, using the write-ahead log (WAL) of the source cluster to propagate the changes. Some use cases for cluster replication include:"},"16553":{"id":"/docs/single-page-6753","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"Backup and disaster recovery"},"16554":{"id":"/docs/single-page-6754","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"Data aggregation"},"16555":{"id":"/docs/single-page-6755","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"Geographic data distribution"},"16556":{"id":"/docs/single-page-6756","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"Online data ingestion combined with offline data analytics"},"16557":{"id":"/docs/single-page-6757","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"Replication is enabled at the granularity of the column family. Before enabling replication for a\ncolumn family, create the table and all column families to be replicated, on the destination\ncluster."},"16558":{"id":"/docs/single-page-6758","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"Replication is asynchronous as we send WAL to another cluster in background, which means that when\nyou want to do recovery through replication, you could loss some data. To address this problem, we\nhave introduced a new feature called synchronous replication. As the mechanism is a bit different\nso we use a separated section to describe it. Please see Synchronous\nReplication."},"16559":{"id":"/docs/single-page-6759","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-replication","content":"At present, there is compatibility problem if Replication and WAL Compression are used together.\nIf you need to use Replication, it is recommended to set the\n`hbase.regionserver.wal.enablecompression` property to `false`. See\n(HBASE-26849) for details."},"16560":{"id":"/docs/single-page-6760","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"Cluster replication uses a source-push methodology. An HBase cluster can be a source (also called master or active, meaning that it is the originator of new data), a destination (also called slave or passive, meaning that it receives data via replication), or can fulfill both roles at once. Replication is asynchronous, and the goal of replication is eventual consistency. When the source receives an edit to a column family with replication enabled, that edit is propagated to all destination clusters using the WAL for that for that column family on the RegionServer managing the relevant region."},"16561":{"id":"/docs/single-page-6761","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"When data is replicated from one cluster to another, the original source of the data is tracked via a cluster ID which is part of the metadata. In HBase 0.96 and newer (HBASE-7709), all clusters which have already consumed the data are also tracked. This prevents replication loops."},"16562":{"id":"/docs/single-page-6762","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"The WALs for each region server must be kept in HDFS as long as they are needed to replicate data to any slave cluster. Each region server reads from the oldest log it needs to replicate and keeps track of its progress processing WALs inside ZooKeeper to simplify failure recovery. The position marker which indicates a slave cluster's progress, as well as the queue of WALs to process, may be different for every slave cluster."},"16563":{"id":"/docs/single-page-6763","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"The clusters participating in replication can be of different sizes. The master cluster relies on randomization to attempt to balance the stream of replication on the slave clusters. It is expected that the slave cluster has storage capacity to hold the replicated data, as well as any data it is responsible for ingesting. If a slave cluster does run out of room, or is inaccessible for other reasons, it throws an error and the master retains the WAL and retries the replication at intervals."},"16564":{"id":"/docs/single-page-6764","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"How your application builds on top of the HBase API matters when replication is in play. HBase's replication system provides at-least-once delivery of client edits for an enabled column family to each configured destination cluster. In the event of failure to reach a given destination, the replication system will retry sending edits in a way that might repeat a given message. HBase provides two ways of replication, one is the original replication and the other is serial replication. In the previous way of replication, there is not a guaranteed order of delivery for client edits. In the event of a RegionServer failing, recovery of the replication queue happens independent of recovery of the individual regions that server was previously handling. This means that it is possible for the not-yet-replicated edits to be serviced by a RegionServer that is currently slower to replicate than the one that handles edits from after the failure."},"16565":{"id":"/docs/single-page-6765","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"The combination of these two properties (at-least-once delivery and the lack of message ordering) means that some destination clusters may end up in a different state if your application makes use of operations that are not idempotent, e.g. Increments."},"16566":{"id":"/docs/single-page-6766","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"To solve the problem, HBase now supports serial replication, which sends edits to destination cluster as the order of requests from client. See Serial Replication."},"16567":{"id":"/docs/single-page-6767","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-overview","content":"Previously, terms such as **master-master**, **master-slave**, and **cyclical** were used to\ndescribe replication relationships in HBase. These terms added confusion, and have been abandoned\nin favor of discussions about cluster topologies appropriate for different scenarios."},"16568":{"id":"/docs/single-page-6768","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-topologies","content":"A central source cluster might propagate changes out to multiple destination clusters, for failover or due to geographic distribution."},"16569":{"id":"/docs/single-page-6769","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-topologies","content":"A source cluster might push changes to a destination cluster, which might also push its own changes back to the original cluster."},"16570":{"id":"/docs/single-page-6770","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-topologies","content":"Many different low-latency clusters might push changes to one centralized cluster for backup or resource-intensive data analytics jobs. The processed data might then be replicated back to the low-latency clusters."},"16571":{"id":"/docs/single-page-6771","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-topologies","content":"Multiple levels of replication may be chained together to suit your organization's needs. The following diagram shows a hypothetical scenario. Use the arrows to follow the data paths."},"16572":{"id":"/docs/single-page-6772","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-topologies","content":"***Example of a Complex Cluster Replication Configuration***"},"16573":{"id":"/docs/single-page-6773","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-topologies","content":"HBase replication borrows many concepts from the **statement-based replication** design used by MySQL. Instead of SQL statements, entire WALEdits (consisting of multiple cell inserts coming from Put and Delete operations on the clients) are replicated in order to maintain atomicity."},"16574":{"id":"/docs/single-page-6774","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-configuration-overview","content":"Configure and start the source and destination clusters. Create tables with the same names and column families on both the source and destination clusters, so that the destination cluster knows where to store data it will receive."},"16575":{"id":"/docs/single-page-6775","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-configuration-overview","content":"All hosts in the source and destination clusters should be reachable to each other."},"16576":{"id":"/docs/single-page-6776","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-configuration-overview","content":"If both clusters use the same ZooKeeper cluster, you must use a different `zookeeper.znode.parent`, because they cannot write in the same folder."},"16577":{"id":"/docs/single-page-6777","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-configuration-overview","content":"On the source cluster, in HBase Shell, add the destination cluster as a peer, using the `add_peer` command."},"16578":{"id":"/docs/single-page-6778","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-configuration-overview","content":"On the source cluster, in HBase Shell, enable the table replication, using the `enable_table_replication` command."},"16579":{"id":"/docs/single-page-6779","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-configuration-overview","content":"Check the logs to see if replication is taking place. If so, you will see messages like the following, coming from the ReplicationSource."},"16580":{"id":"/docs/single-page-6780","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication-configuration","content":"See Serial Replication"},"16581":{"id":"/docs/single-page-6781","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**add\\_peer `<ID>` `<CLUSTER_KEY>`**\\\nAdds a replication relationship between two clusters."},"16582":{"id":"/docs/single-page-6782","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"ID — a unique string, which must not contain a hyphen."},"16583":{"id":"/docs/single-page-6783","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"CLUSTER\\_KEY: composed using the following template, with appropriate place-holders: `hbase.zookeeper.quorum:hbase.zookeeper.property.clientPort:zookeeper.znode.parent`. This value can be found on the Master UI info page."},"16584":{"id":"/docs/single-page-6784","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"STATE(optional): ENABLED or DISABLED, default value is ENABLED"},"16585":{"id":"/docs/single-page-6785","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**list\\_peers**\\\nlist all replication relationships known by this cluster"},"16586":{"id":"/docs/single-page-6786","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**enable\\_peer `<ID>`**\\\nEnable a previously-disabled replication relationship"},"16587":{"id":"/docs/single-page-6787","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**disable\\_peer `<ID>`**\\\nDisable a replication relationship. HBase will no longer send edits to that peer cluster, but it still keeps track of all the new WALs that it will need to replicate if and when it is re-enabled. WALs are retained when enabling or disabling replication as long as peers exist."},"16588":{"id":"/docs/single-page-6788","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**remove\\_peer `<ID>`**\\\nDisable and remove a replication relationship. HBase will no longer send edits to that peer cluster or keep track of WALs."},"16589":{"id":"/docs/single-page-6789","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**enable\\_table\\_replication `<TABLE_NAME>`**\\\nEnable the table replication switch for all its column families. If the table is not found in the destination cluster then it will create one with the same name and column families."},"16590":{"id":"/docs/single-page-6790","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**disable\\_table\\_replication `<TABLE_NAME>`**\\\nDisable the table replication switch for all its column families."},"16591":{"id":"/docs/single-page-6791","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**peer\\_modification\\_switch `<enable_or_disable>`, `<drain_procedures>`**\\\nEnabled/Disable peer modification operations, such as adding/removing replication peers. The second parameter means whether you want to wait until all existing peer modification procedures to finish before returning when disabling peer modification."},"16592":{"id":"/docs/single-page-6792","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cluster-management-commands","content":"**peer\\_modification\\_enabled**\\\nCheck whether peer modification is enabled."},"16593":{"id":"/docs/single-page-6793","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrate-across-different-replication-peer-storages","content":"Starting from 2.6.0, we introduce a file system based `ReplicationPeerStorage`, which stores the replication peer state with files on HFile file system, instead of znodes on ZooKeeper. And we have also implemented a tool to copy replication peer state across different replication peer storages."},"16594":{"id":"/docs/single-page-6794","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrate-across-different-replication-peer-storages","content":"To support doing the migrate online, we introduce a shell command called `peer_modification_switch`."},"16595":{"id":"/docs/single-page-6795","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrate-across-different-replication-peer-storages","content":"Use the above command can disable peer modification operations. The second `true` means you want to wait until all the existing replication peer modification procedures to finish before returning. After disabling the peer modification, it is safe for you to copy replication peer state with the above tool, and then update all the *hbase-site.xml* files in the cluster to specify the new replication peer storage, and finally trigger an online configuration update to load the new replication peer storage."},"16596":{"id":"/docs/single-page-6796","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication","content":"Note: this feature is introduced in HBase 2.1"},"16597":{"id":"/docs/single-page-6797","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication","content":"**Function of serial replication**\\\nSerial replication supports to push logs to the destination cluster in the same order as logs reach to the source cluster."},"16598":{"id":"/docs/single-page-6798","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#why-need-serial-replication","content":"In replication of HBase, we push mutations to destination cluster by reading WAL in each region server. We have a queue for WAL files so we can read them in order of creation time. However, when region-move or RS failure occurs in source cluster, the hlog entries that are not pushed before region-move or RS-failure will be pushed by original RS(for region move) or another RS which takes over the remained hlog of dead RS(for RS failure), and the new entries for the same region(s) will be pushed by the RS which now serves the region(s), but they push the hlog entries of a same region concurrently without coordination."},"16599":{"id":"/docs/single-page-6799","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#why-need-serial-replication","content":"This treatment can possibly lead to data inconsistency between source and destination clusters:"},"16600":{"id":"/docs/single-page-6800","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#why-need-serial-replication","content":"there are put and then delete written to source cluster."},"16601":{"id":"/docs/single-page-6801","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#why-need-serial-replication","content":"due to region-move / RS-failure, they are pushed by different replication-source threads to peer cluster."},"16602":{"id":"/docs/single-page-6802","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#why-need-serial-replication","content":"if delete is pushed to peer cluster before put, and flush and major-compact occurs in peer cluster before put is pushed to peer cluster, the delete is collected and the put remains in peer cluster, but in source cluster the put is masked by the delete, hence data inconsistency between source and destination clusters."},"16603":{"id":"/docs/single-page-6803","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication-configuration-1","content":"Set the serial flag to true for a repliation peer. And the default serial flag is false."},"16604":{"id":"/docs/single-page-6804","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication-configuration-1","content":"Add a new replication peer which serial flag is true"},"16605":{"id":"/docs/single-page-6805","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication-configuration-1","content":"Set a replication peer's serial flag to false"},"16606":{"id":"/docs/single-page-6806","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication-configuration-1","content":"Set a replication peer's serial flag to true"},"16607":{"id":"/docs/single-page-6807","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#serial-replication-configuration-1","content":"The serial replication feature had been done firstly in HBASE-9465 and then reverted and redone in HBASE-20046. You can find more details in these issues."},"16608":{"id":"/docs/single-page-6808","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#verifying-replicated-data","content":"The `VerifyReplication` MapReduce job, which is included in HBase, performs a systematic comparison of replicated data between two different clusters. Run the VerifyReplication job on the master cluster, supplying it with the peer ID and table name to use for validation. You can limit the verification further by specifying a time range or specific families. The job's short name is `verifyrep`. To run the job, use a command like the following:"},"16609":{"id":"/docs/single-page-6809","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#verifying-replicated-data","content":"The `VerifyReplication` command prints out `GOODROWS` and `BADROWS` counters to indicate rows that did and did not replicate correctly."},"16610":{"id":"/docs/single-page-6810","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#detailed-information-about-cluster-replication","content":"***Replication Architecture Overview***"},"16611":{"id":"/docs/single-page-6811","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"A single WAL edit goes through several steps in order to be replicated to a slave cluster."},"16612":{"id":"/docs/single-page-6812","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"An HBase client uses a Put or Delete operation to manipulate data in HBase."},"16613":{"id":"/docs/single-page-6813","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"The region server writes the request to the WAL in a way allows it to be replayed if it is not written successfully."},"16614":{"id":"/docs/single-page-6814","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"If the changed cell corresponds to a column family that is scoped for replication, the edit is added to the queue for replication."},"16615":{"id":"/docs/single-page-6815","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"In a separate thread, the edit is read from the log, as part of a batch process. Only the KeyValues that are eligible for replication are kept. Replicable KeyValues are part of a column family whose schema is scoped GLOBAL, are not part of a catalog such as `hbase:meta`, did not originate from the target slave cluster, and have not already been consumed by the target slave cluster."},"16616":{"id":"/docs/single-page-6816","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"The edit is tagged with the master's UUID and added to a buffer. When the buffer is filled, or the reader reaches the end of the file, the buffer is sent to a random region server on the slave cluster."},"16617":{"id":"/docs/single-page-6817","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"The region server reads the edits sequentially and separates them into buffers, one buffer per table. After all edits are read, each buffer is flushed using Table, HBase's normal client. The master's UUID and the UUIDs of slaves which have already consumed the data are preserved in the edits they are applied, in order to prevent replication loops."},"16618":{"id":"/docs/single-page-6818","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"In the master, the offset for the WAL that is currently being replicated is registered in ZooKeeper."},"16619":{"id":"/docs/single-page-6819","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"The first three steps, where the edit is inserted, are identical."},"16620":{"id":"/docs/single-page-6820","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"Again in a separate thread, the region server reads, filters, and edits the log edits in the same way as above. The slave region server does not answer the RPC call."},"16621":{"id":"/docs/single-page-6821","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"The master sleeps and tries again a configurable number of times."},"16622":{"id":"/docs/single-page-6822","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"If the slave region server is still not available, the master selects a new subset of region server to replicate to, and tries again to send the buffer of edits."},"16623":{"id":"/docs/single-page-6823","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"Meanwhile, the WALs are rolled and stored in a queue in ZooKeeper. Logs that are **archived** by their region server, by moving them from the region server's log directory to a central log directory, will update their paths in the in-memory queue of the replicating thread."},"16624":{"id":"/docs/single-page-6824","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"When the slave cluster is finally available, the buffer is applied in the same way as during normal processing. The master region server will then replicate the backlog of logs that accumulated during the outage."},"16625":{"id":"/docs/single-page-6825","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"**Spreading Queue Failover Load**\\\nWhen replication is active, a subset of region servers in the source cluster is responsible for shipping edits to the sink. This responsibility must be failed over like all other region server functions should a process or node crash. The following configuration settings are recommended for maintaining an even distribution of replication activity over the remaining live servers in the source cluster:"},"16626":{"id":"/docs/single-page-6826","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"Set `replication.source.maxretriesmultiplier` to `300`."},"16627":{"id":"/docs/single-page-6827","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"Set `replication.source.sleepforretries` to `1` (1 second). This value, combined with the value of `replication.source.maxretriesmultiplier`, causes the retry cycle to last about 5 minutes."},"16628":{"id":"/docs/single-page-6828","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"Set `replication.sleep.before.failover` to `30000` (30 seconds) in the source cluster site configuration."},"16629":{"id":"/docs/single-page-6829","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#life-of-a-wal-edit","content":"**Preserving Tags During Replication**\\\nBy default, the codec used for replication between clusters strips tags, such as cell-level ACLs, from cells. To prevent the tags from being stripped, you can use a different codec which does not strip them. Configure `hbase.replication.rpc.codec` to use `org.apache.hadoop.hbase.codec.KeyValueCodecWithTags`, on both the source and sink RegionServers involved in the replication. This option was introduced in HBASE-10322."},"16630":{"id":"/docs/single-page-6830","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"**Replication State Storage**\\\nIn HBASE-15867, we abstract two interfaces for storing replication state, `ReplicationPeerStorage` and `ReplicationQueueStorage`. The former one is for storing the replication peer related states, and the latter one is for storing the replication queue related states. HBASE-15867 is only half done, as although we have abstract these two interfaces, we still only have zookeeper based implementations."},"16631":{"id":"/docs/single-page-6831","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"And in HBASE-27110, we have implemented a file system based replication peer storage, to store replication peer state on file system. Of course you can still use the zookeeper based replication peer storage."},"16632":{"id":"/docs/single-page-6832","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"And in HBASE-27109, we have changed the replication queue storage from zookeeper based to hbase table based. See the below `Replication Queue State` in hbase:replication table section for more details."},"16633":{"id":"/docs/single-page-6833","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"**Replication State in ZooKeeper**\\&#xA;By default, the state is contained in the base node */hbase/replication*. Usually this nodes contains two child nodes, the peers znode is for storing replication peer state, and the rs znodes is for storing replication queue state. And if you choose the file system based replication peer storage, you will not see the peers znode. And starting from 3.0.0, we have moved the replication queue state to `hbase:replication` table (see below), so you will not see the rs znode."},"16634":{"id":"/docs/single-page-6834","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"**The `Peers` Znode**\\\nThe `peers&#x60; znode is stored in */hbase/replication/peers* by default. It consists of a list of all peer replication clusters, along with the status of each of them. The value of each peer is its cluster key, which is provided in the HBase Shell. The cluster key contains a list of ZooKeeper nodes in the cluster's quorum, the client port for the ZooKeeper quorum, and the base znode for HBase in HDFS on that cluster. Starting from 3.0.0, you can also specify connection URI as a cluster key. See Connection URI for more details about connection URI."},"16635":{"id":"/docs/single-page-6835","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"**The `RS` Znode**\\\nThe `rs` znode contains a list of WAL logs which need to be replicated. This list is divided into a set of queues organized by region server and the peer cluster the region server is shipping the logs to. The rs znode has one child znode for each region server in the cluster. The child znode name is the region server's hostname, client port, and start code. This list includes both live and dead region servers."},"16636":{"id":"/docs/single-page-6836","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"**The hbase:replication Table**\\\nAfter 3.0.0, the `Queue` has been stored in the hbase:replication table, where the row key is `<PeerId>-<ServerName>[/<SourceServerName>]`, the WAL group will be the qualifier, and the serialized ReplicationGroupOffset will be the value. The ReplicationGroupOffset includes the wal file of the corresponding queue (`<PeerId>-<ServerName>[/<SourceServerName>]`) and its offset. Because we track replication offset per queue instead of per file, we only need to store one replication offset per queue."},"16637":{"id":"/docs/single-page-6837","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-internals","content":"**Other implementations for `ReplicationPeerStorage`**\\\nStarting from 2.6.0, we introduce a file system based `ReplicationPeerStorage`, which stores the replication peer state with files on HFile file system, instead of znodes on ZooKeeper. The layout is almost the same with znodes on zookeeper, the main difference is that, the HFile file system may not support atomic rename, so we use two files to store the state and when reading we will read them both and compare the timestamp to find out the newer one. So typically, you will see two peer config files. And for enable/disable state, we just touch a disabled file if the peer is disabled, and remove the file when enabling the peer."},"16638":{"id":"/docs/single-page-6838","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#choosing-region-servers-to-replicate-to","content":"When a master cluster region server initiates a replication source to a slave cluster, it first connects to the slave's ZooKeeper ensemble using the provided cluster key . It then scans the &#x2A;rs/* directory to discover all the available sinks (region servers that are accepting incoming streams of edits to replicate) and randomly chooses a subset of them using a configured ratio which has a default value of 10%. For example, if a slave cluster has 150 machines, 15 will be chosen as potential recipient for edits that this master cluster region server sends. Because this selection is performed by each master region server, the probability that all slave region servers are used is very high, and this method works for clusters of any size. For example, a master cluster of 10 machines replicating to a slave cluster of 5 machines with a ratio of 10% causes the master cluster region servers to choose one machine each at random."},"16639":{"id":"/docs/single-page-6839","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#choosing-region-servers-to-replicate-to","content":"A ZooKeeper watcher is placed on the `$zookeeper.znode.parent/rs` node of the slave cluster by each of the master cluster's region servers. This watch is used to monitor changes in the composition of the slave cluster. When nodes are removed from the slave cluster, or if nodes go down or come back up, the master cluster's region servers will respond by selecting a new pool of slave region servers to replicate to."},"16640":{"id":"/docs/single-page-6840","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#keeping-track-of-logsbased-on-zookeeper","content":"Each master cluster region server has its own znode in the replication znodes hierarchy. It contains one znode per peer cluster (if 5 slave clusters, 5 znodes are created), and each of these contain a queue of WALs to process. Each of these queues will track the WALs created by that region server, but they can differ in size. For example, if one slave cluster becomes unavailable for some time, the WALs should not be deleted, so they need to stay in the queue while the others are processed. See rs.failover.details for an example."},"16641":{"id":"/docs/single-page-6841","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#keeping-track-of-logsbased-on-zookeeper","content":"When a source is instantiated, it contains the current WAL that the region server is writing to. During log rolling, the new file is added to the queue of each slave cluster's znode just before it is made available. This ensures that all the sources are aware that a new log exists before the region server is able to append edits into it, but this operations is now more expensive. The queue items are discarded when the replication thread cannot read more entries from a file (because it reached the end of the last block) and there are other files in the queue. This means that if a source is up to date and replicates from the log that the region server writes to, reading up to the \"end\" of the current file will not delete the item in the queue."},"16642":{"id":"/docs/single-page-6842","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#keeping-track-of-logsbased-on-zookeeper","content":"A log can be archived if it is no longer used or if the number of logs exceeds `hbase.regionserver.maxlogs` because the insertion rate is faster than regions are flushed. When a log is archived, the source threads are notified that the path for that log changed. If a particular source has already finished with an archived log, it will just ignore the message. If the log is in the queue, the path will be updated in memory. If the log is currently being replicated, the change will be done atomically so that the reader doesn't attempt to open the file when has already been moved. Because moving a file is a NameNode operation , if the reader is currently reading the log, it won't generate any exception."},"16643":{"id":"/docs/single-page-6843","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#keeping-track-of-logsbased-on-hbase-table","content":"After 3.0.0, for table based implementation, we have server name in row key, which means we will have lots of rows for a given peer."},"16644":{"id":"/docs/single-page-6844","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#keeping-track-of-logsbased-on-hbase-table","content":"For a normal replication queue, the WAL files belong to the region server that is still alive, all the WAL files are kept in memory, so we do not need to get the WAL files from replication queue storage. And for a recovered replication queue, we could get the WAL files of the dead region server by listing the old WAL directory on HDFS. So theoretically, we do not need to store every WAL file in replication queue storage. And what's more, we store the created time(usually) in the WAL file name, so for all the WAL files in a WAL group, we can sort them(actually we will sort them in the current replication framework), which means we only need to store one replication offset per queue. When starting a recovered replication queue, we will skip all the files before this offset, and start replicating from this offset."},"16645":{"id":"/docs/single-page-6845","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#keeping-track-of-logsbased-on-hbase-table","content":"For ReplicationLogCleaner, all the files before this offset can be deleted, otherwise not."},"16646":{"id":"/docs/single-page-6846","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reading-filtering-and-sending-edits","content":"By default, a source attempts to read from a WAL and ship log entries to a sink as quickly as possible. Speed is limited by the filtering of log entries Only KeyValues that are scoped GLOBAL and that do not belong to catalog tables will be retained. Speed is also limited by total size of the list of edits to replicate per slave, which is limited to 64 MB by default. With this configuration, a master cluster region server with three slaves would use at most 192 MB to store data to replicate. This does not account for the data which was filtered but not garbage collected."},"16647":{"id":"/docs/single-page-6847","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reading-filtering-and-sending-edits","content":"Once the maximum size of edits has been buffered or the reader reaches the end of the WAL, the source thread stops reading and chooses at random a sink to replicate to (from the list that was generated by keeping only a subset of slave region servers). It directly issues a RPC to the chosen region server and waits for the method to return. If the RPC was successful, the source determines whether the current file has been emptied or it contains more data which needs to be read. If the file has been emptied, the source deletes the znode in the queue. Otherwise, it registers the new offset in the log's znode. If the RPC threw an exception, the source will retry 10 times before trying to find a different sink."},"16648":{"id":"/docs/single-page-6848","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cleaning-logs","content":"If replication is not enabled, the master's log-cleaning thread deletes old logs using a configured TTL. This TTL-based method does not work well with replication, because archived logs which have exceeded their TTL may still be in a queue. The default behavior is augmented so that if a log is past its TTL, the cleaning thread looks up every queue until it finds the log, while caching queues it has found. If the log is not found in any queues, the log will be deleted. The next time the cleaning process needs to look for a log, it starts by using its cached list."},"16649":{"id":"/docs/single-page-6849","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#cleaning-logs","content":"WALs are saved when replication is enabled or disabled as long as peers exist."},"16650":{"id":"/docs/single-page-6850","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-server-failover","content":"When no region servers are failing, keeping track of the logs in ZooKeeper adds no value. Unfortunately, region servers do fail, and since ZooKeeper is highly available, it is useful for managing the transfer of the queues in the event of a failure. Each of the master cluster region servers keeps a watcher on every other region server, in order to be notified when one dies (just as the master does). When a failure happens, they all race to create a znode called `lock` inside the dead region server's znode that contains its queues. The region server that creates it successfully then transfers all the queues to its own znode, one at a time since ZooKeeper does not support renaming queues. After queues are all transferred, they are deleted from the old location. The znodes that were recovered are renamed with the ID of the slave cluster appended with the name of the dead server."},"16651":{"id":"/docs/single-page-6851","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-server-failover","content":"Next, the master cluster region server creates one new source thread per copied queue, and each of the source threads follows the read/filter/ship pattern. The main difference is that those queues will never receive new data, since they do not belong to their new region server. When the reader hits the end of the last log, the queue's znode is deleted and the master cluster region server closes that replication source."},"16652":{"id":"/docs/single-page-6852","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-server-failover","content":"And starting from 2.5.0, the failover logic has been moved to SCP, where we add a SERVER\\_CRASH\\_CLAIM\\_REPLICATION\\_QUEUES step in SCP to claim the replication queues for a dead server. And starting from 3.0.0, where we changed the replication queue storage from zookeeper to table, the update to the replication queue storage is async, so we also need an extra step to add the missing replication queues before claiming."},"16653":{"id":"/docs/single-page-6853","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-replication-queue-claiming-based-on-zookeeper","content":"Given a master cluster with 3 region servers replicating to a single slave with id `2`, the following hierarchy represents what the znodes layout could be at some point in time. The region servers' znodes all contain a `peers` znode which contains a single queue. The znode names in the queues represent the actual file names on HDFS in the form `address,port.timestamp`."},"16654":{"id":"/docs/single-page-6854","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-replication-queue-claiming-based-on-zookeeper","content":"Assume that 1.1.1.2 loses its ZooKeeper session. The survivors will race to create a lock, and, arbitrarily, 1.1.1.3 wins. It will then start transferring all the queues to its local peers znode by appending the name of the dead server. Right before 1.1.1.3 is able to clean up the old znodes, the layout will look like the following:"},"16655":{"id":"/docs/single-page-6855","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-replication-queue-claiming-based-on-zookeeper","content":"Some time later, but before 1.1.1.3 is able to finish replicating the last WAL from 1.1.1.2, it dies too. Some new logs were also created in the normal queues. The last region server will then try to lock 1.1.1.3's znode and will begin transferring all the queues. The new layout will be:"},"16656":{"id":"/docs/single-page-6856","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-replication-queue-claimingbased-on-hbase-table","content":"Given a master cluster with 3 region servers replicating to a single slave with id `2`, the following info represents what the storage layout of queue in the hbase:replication at some point in time. Row key is `<PeerId>-<ServerName>[/<SourceServerName>]`, and value is WAL && Offset."},"16657":{"id":"/docs/single-page-6857","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-replication-queue-claimingbased-on-hbase-table","content":"Assume that 1.1.1.2 failed. The survivors will claim queue of that, and, arbitrarily, 1.1.1.3 wins. It will claim all the queue of 1.1.1.2, including removing the row of a replication queue, and inserting a new row(where we change the server name to the region server which claims the queue). Finally, the layout will look like the following:"},"16658":{"id":"/docs/single-page-6858","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"The following metrics are exposed at the global region server level and at the peer level:"},"16659":{"id":"/docs/single-page-6859","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.sizeOfLogQueue`\\\nnumber of WALs to process (excludes the one which is being processed) at the Replication source"},"16660":{"id":"/docs/single-page-6860","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.shippedOps`\\\nnumber of mutations shipped"},"16661":{"id":"/docs/single-page-6861","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.logEditsRead`\\\nnumber of mutations read from WALs at the replication source"},"16662":{"id":"/docs/single-page-6862","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.ageOfLastShippedOp`\\\nage of last batch that was shipped by the replication source"},"16663":{"id":"/docs/single-page-6863","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.completedLogs`\\\nThe number of write-ahead-log files that have completed their acknowledged sending to the peer associated with this source. Increments to this metric are a part of normal operation of HBase replication."},"16664":{"id":"/docs/single-page-6864","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.completedRecoverQueues`\\\nThe number of recovery queues this source has completed sending to the associated peer. Increments to this metric are a part of normal recovery of HBase replication in the face of failed Region Servers."},"16665":{"id":"/docs/single-page-6865","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.uncleanlyClosedLogs`\\\nThe number of write-ahead-log files the replication system considered completed after reaching the end of readable entries in the face of an uncleanly closed file."},"16666":{"id":"/docs/single-page-6866","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.ignoredUncleanlyClosedLogContentsInBytes`\\\nWhen a write-ahead-log file is not closed cleanly, there will likely be some entry that has been partially serialized. This metric contains the number of bytes of such entries the HBase replication system believes were remaining at the end of files skipped in the face of an uncleanly closed file. Those bytes should either be in different file or represent a client write that was not acknowledged."},"16667":{"id":"/docs/single-page-6867","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.restartedLogReading`\\\nThe number of times the HBase replication system detected that it failed to correctly parse a cleanly closed write-ahead-log file. In this circumstance, the system replays the entire log from the beginning, ensuring that no edits fail to be acknowledged by the associated peer. Increments to this metric indicate that the HBase replication system is having difficulty correctly handling failures in the underlying distributed storage system. No dataloss should occur, but you should check Region Server log files for details of the failures."},"16668":{"id":"/docs/single-page-6868","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.repeatedLogFileBytes`\\\nWhen the HBase replication system determines that it needs to replay a given write-ahead-log file, this metric is incremented by the number of bytes the replication system believes had already been acknowledged by the associated peer prior to starting over."},"16669":{"id":"/docs/single-page-6869","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-metrics","content":"`source.closedLogsWithUnknownFileLength`\\\nIncremented when the HBase replication system believes it is at the end of a write-ahead-log file but it can not determine the length of that file in the underlying distributed storage system. Could indicate dataloss since the replication system is unable to determine if the end of readable entries lines up with the expected end of the file. You should check Region Server log files for details of the failures."},"16670":{"id":"/docs/single-page-6870","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"Option"},"16671":{"id":"/docs/single-page-6871","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"Description"},"16672":{"id":"/docs/single-page-6872","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"Default"},"16673":{"id":"/docs/single-page-6873","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"zookeeper.znode.parent"},"16674":{"id":"/docs/single-page-6874","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The name of the base ZooKeeper znode used for HBase"},"16675":{"id":"/docs/single-page-6875","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"/hbase"},"16676":{"id":"/docs/single-page-6876","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"zookeeper.znode.replication"},"16677":{"id":"/docs/single-page-6877","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The name of the base znode used for replication"},"16678":{"id":"/docs/single-page-6878","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"replication"},"16679":{"id":"/docs/single-page-6879","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"zookeeper.znode.replication.peers"},"16680":{"id":"/docs/single-page-6880","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The name of the peer znode"},"16681":{"id":"/docs/single-page-6881","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"peers"},"16682":{"id":"/docs/single-page-6882","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"zookeeper.znode.replication.peers.state"},"16683":{"id":"/docs/single-page-6883","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The name of peer-state znode"},"16684":{"id":"/docs/single-page-6884","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"peer-state"},"16685":{"id":"/docs/single-page-6885","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"zookeeper.znode.replication.rs"},"16686":{"id":"/docs/single-page-6886","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The name of the rs znode"},"16687":{"id":"/docs/single-page-6887","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"rs"},"16688":{"id":"/docs/single-page-6888","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"replication.sleep.before.failover"},"16689":{"id":"/docs/single-page-6889","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"How many milliseconds a worker should sleep before attempting to replicate a dead region server's WAL queues."},"16690":{"id":"/docs/single-page-6890","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"replication.executor.workers"},"16691":{"id":"/docs/single-page-6891","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The number of region servers a given region server should attempt to failover simultaneously."},"16692":{"id":"/docs/single-page-6892","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"1"},"16693":{"id":"/docs/single-page-6893","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"hbase.replication.peer.storage.impl"},"16694":{"id":"/docs/single-page-6894","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The replication peer storage implementation"},"16695":{"id":"/docs/single-page-6895","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"zookeeper"},"16696":{"id":"/docs/single-page-6896","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"hbase.replication.peers.directory"},"16697":{"id":"/docs/single-page-6897","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The directory for storing replication peer state, when filesystem replication peer storage is specified"},"16698":{"id":"/docs/single-page-6898","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"peers"},"16699":{"id":"/docs/single-page-6899","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"hbase.replication.queue.table.name"},"16700":{"id":"/docs/single-page-6900","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The table for storing replication queue state"},"16701":{"id":"/docs/single-page-6901","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"hbase:replication"},"16702":{"id":"/docs/single-page-6902","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"hbase.replication.queue.storage.impl"},"16703":{"id":"/docs/single-page-6903","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"The replication queue storage implementation"},"16704":{"id":"/docs/single-page-6904","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-configuration-options","content":"TableReplicationQueueStorage"},"16705":{"id":"/docs/single-page-6905","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#monitoring-replication-status","content":"You can use the HBase Shell command `status 'replication'` to monitor the replication status on your cluster. The command has three variations:"},"16706":{"id":"/docs/single-page-6906","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#monitoring-replication-status","content":"`status 'replication'` — prints the status of each source and its sinks, sorted by hostname."},"16707":{"id":"/docs/single-page-6907","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#monitoring-replication-status","content":"`status 'replication', 'source'` — prints the status for each replication source, sorted by hostname."},"16708":{"id":"/docs/single-page-6908","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#monitoring-replication-status","content":"`status 'replication', 'sink'` — prints the status for each replication sink, sorted by hostname."},"16709":{"id":"/docs/single-page-6909","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"The command output will vary according to the state of replication. For example right after a restart and if destination peer is not reachable, no replication source threads would be running, so no metrics would get displayed:"},"16710":{"id":"/docs/single-page-6910","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Under normal circumstances, a healthy, active-active replication deployment would show the following:"},"16711":{"id":"/docs/single-page-6911","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"The definition for each of these metrics is detailed below:"},"16712":{"id":"/docs/single-page-6912","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Type"},"16713":{"id":"/docs/single-page-6913","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Metric Name"},"16714":{"id":"/docs/single-page-6914","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Description"},"16715":{"id":"/docs/single-page-6915","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Source"},"16716":{"id":"/docs/single-page-6916","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"AgeOfLastShippedOp"},"16717":{"id":"/docs/single-page-6917","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"How long last successfully shipped edit took to effectively get replicated on target."},"16718":{"id":"/docs/single-page-6918","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Source"},"16719":{"id":"/docs/single-page-6919","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"TimeStampOfLastShippedOp"},"16720":{"id":"/docs/single-page-6920","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"The actual date of last successful edit shipment."},"16721":{"id":"/docs/single-page-6921","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Source"},"16722":{"id":"/docs/single-page-6922","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"SizeOfLogQueue"},"16723":{"id":"/docs/single-page-6923","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Number of wal files on this given queue."},"16724":{"id":"/docs/single-page-6924","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Source"},"16725":{"id":"/docs/single-page-6925","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"EditsReadFromLogQueue"},"16726":{"id":"/docs/single-page-6926","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"How many edits have been read from this given queue since this source thread started."},"16727":{"id":"/docs/single-page-6927","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Source"},"16728":{"id":"/docs/single-page-6928","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"OpsShippedToTarget"},"16729":{"id":"/docs/single-page-6929","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"How many edits have been shipped to target since this source thread started."},"16730":{"id":"/docs/single-page-6930","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Source"},"16731":{"id":"/docs/single-page-6931","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"TimeStampOfNextToReplicate"},"16732":{"id":"/docs/single-page-6932","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Date of the current edit been attempted to replicate."},"16733":{"id":"/docs/single-page-6933","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Source"},"16734":{"id":"/docs/single-page-6934","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Replication Lag"},"16735":{"id":"/docs/single-page-6935","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"The elapsed time (in millis), since the last edit to replicate was read by this source thread and effectively replicated to target"},"16736":{"id":"/docs/single-page-6936","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Sink"},"16737":{"id":"/docs/single-page-6937","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"TimeStampStarted"},"16738":{"id":"/docs/single-page-6938","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Date (in millis) of when this Sink thread started."},"16739":{"id":"/docs/single-page-6939","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Sink"},"16740":{"id":"/docs/single-page-6940","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"AgeOfLastAppliedOp"},"16741":{"id":"/docs/single-page-6941","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"How long it took to apply the last successful shipped edit."},"16742":{"id":"/docs/single-page-6942","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Sink"},"16743":{"id":"/docs/single-page-6943","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"TimeStampsOfLastAppliedOp"},"16744":{"id":"/docs/single-page-6944","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Date of last successful applied edit."},"16745":{"id":"/docs/single-page-6945","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#understanding-the-output","content":"Growing values for `Source.TimeStampsOfLastAppliedOp` and/or `Source.Replication Lag` would indicate replication delays. If those numbers keep going up, while `Source.TimeStampOfLastShippedOp`, `Source.EditsReadFromLogQueue`, `Source.OpsShippedToTarget` or `Source.TimeStampOfNextToReplicate` do not change at all, then replication flow is failing to progress, and there might be problems within clusters communication. This could also happen if replication is manually paused (via hbase shell `disable_peer` command, for example), but data keeps getting ingested in the source cluster tables."},"16746":{"id":"/docs/single-page-6946","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replication-observability-framework","content":"The core idea is to create `replication marker rows` periodically and insert them into WAL. These marker rows will help track the replication delays/bugs back to the `originating region server, WAL and timestamp of occurrence`. This tracker rows' WAL entries are interleaved with the regular table WAL entries and have a very high chance of running into the same replication delays/bugs that the user tables are seeing. Details as follows:"},"16747":{"id":"/docs/single-page-6947","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"Create a new table called `REPLICATION.WALEVENTTRACKER` table and persist all the WAL events (like `ACTIVE`, `ROLLING`, `ROLLED`) to this table.\\\nThe properties of this table are: Replication is set to 0, Block Cache is Disabled, Max versions is 1, TTL is 1 year."},"16748":{"id":"/docs/single-page-6948","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"This table has single ColumnFamily: `info`\\\n`info` contains multiple qualifiers:"},"16749":{"id":"/docs/single-page-6949","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"`info:region_server_name`"},"16750":{"id":"/docs/single-page-6950","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"`info:wal_name`"},"16751":{"id":"/docs/single-page-6951","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"`info:timestamp`"},"16752":{"id":"/docs/single-page-6952","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"`info:wal_state`"},"16753":{"id":"/docs/single-page-6953","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"`info:wal_length`"},"16754":{"id":"/docs/single-page-6954","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"Whenever we roll a WAL (`old-wal-name` → `new-wal-name`), it will create 3 rows in this table.\\\n`<region_server_name>, <old-wal-name>, <current timestamp>, <ROLLING>, <length of old-wal-name>`\\\n`<region_server_name>, <old-wal-name>, <current timestamp>, <ROLLED>, <length of old-wal-name>`\\\n`<region_server_name>, <new-wal-name>, <current timestamp>, <ACTIVE>, 0`"},"16755":{"id":"/docs/single-page-6955","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationwaleventtracker-table","content":"**Configuration**\\\nTo enable persisting WAL events, there is a configuration property: `hbase.regionserver.wal.event.tracker.enabled` (defaults to false)"},"16756":{"id":"/docs/single-page-6956","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationsink_tracker-table","content":"Create a new table called `REPLICATION.SINK_TRACKER`.\\\nThe properties of this table are: Replication is set to 0, Block Cache is Disabled, Max versions is 1, TTL is 1 year."},"16757":{"id":"/docs/single-page-6957","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationsink_tracker-table","content":"This table has single ColumnFamily: `info`\\\n`info` contains multiple qualifiers:"},"16758":{"id":"/docs/single-page-6958","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationsink_tracker-table","content":"`info:region_server_name`"},"16759":{"id":"/docs/single-page-6959","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationsink_tracker-table","content":"`info:wal_name`"},"16760":{"id":"/docs/single-page-6960","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationsink_tracker-table","content":"`info:timestamp`"},"16761":{"id":"/docs/single-page-6961","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationsink_tracker-table","content":"`info:offset`"},"16762":{"id":"/docs/single-page-6962","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationsink_tracker-table","content":"**Configuration**\\\nTo create the above table, there is a configuration property: `hbase.regionserver.replication.sink.tracker.enabled` (defaults to false)"},"16763":{"id":"/docs/single-page-6963","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationmarker-chore","content":"We introduced a new chore called `ReplicationMarkerChore` which will create the marker rows periodically into active WAL. The marker rows has the following metadata: `region_server_name, wal_name, timestamp and offset within WAL`. These markers are replicated (with special handling) and they are persisted into a sink side table `REPLICATION.SINK_TRACKER`."},"16764":{"id":"/docs/single-page-6964","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#replicationmarker-chore","content":"**Configuration:**\\\n`ReplicationMarkerChore` is enabled with configuration property: `hbase.regionserver.replication.marker.enabled` (defaults to false) and the period at which it creates marker rows is controlled by `hbase.regionserver.replication.marker.chore.duration` (defaults to 30 seconds). Sink cluster can choose to process these marker rows and persist to `REPLICATION.SINK_TRACKER` table or it can ignore these rows. This behavior is controlled by configuration property `hbase.regionserver.replication.sink.tracker.enabled` (defaults to false). If set to false, it will ignore the marker rows."},"16765":{"id":"/docs/single-page-6965","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-to-enable-end-to-end-feature-","content":"To use this whole feature, we will need to enable the above configuration properties in 2 phases/releases.\\\nIn first phase/release, set the following configuration properties to `true`:"},"16766":{"id":"/docs/single-page-6966","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-to-enable-end-to-end-feature-","content":"`hbase.regionserver.wal.event.tracker.enabled`: This will just persist all the WAL events to REPLICATION.WALEVENTTRACKER table."},"16767":{"id":"/docs/single-page-6967","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-to-enable-end-to-end-feature-","content":"`hbase.regionserver.replication.sink.tracker.enabled`: This will create REPLICATION.SINK\\_TRACKER table and will process special marker rows coming from source cluster."},"16768":{"id":"/docs/single-page-6968","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-to-enable-end-to-end-feature-","content":"In second phase/release, set the following configuration property to `true`:"},"16769":{"id":"/docs/single-page-6969","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#how-to-enable-end-to-end-feature-","content":"`hbase.regionserver.replication.marker.enabled`: This will create marker rows periodically and sink cluster will persist these marker rows in `REPLICATION.SINK_TRACKER` table."},"16770":{"id":"/docs/single-page-6970","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-multiple-workloads-on-a-single-cluster","content":"HBase provides the following mechanisms for managing the performance of a cluster handling multiple workloads:"},"16771":{"id":"/docs/single-page-6971","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-multiple-workloads-on-a-single-cluster","content":"Quotas"},"16772":{"id":"/docs/single-page-6972","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-multiple-workloads-on-a-single-cluster","content":"Request Queues"},"16773":{"id":"/docs/single-page-6973","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-multiple-workloads-on-a-single-cluster","content":"Multiple-Typed Queues"},"16774":{"id":"/docs/single-page-6974","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#quotas","content":"HBASE-11598 introduces RPC quotas, which allow you to throttle requests based on the following limits:"},"16775":{"id":"/docs/single-page-6975","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#quotas","content":"The number or size of requests(read, write, or read+write) in a given timeframe"},"16776":{"id":"/docs/single-page-6976","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#quotas","content":"The number of tables allowed in a namespace"},"16777":{"id":"/docs/single-page-6977","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#quotas","content":"These limits can be enforced for a specified user, table, or namespace."},"16778":{"id":"/docs/single-page-6978","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-quotas","content":"Quotas are disabled by default. To enable the feature, set the `hbase.quota.enabled` property to `true` in *hbase-site.xml* file for all cluster nodes."},"16779":{"id":"/docs/single-page-6979","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-quota-syntax","content":"THROTTLE\\_TYPE can be expressed as READ, WRITE, or the default type(read + write)."},"16780":{"id":"/docs/single-page-6980","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-quota-syntax","content":"Timeframes can be expressed in the following units: `sec`, `min`, `hour`, `day`"},"16781":{"id":"/docs/single-page-6981","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-quota-syntax","content":"Request sizes can be expressed in the following units: `B` (bytes), `K` (kilobytes), `M` (megabytes), `G` (gigabytes), `T` (terabytes), `P` (petabytes)"},"16782":{"id":"/docs/single-page-6982","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-quota-syntax","content":"Numbers of requests are expressed as an integer followed by the string `req`"},"16783":{"id":"/docs/single-page-6983","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-quota-syntax","content":"Limits relating to time are expressed as req/time or size/time. For instance `10req/day` or `100P/hour`."},"16784":{"id":"/docs/single-page-6984","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-quota-syntax","content":"Numbers of tables or regions are expressed as integers."},"16785":{"id":"/docs/single-page-6985","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#setting-request-quotas","content":"You can set quota rules ahead of time, or you can change the throttle at runtime. The change will propagate after the quota refresh period has expired. This expiration period defaults to 5 minutes. To change it, modify the `hbase.quota.refresh.period` property in `hbase-site.xml`. This property is expressed in milliseconds and defaults to `300000`."},"16786":{"id":"/docs/single-page-6986","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#setting-request-quotas","content":"You can also place a global limit and exclude a user or a table from the limit by applying the `GLOBAL_BYPASS` property."},"16787":{"id":"/docs/single-page-6987","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-disabling-and-checking-rpc-throttling","content":"HBase provides shell commands to control RPC throttling at runtime. When throttling is disabled, HBase will not apply any request throttling. This can be useful in production environments that require temporary unthrottled operation."},"16788":{"id":"/docs/single-page-6988","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-disabling-and-checking-rpc-throttling","content":"The following HBase shell commands are available:"},"16789":{"id":"/docs/single-page-6989","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-disabling-and-checking-rpc-throttling","content":"`enable_rpc_throttle` and `disable_rpc_throttle` return the previous RPC throttling state as a boolean value. `rpc_throttle_enabled` returns the current state."},"16790":{"id":"/docs/single-page-6990","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabling-disabling-and-checking-rpc-throttling","content":"If no quotas are configured, RPC throttling is not applied, and enabling or disabling throttling\nwill always return false."},"16791":{"id":"/docs/single-page-6991","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#setting-namespace-quotas","content":"You can specify the maximum number of tables or regions allowed in a given namespace, either when you create the namespace or by altering an existing namespace, by setting the `hbase.namespace.quota.maxtables property` on the namespace."},"16792":{"id":"/docs/single-page-6992","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#request-queues","content":"If no throttling policy is configured, when the RegionServer receives multiple requests, they are now placed into a queue waiting for a free execution slot (HBASE-6721). The simplest queue is a FIFO queue, where each request waits for all previous requests in the queue to finish before running. Fast or interactive queries can get stuck behind large requests."},"16793":{"id":"/docs/single-page-6993","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#request-queues","content":"If you are able to guess how long a request will take, you can reorder requests by pushing the long requests to the end of the queue and allowing short requests to preempt them. Eventually, you must still execute the large requests and prioritize the new requests behind them. The short requests will be newer, so the result is not terrible, but still suboptimal compared to a mechanism which allows large requests to be split into multiple smaller ones."},"16794":{"id":"/docs/single-page-6994","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#request-queues","content":"HBASE-10993 introduces such a system for deprioritizing long-running scanners. There are two types of queues, `fifo` and `deadline`. To configure the type of queue used, configure the `hbase.ipc.server.callqueue.type` property in `hbase-site.xml`. There is no way to estimate how long each request may take, so de-prioritization only affects scans, and is based on the number of “next” calls a scan request has made. An assumption is made that when you are doing a full table scan, your job is not likely to be interactive, so if there are concurrent requests, you can delay long-running scans up to a limit tunable by setting the `hbase.ipc.server.queue.max.call.delay` property. The slope of the delay is calculated by a simple square root of `(numNextCall * weight)` where the weight is configurable by setting the `hbase.ipc.server.scan.vtime.weight` property."},"16795":{"id":"/docs/single-page-6995","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-typed-queues","content":"You can also prioritize or deprioritize different kinds of requests by configuring a specified number of dedicated handlers and queues. You can segregate the scan requests in a single queue with a single handler, and all the other available queues can service short `Get` requests."},"16796":{"id":"/docs/single-page-6996","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-typed-queues","content":"You can adjust the IPC queues and handlers based on the type of workload, using static tuning options. This approach is an interim first step that will eventually allow you to change the settings at runtime, and to dynamically adjust values based on the load."},"16797":{"id":"/docs/single-page-6997","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-queues","content":"To avoid contention and separate different kinds of requests, configure the `hbase.ipc.server.callqueue.handler.factor` property, which allows you to increase the number of queues and control how many handlers can share the same queue., allows admins to increase the number of queues and decide how many handlers share the same queue."},"16798":{"id":"/docs/single-page-6998","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#multiple-queues","content":"Using more queues reduces contention when adding a task to a queue or selecting it from a queue. You can even configure one queue per handler. The trade-off is that if some queues contain long-running tasks, a handler may need to wait to execute from that queue rather than stealing from another queue which has waiting tasks."},"16799":{"id":"/docs/single-page-6999","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#read-and-write-queues","content":"With multiple queues, you can now divide read and write requests, giving more priority (more queues) to one or the other type. Use the `hbase.ipc.server.callqueue.read.ratio` property to choose to serve more reads or more writes."},"16800":{"id":"/docs/single-page-7000","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#get-and-scan-queues","content":"Similar to the read/write split, you can split gets and scans by tuning the `hbase.ipc.server.callqueue.scan.ratio` property to give more priority to gets or to scans. A scan ratio of `0.1` will give more queue/handlers to the incoming gets, which means that more gets can be processed at the same time and that fewer scans can be executed at the same time. A value of `0.9` will give more queue/handlers to scans, so the number of scans executed will increase and the number of gets will decrease."},"16801":{"id":"/docs/single-page-7001","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"HBASE-16961 introduces a new type of quotas for HBase to leverage: filesystem quotas. These \"space\" quotas limit the amount of space on the filesystem that HBase namespaces and tables can consume. If a user, malicious or ignorant, has the ability to write data into HBase, with enough time, that user can effectively crash HBase (or worse HDFS) by consuming all available space. When there is no filesystem space available, HBase crashes because it can no longer create/sync data to the write-ahead log."},"16802":{"id":"/docs/single-page-7002","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"This feature allows a for a limit to be set on the size of a table or namespace. When a space quota is set on a namespace, the quota's limit applies to the sum of usage of all tables in that namespace. When a table with a quota exists in a namespace with a quota, the table quota takes priority over the namespace quota. This allows for a scenario where a large limit can be placed on a collection of tables, but a single table in that collection can have a fine-grained limit set."},"16803":{"id":"/docs/single-page-7003","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"The existing `set_quota` and `list_quota` HBase shell commands can be used to interact with space quotas. Space quotas are quotas with a `TYPE` of `SPACE` and have `LIMIT` and `POLICY` attributes. The `LIMIT` is a string that refers to the amount of space on the filesystem that the quota subject (e.g. the table or namespace) may consume. For example, valid values of `LIMIT` are `'10G'`, `'2T'`, or `'256M'`. The `POLICY` refers to the action that HBase will take when the quota subject's usage exceeds the `LIMIT`. The following are valid `POLICY` values."},"16804":{"id":"/docs/single-page-7004","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"`NO_INSERTS` - No new data may be written (e.g. `Put`, `Increment`, `Append`)."},"16805":{"id":"/docs/single-page-7005","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"`NO_WRITES` - Same as `NO_INSERTS` but `Deletes` are also disallowed."},"16806":{"id":"/docs/single-page-7006","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"`NO_WRITES_COMPACTIONS` - Same as `NO_WRITES` but compactions are also disallowed."},"16807":{"id":"/docs/single-page-7007","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"This policy only prevents user-submitted compactions. System can still run compactions."},"16808":{"id":"/docs/single-page-7008","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-quotas","content":"`DISABLE` - The table(s) are disabled, preventing all read/write access."},"16809":{"id":"/docs/single-page-7009","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#setting-simple-space-quotas","content":"Consider the following scenario to set up quotas on a namespace, overriding the quota on tables in that namespace"},"16810":{"id":"/docs/single-page-7010","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-and-namespace-space-quotas","content":"In the above scenario, the tables in the namespace `ns1` will not be allowed to consume more than 100TB of space on the filesystem among each other. The table 'ns1:t2' is only allowed to be 200GB in size, and will disallow all writes when the usage exceeds this limit. The table 'ns1:t3' is allowed to grow to 20TB in size and also will disallow all writes then the usage exceeds this limit. Because there is no table quota on 'ns1:t1', this table can grow up to 100TB, but only if 'ns1:t2' and 'ns1:t3' have a usage of zero bytes. Practically, it's limit is 100TB less the current usage of 'ns1:t2' and 'ns1:t3'."},"16811":{"id":"/docs/single-page-7011","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#disabling-automatic-space-quota-deletion","content":"By default, if a table or namespace is deleted that has a space quota, the quota itself is also deleted. In some cases, it may be desirable for the space quota to not be automatically deleted. In these cases, the user may configure the system to not delete any space quota automatically via hbase-site.xml."},"16812":{"id":"/docs/single-page-7012","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#disabling-automatic-space-quota-deletion","content":"The value is set to `true` by default."},"16813":{"id":"/docs/single-page-7013","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots-with-space-quotas","content":"One common area of unintended-filesystem-use with HBase is via HBase snapshots. Because snapshots exist outside of the management of HBase tables, it is not uncommon for administrators to suddenly realize that hundreds of gigabytes or terabytes of space is being used by HBase snapshots which were forgotten and never removed."},"16814":{"id":"/docs/single-page-7014","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots-with-space-quotas","content":"HBASE-17748 is the umbrella JIRA issue which expands on the original space quota functionality to also include HBase snapshots. While this is a confusing subject, the implementation attempts to present this support in as reasonable and simple of a manner as possible for administrators. This feature does not make any changes to administrator interaction with space quotas, only in the internal computation of table/namespace usage. Table and namespace usage will automatically incorporate the size taken by a snapshot per the rules defined below."},"16815":{"id":"/docs/single-page-7015","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots-with-space-quotas","content":"As a review, let's cover a snapshot's lifecycle: a snapshot is metadata which points to a list of HFiles on the filesystem. This is why creating a snapshot is a very cheap operation; no HBase table data is actually copied to perform a snapshot. Cloning a snapshot into a new table or restoring a table is a cheap operation for the same reason; the new table references the files which already exist on the filesystem without a copy. To include snapshots in space quotas, we need to define which table \"owns\" a file when a snapshot references the file (\"owns\" refers to encompassing the filesystem usage of that file)."},"16816":{"id":"/docs/single-page-7016","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots-with-space-quotas","content":"Consider a snapshot which was made against a table. When the snapshot refers to a file and the table no longer refers to that file, the \"originating\" table \"owns\" that file. When multiple snapshots refer to the same file and no table refers to that file, the snapshot with the lowest-sorting name (lexicographically) is chosen and the table which that snapshot was created from \"owns\" that file. HFiles are not \"double-counted\" hen a table and one or more snapshots refer to that HFile."},"16817":{"id":"/docs/single-page-7017","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots-with-space-quotas","content":"When a table is \"rematerialized\" (via `clone_snapshot` or `restore_snapshot`), a similar problem of file ownership arises. In this case, while the rematerialized table references a file which a snapshot also references, the table does not \"own\" the file. The table from which the snapshot was created still \"owns\" that file. When the rematerialized table is compacted or the snapshot is deleted, the rematerialized table will uniquely refer to a new file and \"own\" the usage of that file. Similarly, when a table is duplicated via a snapshot and `restore_snapshot`, the new table will not consume any quota size until the original table stops referring to the files, either due to a compaction on the original table, a compaction on the new table, or the original table being deleted."},"16818":{"id":"/docs/single-page-7018","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots-with-space-quotas","content":"One new HBase shell command was added to inspect the computed sizes of each snapshot in an HBase instance."},"16819":{"id":"/docs/single-page-7019","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-backup","content":"There are two broad strategies for performing HBase backups: backing up with a full cluster shutdown, and backing up on a live cluster. Each approach has pros and cons."},"16820":{"id":"/docs/single-page-7020","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-backup","content":"For additional information, see HBase Backup Options over on the Sematext Blog."},"16821":{"id":"/docs/single-page-7021","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#full-shutdown-backup","content":"Some environments can tolerate a periodic full shutdown of their HBase cluster, for example if it is being used a back-end analytic capacity and not serving front-end web-pages. The benefits are that the NameNode/Master are RegionServers are down, so there is no chance of missing any in-flight changes to either StoreFiles or metadata. The obvious con is that the cluster is down. The steps include:"},"16822":{"id":"/docs/single-page-7022","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#distcp","content":"Distcp could be used to either copy the contents of the HBase directory in HDFS to either the same cluster in another directory, or to a different cluster.\\\nNote: Distcp works in this situation because the cluster is down and there are no in-flight edits to files. Distcp-ing of files in the HBase directory is not generally recommended on a live cluster."},"16823":{"id":"/docs/single-page-7023","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restore-if-needed","content":"The backup of the hbase directory from HDFS is copied onto the 'real' hbase directory via distcp. The act of copying these files creates new HDFS metadata, which is why a restore of the NameNode edits from the time of the HBase backup isn't required for this kind of restore, because it's a restore (via distcp) of a specific HDFS directory (i.e., the HBase part) not the entire HDFS file-system."},"16824":{"id":"/docs/single-page-7024","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#live-cluster-backup---replication","content":"This approach assumes that there is a second cluster. See the HBase page on replication for more information."},"16825":{"id":"/docs/single-page-7025","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#live-cluster-backup---copytable","content":"The copytable utility could either be used to copy data from one table to another on the same cluster, or to copy data to another table on another cluster."},"16826":{"id":"/docs/single-page-7026","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#live-cluster-backup---copytable","content":"Since the cluster is up, there is a risk that edits could be missed in the copy process."},"16827":{"id":"/docs/single-page-7027","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#live-cluster-backup---export","content":"The export approach dumps the content of a table to HDFS on the same cluster. To restore the data, the import utility would be used."},"16828":{"id":"/docs/single-page-7028","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#live-cluster-backup---export","content":"Since the cluster is up, there is a risk that edits could be missed in the export process. If you want to know more about HBase back-up and restore see the page on Backup and Restore."},"16829":{"id":"/docs/single-page-7029","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots","content":"HBase Snapshots allow you to take a copy of a table (both contents and metadata)with a very small performance impact. A Snapshot is an immutable collection of table metadata and a list of HFiles that comprised the table at the time the Snapshot was taken. A \"clone\" of a snapshot creates a new table from that snapshot, and a \"restore\" of a snapshot returns the contents of a table to what it was when the snapshot was created. The \"clone\" and \"restore\" operations do not require any data to be copied, as the underlying HFiles (the files which contain the data for an HBase table) are not modified with either action. Simiarly, exporting a snapshot to another cluster has little impact on RegionServers of the local cluster."},"16830":{"id":"/docs/single-page-7030","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-snapshots","content":"Prior to version 0.94.6, the only way to backup or to clone a table is to use CopyTable/ExportTable, or to copy all the hfiles in HDFS after disabling the table. The disadvantages of these methods are that you can degrade region server performance (Copy/Export Table) or you need to disable the table, that means no reads or writes; and this is usually unacceptable."},"16831":{"id":"/docs/single-page-7031","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-configuration","content":"To turn on the snapshot support just set the `hbase.snapshot.enabled` property to true. (Snapshots are enabled by default in 0.95+ and off by default in 0.94.6+)"},"16832":{"id":"/docs/single-page-7032","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#take-a-snapshot","content":"You can take a snapshot of a table regardless of whether it is enabled or disabled. The snapshot operation doesn't involve any data copying."},"16833":{"id":"/docs/single-page-7033","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#take-a-snapshot-without-flushing","content":"The default behavior is to perform a flush of data in memory before the snapshot is taken. This means that data in memory is included in the snapshot. In most cases, this is the desired behavior. However, if your set-up can tolerate data in memory being excluded from the snapshot, you can use the `SKIP_FLUSH` option of the `snapshot` command to disable and flushing while taking the snapshot."},"16834":{"id":"/docs/single-page-7034","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#take-a-snapshot-without-flushing","content":"There is no way to determine or predict whether a very concurrent insert or update will be\nincluded in a given snapshot, whether flushing is enabled or disabled. A snapshot is only a\nrepresentation of a table during a window of time. The amount of time the snapshot operation will\ntake to reach each Region Server may vary from a few seconds to a minute, depending on the\nresource load and speed of the hardware or network, among other factors. There is also no way to\nknow whether a given insert or update is in memory or has been flushed."},"16835":{"id":"/docs/single-page-7035","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#take-a-snapshot-with-ttl","content":"Snapshots have a lifecycle that is independent from the table from which they are created. Although data in a table may be stored with TTL the data files containing them become frozen by the snapshot. Space consumed by expired cells will not be reclaimed by normal table housekeeping like compaction. While this is expected it can be inconvenient at scale. When many snapshots are under management and the data in various tables is expired by TTL some notion of optional TTL (and optional default TTL) for snapshots could be useful."},"16836":{"id":"/docs/single-page-7036","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#take-a-snapshot-with-ttl","content":"The above command creates snapshot `snapshot1234` with TTL of 86400 sec (24 hours) and hence, the snapshot is supposed to be cleaned up after 24 hours"},"16837":{"id":"/docs/single-page-7037","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"User specified default TTL with config `hbase.master.snapshot.ttl`"},"16838":{"id":"/docs/single-page-7038","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"FOREVER if `hbase.master.snapshot.ttl` is not set"},"16839":{"id":"/docs/single-page-7039","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"While creating a snapshot, if TTL in seconds is not explicitly specified, the above logic will be followed to determine the TTL. If no configs are changed, the default behavior is that all snapshots will be retained forever (until manual deletion). If a different default TTL behavior is desired, `hbase.master.snapshot.ttl` can be set to a default TTL in seconds. Any snapshot created without an explicit TTL will take this new value."},"16840":{"id":"/docs/single-page-7040","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"If `hbase.master.snapshot.ttl` is set, a snapshot with an explicit \\{TTL ⇒ 0} or \\{TTL ⇒ -1} will also take this value. In this case, a TTL \\< -1 (such as \\{TTL ⇒ -2}) should be used to indicate FOREVER."},"16841":{"id":"/docs/single-page-7041","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"To summarize concisely,"},"16842":{"id":"/docs/single-page-7042","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"Snapshot with TTL value \\< -1 will stay forever regardless of any server side config changes (until deleted manually by user)."},"16843":{"id":"/docs/single-page-7043","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"Snapshot with TTL value > 0 will be deleted automatically soon after TTL expires."},"16844":{"id":"/docs/single-page-7044","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"Snapshot created without specifying TTL will always have TTL value represented by config `hbase.master.snapshot.ttl`. Default value of this config is 0, which represents: keep the snapshot forever (until deleted manually by user)."},"16845":{"id":"/docs/single-page-7045","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-snapshot-ttl","content":"From client side, TTL value 0 or -1 should never be explicitly provided because they will be treated same as snapshot without TTL (same as above point 3) and hence will use TTL as per value represented by config `hbase.master.snapshot.ttl`."},"16846":{"id":"/docs/single-page-7046","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#take-a-snapshot-with-custom-max_filesize","content":"Optionally, snapshots can be created with a custom max file size configuration that will be used by cloned tables, instead of the global `hbase.hregion.max.filesize` configuration property. This is mostly useful when exporting snapshots between different clusters. If the HBase cluster where the snapshot is originally taken has a much larger value set for `hbase.hregion.max.filesize` than one or more clusters where the snapshot is being exported to, a storm of region splits may occur when restoring the snapshot on destination clusters. Specifying `MAX_FILESIZE` on properties passed to `snapshot` command will save informed value into the table's `MAX_FILESIZE` decriptor at snapshot creation time. If the table already defines `MAX_FILESIZE` descriptor, this property would be ignored and have no effect."},"16847":{"id":"/docs/single-page-7047","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabledisable-snapshot-auto-cleanup-on-running-cluster","content":"By default, snapshot auto cleanup based on TTL would be enabled for any new cluster. At any point in time, if snapshot cleanup is supposed to be stopped due to some snapshot restore activity or any other reason, it is advisable to disable it using shell command:"},"16848":{"id":"/docs/single-page-7048","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabledisable-snapshot-auto-cleanup-on-running-cluster","content":"We can re-enable it using:"},"16849":{"id":"/docs/single-page-7049","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabledisable-snapshot-auto-cleanup-on-running-cluster","content":"The shell command with switch false would disable snapshot auto cleanup activity based on TTL and return the previous state of the activity(true: running already, false: disabled already)"},"16850":{"id":"/docs/single-page-7050","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabledisable-snapshot-auto-cleanup-on-running-cluster","content":"A sample output for above commands:"},"16851":{"id":"/docs/single-page-7051","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabledisable-snapshot-auto-cleanup-on-running-cluster","content":"We can query whether snapshot auto cleanup is enabled for cluster using:"},"16852":{"id":"/docs/single-page-7052","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#enabledisable-snapshot-auto-cleanup-on-running-cluster","content":"The command would return output in true/false."},"16853":{"id":"/docs/single-page-7053","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#listing-snapshots","content":"List all snapshots taken (by printing the names and relative information)."},"16854":{"id":"/docs/single-page-7054","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#deleting-snapshots","content":"You can remove a snapshot, and the files retained for that snapshot will be removed if no longer needed."},"16855":{"id":"/docs/single-page-7055","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#clone-a-table-from-snapshot","content":"From a snapshot you can create a new table (clone operation) with the same data that you had when the snapshot was taken. The clone operation, doesn't involve data copies, and a change to the cloned table doesn't impact the snapshot or the original table."},"16856":{"id":"/docs/single-page-7056","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restore-a-snapshot","content":"The restore operation requires the table to be disabled, and the table will be restored to the state at the time when the snapshot was taken, changing both data and schema if required."},"16857":{"id":"/docs/single-page-7057","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restore-a-snapshot","content":"Since Replication works at log level and snapshots at file-system level, after a restore, the\nreplicas will be in a different state from the master. If you want to use restore, you need to\nstop replication and redo the bootstrap."},"16858":{"id":"/docs/single-page-7058","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#restore-a-snapshot","content":"In case of partial data-loss due to misbehaving client, instead of a full restore that requires the table to be disabled, you can clone the table from the snapshot and use a Map-Reduce job to copy the data that you need, from the clone to the main one."},"16859":{"id":"/docs/single-page-7059","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#snapshots-operations-and-acls","content":"If you are using security with the AccessController Coprocessor (See hbase.accesscontrol.configuration), only a global administrator can take, clone, or restore a snapshot, and these actions do not capture the ACL rights. This means that restoring a table preserves the ACL rights of the existing table, while cloning a table creates a new table that has no ACL rights until the administrator adds them."},"16860":{"id":"/docs/single-page-7060","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export-to-another-cluster","content":"The ExportSnapshot tool copies all the data related to a snapshot (hfiles, logs, snapshot metadata) to another cluster. The tool executes a Map-Reduce job, similar to distcp, to copy files between the two clusters, and since it works at file-system level the hbase cluster does not have to be online."},"16861":{"id":"/docs/single-page-7061","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#export-to-another-cluster","content":"To copy a snapshot called MySnapshot to an HBase cluster srv2 (hdfs\\:///srv2:8082/hbase) using 16 mappers:"},"16862":{"id":"/docs/single-page-7062","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#limiting-bandwidth-consumption","content":"You can limit the bandwidth consumption when exporting a snapshot, by specifying the `-bandwidth` parameter, which expects an integer representing megabytes per second. The following example limits the above example to 200 MB/sec."},"16863":{"id":"/docs/single-page-7063","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#storing-snapshots-in-an-amazon-s3-bucket","content":"You can store and retrieve snapshots from Amazon S3, using the following procedure."},"16864":{"id":"/docs/single-page-7064","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#storing-snapshots-in-an-amazon-s3-bucket","content":"You can also store snapshots in Microsoft Azure Blob Storage. See Storing Snapshots in Microsoft\nAzure Blob\nStorage."},"16865":{"id":"/docs/single-page-7065","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-s3-prerequisites","content":"You must be using HBase 1.0 or higher and Hadoop 2.6.1 or higher, which is the first configuration that uses the Amazon AWS SDK."},"16866":{"id":"/docs/single-page-7066","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-s3-prerequisites","content":"You must use the `s3a://` protocol to connect to Amazon S3. The older `s3n://` and `s3://` protocols have various limitations and do not use the Amazon AWS SDK."},"16867":{"id":"/docs/single-page-7067","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-s3-prerequisites","content":"The `s3a://` URI must be configured and available on the server where you run the commands to export and restore the snapshot."},"16868":{"id":"/docs/single-page-7068","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-s3-prerequisites","content":"After you have fulfilled the prerequisites, take the snapshot like you normally would. Afterward, you can export it using the `org.apache.hadoop.hbase.snapshot.ExportSnapshot` command like the one below, substituting your own `s3a://` path in the `copy-from` or `copy-to` directive and substituting or modifying other options as required:"},"16869":{"id":"/docs/single-page-7069","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-s3-prerequisites","content":"You can also use the `org.apache.hadoop.hbase.snapshot.SnapshotInfo` utility with the `s3a://` path by including the `-remote-dir` option."},"16870":{"id":"/docs/single-page-7070","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#storing-snapshots-in-microsoft-azure-blob-storage","content":"You can store snapshots in Microsoft Azure Blog Storage using the same techniques as in Storing Snapshots in an Amazon S3 Bucket."},"16871":{"id":"/docs/single-page-7071","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-azure-prerequisites","content":"You must be using HBase 1.2 or higher with Hadoop 2.7.1 or higher. No version of HBase supports Hadoop 2.7.0."},"16872":{"id":"/docs/single-page-7072","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-azure-prerequisites","content":"Your hosts must be configured to be aware of the Azure blob storage filesystem. See https\\://hadoop.apache.org/docs/r2.7.1/hadoop-azure/index.html."},"16873":{"id":"/docs/single-page-7073","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-azure-prerequisites","content":"After you meet the prerequisites, follow the instructions in Storing Snapshots in an Amazon S3 Bucket, replacingthe protocol specifier with `wasb://` or `wasbs://`."},"16874":{"id":"/docs/single-page-7074","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#storing-snapshots-in-aliyun-object-storage-service","content":"You can store snapshots in Aliyun Object Storage Service(Aliyun OSS) using the same techniques as in Storing Snapshots in an Amazon S3 Bucket."},"16875":{"id":"/docs/single-page-7075","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-aliyun-prerequisites","content":"You must be using HBase 1.2 or higher with Hadoop 2.9.1 or higher."},"16876":{"id":"/docs/single-page-7076","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-aliyun-prerequisites","content":"Your hosts must be configured to be aware of the Aliyun oss filesystem. See https\\://hadoop.apache.org/docs/stable/hadoop-aliyun/tools/hadoop-aliyun/index.html."},"16877":{"id":"/docs/single-page-7077","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operational-management-backup-and-snapshots-stroing-in-aliyun-prerequisites","content":"After you meet the prerequisites, follow the instructions in Storing Snapshots in an Amazon S3 Bucket, replacing the protocol specifier with `oss://`."},"16878":{"id":"/docs/single-page-7078","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-rename","content":"In versions 0.90.x of hbase and earlier, we had a simple script that would rename the hdfs table directory and then do an edit of the hbase:meta table replacing all mentions of the old table name with the new. The script was called `./bin/rename_table.rb`. The script was deprecated and removed mostly because it was unmaintained and the operation performed by the script was brutal."},"16879":{"id":"/docs/single-page-7079","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-rename","content":"As of hbase 0.94.x, you can use the snapshot facility renaming a table. Here is how you would do it using the hbase shell:"},"16880":{"id":"/docs/single-page-7080","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#table-rename","content":"or in code it would be as follows:"},"16881":{"id":"/docs/single-page-7081","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#major-compaction","content":"Major compactions can be requested via the HBase shell or Admin.majorCompact."},"16882":{"id":"/docs/single-page-7082","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#major-compaction","content":"Note: major compactions do NOT do region merges. See compaction for more information about compactions."},"16883":{"id":"/docs/single-page-7083","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#merge","content":"Merge is a utility that can merge adjoining regions in the same table (see org.apache.hadoop.hbase.util.Merge)."},"16884":{"id":"/docs/single-page-7084","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#merge","content":"If you feel you have too many regions and want to consolidate them, Merge is the utility you need. Merge must run be done when the cluster is down. See the O'Reilly HBase Book for an example of usage."},"16885":{"id":"/docs/single-page-7085","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#merge","content":"You will need to pass 3 parameters to this application. The first one is the table name. The second one is the fully qualified name of the first region to merge, like \"table\\_name,\\x0A,1342956111995.7cef47f192318ba7ccc75b1bbf27a82b.\". The third one is the fully qualified name for the second region to merge."},"16886":{"id":"/docs/single-page-7086","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#merge","content":"Additionally, there is a Ruby script attached to HBASE-1621 for region merging."},"16887":{"id":"/docs/single-page-7087","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#capacity-planning-and-region-sizing","content":"There are several considerations when planning the capacity for an HBase cluster and performing the initial configuration. Start with a solid understanding of how HBase handles data internally."},"16888":{"id":"/docs/single-page-7088","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"Physical data size on disk is distinct from logical size of your data and is affected by the following:"},"16889":{"id":"/docs/single-page-7089","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"Increased by HBase overhead"},"16890":{"id":"/docs/single-page-7090","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"See keyvalue and keysize. At least 24 bytes per key-value (cell), can be more. Small keys/values means more relative overhead."},"16891":{"id":"/docs/single-page-7091","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"KeyValue instances are aggregated into blocks, which are indexed. Indexes also have to be stored. Blocksize is configurable on a per-ColumnFamily basis. See regions.arch."},"16892":{"id":"/docs/single-page-7092","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"Decreased by compression and data block encoding, depending on data. You might want to test what compression and encoding (if any) make sense for your data."},"16893":{"id":"/docs/single-page-7093","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"Increased by size of region server \\[wal]/docs/architecture/regionserver#write-ahead-log-wal (usually fixed and negligible - less than half of RS memory size, per RS)."},"16894":{"id":"/docs/single-page-7094","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"Increased by HDFS replication - usually x3."},"16895":{"id":"/docs/single-page-7095","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#physical-data-size","content":"Aside from the disk space necessary to store the data, one RS may not be able to serve arbitrarily large amounts of data due to some practical limits on region count and size (see ops.capacity.regions)."},"16896":{"id":"/docs/single-page-7096","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#readwrite-throughput","content":"Number of nodes can also be driven by required throughput for reads and/or writes. The throughput one can get per node depends a lot on data (esp. key/value sizes) and request patterns, as well as node and system configuration. Planning should be done for peak load if it is likely that the load would be the main driver of the increase of the node count. PerformanceEvaluation and ycsb tools can be used to test single node or a test cluster."},"16897":{"id":"/docs/single-page-7097","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#readwrite-throughput","content":"For write, usually 5-15Mb/s per RS can be expected, since every region server has only one active WAL. There's no good estimate for reads, as it depends vastly on data, requests, and cache hit rate. perf.casestudy might be helpful."},"16898":{"id":"/docs/single-page-7098","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#jvm-gc-limitations","content":"RS cannot currently utilize very large heap due to cost of GC. There's also no good way of running multiple RS-es per server (other than running several VMs per machine). Thus, \\~20-24Gb or less memory dedicated to one RS is recommended. GC tuning is required for large heap sizes. See gcpause, trouble.log.gc and elsewhere (TODO: where?)"},"16899":{"id":"/docs/single-page-7099","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#determining-region-count-and-size","content":"Generally less regions makes for a smoother running cluster (you can always manually split the big regions later (if necessary) to spread the data, or request load, over the cluster); 20-200 regions per RS is a reasonable range. The number of regions cannot be configured directly (unless you go for fully disable.splitting); adjust the region size to achieve the target region size given table size."},"16900":{"id":"/docs/single-page-7100","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#determining-region-count-and-size","content":"When configuring regions for multiple tables, note that most region settings can be set on a per-table basis via TableDescriptorBuilder, as well as shell commands. These settings will override the ones in `hbase-site.xml`. That is useful if your tables have different workloads/use cases."},"16901":{"id":"/docs/single-page-7101","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#determining-region-count-and-size","content":"Also note that in the discussion of region sizes here, &#x2A;HDFS replication factor is not (and should not be) taken into account, whereas other factors ops.capacity.nodes.datasize should be.* So, if your data is compressed and replicated 3 ways by HDFS, \"9 Gb region\" means 9 Gb of compressed data. HDFS replication factor only affects your disk usage and is invisible to most HBase code."},"16902":{"id":"/docs/single-page-7102","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#viewing-the-current-number-of-regions","content":"You can view the current number of regions for a given table using the HMaster UI. In the **Tables** section, the number of online regions for each table is listed in the **Online Regions** column. This total only includes the in-memory state and does not include disabled or offline regions."},"16903":{"id":"/docs/single-page-7103","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---upper-bound","content":"In production scenarios, where you have a lot of data, you are normally concerned with the maximum number of regions you can have per server. too many regions has technical discussion on the subject. Basically, the maximum number of regions is mostly determined by memstore memory usage. Each region has its own memstores; these grow up to a configurable size; usually in 128-256 MB range, see hbase.hregion.memstore.flush.size. One memstore exists per column family (so there's only one per region if there's one CF in the table). The RS dedicates some fraction of total memory to its memstores (see hbase.regionserver.global.memstore.size). If this memory is exceeded (too much memstore usage), it can cause undesirable consequences such as unresponsive server or compaction storms. A good starting point for the number of regions per RS (assuming one table) is:"},"16904":{"id":"/docs/single-page-7104","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---upper-bound","content":"This formula is pseudo-code. Here are two formulas using the actual tunable parameters, first for HBase 0.98+ and second for HBase 0.94.x."},"16905":{"id":"/docs/single-page-7105","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---upper-bound","content":"**HBase 0.98.x**"},"16906":{"id":"/docs/single-page-7106","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---upper-bound","content":"**HBase 0.94.x**"},"16907":{"id":"/docs/single-page-7107","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---upper-bound","content":"If a given RegionServer has 16 GB of RAM, with default settings, the formula works out to 16384\\*0.4/128 \\~ 51 regions per RS is a starting point. The formula can be extended to multiple tables; if they all have the same configuration, just use the total number of families."},"16908":{"id":"/docs/single-page-7108","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---upper-bound","content":"This number can be adjusted; the formula above assumes all your regions are filled at approximately the same rate. If only a fraction of your regions are going to be actively written to, you can divide the result by that fraction to get a larger region count. Then, even if all regions are written to, all region memstores are not filled evenly, and eventually jitter appears even if they are (due to limited number of concurrent flushes). Thus, one can have as many as 2-3 times more regions than the starting point; however, increased numbers carry increased risk."},"16909":{"id":"/docs/single-page-7109","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---upper-bound","content":"For write-heavy workload, memstore fraction can be increased in configuration at the expense of block cache; this will also allow one to have more regions."},"16910":{"id":"/docs/single-page-7110","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---lower-bound","content":"HBase scales by having regions across many servers. Thus if you have 2 regions for 16GB data, on a 20 node machine your data will be concentrated on just a few machines - nearly the entire cluster will be idle. This really can't be stressed enough, since a common problem is loading 200MB data into HBase and then wondering why your awesome 10 node cluster isn't doing anything."},"16911":{"id":"/docs/single-page-7111","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#number-of-regions-per-rs---lower-bound","content":"On the other hand, if you have a very large amount of data, you may also want to go for a larger number of regions to avoid having regions that are too large."},"16912":{"id":"/docs/single-page-7112","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maximum-region-size","content":"For large tables in production scenarios, maximum region size is mostly limited by compactions - very large compactions, esp. major, can degrade cluster performance. Currently, the recommended maximum region size is 10-20Gb, and 5-10Gb is optimal. For older 0.90.x codebase, the upper-bound of regionsize is about 4Gb, with a default of 256Mb."},"16913":{"id":"/docs/single-page-7113","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maximum-region-size","content":"The size at which the region is split into two is generally configured via hbase.hregion.max.filesize; for details, see arch.region.splits."},"16914":{"id":"/docs/single-page-7114","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maximum-region-size","content":"If you cannot estimate the size of your tables well, when starting off, it's probably best to stick to the default region size, perhaps going smaller for hot tables (or manually split hot regions to spread the load over the cluster), or go with larger region sizes if your cell sizes tend to be largish (100k and up)."},"16915":{"id":"/docs/single-page-7115","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maximum-region-size","content":"In HBase 0.98, experimental stripe compactions feature was added that would allow for larger regions, especially for log data. See ops.stripe."},"16916":{"id":"/docs/single-page-7116","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#total-data-size-per-region-server","content":"According to above numbers for region size and number of regions per region server, in an optimistic estimate 10 GB x 100 regions per RS will give up to 1TB served per region server, which is in line with some of the reported multi-PB use cases. However, it is important to think about the data vs cache size ratio at the RS level. With 1TB of data per server and 10 GB block cache, only 1% of the data will be cached, which may barely cover all block indices."},"16917":{"id":"/docs/single-page-7117","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#initial-configuration-and-tuning","content":"First, see important configurations. Note that some configurations, more than others, depend on specific scenarios. Pay special attention to:"},"16918":{"id":"/docs/single-page-7118","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#initial-configuration-and-tuning","content":"hbase.regionserver.handler.count - request handler thread count, vital for high-throughput workloads."},"16919":{"id":"/docs/single-page-7119","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#initial-configuration-and-tuning","content":"config.wals - the blocking number of WAL files depends on your memstore configuration and should be set accordingly to prevent potential blocking when doing high volume of writes."},"16920":{"id":"/docs/single-page-7120","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#initial-configuration-and-tuning","content":"Then, there are some considerations when setting up your cluster and tables."},"16921":{"id":"/docs/single-page-7121","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#compactions","content":"Depending on read/write volume and latency requirements, optimal compaction settings may be different. See compaction for some details."},"16922":{"id":"/docs/single-page-7122","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#compactions","content":"When provisioning for large data sizes, however, it's good to keep in mind that compactions can affect write throughput. Thus, for write-intensive workloads, you may opt for less frequent compactions and more store files per regions. Minimum number of files for compactions (`hbase.hstore.compaction.min`) can be set to higher value; hbase.hstore.blockingStoreFiles should also be increased, as more files might accumulate in such case. You may also consider manually managing compactions: managed.compactions"},"16923":{"id":"/docs/single-page-7123","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pre-splitting-the-table","content":"Based on the target number of the regions per RS (see ops.capacity.regions.count) and number of RSes, one can pre-split the table at creation time. This would both avoid some costly splitting as the table starts to fill up, and ensure that the table starts out already distributed across many servers."},"16924":{"id":"/docs/single-page-7124","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pre-splitting-the-table","content":"If the table is expected to grow large enough to justify that, at least one region per RS should be created. It is not recommended to split immediately into the full target number of regions (e.g. 50 \\* number of RSes), but a low intermediate value can be chosen. For multiple tables, it is recommended to be conservative with presplitting (e.g. pre-split 1 region per RS at most), especially if you don't know how much each table will grow. If you split too much, you may end up with too many regions, with some tables having too many small regions."},"16925":{"id":"/docs/single-page-7125","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pre-splitting-the-table","content":"For pre-splitting howto, see manual region splitting decisions and precreate.regions."},"16926":{"id":"/docs/single-page-7126","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"RegionServer Grouping (A.K.A `rsgroup`) is an advanced feature for partitioning regionservers into distinctive groups for strict isolation. It should only be used by users who are sophisticated enough to understand the full implications and have a sufficient background in managing HBase clusters. It was developed by Yahoo! and they run it at scale on their large grid cluster. See HBase at Yahoo! Scale."},"16927":{"id":"/docs/single-page-7127","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"RSGroups can be defined and managed with both admin methods and shell commands. A server can be added to a group with hostname and port pair and tables can be moved to this group so that only regionservers in the same rsgroup can host the regions of the table. The group for a table is stored in its TableDescriptor, the property name is `hbase.rsgroup.name`. You can also set this property on a namespace, so it will cause all the tables under this namespace to be placed into this group. RegionServers and tables can only belong to one rsgroup at a time. By default, all tables and regionservers belong to the `default` rsgroup. System tables can also be put into a rsgroup using the regular APIs. A custom balancer implementation tracks assignments per rsgroup and makes sure to move regions to the relevant regionservers in that rsgroup. The rsgroup information is stored in a regular HBase table, and a zookeeper-based read-only cache is used at cluster bootstrap time."},"16928":{"id":"/docs/single-page-7128","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"To enable, add the following to your hbase-site.xml and restart your Master:"},"16929":{"id":"/docs/single-page-7129","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"Then use the admin/shell *rsgroup* methods/commands to create and manipulate RegionServer groups: e.g. to add a rsgroup and then add a server to it. To see the list of rsgroup commands available in the hbase shell type:"},"16930":{"id":"/docs/single-page-7130","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"High level, you create a rsgroup that is other than the `default` group using *add\\_rsgroup* command. You then add servers and tables to this group with the *move\\_servers\\_rsgroup* and *move\\_tables\\_rsgroup* commands. If necessary, run a balance for the group if tables are slow to migrate to the groups dedicated server with the *balance\\_rsgroup* command (Usually this is not needed). To monitor effect of the commands, see the `Tables` tab toward the end of the Master UI home page. If you click on a table, you can see what servers it is deployed across. You should see here a reflection of the grouping done with your shell commands. View the master log if issues."},"16931":{"id":"/docs/single-page-7131","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"Here is example using a few of the rsgroup commands. To add a group, do as follows:"},"16932":{"id":"/docs/single-page-7132","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"If you have not enabled the rsgroup feature and you call any of the rsgroup admin methods or shell\ncommands the call will fail with a `DoNotRetryIOException` with a detail message that says the\nrsgroup feature is disabled."},"16933":{"id":"/docs/single-page-7133","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"Add a server (specified by hostname + port) to the just-made group using the *move\\_servers\\_rsgroup* command as follows:"},"16934":{"id":"/docs/single-page-7134","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"The rsgroup feature refers to servers in a cluster with hostname and port only. It does not make\nuse of the HBase ServerName type identifying RegionServers; i.e. hostname + port + starttime to\ndistinguish RegionServer instances. The rsgroup feature keeps working across RegionServer restarts\nso the starttime of ServerName — and hence the ServerName type — is not appropriate.\nAdministration"},"16935":{"id":"/docs/single-page-7135","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"Servers come and go over the lifetime of a Cluster. Currently, you must manually align the servers referenced in rsgroups with the actual state of nodes in the running cluster. What we mean by this is that if you decommission a server, then you must update rsgroups as part of your server decommission process removing references. Notice that, by calling `clearDeadServers` manually will also remove the dead servers from any rsgroups, but the problem is that we will lost track of the dead servers after master restarts, which means you still need to update the rsgroup by your own."},"16936":{"id":"/docs/single-page-7136","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"Please use `Admin.removeServersFromRSGroup` or shell command *remove\\_servers\\_rsgroup* to remove decommission servers from rsgroup."},"16937":{"id":"/docs/single-page-7137","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regionserver-grouping","content":"The `default` group, and every regex-governed group (see Regex-Based Membership), are dynamic. Their server lists mirror the current state of the cluster; i.e. if you shutdown a server that was part of one of them, and then do a *get\\_rsgroup* on it to list its content in the shell, the server will no longer be listed. For other non-default rsgroups, though a node may be offline, it will persist in the group's list of servers. But if you move the offline server from the non-default rsgroup to default, it will not show in the `default` list. It will just be dropped."},"16938":{"id":"/docs/single-page-7138","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"Instead of moving each server into a group by hand, a non-default rsgroup can be made *regex-governed*: regionservers whose hostname matches a regular expression are placed in the group automatically as they register, and removed again when they go away. Set one property per group, where the suffix is the name of an existing rsgroup:"},"16939":{"id":"/docs/single-page-7139","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"The regex is matched against the server's hostname only (not the port), and must match the whole hostname."},"16940":{"id":"/docs/single-page-7140","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"Regexes are evaluated by the master on every regionserver join and leave, with no timeout. Like the rest of `hbase-site.xml`, they are trusted configuration, so keep them simple: a pattern prone to catastrophic backtracking (for example nested quantifiers such as `(a+)+`) can stall regionserver registration and expiry."},"16941":{"id":"/docs/single-page-7141","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"The group must already exist (`add_rsgroup`); the `default` group cannot be regex-governed."},"16942":{"id":"/docs/single-page-7142","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"A hostname that matches the regexes of more than one group is treated as unmatched and stays in `default` until the overlap is fixed. Invalid regexes and invalid group names are ignored with a warning in the master log."},"16943":{"id":"/docs/single-page-7143","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"Membership of a regex-governed group follows the live servers and is recomputed whenever a server joins or leaves, or when the HMaster restarts, like the `default` group. It is never stored in `hbase:rsgroup` or ZooKeeper: a regex-governed group is persisted with no servers, so a server event costs no extra I/O."},"16944":{"id":"/docs/single-page-7144","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"The regex always wins. A manual move that contradicts a regex is rejected, because the next server event or master restart would put the server back where its hostname says: a server matching a regex can only be moved to its regex-governed group, and a server that does not match cannot be moved into one. A regex-governed group cannot be removed while it has servers in the master's in-memory view. Remove the `hbase.rsgroup.regex.<group>` property from the configuration of all masters, including backup masters, and restart all HMasters. The group is then an ordinary admin-managed group with no servers, and its former servers go to `default`. This holds only if you did not reload the configuration first and a group change stored the servers in the meantime; if you did, move the servers out of the group by hand. Then remove the group. Removal also fails while a table or a namespace refers to the group."},"16945":{"id":"/docs/single-page-7145","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"Set the same `hbase.rsgroup.regex.*` properties on every master, including backup masters. Membership is computed from the active master's configuration, so a master that takes over with different properties would regroup the servers."},"16946":{"id":"/docs/single-page-7146","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"To add, change or remove a regex, change the configuration of all masters and restart the HMasters. Do not reload the configuration; reload is not recommended for these properties. A restart recomputes the membership of every regex-governed group at once. A reload recomputes nothing: servers move only at the next server event, and the in-memory membership of a group stays as it was until then. Group operations do not recompute it either: `add_rsgroup` and a group rename do not apply a regex, so a regex for a group that does not exist yet is ignored until a later server event or restart."},"16947":{"id":"/docs/single-page-7147","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"Adding or changing a regex for an existing group removes the servers that the regex does not match, but not at once. They leave the group at the next server event or master restart, and tables bound to the group then have fewer servers. Before you add or change a regex for an existing group, check the group's current servers against the regex."},"16948":{"id":"/docs/single-page-7148","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"**Removing a regex, or breaking it (typo, invalid regex), turns the group back into an ordinary\nadmin-managed group.** Its servers are not stored, so the group has none after a master restart;\nuntil then, servers it already holds stay in it, and a server that joins later is placed in\n`default`. Restart all masters, including backup masters, to settle it. A configuration reload is\nnot enough: it leaves the in-memory servers in the group, and a later change to a group stores\nthem as admin-managed members. Tables bound to the group may then have no regionserver of their\nown (see `hbase.rsgroup.fallback.enable` below). Invalid regexes and a regex-governed group with\nno online servers are both logged at WARN in the master log."},"16949":{"id":"/docs/single-page-7149","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"Set `hbase.rsgroup.fallback.enable` to `true` whenever you use regex-based membership, unless you\nhave a very good reason not to. Membership follows the live servers, so a regex-governed group (or\n`default`) can lose all of its servers when pods go down, when a regex is mistyped or removed, or\nwhen the regexes cover every regionserver. Without fallback, regions of tables bound to that group\nstay unassigned until a matching server returns."},"16950":{"id":"/docs/single-page-7150","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"When you enable a regex for servers that were previously placed in groups by hand, no manual cleanup is needed: after the HMaster restart, the regex places each matching server in its group at once (a reload would do so only at the next server event), any stale copy stored for it is cleared on the next flush, and a server stored in a regex-governed group that no longer matches its regex returns to `default`. The master logs a WARN naming the group the stale copy was in."},"16951":{"id":"/docs/single-page-7151","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#regex-based-membership","content":"Regex placement is always applied, even if it leaves the `default` group without any online servers (for example, when the regexes cover every regionserver). The master logs a warning in that case. Tables in `default`, including system tables unless they live in another rsgroup, then have no regionserver of their own, so set `hbase.rsgroup.fallback.enable` to `true` to let their regions fall back to the servers of other groups. Without it, those regions stay unassigned until a server that matches no regex, and is in no other group, registers."},"16952":{"id":"/docs/single-page-7152","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#best-practice","content":"The authors of the rsgroup feature, the Yahoo! HBase Engineering team, have been running it on their grid for a good while now and have come up with a few best practices informed by their experience."},"16953":{"id":"/docs/single-page-7153","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#isolate-system-tables","content":"Either have a system rsgroup where all the system tables are or just leave the system tables in `default` rsgroup and have all user-space tables are in non-default rsgroups."},"16954":{"id":"/docs/single-page-7154","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dead-nodes","content":"Yahoo! Have found it useful at their scale to keep a special rsgroup of dead or questionable nodes; this is one means of keeping them out of the running until repair."},"16955":{"id":"/docs/single-page-7155","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dead-nodes","content":"Be careful replacing dead nodes in an rsgroup. Ensure there are enough live nodes before you start moving out the dead. Move in good live nodes first if you have to."},"16956":{"id":"/docs/single-page-7156","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dead-nodes","content":"Servers that match a `hbase.rsgroup.regex.<group>` entry cannot be moved into a dead-nodes group; the move is rejected because the regex decides their group. To park such a server, change the regex (for example, exclude it by hostname) and restart the HMaster to apply the change. A configuration reload is not recommended."},"16957":{"id":"/docs/single-page-7157","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-and-capacity-troubleshooting","content":"Viewing the Master log will give you insight on rsgroup operation."},"16958":{"id":"/docs/single-page-7158","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-and-capacity-troubleshooting","content":"If it appears stuck, restart the Master process."},"16959":{"id":"/docs/single-page-7159","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Simply disable RegionServer Grouping feature is easy, just remove the 'hbase.balancer.rsgroup.enabled' from hbase-site.xml or explicitly set it to false in hbase-site.xml."},"16960":{"id":"/docs/single-page-7160","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"But if you change the 'hbase.balancer.rsgroup.enabled' to true, the old rsgroup configs will take effect again. So if you want to completely remove the RegionServer Grouping feature from a cluster, so that if the feature is re-enabled in the future, the old meta data will not affect the functioning of the cluster, there are more steps to do."},"16961":{"id":"/docs/single-page-7161","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Move all tables in non-default rsgroups to `default` regionserver group"},"16962":{"id":"/docs/single-page-7162","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Remove every `hbase.rsgroup.regex.*` property from the configuration on **all masters**, and restart all HMasters, including backup masters. Do not only reload the configuration. Moves of servers that match a regex are rejected while the property is set. After the restart, the regex-governed groups have no servers and their former servers are in `default`."},"16963":{"id":"/docs/single-page-7163","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Move all regionservers in non-default rsgroups to `default` regionserver group"},"16964":{"id":"/docs/single-page-7164","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Remove all non-default rsgroups. `default` rsgroup created implicitly doesn't have to be removed"},"16965":{"id":"/docs/single-page-7165","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Remove the changes made in `hbase-site.xml` and restart the cluster"},"16966":{"id":"/docs/single-page-7166","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Drop the table `hbase:rsgroup` from `hbase`"},"16967":{"id":"/docs/single-page-7167","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remove-regionserver-grouping","content":"Remove znode `rsgroup` from the cluster ZooKeeper using zkCli.sh"},"16968":{"id":"/docs/single-page-7168","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#acl","content":"To enable ACL, add the following to your hbase-site.xml and restart your Master:"},"16969":{"id":"/docs/single-page-7169","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrating-from-old-implementation","content":"The coprocessor `org.apache.hadoop.hbase.rsgroup.RSGroupAdminEndpoint` is deprected, but for compatible, if you want the pre 3.0.0 hbase client/shell to communicate with the new hbase cluster, you still need to add this coprocessor to master."},"16970":{"id":"/docs/single-page-7170","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrating-from-old-implementation","content":"The `hbase.rsgroup.grouploadbalancer.class` config has been deprecated, as now the top level load balancer will always be `RSGroupBasedLoadBalaner`, and the `hbase.master.loadbalancer.class` config is for configuring the balancer within a group. This also means you should not set `hbase.master.loadbalancer.class` to `RSGroupBasedLoadBalaner` any more even if rsgroup feature is enabled."},"16971":{"id":"/docs/single-page-7171","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrating-from-old-implementation","content":"And we have done some special changes for compatibility. First, if coprocessor `org.apache.hadoop.hbase.rsgroup.RSGroupAdminEndpoint` is specified, the `hbase.balancer.rsgroup.enabled` flag will be set to true automatically to enable rs group feature. Second, we will load `hbase.rsgroup.grouploadbalancer.class` prior to `hbase.master.loadbalancer.class`. And last, if you do not set `hbase.rsgroup.grouploadbalancer.class` but only set `hbase.master.loadbalancer.class` to `RSGroupBasedLoadBalancer`, we will load the default load balancer to avoid infinite nesting. This means you do not need to change anything when upgrading if you have already enabled rs group feature."},"16972":{"id":"/docs/single-page-7172","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrating-from-old-implementation","content":"The main difference comparing to the old implementation is that, now the rsgroup for a table is stored in `TableDescriptor`, instead of in `RSGroupInfo`, so the `getTables` method of `RSGroupInfo` has been deprecated. And if you use the `Admin` methods to get the `RSGroupInfo`, its `getTables` method will always return empty. This is because that in the old implementation, this method is a bit broken as you can set rsgroup on namespace and make all the tables under this namespace into this group but you can not get these tables through `RSGroupInfo.getTables`. Now you should use the two new methods `listTablesInRSGroup` and `getConfiguredNamespacesAndTablesInRSGroup` in `Admin` to get tables and namespaces in a rsgroup."},"16973":{"id":"/docs/single-page-7173","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrating-from-old-implementation","content":"Of course the behavior for the old RSGroupAdminEndpoint is not changed, we will fill the tables field of the RSGroupInfo before returning, to make it compatible with old hbase client/shell."},"16974":{"id":"/docs/single-page-7174","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#migrating-from-old-implementation","content":"When upgrading, the migration between the RSGroupInfo and TableDescriptor will be done automatically. It will take sometime, but it is fine to restart master in the middle, the migration will continue after restart. And during the migration, the rs group feature will still work and in most cases the region will not be misplaced(since this is only a one time job and will not last too long so we have not test it very seriously to make sure the region will not be misplaced always, so we use the word 'in most cases'). The implementation is a bit tricky, you can see the code in `RSGroupInfoManagerImpl.migrate` if interested."},"16975":{"id":"/docs/single-page-7175","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"The Region Normalizer tries to make Regions all in a table about the same in size. It does this by first calculating total table size and average size per region. It splits any region that is larger than twice this size. Any region that is much smaller is merged into an adjacent region. The Normalizer runs on a regular schedule, which is configurable. It can also be disabled entirely via a runtime \"switch\". It can be run manually via the shell or Admin API call. Even if normally disabled, it is good to run manually after the cluster has been running a while or say after a burst of activity such as a large delete."},"16976":{"id":"/docs/single-page-7176","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"The Normalizer works well for bringing a table's region boundaries into alignment with the reality of data distribution after an initial effort at pre-splitting a table. It is also a nice compliment to the data TTL feature when the schema includes timestamp in the rowkey, as it will automatically merge away regions whose contents have expired."},"16977":{"id":"/docs/single-page-7177","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"(The bulk of the below detail was copied wholesale from the blog by Romil Choksi at HBase Region Normalizer)."},"16978":{"id":"/docs/single-page-7178","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"The Region Normalizer is feature available since HBase-1.2. It runs a set of pre-calculated merge/split actions to resize regions that are either too large or too small compared to the average region size for a given table. Region Normalizer when invoked computes a normalization 'plan' for all of the tables in HBase. System tables (such as hbase:meta, hbase:namespace, Phoenix system tables etc) and user tables with normalization disabled are ignored while computing the plan. For normalization enabled tables, normalization plan is carried out in parallel across multiple tables."},"16979":{"id":"/docs/single-page-7179","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"Normalizer can be enabled or disabled globally for the entire cluster using the ‘normalizer\\_switch' command in the HBase shell. Normalization can also be controlled on a per table basis, which is disabled by default when a table is created. Normalization for a table can be enabled or disabled by setting the NORMALIZATION\\_ENABLED table attribute to true or false."},"16980":{"id":"/docs/single-page-7180","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"To check normalizer status and enable/disable normalizer"},"16981":{"id":"/docs/single-page-7181","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"When enabled, Normalizer is invoked in the background every 5 mins (by default), which can be configured using `hbase.normalization.period` in `hbase-site.xml`. Normalizer can also be invoked manually/programmatically at will using HBase shell's `normalize` command. HBase by default uses `SimpleRegionNormalizer`, but users can design their own normalizer as long as they implement the RegionNormalizer Interface. Details about the logic used by `SimpleRegionNormalizer` to compute its normalization plan can be found here."},"16982":{"id":"/docs/single-page-7182","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"The below example shows a normalization plan being computed for an user table, and merge action being taken as a result of the normalization plan computed by SimpleRegionNormalizer."},"16983":{"id":"/docs/single-page-7183","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"Consider an user table with some pre-split regions having 3 equally large regions (about 100K rows) and 1 relatively small region (about 25K rows). Following is the snippet from an hbase meta table scan showing each of the pre-split regions for the user table."},"16984":{"id":"/docs/single-page-7184","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"Invoking the normalizer using 'normalize' int the HBase shell, the below log snippet from HMaster log shows the normalization plan computed as per the logic defined for SimpleRegionNormalizer. Since the total region size (in MB) for the adjacent smallest regions in the table is less than the average region size, the normalizer computes a plan to merge these two regions."},"16985":{"id":"/docs/single-page-7185","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"Region normalizer as per it's computed plan, merged the region with start key as ‘' and end key as ‘1', with another region having start key as ‘1' and end key as ‘3'. Now, that these regions have been merged we see a single new region with start key as ‘' and end key as ‘3'"},"16986":{"id":"/docs/single-page-7186","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-normalizer","content":"A similar example can be seen for an user table with 3 smaller regions and 1 relatively large region. For this example, we have an user table with 1 large region containing 100K rows, and 3 relatively smaller regions with about 33K rows each. As seen from the normalization plan, since the larger region is more than twice the average region size it ends being split into two regions – one with start key as ‘1' and end key as ‘154717' and the other region with start key as '154717' and end key as ‘3'"},"16987":{"id":"/docs/single-page-7187","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#auto-region-reopen","content":"We can leak store reader references if a coprocessor or core function somehow opens a scanner, or wraps one, and then does not take care to call close on the scanner or the wrapped instance. Leaked store files can not be removed even after it is invalidated via compaction. A reasonable mitigation for a reader reference leak would be a fast reopen of the region on the same server. This will release all resources, like the refcount, leases, etc. The clients should gracefully ride over this like any other region in transition. By default this auto reopen of region feature would be disabled. To enabled it, please provide high ref count value for config `hbase.regions.recovery.store.file.ref.count`."},"16988":{"id":"/docs/single-page-7188","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#auto-region-reopen","content":"Please refer to config descriptions for `hbase.master.regions.recovery.check.interval` and `hbase.regions.recovery.store.file.ref.count`."},"16989":{"id":"/docs/single-page-7189","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing","content":"This chapter contains information and guidelines for building and releasing HBase code and documentation.\nBeing familiar with these guidelines will help the HBase committers to use your contributions more easily."},"16990":{"id":"/docs/single-page-7190","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#getting-involved","content":"Apache HBase gets better only when people contribute! If you are looking to contribute to Apache HBase, look for issues in JIRA tagged with the label 'beginner'.\nThese are issues HBase contributors have deemed worthy but not of immediate priority and a good way to ramp on HBase internals.\nSee What label\nis used for issues that are good on ramps for new contributors? from the dev mailing list for background."},"16991":{"id":"/docs/single-page-7191","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#getting-involved","content":"Before you get started submitting code to HBase, please refer to Developer Guidelines."},"16992":{"id":"/docs/single-page-7192","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#getting-involved","content":"As Apache HBase is an Apache Software Foundation project, see The Apache Software Foundation for more information about how the ASF functions."},"16993":{"id":"/docs/single-page-7193","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-mailing-lists","content":"Sign up for the dev-list and the user-list.\nSee the mailing lists page.\nPosing questions - and helping to answer other people's questions - is encouraged! There are varying levels of experience on both lists so patience and politeness are encouraged (and please stay on topic.)"},"16994":{"id":"/docs/single-page-7194","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-slack","content":"The Apache HBase project uses the #hbase channel on the official\nASF Slack Workspace for real-time questions and discussion.\nAll committers of any Apache projects can join the channel directly, for others, please mail\ndev\\@hbase.apache.org to request an invite."},"16995":{"id":"/docs/single-page-7195","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#internet-relay-chat-irc","content":"(NOTE: Our IRC channel seems to have been deprecated in favor of the above Slack channel)"},"16996":{"id":"/docs/single-page-7196","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#internet-relay-chat-irc","content":"For real-time questions and discussions, use the `#hbase` IRC channel on the FreeNode IRC network.\nFreeNode offers a web-based client, but most people prefer a native client, and several clients are available for each operating system."},"16997":{"id":"/docs/single-page-7197","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"Check for existing issues in Jira.\nIf it's either a new feature request, enhancement, or a bug, file a ticket."},"16998":{"id":"/docs/single-page-7198","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"We track multiple types of work in JIRA:"},"16999":{"id":"/docs/single-page-7199","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"Bug: Something is broken in HBase itself."},"17000":{"id":"/docs/single-page-7200","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"Test: A test is needed, or a test is broken."},"17001":{"id":"/docs/single-page-7201","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"New feature: You have an idea for new functionality. It's often best to bring\nthese up on the mailing lists first, and then write up a design specification\nthat you add to the feature request JIRA."},"17002":{"id":"/docs/single-page-7202","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"Improvement: A feature exists, but could be tweaked or augmented. It's often\nbest to bring these up on the mailing lists first and have a discussion, then\nsummarize or link to the discussion if others seem interested in the\nimprovement."},"17003":{"id":"/docs/single-page-7203","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"Wish: This is like a new feature, but for something you may not have the\nbackground to flesh out yourself."},"17004":{"id":"/docs/single-page-7204","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-getting-involved-jira","content":"Bugs and tests have the highest priority and should be actionable."},"17005":{"id":"/docs/single-page-7205","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"*Search for duplicates*: Your issue may have already been reported. Have a\nlook, realizing that someone else might have worded the summary differently."},"17006":{"id":"/docs/single-page-7206","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"Also search the mailing lists, which may have information about your problem\nand how to work around it. Don't file an issue for something that has already\nbeen discussed and resolved on a mailing list, unless you strongly disagree\nwith the resolution *and* are willing to help take the issue forward."},"17007":{"id":"/docs/single-page-7207","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"*Discuss in public*: Use the mailing lists to discuss what you've discovered\nand see if there is something you've missed. Avoid using back channels, so\nthat you benefit from the experience and expertise of the project as a whole."},"17008":{"id":"/docs/single-page-7208","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"*Don't file on behalf of others*: You might not have all the context, and you\ndon't have as much motivation to see it through as the person who is actually\nexperiencing the bug. It's more helpful in the long term to encourage others\nto file their own issues. Point them to this material and offer to help out\nthe first time or two."},"17009":{"id":"/docs/single-page-7209","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"*Write a good summary*: A good summary includes information about the problem,\nthe impact on the user or developer, and the area of the code."},"17010":{"id":"/docs/single-page-7210","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"Good: `Address new license dependencies from hadoop3-alpha4`"},"17011":{"id":"/docs/single-page-7211","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"Room for improvement: `Canary is broken`\nIf you write a bad title, someone else will rewrite it for you. This is time\nthey could have spent working on the issue instead."},"17012":{"id":"/docs/single-page-7212","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"*Give context in the description*: It can be good to think of this in multiple\nparts:"},"17013":{"id":"/docs/single-page-7213","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"What happens or doesn't happen?"},"17014":{"id":"/docs/single-page-7214","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"How does it impact you?"},"17015":{"id":"/docs/single-page-7215","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"How can someone else reproduce it?"},"17016":{"id":"/docs/single-page-7216","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"What would \"fixed\" look like?\\\nYou don't need to know the answers for all of these, but give as much\ninformation as you can. If you can provide technical information, such as a\nGit commit SHA that you think might have caused the issue or a build failure\non builds.apache.org where you think the issue first showed up, share that\ninfo."},"17017":{"id":"/docs/single-page-7217","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"**Fill in all relevant fields**: These fields help us filter, categorize, and\nfind things."},"17018":{"id":"/docs/single-page-7218","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"**One bug, one issue, one patch**: To help with back-porting, don't split issues\nor fixes among multiple bugs."},"17019":{"id":"/docs/single-page-7219","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"**Add value if you can**: Filing issues is great, even if you don't know how to\nfix them. But providing as much information as possible, being willing to\ntriage and answer questions, and being willing to test potential fixes is even\nbetter! We want to fix your issue as quickly as you want it to be fixed."},"17020":{"id":"/docs/single-page-7220","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#guidelines-for-reporting-effective-issues","content":"**Don't be upset if we don't fix it**: Time and resources are finite. In some\ncases, we may not be able to (or might choose not to) fix an issue, especially\nif it is an edge case or there is a workaround. Even if it doesn't get fixed,\nthe JIRA is a public record of it, and will help others out if they run into\na similar issue in the future."},"17021":{"id":"/docs/single-page-7221","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"To check for existing issues which you can tackle as a beginner, search for issues in JIRA tagged with the label 'beginner'."},"17022":{"id":"/docs/single-page-7222","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"JIRA Priorites:"},"17023":{"id":"/docs/single-page-7223","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"**Blocker**: Should only be used if the issue WILL cause data loss or cluster instability reliably."},"17024":{"id":"/docs/single-page-7224","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"**Critical**: The issue described can cause data loss or cluster instability in some cases."},"17025":{"id":"/docs/single-page-7225","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"**Major**: Important but not tragic issues, like updates to the client API that will add a lot of much-needed functionality or significant bugs that need to be fixed but that don't cause data loss."},"17026":{"id":"/docs/single-page-7226","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"**Minor**: Useful enhancements and annoying but not damaging bugs."},"17027":{"id":"/docs/single-page-7227","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"**Trivial**: Useful enhancements but generally cosmetic."},"17028":{"id":"/docs/single-page-7228","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"Code Blocks in Jira Comments:"},"17029":{"id":"/docs/single-page-7229","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#working-on-an-issue","content":"A commonly used macro in Jira is `{code}`. Everything inside the tags is preformatted, as in this example."},"17030":{"id":"/docs/single-page-7230","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repositories","content":"Apache HBase consists of multiple repositories which are hosted on Apache GitBox.\nThese are the following:"},"17031":{"id":"/docs/single-page-7231","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repositories","content":"hbase - main Apache HBase repository"},"17032":{"id":"/docs/single-page-7232","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repositories","content":"hbase-connectors - connectors to Apache Kafka and Apache Spark"},"17033":{"id":"/docs/single-page-7233","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repositories","content":"hbase-operator-tools - operability and supportability tools, such as HBase HBCK2"},"17034":{"id":"/docs/single-page-7234","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repositories","content":"hbase-site - hbase.apache.org website"},"17035":{"id":"/docs/single-page-7235","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#repositories","content":"hbase-thirdparty - relocated versions of popular third-party libraries"},"17036":{"id":"/docs/single-page-7236","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#code-formatting","content":"Under the &#x2A;dev-support/* folder, you will find *hbase\\_eclipse\\_formatter.xml*.\nWe encourage you to have this formatter in place in eclipse when editing HBase code."},"17037":{"id":"/docs/single-page-7237","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#code-formatting","content":"Go to `Preferences->Java->Code Style->Formatter->Import` to load the xml file.\nGo to `Preferences->Java->Editor->Save Actions`, and make sure 'Format source code' and 'Format\nedited lines' is selected."},"17038":{"id":"/docs/single-page-7238","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#code-formatting","content":"In addition to the automatic formatting, make sure you follow the style guidelines explained in\nCode Formatting Conventions."},"17039":{"id":"/docs/single-page-7239","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#eclipse-git-plugin","content":"If you cloned the project via git, download and install the Git plugin (EGit). Attach to your local git repo (via the Git Repositories window) and you'll be able to see file revision history, generate patches, etc."},"17040":{"id":"/docs/single-page-7240","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-m2eclipse","content":"The easiest way is to use the `m2eclipse` plugin for Eclipse.\nEclipse Indigo or newer includes +m2eclipse+, or you can download it from http\\://www\\.eclipse.org/m2e/. It provides Maven integration for Eclipse, and even lets you use the direct Maven commands from within Eclipse to compile and test your project."},"17041":{"id":"/docs/single-page-7241","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-m2eclipse","content":"To import the project, click and select the HBase root directory. `m2eclipse` locates all the hbase modules for you."},"17042":{"id":"/docs/single-page-7242","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-m2eclipse","content":"If you install `m2eclipse` and import HBase in your workspace, do the following to fix your eclipse Build Path."},"17043":{"id":"/docs/single-page-7243","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-m2eclipse","content":"Remove *target* folder"},"17044":{"id":"/docs/single-page-7244","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-m2eclipse","content":"Add *target/generated-sources/java* folder."},"17045":{"id":"/docs/single-page-7245","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-m2eclipse","content":"Remove from your Build Path the exclusions on the *src/main/resources* and *src/test/resources* to avoid error message in the console, such as the following:"},"17046":{"id":"/docs/single-page-7246","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-m2eclipse","content":"This will also reduce the eclipse build cycles and make your life easier when developing."},"17047":{"id":"/docs/single-page-7247","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-the-command-line","content":"Instead of using `m2eclipse`, you can generate the Eclipse files from the command line."},"17048":{"id":"/docs/single-page-7248","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-the-command-line","content":"First, run the following command, which builds HBase.\nYou only need to do this once."},"17049":{"id":"/docs/single-page-7249","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-the-command-line","content":"Close Eclipse, and execute the following command from the terminal, in your local HBase project directory, to generate new *.project&#x2A; and *.classpath* files."},"17050":{"id":"/docs/single-page-7250","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-project-setup-in-eclipse-using-the-command-line","content":"Reopen Eclipse and import the *.project* file in the HBase directory to a workspace."},"17051":{"id":"/docs/single-page-7251","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maven-classpath-variable","content":"The `$M2_REPO&#x60; classpath variable needs to be set up for the project.\nThis needs to be set to your local Maven repository, which is usually *\\~/.m2/repository*"},"17052":{"id":"/docs/single-page-7252","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maven-classpath-variable","content":"If this classpath variable is not configured, you will see compile errors in Eclipse like this:"},"17053":{"id":"/docs/single-page-7253","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#eclipse-known-issues","content":"Eclipse will currently complain about *Bytes.java*.\nIt is not possible to turn these errors off."},"17054":{"id":"/docs/single-page-7254","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#eclipse---more-information","content":"For additional information on setting up Eclipse for HBase development on Windows, see Michael Morello's blog on the topic."},"17055":{"id":"/docs/single-page-7255","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"A functional development environment can be setup around an IntelliJ IDEA installation that has the\nplugins necessary for building Java projects with Maven."},"17056":{"id":"/docs/single-page-7256","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"Use either File > New > \"Project from Existing Sources...\" or \"Project From Version Control..\""},"17057":{"id":"/docs/single-page-7257","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"Depending on your version of IntelliJ, you may need to choose Maven as the \"project\" or \"model\"\ntype."},"17058":{"id":"/docs/single-page-7258","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"The following plugins are recommended:"},"17059":{"id":"/docs/single-page-7259","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"Maven, bundled. This allows IntelliJ to resolve dependencies and recognize the project structure."},"17060":{"id":"/docs/single-page-7260","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"EditorConfig, bundled. This will apply project whitespace settings found in the\n`.editorconfig` file available on branches with\nHBASE-23234 or later."},"17061":{"id":"/docs/single-page-7261","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"Checkstyle-IDEA. Configure this\nagainst the configuration file found under `hbase-checkstyle/src/main/resources/hbase/checkstyle.xml`\n(If the Intellij checkstyle plugin complains parsing the volunteered hbase `checkstyle.xml`, make\nsure the plugin's `version` popup menu matches the hbase checkstyle version. Find the current\ncheckstyle version as a property in `pom.xml`.\nThis plugin will highlight style errors in the IDE, so you can fix them before they get flagged during the\npre-commit process."},"17062":{"id":"/docs/single-page-7262","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"Protobuf Support. HBase uses\nProtocol Buffers in a number of places where\nserialization is required. This plugin is helpful when editing these object definitions."},"17063":{"id":"/docs/single-page-7263","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#intellij-idea","content":"MDX. HBase uses\nMDX (just extended markdown) for building it's project documentation. This plugin is helpful\nwhen editing this book."},"17064":{"id":"/docs/single-page-7264","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#other-ides","content":"If you'd have another environment with which you'd like to develop on HBase, please consider\ndocumenting your setup process here."},"17065":{"id":"/docs/single-page-7265","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#basic-compile","content":"HBase is compiled using Maven. You must use at least Maven 3.0.4. To check your Maven version, run\nthe command `mvn -version`."},"17066":{"id":"/docs/single-page-7266","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-basic-compile-jdk-version-requirements","content":"HBase has Java version compiler requirements that vary by release branch. At compilation time,\nHBase has the same version requirements as it does for runtime. See Java for a complete\nsupport matrix of Java version by HBase version."},"17067":{"id":"/docs/single-page-7267","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maven-build-commands","content":"All commands are executed from the local HBase project directory."},"17068":{"id":"/docs/single-page-7268","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#package","content":"The simplest command to compile HBase from its java source code is to use the `package` target, which builds JARs with the compiled files."},"17069":{"id":"/docs/single-page-7269","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#package","content":"Or, to clean up before compiling:"},"17070":{"id":"/docs/single-page-7270","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#package","content":"With Eclipse set up as explained above in Eclipse, you can also use the **Build** command in Eclipse.\nTo create the full installable HBase package takes a little bit more work, so read on."},"17071":{"id":"/docs/single-page-7271","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#compile","content":"The `compile` target does not create the JARs with the compiled files."},"17072":{"id":"/docs/single-page-7272","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#install","content":"To install the JARs in your &#x2A;\\~/.m2/* directory, use the `install` target."},"17073":{"id":"/docs/single-page-7273","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-hbase-2x-on-apple-silicon","content":"Building a non-master branch requires protoc 2.5.0 binary which is not available for Apple Silicon.\nHBASE-27741 added a workaround to the build to fall back to osx-x86\\_64 version of protoc automatically by `apple-silicon-workaround` Maven profile.\nThe intention is that this change will permit the build to proceed with the x86 version of `protoc`, making use of the Rosetta instruction translation service built into the OS.\nIf you'd like to provide and make use of your own aarch\\_64 `protoc`, you can disable this profile on the command line by adding `-P'!apple-silicon-workaround'`, or through configuration in your `settings.xml`."},"17074":{"id":"/docs/single-page-7274","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-hbase-2x-on-apple-silicon","content":"You can use the following commands to build protoc on your Apple Silicon machine."},"17075":{"id":"/docs/single-page-7275","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-all-or-individual-unit-tests","content":"See the Running tests section in Unit Tests"},"17076":{"id":"/docs/single-page-7276","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-against-various-hadoop-versions","content":"HBase supports building against Apache Hadoop versions: 2.y and 3.y (early release artifacts).\nExactly which version of Hadoop is used by default varies by release branch. See the section\nHadoop for the complete breakdown of supported Hadoop version by HBase release."},"17077":{"id":"/docs/single-page-7277","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-against-various-hadoop-versions","content":"The mechanism for selecting a Hadoop version at build time is identical across all releases. Which\nversion of Hadoop is default varies. We manage Hadoop major version selection by way of Maven\nprofiles. Due to the peculiarities of Maven profile mutual exclusion, the profile that builds\nagainst a particular Hadoop version is activated by setting a property, *not* the usual profile\nactivation. Hadoop version profile activation is summarized by the following table."},"17078":{"id":"/docs/single-page-7278","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"Hadoop2 Activation"},"17079":{"id":"/docs/single-page-7279","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"Hadoop3 Activation"},"17080":{"id":"/docs/single-page-7280","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"HBase 1.3+"},"17081":{"id":"/docs/single-page-7281","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"*active by default*"},"17082":{"id":"/docs/single-page-7282","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"`-Dhadoop.profile=3.0`"},"17083":{"id":"/docs/single-page-7283","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"HBase 3.0+"},"17084":{"id":"/docs/single-page-7284","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"*not supported*"},"17085":{"id":"/docs/single-page-7285","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"*active by default*"},"17086":{"id":"/docs/single-page-7286","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"Please note that where a profile is active by default, `hadoop.profile` must NOT be provided."},"17087":{"id":"/docs/single-page-7287","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hadoop-profile-activation-by-hbase-release","content":"Once the Hadoop major version profile is activated, the exact Hadoop version can be\nspecified by overriding the appropriate property value. For Hadoop2 versions, the property name\nis `hadoop-two.version`. With Hadoop3 versions, the property name is `hadoop-three.version`."},"17088":{"id":"/docs/single-page-7288","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-1-building-hbase-17-against-hadoop-2100","content":"For example, to build HBase 1.7 against Hadoop 2.10.0, the profile is set for Hadoop2 by default,\nso only `hadoop-two.version` must be specified:"},"17089":{"id":"/docs/single-page-7289","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-2-building-hbase-23-or-24-against-hadoop-340-snapshot","content":"This is how a developer might check the compatibility of HBase 2.3 or 2.4 against an unreleased\nHadoop version (currently 3.4). Both the Hadoop3 profile and version must be specified:"},"17090":{"id":"/docs/single-page-7290","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-3-building-hbase-30-against-hadoop-340-snapshot","content":"The same developer might want also to check the development version of HBase (currently 3.0)\nagainst the development version of Hadoop (currently 3.4). In this case, the Hadoop3 profile is\nactive by default, so only `hadoop-three.version` must be specified:"},"17091":{"id":"/docs/single-page-7291","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-with-jdk11-and-hadoop3","content":"HBase manages JDK-specific build settings using Maven profiles. The profile appropriate to the JDK\nin use is automatically activated. Building and running on JDK8 supports both Hadoop2 and Hadoop3.\nFor JDK11, only Hadoop3 is supported. Thus, the Hadoop3 profile must be active when building on\nJDK11, and the artifacts used when running HBase on JDK11 must be compiled against Hadoop3.\nFurthermore, the JDK11 profile requires a minimum Hadoop version of 3.2.0. This value is specified\nby the JDK11 profile, but it can be overridden using the `hadoop-three.version` property as normal.\nFor details on Hadoop profile activation by HBase branch, see\nBuilding against various Hadoop versions. See Java for a complete\nsupport matrix of Java version by HBase version."},"17092":{"id":"/docs/single-page-7292","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-1-building-hbase-23-or-24-with-jdk11","content":"To build HBase 2.3 or 2.4 with JDK11, the Hadoop3 profile must be activated explicitly."},"17093":{"id":"/docs/single-page-7293","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-2-building-hbase-30-with-jdk11","content":"For HBase 3.0, the Hadoop3 profile is active by default, no additional properties need be\nspecified."},"17094":{"id":"/docs/single-page-7294","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-testing-in-an-ide-with-jdk11-and-hadoop3","content":"Continuing the discussion from the earlier section, building and\ntesting with JDK11 and Hadoop3 within an IDE may require additional configuration. Specifically,\nmake sure the JVM version used by the IDE is a JDK11, the active JDK Maven profile is for JDK11,\nand the Maven profile for JDK8 is NOT active. Likewise, ensure the Hadoop3 Maven profile is active\nand the Hadoop2 Maven profile is NOT active."},"17095":{"id":"/docs/single-page-7295","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-protobuf","content":"You may need to change the protobuf definitions that reside in the *hbase-protocol* module or other modules."},"17096":{"id":"/docs/single-page-7296","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-protobuf","content":"Previous to hbase-2.0.0, protobuf definition files were sprinkled across all hbase modules but now all\nto do with protobuf must reside in the hbase-protocol module; we are trying to contain our protobuf\nuse so we can freely change versions without upsetting any downstream project use of protobuf."},"17097":{"id":"/docs/single-page-7297","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-protobuf","content":"The protobuf files are located in *hbase-protocol/src/main/protobuf*.\nFor the change to be effective, you will need to regenerate the classes."},"17098":{"id":"/docs/single-page-7298","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-protobuf","content":"Similarly, protobuf definitions for internal use are located in the *hbase-protocol-shaded* module."},"17099":{"id":"/docs/single-page-7299","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-protobuf","content":"Typically, protobuf code generation is done using the native `protoc` binary. In our build we use a maven plugin for\nconvenience; however, the plugin may not be able to retrieve appropriate binaries for all platforms. If you find yourself\non a platform where protoc fails, you will have to compile protoc from source, and run it independent of our maven build.\nYou can disable the inline code generation by specifying `-Dprotoc.skip` in your maven arguments, allowing your build to proceed further."},"17100":{"id":"/docs/single-page-7300","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-protobuf","content":"If you need to manually generate your protobuf files, you should not use `clean` in subsequent\nmaven calls, as that will delete the newly generated files."},"17101":{"id":"/docs/single-page-7301","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-protobuf","content":"Read the *hbase-protocol/README.txt* for more details"},"17102":{"id":"/docs/single-page-7302","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-thrift","content":"You may need to change the thrift definitions that reside in the *hbase-thrift* module or other modules."},"17103":{"id":"/docs/single-page-7303","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-thrift","content":"The thrift files are located in *hbase-thrift/src/main/resources*.\nFor the change to be effective, you will need to regenerate the classes.\nYou can use maven profile `compile-thrift` to do this."},"17104":{"id":"/docs/single-page-7304","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-thrift","content":"You may also want to define `thrift.path` for the thrift binary, using the following command:"},"17105":{"id":"/docs/single-page-7305","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-a-tarball","content":"You can build a tarball without going through the release process described in Releasing Apache HBase, by running the following command:"},"17106":{"id":"/docs/single-page-7306","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-a-tarball","content":"The distribution tarball is built in `hbase-assembly/target/hbase-<version>-bin.tar.gz`."},"17107":{"id":"/docs/single-page-7307","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-a-tarball","content":"You can install or deploy the tarball by having the assembly:single goal before install or deploy in the maven command:"},"17108":{"id":"/docs/single-page-7308","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#maven-site-failure","content":"If you see `Unable to find resource 'VM_global_library.vm'`, ignore it.\nIt's not an error.\nIt is officially ugly though."},"17109":{"id":"/docs/single-page-7309","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-on-linux-aarch64","content":"HBase runs on both Windows and UNIX-like systems, and it should run on any platform\nthat runs a supported version of Java. This should include JVMs on x86\\_64 and aarch64.\nThe documentation below describes how to build hbase on aarch64 platform."},"17110":{"id":"/docs/single-page-7310","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#set-environment-variables","content":"Manually install Java and Maven on aarch64 servers if they are not installed,\nand set environment variables. For example:"},"17111":{"id":"/docs/single-page-7311","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#use-protobuf-supported-on-aarch64","content":"Now HBase uses protobuf of two versions. Version '3.11.4' of protobuf that hbase uses\ninternally and version '2.5.0' as external usage.\nPackage protoc-2.5.0 does not work on aarch64 platform, we should add maven\nprofile '-Paarch64' when building. It downloads protoc-2.5.0 package from maven\nrepository which we made on aarch64 platform locally."},"17112":{"id":"/docs/single-page-7312","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#use-protobuf-supported-on-aarch64","content":"Protobuf is released with aarch64 protoc since version '3.5.0', and we are planning to upgrade\nprotobuf later, then we don't have to add the profile '-Paarch64' anymore."},"17113":{"id":"/docs/single-page-7313","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#releasing","content":"See old refguides for how to build HBase 1.x. The below is for building hbase2."},"17114":{"id":"/docs/single-page-7314","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Only committers can make releases of hbase artifacts."},"17115":{"id":"/docs/single-page-7315","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"**Before You Begin**"},"17116":{"id":"/docs/single-page-7316","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Check to be sure recent builds have been passing for the branch from where you\nare going to take your release. You should also have tried recent branch tips\nout on a cluster under load, perhaps by running the `hbase-it` integration test\nsuite for a few hours to 'burn in' the near-candidate bits."},"17117":{"id":"/docs/single-page-7317","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"You will need a published signing key added to the hbase\nKEYS file.\n(For how to add a KEY, see &#x2A;Step 1.* in How To Release,\nthe Hadoop version of this document)."},"17118":{"id":"/docs/single-page-7318","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Next make sure JIRA is properly primed, that all issues targeted against\nthe prospective release have been resolved and are present in git on the\nparticular branch. If any outstanding issues, move them out of the release by\nadjusting the fix version to remove this pending release as a target.\nAny JIRA with a fix version that matches the release candidate\ntarget release will be included in the generated *CHANGES.md/RELEASENOTES.md*\nfiles that ship with the release so make sure JIRA is correct before you begin."},"17119":{"id":"/docs/single-page-7319","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"After doing the above, you can move to the manufacture of an RC."},"17120":{"id":"/docs/single-page-7320","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Building an RC is involved so we've scripted it. The script builds in a Docker\ncontainer to ensure we have a consistent environment building. It will ask you\nfor passwords for apache and for your gpg signing key so it can sign and commit\non your behalf. The passwords are passed to gpg-agent in the container and\npurged along with the container when the build is done."},"17121":{"id":"/docs/single-page-7321","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"The script will:"},"17122":{"id":"/docs/single-page-7322","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Set version to the release version"},"17123":{"id":"/docs/single-page-7323","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Updates RELEASENOTES.md and CHANGES.md"},"17124":{"id":"/docs/single-page-7324","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Tag the RC"},"17125":{"id":"/docs/single-page-7325","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Set version to next SNAPSHOT version."},"17126":{"id":"/docs/single-page-7326","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Builds, signs, and hashes all artifacts."},"17127":{"id":"/docs/single-page-7327","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Generates the api compatibility report"},"17128":{"id":"/docs/single-page-7328","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Pushes release tgzs to the dev dir in a apache dist."},"17129":{"id":"/docs/single-page-7329","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Pushes to repository.apache.org staging."},"17130":{"id":"/docs/single-page-7330","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"Creates vote email template."},"17131":{"id":"/docs/single-page-7331","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"The *dev-support/create-release/do-release-docker.sh* Release Candidate (RC)\nGenerating script is maintained in the master branch but can generate RCs\nfor any 2.x+ branch (The script does not work against branch-1). Check out\nand update the master branch when making RCs. See\n*dev-support/create-release/README.txt* for how to configure your\nenvironment and run the script."},"17132":{"id":"/docs/single-page-7332","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#making-a-release-candidate","content":"*dev-support/create-release/do-release-docker.sh* supercedes the previous *dev-support/make\\_rc.sh*\nscript. It is more comprehensive automating all steps, rather than a portion, building a RC."},"17133":{"id":"/docs/single-page-7333","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#release-candidate-procedure","content":"Here we outline the steps involved generating a Release Candidate, the steps\nautomated by the *dev-support/create-release/do-release-docker.sh* script\ndescribed in the previous section. Running these steps manually tends to\nbe error-prone so is not recommended. The below is informational only."},"17134":{"id":"/docs/single-page-7334","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#release-candidate-procedure","content":"The process below makes use of various tools, mainly *git* and *maven*."},"17135":{"id":"/docs/single-page-7335","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#release-candidate-procedure","content":"You may run into OutOfMemoryErrors building, particularly building the site and\ndocumentation. Up the heap for Maven by setting the `MAVEN_OPTS` variable.\nYou can prefix the variable to the Maven command, as in the following example:"},"17136":{"id":"/docs/single-page-7336","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#release-candidate-procedure","content":"You could also set this in an environment variable or alias in your shell."},"17137":{"id":"/docs/single-page-7337","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-m2settingsxml-file","content":"Publishing to maven requires you sign the artifacts you want to upload.\nFor the build to sign them for you, you a properly configured *settings.xml&#x2A;\nin your local repository under *.m2*, such as the following."},"17138":{"id":"/docs/single-page-7338","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#update-the-changesmd-and-releasenotesmd-files-and-the-pom-files","content":"Update *CHANGES.md* with the changes since the last release. Be careful with where you put\nheadings and license. Respect the instructions and warning you find in current\n*CHANGES.md* and *RELEASENOTES.md* since these two files are processed by tooling that is\nlooking for particular string sequences. See HBASE-21399\nfor description on how to make use of yetus generating additions to\n*CHANGES.md* and *RELEASENOTES.md* (RECOMMENDED!). Adding JIRA fixes, make sure the\nURL to the JIRA points to the proper location which lists fixes for this release."},"17139":{"id":"/docs/single-page-7339","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#update-the-changesmd-and-releasenotesmd-files-and-the-pom-files","content":"Next, adjust the version in all the POM files appropriately.\nIf you are making a release candidate, you must remove the `-SNAPSHOT` label from all versions\nin all pom.xml files.\nIf you are running this receipe to publish a snapshot, you must keep the `-SNAPSHOT` suffix on the hbase version.\nThe Versions Maven Plugin can be of use here.\nTo set a version in all the many poms of the hbase multi-module project, use a command like the following:"},"17140":{"id":"/docs/single-page-7340","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#update-the-changesmd-and-releasenotesmd-files-and-the-pom-files","content":"Make sure all versions in poms are changed! Checkin the *CHANGES.md*, *RELEASENOTES.md*, and\nany maven version changes."},"17141":{"id":"/docs/single-page-7341","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#update-the-documentation","content":"Update the documentation under &#x2A;hbase-website/app/page/\\_docs/docs/\\_mdx/(multi-page)*.\nThis usually involves copying the latest from master branch and making version-particular\nadjustments to suit this release candidate version. Commit your changes."},"17142":{"id":"/docs/single-page-7342","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#run-apache-rat","content":"Check licenses are good"},"17143":{"id":"/docs/single-page-7343","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#run-apache-rat","content":"If the above fails, check the rat log."},"17144":{"id":"/docs/single-page-7344","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#create-a-release-tag","content":"Presuming you have run basic tests, the rat check, passes and all is\nlooking good, now is the time to tag the release candidate (You\nalways remove the tag if you need to redo). To tag, do\nwhat follows substituting in the version appropriate to your build.\nAll tags should be signed tags; i.e. pass the *-s* option (See\nSigning Your Work\nfor how to set up your git environment for signing)."},"17145":{"id":"/docs/single-page-7345","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#create-a-release-tag","content":"Or, if you are making a release, tags should have a &#x2A;rel/* prefix to ensure\nthey are preserved in the Apache repo as in:"},"17146":{"id":"/docs/single-page-7346","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#create-a-release-tag","content":"Push the (specific) tag (only) so others have access."},"17147":{"id":"/docs/single-page-7347","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#create-a-release-tag","content":"For how to delete tags, see\nHow to Delete a Tag. Covers\ndeleting tags that have not yet been pushed to the remote Apache\nrepo as well as delete of tags pushed to Apache."},"17148":{"id":"/docs/single-page-7348","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-the-source-tarball","content":"Now, build the source tarball. Lets presume we are building the source\ntarball for the tag *2.0.0-alpha4-RC0&#x2A; into &#x2A;/tmp/hbase-2.0.0-alpha4-RC0/*\n(This step requires that the mvn and git clean steps described above have just been done)."},"17149":{"id":"/docs/single-page-7349","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-the-source-tarball","content":"Above we generate the hbase-2.0.0-alpha4-src.tar.gz tarball into the\n*/tmp/hbase-2.0.0-alpha4-RC0* build output directory (We don't want the *RC0* in the name or prefix.\nThese bits are currently a release candidate but if the VOTE passes, they will become the release so we do not taint\nthe artifact names with *RCX*)."},"17150":{"id":"/docs/single-page-7350","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-the-binary-tarball","content":"Next, build the binary tarball. Add the `-Prelease` profile when building.\nIt runs the license apache-rat check among other rules that help ensure\nall is wholesome. Do it in two steps."},"17151":{"id":"/docs/single-page-7351","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-the-binary-tarball","content":"First install into the local repository"},"17152":{"id":"/docs/single-page-7352","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-the-binary-tarball","content":"Next, generate documentation and assemble the tarball. Be warned,\nthis next step can take a good while, a couple of hours generating site\ndocumentation."},"17153":{"id":"/docs/single-page-7353","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-the-binary-tarball","content":"Otherwise, the build complains that hbase modules are not in the maven repository\nwhen you try to do it all in one step, especially on a fresh repository.\nIt seems that you need the install goal in both steps."},"17154":{"id":"/docs/single-page-7354","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#build-the-binary-tarball","content":"Extract the generated tarball — you'll find it under\n*hbase-assembly/target* and check it out.\nLook at the documentation, see if it runs, etc.\nIf good, copy the tarball beside the source tarball in the\nbuild output directory."},"17155":{"id":"/docs/single-page-7355","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#deploy-to-the-maven-repository","content":"Next, deploy HBase to the Apache Maven repository. Add the\napache-release`profile when running the`mvn deploy\\` command.\nThis profile comes from the Apache parent pom referenced by our pom files.\nIt does signing of your artifacts published to Maven, as long as the\n*settings.xml* is configured correctly, as described in Example \\~/.m2/settings.xml File.\nThis step depends on the local repository having been populate\nby the just-previous bin tarball build."},"17156":{"id":"/docs/single-page-7356","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#deploy-to-the-maven-repository","content":"This command copies all artifacts up to a temporary staging Apache mvn repository in an 'open' state.\nMore work needs to be done on these maven artifacts to make them generally available."},"17157":{"id":"/docs/single-page-7357","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#deploy-to-the-maven-repository","content":"We do not release HBase tarball to the Apache Maven repository. To avoid deploying the tarball, do not\ninclude the `assembly:single` goal in your `mvn deploy` command. Check the deployed artifacts as described in the next section."},"17158":{"id":"/docs/single-page-7358","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#deploy-to-the-maven-repository","content":"If you ran the old *dev-support/make\\_rc.sh* script, this is as far as it takes you. To finish the\nrelease, take up the script from here on out."},"17159":{"id":"/docs/single-page-7359","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"The artifacts are in the maven repository in the staging area in the 'open' state.\nWhile in this 'open' state you can check out what you've published to make sure all is good.\nTo do this, log in to Apache's Nexus at repository.apache.org using your Apache ID.\nFind your artifacts in the staging repository. Click on 'Staging Repositories' and look for a new one ending in \"hbase\" with a status of 'Open', select it.\nUse the tree view to expand the list of repository contents and inspect if the artifacts you expect are present. Check the POMs.\nAs long as the staging repo is open you can re-upload if something is missing or built incorrectly."},"17160":{"id":"/docs/single-page-7360","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"If something is seriously wrong and you would like to back out the upload, you can use the 'Drop' button to drop and delete the staging repository.\nSometimes the upload fails in the middle. This is another reason you might have to 'Drop' the upload from the staging repository."},"17161":{"id":"/docs/single-page-7361","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"If it checks out, close the repo using the 'Close' button. The repository must be closed before a public URL to it becomes available. It may take a few minutes for the repository to close. Once complete you'll see a public URL to the repository in the Nexus UI. You may also receive an email with the URL. Provide the URL to the temporary staging repository in the email that announces the release candidate.\n(Folks will need to add this repo URL to their local poms or to their local *settings.xml* file to pull the published release candidate artifacts.)"},"17162":{"id":"/docs/single-page-7362","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"When the release vote concludes successfully, return here and click the 'Release' button to release the artifacts to central. The release process will automatically drop and delete the staging repository."},"17163":{"id":"/docs/single-page-7363","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"See the hbase-downstreamer test for a simple\nexample of a project that is downstream of HBase an depends on it. Check it out and run its simple\ntest to make sure maven artifacts are properly deployed to the maven repository. Be sure to edit\nthe pom to point to the proper staging repository. Make sure you are pulling from the repository\nwhen tests run and that you are not getting from your local repository, by either passing the `-U`\nflag or deleting your local repo content and check maven is pulling from remote out of the staging\nrepository."},"17164":{"id":"/docs/single-page-7364","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"See Publishing Maven Artifacts for some pointers on this maven staging process."},"17165":{"id":"/docs/single-page-7365","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"If the HBase version ends in `-SNAPSHOT`, the artifacts go elsewhere.\nThey are put into the Apache snapshots repository directly and are immediately available.\nMaking a SNAPSHOT release, this is what you want to happen."},"17166":{"id":"/docs/single-page-7366","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"At this stage, you have two tarballs in your 'build output directory' and a set of artifacts\nin a staging area of the maven repository, in the 'closed' state.\nNext sign, fingerprint and then 'stage' your release candiate build output directory via svnpubsub by committing\nyour directory to The dev distribution directory\n(See comments on HBASE-10554 Please delete old releases from mirroring system\nbut in essence it is an svn checkout of dev/hbase — releases are at\nrelease/hbase). In the *version directory* run the following commands:"},"17167":{"id":"/docs/single-page-7367","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"Ensure it actually gets published by checking https\\://dist.apache.org/repos/dist/dev/hbase/."},"17168":{"id":"/docs/single-page-7368","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#make-the-release-candidate-available","content":"Announce the release candidate on the mailing list and call a vote."},"17169":{"id":"/docs/single-page-7369","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#publishing-a-snapshot-to-maven","content":"Make sure your *settings.xml* is set up properly (see Example \\~/.m2/settings.xml File).\nMake sure the hbase version includes `-SNAPSHOT` as a suffix.\nFollowing is an example of publishing SNAPSHOTS of a release that had an hbase version of 0.96.0 in its poms."},"17170":{"id":"/docs/single-page-7370","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#publishing-a-snapshot-to-maven","content":"The *make\\_rc.sh* script mentioned above (see Making a Release Candidate) can help you publish `SNAPSHOTS`.\nMake sure your `hbase.version` has a `-SNAPSHOT` suffix before running the script.\nIt will put a snapshot up into the apache snapshot repository for you."},"17171":{"id":"/docs/single-page-7371","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#voting","content":"Everyone is encouraged to try and vote on HBase release candidates.\nOnly the votes of PMC members are binding.\nPMC members, please read this WIP doc on policy voting for a release candidate, Release Policy."},"17172":{"id":"/docs/single-page-7372","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#voting","content":"> Before casting +1 binding votes, individuals are required to\n> download the signed source code package onto their own hardware, compile it as\n> provided, and test the resulting executable on their own platform, along with also\n> validating cryptographic signatures and verifying that the package meets the\n> requirements of the ASF policy on releases."},"17173":{"id":"/docs/single-page-7373","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#voting","content":"Regards the latter, run `mvn apache-rat:check` to verify all files are suitably licensed.\nSee HBase, mail # dev - On recent discussion clarifying ASF release policy\nfor how we arrived at this process."},"17174":{"id":"/docs/single-page-7374","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#voting","content":"To help with the release verification, please follow the guideline below and vote based on the your verification."},"17175":{"id":"/docs/single-page-7375","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"Although contributors have their own checklist for verifications, the following items are usually used for voting on release candidates."},"17176":{"id":"/docs/single-page-7376","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"CHANGES.md if any"},"17177":{"id":"/docs/single-page-7377","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"RELEASENOTES.md (release notes) if any"},"17178":{"id":"/docs/single-page-7378","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"Generated API compatibility report"},"17179":{"id":"/docs/single-page-7379","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"For what should be compatible please refer the versioning guideline, especially for items with marked as high severity"},"17180":{"id":"/docs/single-page-7380","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"Use `hbase-vote.sh` to perform sanity checks for checksum, signatures, files are licensed, built from source, and unit tests."},"17181":{"id":"/docs/single-page-7381","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"`hbase-vote.sh` shell script is available under `dev-support` directory of HBase source. Following are the usage details."},"17182":{"id":"/docs/single-page-7382","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baseline-verifications-for-voting-release-candidates","content":"If you see any unit test failures, please call out the solo test result and whether it's part of flaky (nightly) tests dashboard, e.g. dashboard of master branch (please change the test branch accordingly)."},"17183":{"id":"/docs/single-page-7383","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#additional-verifications-for-voting-release-candidates","content":"Other than the common verifications, contributors may call out additional concerns, e.g. for a specific feature by running end to end tests on a distributed environment. This is optional and always encouraged."},"17184":{"id":"/docs/single-page-7384","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#additional-verifications-for-voting-release-candidates","content":"Start a distributed HBase cluster and call out the test result of specific workload on cluster. e.g."},"17185":{"id":"/docs/single-page-7385","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#additional-verifications-for-voting-release-candidates","content":"Run basic table operations, e.g. `create/put/get/scan/flush/list/disable/drop`"},"17186":{"id":"/docs/single-page-7386","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#additional-verifications-for-voting-release-candidates","content":"Run built-in tests, e.g. `LoadTestTool` (LTT) and `IntegrationTestBigLinkedList` (ITBLL)"},"17187":{"id":"/docs/single-page-7387","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#announcing","content":"Once an RC has passed successfully and the needed artifacts have been staged for disribution, you'll need to let everyone know about our shiny new release. It's not a requirement, but to make things easier for release managers we have a template you can start with. Be sure you replace \\_version\\_ and other markers with the relevant version numbers. You should manually verify all links before sending."},"17188":{"id":"/docs/single-page-7388","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#announcing","content":"You should sent this message to the following lists: dev\\@hbase.apache.org, user\\@hbase.apache.org, announce\\@apache.org. If you'd like a spot check before sending, feel free to ask via jira or the dev list."},"17189":{"id":"/docs/single-page-7389","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#generating-documentation","content":"The manual is marked up using MDX (just extended markdown).\nThen we render markdown into HTML content by using Fumadocs.\nTo build run `mvn site` from the root or `hbase-website` directory.\nSee appendix contributing to documentation for more information on building the documentation."},"17190":{"id":"/docs/single-page-7390","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#contributing-to-hbaseapacheorg","content":"See appendix contributing to documentation for more information on contributing to the documentation or website."},"17191":{"id":"/docs/single-page-7391","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#publishing-hbaseapacheorg","content":"See Publishing the HBase Website and Documentation for instructions on publishing the website and documentation."},"17192":{"id":"/docs/single-page-7392","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tests","content":"Developers, at a minimum, should familiarize themselves with the unit test detail; unit tests in HBase have a character not usually seen in other projects."},"17193":{"id":"/docs/single-page-7393","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tests","content":"This information is about unit tests for HBase itself.\nFor developing unit tests for your HBase applications, see Unit Testing HBase Applications."},"17194":{"id":"/docs/single-page-7394","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#apache-hbase-modules","content":"As of 0.96, Apache HBase is split into multiple modules.\nThis creates \"interesting\" rules for how and where tests are written.\nIf you are writing code for `hbase-server`, see Unit Tests for how to write your tests.\nThese tests can spin up a minicluster and will need to be categorized.\nFor any other module, for example `hbase-common`, the tests must be strict unit tests and just test the class under test - no use of the HBaseTestingUtility or minicluster is allowed (or even possible given the dependency tree)."},"17195":{"id":"/docs/single-page-7395","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#apache-hbase-modules","content":"Starting from 3.0.0, HBaseTestingUtility is renamed to HBaseTestingUtil and marked as IA.Private. Of course the API is still the same."},"17196":{"id":"/docs/single-page-7396","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#testing-the-hbase-shell","content":"The HBase shell and its tests are predominantly written in jruby."},"17197":{"id":"/docs/single-page-7397","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#testing-the-hbase-shell","content":"In order to make these tests run as a part of the standard build, there are a few JUnit test classes that take care of loading the jruby implemented tests and running them.\nThe tests were split into separate classes to accomodate class level timeouts (see Unit Tests for specifics).\nYou can run all of these tests from the top level with:"},"17198":{"id":"/docs/single-page-7398","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#testing-the-hbase-shell","content":"If you have previously done a `mvn install`, then you can instruct maven to run only the tests in the hbase-shell module with:"},"17199":{"id":"/docs/single-page-7399","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#testing-the-hbase-shell","content":"Alternatively, you may limit the shell tests that run using the system variable `shell.test`.\nThis value should specify the ruby literal equivalent of a particular test case by name.\nFor example, the tests that cover the shell commands for altering tables are contained in the test case `AdminAlterTableTest` and you can run them with:"},"17200":{"id":"/docs/single-page-7400","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#testing-the-hbase-shell","content":"You may also use a Ruby Regular Expression\nliteral (in the `/pattern/` style) to select a set of test cases.\nYou can run all of the HBase admin related tests, including both the normal administration and the security administration, with the command:"},"17201":{"id":"/docs/single-page-7401","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#testing-the-hbase-shell","content":"In the event of a test failure, you can see details by examining the XML version of the surefire report results"},"17202":{"id":"/docs/single-page-7402","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-in-other-modules","content":"If the module you are developing in has no other dependencies on other HBase modules, then you can cd into that module and just run:"},"17203":{"id":"/docs/single-page-7403","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-in-other-modules","content":"which will just run the tests IN THAT MODULE.\nIf there are other dependencies on other modules, then you will have run the command from the ROOT HBASE DIRECTORY.\nThis will run the tests in the other modules, unless you specify to skip the tests in that module.\nFor instance, to skip the tests in the hbase-server module, you would run:"},"17204":{"id":"/docs/single-page-7404","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-in-other-modules","content":"from the top level directory to run all the tests in modules other than hbase-server.\nNote that you can specify to skip tests in multiple modules as well as just for a single module.\nFor example, to skip the tests in `hbase-server` and `hbase-common`, you would run:"},"17205":{"id":"/docs/single-page-7405","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-in-other-modules","content":"Also, keep in mind that if you are running tests in the `hbase-server` module you will need to apply the maven profiles discussed in Running tests to get the tests to run properly."},"17206":{"id":"/docs/single-page-7406","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"Apache HBase runs its unit tests with JUnit 5. Every unit\ntest must carry a sizing tag, applied with the JUnit 5 `@Tag` annotation. Here is an\nexample of what a Test Class looks like:"},"17207":{"id":"/docs/single-page-7407","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"Here the Test Class is `TestHRegionInfo`, tagged as a `SmallTests` (plus the functional\ntag `RegionServerTests`). Prior to the JUnit 5 migration, tests were categorized with\n`@Category(...)` and, as of `hbase-2.0.0`, had to declare an `HBaseClassTestRule`\n`@ClassRule` — both are gone now. The cross-cutting facilities the old `ClassRule`\nprovided are now applied automatically by the `HBaseJupiterExtension`:"},"17208":{"id":"/docs/single-page-7408","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"it enforces a per-class timeout derived from the sizing tag (three minutes for `small`,\nsix for `medium`, and a hard limit of thirteen! minutes — 780 seconds — for `large`;\n`integration` tests have no timeout);"},"17209":{"id":"/docs/single-page-7409","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"it dumps a thread stack to the log output when a test class times out;"},"17210":{"id":"/docs/single-page-7410","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"it runs the resource-leak checker (see the Test Resource Checker section below);"},"17211":{"id":"/docs/single-page-7411","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"and, for every test class selected for execution, it verifies that the class has exactly\none sizing tag."},"17212":{"id":"/docs/single-page-7412","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"`HBaseJupiterExtension` is auto-registered for the Surefire unit-test runs in every module\nthrough the JUnit 5 `ServiceLoader` mechanism\n(`junit.jupiter.extensions.autodetection.enabled=true` in the Surefire configuration plus a\n`META-INF/services/org.junit.jupiter.api.extension.Extension` entry), so individual test\nclasses no longer need any `@ClassRule` boilerplate. Integration tests (run under Failsafe\nor the `IntegrationTestsDriver`) do not currently enable this auto-registration."},"17213":{"id":"/docs/single-page-7413","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"Tags can be arbitrary and provided as a list, but each test MUST carry one from the\nfollowing list of sizings: `small`, `medium`, `large`, and `integration`. The test sizing\nis designated with a JUnit 5\ntag\nreferencing one of `SmallTests`, `MediumTests`, `LargeTests`, or `IntegrationTests` — use\nthe `TAG` constant on each of those interfaces in the\n`org.apache.hadoop.hbase.testclassification` package (a special extension checks for the\npresence of exactly one sizing `@Tag` in every test class selected for execution; it does\nnot inspect classes excluded by tag filters)."},"17214":{"id":"/docs/single-page-7414","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"The first three categories, `small`, `medium`, and `large`, are for test cases which run when you\ntype `$ mvn test`.\nIn other words, these three categorizations are for HBase unit tests.\nThe `integration` category is not for unit tests, but for integration tests.\nThese are normally run when you invoke `$ mvn verify`.\nIntegration tests are described in Integration Tests."},"17215":{"id":"/docs/single-page-7415","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests","content":"Keep reading to figure which annotation of the set `small`, `medium`, and `large`\nto put on your new HBase test case."},"17216":{"id":"/docs/single-page-7416","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#small-tests","content":"*Small* test cases are executed in separate JVM and each test suite/test class should\nrun in 15 seconds or less; i.e. a junit test fixture, a java object made\nup of test methods, should finish in under 15 seconds, no matter how many or how few test methods\nit has. These test cases should not use a minicluster as a minicluster starts many services,\nmost unrelated to what is being tested."},"17217":{"id":"/docs/single-page-7417","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#medium-tests","content":"*Medium* test cases are executed in separate JVM and individual test suites or test classes or in\njunit parlance, test fixture, should run in 50 seconds\nor less. These test cases can use a mini cluster. Since we start up a JVM per test fixture (and\noften a cluster too), be sure to make the startup pay by writing test fixtures that do a lot of\ntesting running tens of seconds perhaps combining test rather than spin up a jvm (and cluster)\nper test method; this practice will help w/ overall test times."},"17218":{"id":"/docs/single-page-7418","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#large-tests","content":"*Large* test cases are everything else. They are typically large-scale tests, regression tests\nfor specific bugs, timeout tests, or performance tests. No large test suite can take longer than\nthirteen minutes. It will be killed as timed out. Cast your test as an Integration Test if it needs\nto run longer."},"17219":{"id":"/docs/single-page-7419","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-unit-tests-categorizing-tests-integration-tests","content":"*Integration* tests are system level tests.\nSee Integration Tests for more info.\nIf you invoke `$ mvn test` on integration tests, there is no timeout for the test."},"17220":{"id":"/docs/single-page-7420","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests","content":"The state of tests on the hbase branches varies. Some branches keep good test hygiene and all tests pass\nreliably with perhaps an unlucky sporadic flakey test failure. On other branches, the case may be less so with\nfrequent flakies and even broken tests in need of attention that fail 100% of the time. Try and figure\nthe state of tests on the branch you are currently interested in; the current state of nightly\napache jenkins builds is a good\nplace to start. Tests on master branch are generally not in the best of condition as releases\nare less frequent off master. This can make it hard landing patches especially given our dictum that\npatches land on master branch first."},"17221":{"id":"/docs/single-page-7421","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests","content":"The full test suite can take from 5-6 hours on an anemic VM with 4 CPUs and minimal\nparallelism to 50 minutes or less on a linux machine with dozens of CPUs and plenty of\nRAM."},"17222":{"id":"/docs/single-page-7422","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests","content":"When you go to run the full test suite, make sure you up the test runner user nproc\n(`ulimit -u` — make sure it > 6000 or more if more parallelism) and the number of\nopen files (`ulimit -n` — make sure it > 10240 or more) limits on your system.\nErrors because the test run hits\nlimits are often only opaquely related to the constraint. You can see the current\nuser settings by running `ulimit -a`."},"17223":{"id":"/docs/single-page-7423","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#default-small-and-medium-category-tests","content":"Running `mvn test` will execute all small tests in a single JVM (no fork) and then medium tests in a\nforked, separate JVM for each test instance (For definition of 'small' test and so on, see\nUnit Tests). Medium tests are NOT executed if there is an error in a\nsmall test. Large tests are NOT executed."},"17224":{"id":"/docs/single-page-7424","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-all-tests","content":"Running `mvn test -P runAllTests` will execute small tests in a single JVM, then medium and large tests\nin a forked, separate JVM for each test. Medium and large tests are NOT executed if there is an error in\na small test."},"17225":{"id":"/docs/single-page-7425","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-a-single-test-or-all-tests-in-a-package","content":"To run an individual test, e.g. `MyTest`, rum `mvn test -Dtest=MyTest` You can also pass multiple,\nindividual tests as a comma-delimited list:"},"17226":{"id":"/docs/single-page-7426","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-a-single-test-or-all-tests-in-a-package","content":"You can also pass a package, which will run all tests under the package:"},"17227":{"id":"/docs/single-page-7427","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-a-single-test-or-all-tests-in-a-package","content":"When `-Dtest` is specified, the `localTests` profile will be used.\nEach junit test is executed in a separate JVM (A fork per test class).\nThere is no parallelization when tests are running in this mode.\nYou will see a new message at the end of the -report: `\"[INFO] Tests are skipped\"`.\nIt's harmless. However, you need to make sure the sum of\n`Tests run:` in the `Results:` section of test reports matching the number of tests\nyou specified because no error will be reported when a non-existent test case is specified."},"17228":{"id":"/docs/single-page-7428","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#other-test-invocation-permutations","content":"Running `mvn test -P runSmallTests` will execute \"small\" tests only, using a single JVM."},"17229":{"id":"/docs/single-page-7429","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#other-test-invocation-permutations","content":"Running `mvn test -P runMediumTests` will execute \"medium\" tests only, launching a new JVM for each test-class."},"17230":{"id":"/docs/single-page-7430","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#other-test-invocation-permutations","content":"Running `mvn test -P runLargeTests` will execute \"large\" tests only, launching a new JVM for each test-class."},"17231":{"id":"/docs/single-page-7431","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#other-test-invocation-permutations","content":"For convenience, you can run `mvn test -P runDevTests` to execute both small and medium tests, using a single JVM."},"17232":{"id":"/docs/single-page-7432","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-faster","content":"By default, `$ mvn test -P runAllTests` runs all tests using a quarter of the CPUs available on machine\nhosting the test run (see `surefire.firstPartForkCount` and `surefire.secondPartForkCount` in the top-level\nhbase `pom.xml` which default to 0.25C, or 1/4 of CPU count). Up these counts to get the build to run faster.\nYou can also have hbase modules\nrun their tests in parrallel when the dependency graph allows by passing `--threads=N` when you invoke\nmaven, where `N` is the amount of parallelism wanted.\nmaven, where `N` is the amount of *module* parallelism wanted."},"17233":{"id":"/docs/single-page-7433","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-faster","content":"For example, allowing that you want to use all cores on a machine to run tests,\nyou could start up the maven test run with:"},"17234":{"id":"/docs/single-page-7434","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-faster","content":"If a 32 core machine, you should see periods during which 32 forked jvms appear in your process listing each running unit tests.\nYour milage may vary. Dependent on hardware, overcommittment of CPU and/or memory can bring the test suite crashing down,\nusually complaining with a spew of test system exits and incomplete test report xml files. Start gently, with the default fork\nand move up gradually."},"17235":{"id":"/docs/single-page-7435","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-faster","content":"Adding the `--threads=N`, maven will run N maven modules in parallel (when module inter-dependencies allow). Be aware, if you have\nset the forkcount to `1.0C`, and the `--threads` count to '2', the number of concurrent test runners can approach\n2 \\* CPU, a count likely to overcommit the host machine (with attendant test exits failures)."},"17236":{"id":"/docs/single-page-7436","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-tests-faster","content":"You will need \\~2.2GB of memory per forked JVM plus the memory used by maven itself (3-4G)."},"17237":{"id":"/docs/single-page-7437","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ram-disk","content":"To increase the speed, you can as well use a ramdisk. 2-3G should be sufficient. Be sure to\ndelete the files between each test run. The typical way to configure a ramdisk on Linux is:"},"17238":{"id":"/docs/single-page-7438","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ram-disk","content":"You can then use it to run all HBase tests on 2.0 with the command:"},"17239":{"id":"/docs/single-page-7439","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbasetestssh","content":"It's also possible to use the script `hbasetests.sh`.\nThis script runs the medium and large tests in parallel with two maven instances, and provides a single report.\nThis script does not use the hbase version of surefire so no parallelization is being done other than the two maven instances the script sets up.\nIt must be executed from the directory which contains the *pom.xml*."},"17240":{"id":"/docs/single-page-7440","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbasetestssh","content":"For example running `./dev-support/hbasetests.sh` will execute small and medium tests.\nRunning `./dev-support/hbasetests.sh runAllTests` will execute all tests.\nRunning `./dev-support/hbasetests.sh replayFailed` will rerun the failed tests a second time, in a separate jvm and without parallelisation."},"17241":{"id":"/docs/single-page-7441","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#test-timeouts","content":"`HBaseJupiterExtension` enforces a per-class timeout based on the sizing tag: three minutes\nfor `small`, six minutes for `medium`, and thirteen minutes for `large` tests\n(`integration` tests have no timeout). When a test class exceeds its deadline it is failed\nand a thread dump is logged. Independently, Surefire kills any forked JVM that runs longer\nthan `surefire.timeout` (900 seconds by default)."},"17242":{"id":"/docs/single-page-7442","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#test-timeouts","content":"As of hbase-2.0.0, we have purged the old JUnit 4 per-test-method timeouts, i.e."},"17243":{"id":"/docs/single-page-7443","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#test-timeouts","content":"Blanket per-method timeouts are discouraged and don't make much sense given we are timing\nbased on how long the whole Test Fixture/Class/Suite takes and\nthat the variance in how long a test method takes varies wildly\ndependent upon context (loaded Apache Infrastructure versus\ndeveloper machine with nothing else running on it). JUnit 5's `@Timeout` may still be\napplied sparingly to an individual method that genuinely needs its own deadline."},"17244":{"id":"/docs/single-page-7444","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#test-resource-checker","content":"The `ResourceChecker`, wired in through `HBaseJupiterExtension`'s `BeforeEachCallback`/`AfterEachCallback`, checks a number of resources before and after each HBase unit test runs and logs its findings in the test output files which can be found in *target/surefire-reports&#x2A; per Maven module (Tests write test reports named for the test class into this directory.\nCheck the *\\*-out.txt* files). The resources counted are the number of threads, the number of file descriptors, etc.\nIf the number has increased, it adds a &#x2A;LEAK?* comment in the logs.\nAs you can have an HBase instance running in the background, some threads can be deleted/created without any specific action in the test.\nHowever, if the test does not work as expected, or if the test should not impact these resources, it's worth checking these log lines `...hbase.ResourceChecker(157): before...` and `...hbase.ResourceChecker(157): after...`.\nFor example:"},"17245":{"id":"/docs/single-page-7445","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-rules","content":"As much as possible, tests should be written as category small tests."},"17246":{"id":"/docs/single-page-7446","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-rules","content":"All tests must be written to support parallel execution on the same machine, hence they should not use shared resources as fixed ports or fixed file names."},"17247":{"id":"/docs/single-page-7447","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-rules","content":"Tests should not overlog.\nMore than 100 lines/second makes the logs complex to read and use i/o that are hence not available for the other tests."},"17248":{"id":"/docs/single-page-7448","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#general-rules","content":"Tests can be written with `HBaseTestingUtility`.\nThis class offers helper functions to create a temp directory and do the cleanup, or to start a cluster."},"17249":{"id":"/docs/single-page-7449","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#categories-and-execution-time","content":"All tests must be categorized, if not they could be skipped."},"17250":{"id":"/docs/single-page-7450","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#categories-and-execution-time","content":"All tests should be written to be as fast as possible."},"17251":{"id":"/docs/single-page-7451","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#categories-and-execution-time","content":"See Unit Tests for test case categories and corresponding timeouts.\nThis should ensure a good parallelization for people using it, and ease the analysis when the test fails."},"17252":{"id":"/docs/single-page-7452","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sleeps-in-tests","content":"Whenever possible, tests should not use `Thread.sleep`, but rather waiting for the real event they need.\nThis is faster and clearer for the reader.\nTests should not do a `Thread.sleep` without testing an ending condition.\nThis allows understanding what the test is waiting for.\nMoreover, the test will work whatever the machine performance is.\nSleep should be minimal to be as fast as possible.\nWaiting for a variable should be done in a 40ms sleep loop.\nWaiting for a socket operation should be done in a 200 ms sleep loop."},"17253":{"id":"/docs/single-page-7453","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tests-using-a-cluster","content":"Tests using a HRegion do not have to start a cluster: A region can use the local file system.\nStart/stopping a cluster cost around 10 seconds.\nThey should not be started per test method but per test class.\nStarted cluster must be shutdown using `HBaseTestingUtility#shutdownMiniCluster`, which cleans the directories.\nAs most as possible, tests should use the default settings for the cluster.\nWhen they don't, they should document it.\nThis will allow to share the cluster later."},"17254":{"id":"/docs/single-page-7454","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#tests-skeleton-code","content":"Here is a test skeleton code with sizing tags to copy and paste and use as basis for test contribution."},"17255":{"id":"/docs/single-page-7455","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-integration-tests","content":"HBase integration/system tests are tests that are beyond HBase unit tests.\nThey are generally long-lasting, sizeable (the test can be asked to 1M rows or 1B rows), targetable (they can take configuration that will point them at the ready-made cluster they are to run against; integration tests do not include cluster start/stop code), and verifying success, integration tests rely on public APIs only; they do not attempt to examine server internals asserting success/fail.\nIntegration tests are what you would run when you need to more elaborate proofing of a release candidate beyond what unit tests can do.\nThey are not generally run on the Apache Continuous Integration build server, however, some sites opt to run integration tests as a part of their continuous testing on an actual cluster."},"17256":{"id":"/docs/single-page-7456","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-integration-tests","content":"Integration tests currently live under the *src/test&#x2A; directory in the hbase-it submodule and will match the regex: **IntegrationTest*.java*.\nAll integration tests are also annotated with `@Tag(IntegrationTests.TAG)`."},"17257":{"id":"/docs/single-page-7457","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-integration-tests","content":"Integration tests can be run in two modes: using a mini cluster, or against an actual distributed cluster.\nMaven failsafe is used to run the tests using the mini cluster.\nIntegrationTestsDriver class is used for executing the tests against a distributed cluster.\nIntegration tests SHOULD NOT assume that they are running against a mini cluster, and SHOULD NOT use private API's to access cluster state.\nTo interact with the distributed or mini cluster uniformly, `IntegrationTestingUtility`, and `HBaseCluster` classes, and public client API's can be used."},"17258":{"id":"/docs/single-page-7458","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-integration-tests","content":"On a distributed cluster, integration tests that use ChaosMonkey or otherwise manipulate services thru cluster manager (e.g.\nrestart regionservers) use SSH to do it.\nTo run these, test process should be able to run commands on remote end, so ssh should be configured accordingly (for example, if HBase runs under hbase user in your cluster, you can set up passwordless ssh for that user and run the test also under it). To facilitate that, `hbase.it.clustermanager.ssh.user`, `hbase.it.clustermanager.ssh.opts` and `hbase.it.clustermanager.ssh.cmd` configuration settings can be used.\n\"User\" is the remote user that cluster manager should use to perform ssh commands.\n\"Opts\" contains additional options that are passed to SSH (for example, \"-i /tmp/my-key\"). Finally, if you have some custom environment setup, \"cmd\" is the override format for the entire tunnel (ssh) command.\nThe default string is \\{`/usr/bin/ssh %1$s %2$s%3$s%4$s \"%5$s\"`} and is a good starting point.\nThis is a standard Java format string with 5 arguments that is used to execute the remote command.\nThe argument 1 (%1\\$s) is SSH options set the via opts setting or via environment variable, 2 is SSH user name, 3 is \"@\" if username is set or \"\" otherwise, 4 is the target host name, and 5 is the logical command to execute (that may include single quotes, so don't use them). For example, if you run the tests under non-hbase user and want to ssh as that user and change to hbase on remote machine, you can use:"},"17259":{"id":"/docs/single-page-7459","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-integration-tests","content":"That way, to kill RS (for example) integration tests may run:"},"17260":{"id":"/docs/single-page-7460","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-integration-tests","content":"The command is logged in the test logs, so you can verify it is correct for your environment."},"17261":{"id":"/docs/single-page-7461","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#building-and-developing-integration-tests","content":"To disable the running of Integration Tests, pass the following profile on the command line `-PskipIntegrationTests`.\nFor example,"},"17262":{"id":"/docs/single-page-7462","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-mini-cluster","content":"HBase 0.92 added a `verify` maven target.\nInvoking it, for example by doing `mvn verify`, will run all the phases up to and including the verify phase via the maven failsafe\nplugin, running all the above mentioned HBase unit tests as well as tests that are in the HBase integration test group.\nAfter you have completed `mvn install -DskipTests` You can run just the integration tests by invoking:"},"17263":{"id":"/docs/single-page-7463","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-mini-cluster","content":"If you just want to run the integration tests in top-level, you need to run two commands.\nFirst:"},"17264":{"id":"/docs/single-page-7464","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-mini-cluster","content":"This actually runs ALL the integration tests."},"17265":{"id":"/docs/single-page-7465","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-mini-cluster","content":"This command will always output `BUILD SUCCESS` even if there are test failures."},"17266":{"id":"/docs/single-page-7466","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-mini-cluster","content":"At this point, you could grep the output by hand looking for failed tests.\nHowever, maven will do this for us; just use:"},"17267":{"id":"/docs/single-page-7467","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-mini-cluster","content":"The above command basically looks at all the test results (so don't remove the 'target' directory) for test failures and reports the results."},"17268":{"id":"/docs/single-page-7468","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-a-subset-of-integration-tests","content":"This is very similar to how you specify running a subset of unit tests (see above), but use the property `it.test` instead of `test`.\nTo just run `IntegrationTestClassXYZ.java`, use:"},"17269":{"id":"/docs/single-page-7469","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-a-subset-of-integration-tests","content":"The next thing you might want to do is run groups of integration tests, say all integration tests that are named IntegrationTestClassX\\*.java:"},"17270":{"id":"/docs/single-page-7470","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-a-subset-of-integration-tests","content":"This runs everything that is an integration test that matches **ClassX*&#x2A;. This means anything matching: \"**\\*/IntegrationTest\\*ClassX**\". You can also run multiple groups of integration tests using comma-delimited lists (similar to unit tests). Using a list of matches still supports full regex matching for each of the groups. This would look something like:"},"17271":{"id":"/docs/single-page-7471","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-distributed-cluster","content":"If you have an already-setup HBase cluster, you can launch the integration tests by invoking the class `IntegrationTestsDriver`.\nYou may have to run test-compile first.\nThe configuration will be picked by the bin/hbase script."},"17272":{"id":"/docs/single-page-7472","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-distributed-cluster","content":"Then launch the tests with:"},"17273":{"id":"/docs/single-page-7473","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-distributed-cluster","content":"Pass `-h` to get usage on this sweet tool.\nRunning the IntegrationTestsDriver without any argument will launch tests found under `hbase-it/src/test`, having `@Tag(IntegrationTests.TAG)` annotation, and a name starting with `IntegrationTest`.\nSee the usage, by passing -h, to see how to filter test classes.\nYou can pass a regex which is checked against the full class name; so, part of class name can be used.\nIntegrationTestsDriver uses JUnit 5 to run the tests.\nCurrently there is no support for running integration tests against a distributed cluster using maven (see HBASE-6201)."},"17274":{"id":"/docs/single-page-7474","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-distributed-cluster","content":"The tests interact with the distributed cluster by using the methods in the `DistributedHBaseCluster` (implementing `HBaseCluster`) class, which in turn uses a pluggable `ClusterManager`.\nConcrete implementations provide actual functionality for carrying out deployment-specific and environment-dependent tasks (SSH, etc). The default `ClusterManager` is `HBaseClusterManager`, which uses SSH to remotely execute start/stop/kill/signal commands, and assumes some posix commands (ps, etc). Also assumes the user running the test has enough \"power\" to start/stop servers on the remote machines.\nBy default, it picks up `HBASE_SSH_OPTS`, `HBASE_HOME`, `HBASE_CONF_DIR` from the env, and uses `bin/hbase-daemon.sh` to carry out the actions.\nCurrently tarball deployments, deployments which uses *hbase-daemons.sh*, and Apache Ambar&#x69; deployments are supported.\n&#x2A;/etc/init.d/* scripts are not supported for now, but it can be easily added.\nFor other deployment options, a ClusterManager can be implemented and plugged in."},"17275":{"id":"/docs/single-page-7475","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-distributed-cluster","content":"Some integration tests define a *main* method as entry point, and can be run on its' own, rather than using the test driver. For example, the *itbll* test can be run as follows:"},"17276":{"id":"/docs/single-page-7476","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-integration-tests-against-distributed-cluster","content":"The *hbase* script assumes all integration tests with exposed *main* methods to be run against a\ndistributed cluster will follow the **IntegrationTest** regex naming pattern mentioned above, in\norder to proper set test dependencies into the classpath."},"17277":{"id":"/docs/single-page-7477","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#destructive-integration--system-tests-chaosmonkey","content":"HBase 0.96 introduced a tool named `ChaosMonkey`, modeled after\nsame-named tool by Netflix's Chaos Monkey tool.\nChaosMonkey simulates real-world\nfaults in a running cluster by killing or disconnecting random servers, or injecting\nother failures into the environment. You can use ChaosMonkey as a stand-alone tool\nto run a policy while other tests are running. In some environments, ChaosMonkey is\nalways running, in order to constantly check that high availability and fault tolerance\nare working as expected."},"17278":{"id":"/docs/single-page-7478","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#destructive-integration--system-tests-chaosmonkey","content":"ChaosMonkey defines **Actions** and **Policies**."},"17279":{"id":"/docs/single-page-7479","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Actions are predefined sequences of events, such as the following:"},"17280":{"id":"/docs/single-page-7480","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Restart active master (sleep 5 sec)"},"17281":{"id":"/docs/single-page-7481","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Restart random regionserver (sleep 5 sec)"},"17282":{"id":"/docs/single-page-7482","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Restart random regionserver (sleep 60 sec)"},"17283":{"id":"/docs/single-page-7483","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Restart META regionserver (sleep 5 sec)"},"17284":{"id":"/docs/single-page-7484","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Restart ROOT regionserver (sleep 5 sec)"},"17285":{"id":"/docs/single-page-7485","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Batch restart of 50% of regionservers (sleep 5 sec)"},"17286":{"id":"/docs/single-page-7486","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#actions","content":"Rolling restart of 100% of regionservers (sleep 5 sec)"},"17287":{"id":"/docs/single-page-7487","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#policies","content":"A policy is a strategy for executing one or more actions. The default policy\nexecutes a random action every minute based on predefined action weights.\nA given policy will be executed until ChaosMonkey is interrupted."},"17288":{"id":"/docs/single-page-7488","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#policies","content":"Most ChaosMonkey actions are configured to have reasonable defaults, so you can run\nChaosMonkey against an existing cluster without any additional configuration. The\nfollowing example runs ChaosMonkey with the default configuration:"},"17289":{"id":"/docs/single-page-7489","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#policies","content":"The output indicates that ChaosMonkey started the default `PeriodicRandomActionPolicy`\npolicy, which is configured with all the available actions. It chose to run `RestartActiveMaster` and `RestartRandomRs` actions."},"17290":{"id":"/docs/single-page-7490","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#chaosmonkey-without-ssh","content":"Chaos monkey can be run without SSH using the Chaos service and ZNode cluster manager. HBase ships\nwith many cluster managers, available in the `hbase-it/src/test/java/org/apache/hadoop/hbase/` directory."},"17291":{"id":"/docs/single-page-7491","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#chaosmonkey-without-ssh","content":"Set the following property in hbase configuration to switch to `ZNodeClusterManager`:"},"17292":{"id":"/docs/single-page-7492","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#chaosmonkey-without-ssh","content":"Start chaos agent on all hosts where you want to test chaos scenarios."},"17293":{"id":"/docs/single-page-7493","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#chaosmonkey-without-ssh","content":"Start chaos monkey runner from any one host, preferrably an edgenode.\nAn example log while running chaos monkey with default policy `PeriodicRandomActionPolicy` is as shown below:"},"17294":{"id":"/docs/single-page-7494","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#chaosmonkey-without-ssh","content":"For info on more customisations we can see help for the `ChaosMonkeyRunner`. For example we can pass the table name on which the chaos operations to be performed etc.\nBelow is the output of the help command, listing all the supported options."},"17295":{"id":"/docs/single-page-7495","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#chaosmonkey-without-ssh","content":"For example, running the following will start `ServerKillingMonkeyFactory` that chooses among actions to rolling batch restart RS, graceful rolling restart RS one at a time, restart active master, force balancer run etc."},"17296":{"id":"/docs/single-page-7496","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#available-policies","content":"HBase ships with several ChaosMonkey policies, available in the\n`hbase/hbase-it/src/test/java/org/apache/hadoop/hbase/chaos/policies/` directory."},"17297":{"id":"/docs/single-page-7497","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-individual-chaosmonkey-actions","content":"ChaosMonkey integration tests can be configured per test run.\nCreate a Java properties file in the HBase CLASSPATH and pass it to ChaosMonkey using\nthe `-monkeyProps` configuration flag. Configurable properties, along with their default\nvalues if applicable, are listed in the `org.apache.hadoop.hbase.chaos.factories.MonkeyConstants`\nclass. For properties that have defaults, you can override them by including them\nin your properties file."},"17298":{"id":"/docs/single-page-7498","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-individual-chaosmonkey-actions","content":"The following example uses a properties file called `monkey.properties`."},"17299":{"id":"/docs/single-page-7499","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-individual-chaosmonkey-actions","content":"The above command will start the integration tests and chaos monkey. It will look for the\nproperties file *monkey.properties* on the HBase CLASSPATH; e.g. inside the HBASE *conf* dir."},"17300":{"id":"/docs/single-page-7500","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#configuring-individual-chaosmonkey-actions","content":"Here is an example chaos monkey file:"},"17301":{"id":"/docs/single-page-7501","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-chaosmonkey-properties-file","content":"Periods/time are expressed in milliseconds."},"17302":{"id":"/docs/single-page-7502","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#example-chaosmonkey-properties-file","content":"HBase 1.0.2 and newer adds the ability to restart HBase's underlying ZooKeeper quorum or\nHDFS nodes. To use these actions, you need to configure some new properties, which\nhave no reasonable defaults because they are deployment-specific, in your ChaosMonkey\nproperties file, which may be `hbase-site.xml` or a different properties file."},"17303":{"id":"/docs/single-page-7503","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#customizing-destructive-chaosmonkey-actions","content":"The session above shows how to setup custom configurations for the *slowDeterministic* monkey\npolicy. This is a policy that pre-defines a set of destructive actions of varying gravity for a\nrunning cluster. These actions are grouped into three categories: *light weight*, *mid weight* and\n*heavy weight*. Although it's possible to define some properties for the different actions\n(such as timeouts, frequency, etc), the actions themselves are not configurable."},"17304":{"id":"/docs/single-page-7504","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#customizing-destructive-chaosmonkey-actions","content":"For certain deployments, it may be interesting to define its own test strategy, either less or more\naggressive than the pre-defined set of actions provided by *slowDeterministic*. For such cases,\nthe *configurableSlowDeterministic* policy can be used. It allows for a customizable set of\n*heavy weight* actions to be defined in the *monkey.properties* properties file:"},"17305":{"id":"/docs/single-page-7505","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#customizing-destructive-chaosmonkey-actions","content":"The above properties file definition instructs chaos monkey to perform a RegionServer crash every 8 minutes,\na random region move every 6 minutes, and at least one split of all table regions."},"17306":{"id":"/docs/single-page-7506","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#customizing-destructive-chaosmonkey-actions","content":"To run this policy, just specify *configurableSlowDeterministic* as the monkey policy to run, together\nwith a property file containing the *heavy.actions* property definition:"},"17307":{"id":"/docs/single-page-7507","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#customizing-destructive-chaosmonkey-actions","content":"When specifying monkey actions, make sure to define all required constructor parameters. For actions\nthat require a table name parameter, the *\\$table\\_name* placeholder can be specified, and it will\nautomatically resort to the table created by the integration test run."},"17308":{"id":"/docs/single-page-7508","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#customizing-destructive-chaosmonkey-actions","content":"If *heavy.actions* property is omitted in the properties file, *configurableSlowDeterministic* will\njust run as the *slowDeterministic* policy\n(it will execute all the heavy weight actions defined by *slowDeterministic* policy)."},"17309":{"id":"/docs/single-page-7509","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#branches","content":"We use Git for source code management and latest development happens on `master` branch. There are\nbranches for past major/minor/maintenance releases and important features and bug fixes are often\nback-ported to them."},"17310":{"id":"/docs/single-page-7510","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#policy-for-fix-version-in-jira","content":"To determine if a given fix is in a given release purely from the release numbers following rules\nare defined:"},"17311":{"id":"/docs/single-page-7511","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#policy-for-fix-version-in-jira","content":"Fix version of X.Y.Z => fixed in all releases X.Y.Z' (where Z' = Z).\\\nFix version of X.Y.0 => fixed in all releases X.Y'.\\* (where Y' = Y).\\\nFix version of X.0.0 => fixed in all releases X'.\\*.\\* (where X' = X)."},"17312":{"id":"/docs/single-page-7512","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#policy-for-fix-version-in-jira","content":"By this policy, fix version of 1.3.0 implies 1.4.0, but 1.3.2 does not imply 1.4.0 as we could not\ntell purely from the numbers which release came first."},"17313":{"id":"/docs/single-page-7513","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interface-classifications","content":"Interfaces are classified both by audience and by stability level.\nThese labels appear at the head of a class.\nThe conventions followed by HBase are inherited by its parent project, Hadoop."},"17314":{"id":"/docs/single-page-7514","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interface-classifications","content":"The following interface classifications are commonly used:"},"17315":{"id":"/docs/single-page-7515","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfaceaudience","content":"`@InterfaceAudience.Public`\\\nAPIs for users and HBase applications.\nThese APIs will be deprecated through major versions of HBase."},"17316":{"id":"/docs/single-page-7516","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfaceaudience","content":"`@InterfaceAudience.Private`\\\nAPIs for HBase internals developers.\nNo guarantees on compatibility or availability in future versions.\nPrivate interfaces do not need an `@InterfaceStability` classification."},"17317":{"id":"/docs/single-page-7517","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfaceaudience","content":"`@InterfaceAudience.LimitedPrivate(HBaseInterfaceAudience.COPROC)`\\\nAPIs for HBase coprocessor writers."},"17318":{"id":"/docs/single-page-7518","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfaceaudience","content":"**No `@InterfaceAudience` Classification**:\\\nPackages without an `@InterfaceAudience` label are considered private.\nMark your new packages if publicly accessible."},"17319":{"id":"/docs/single-page-7519","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfaceaudience","content":"Only interfaces classified `@InterfaceAudience.Public` should be included in API documentation\n(Javadoc). Committers must add new package excludes `ExcludePackageNames` section of the *pom.xml*\nfor new packages which do not contain public classes."},"17320":{"id":"/docs/single-page-7520","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfacestability","content":"`@InterfaceStability` is important for packages marked `@InterfaceAudience.Public`."},"17321":{"id":"/docs/single-page-7521","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfacestability","content":"`@InterfaceStability.Stable`\\\nPublic packages marked as stable cannot be changed without a deprecation path or a very good reason."},"17322":{"id":"/docs/single-page-7522","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfacestability","content":"`@InterfaceStability.Unstable`\\\nPublic packages marked as unstable can be changed without a deprecation path."},"17323":{"id":"/docs/single-page-7523","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfacestability","content":"`@InterfaceStability.Evolving`\\\nPublic packages marked as evolving may be changed, but it is discouraged."},"17324":{"id":"/docs/single-page-7524","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfacestability","content":"**No `@InterfaceStability` Label**:\nPublic classes with no `@InterfaceStability` label are discouraged, and should be considered implicitly unstable."},"17325":{"id":"/docs/single-page-7525","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#interfacestability","content":"If you are unclear about how to mark packages, ask on the development list."},"17326":{"id":"/docs/single-page-7526","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#code-formatting-conventions","content":"Please adhere to the following guidelines so that your patches can be reviewed more quickly.\nThese guidelines have been developed based upon common feedback on patches from new contributors."},"17327":{"id":"/docs/single-page-7527","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#code-formatting-conventions","content":"See the Code Conventions for the Java Programming Language for more information on coding conventions in Java.\nSee Eclipse Code Formatting to setup Eclipse to check for some of\nthese guidelines automatically."},"17328":{"id":"/docs/single-page-7528","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#space-invaders","content":"Do not use extra spaces around brackets.\nUse the second style, rather than the first."},"17329":{"id":"/docs/single-page-7529","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#auto-generated-code","content":"Auto-generated code in Eclipse often uses bad variable names such as `arg0`.\nUse more informative variable names.\nUse code like the second example here."},"17330":{"id":"/docs/single-page-7530","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#long-lines","content":"Keep lines less than 100 characters.\nYou can configure your IDE to do this automatically."},"17331":{"id":"/docs/single-page-7531","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#trailing-spaces","content":"Be sure there is a line break after the end of your code, and avoid lines with nothing but whitespace.\nThis makes diffs more meaningful.\nYou can configure your IDE to help with this."},"17332":{"id":"/docs/single-page-7532","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#api-documentation-javadoc","content":"Don't forget Javadoc!"},"17333":{"id":"/docs/single-page-7533","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#api-documentation-javadoc","content":"Javadoc warnings are checked during precommit.\nIf the precommit tool gives you a '-1', please fix the javadoc issue.\nYour patch won't be committed if it adds such warnings."},"17334":{"id":"/docs/single-page-7534","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#api-documentation-javadoc","content":"Also, no `@author` tags - that's a rule."},"17335":{"id":"/docs/single-page-7535","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#findbugs","content":"`Findbugs` is used to detect common bugs pattern.\nIt is checked during the precommit build.\nIf errors are found, please fix them.\nYou can run findbugs locally with `mvn\n                            findbugs:findbugs`, which will generate the `findbugs` files locally.\nSometimes, you may have to write code smarter than `findbugs`.\nYou can annotate your code to tell `findbugs` you know what you're doing, by annotating your class with the following annotation:"},"17336":{"id":"/docs/single-page-7536","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#findbugs","content":"It is important to use the Apache-licensed version of the annotations. That generally means using\nannotations in the `edu.umd.cs.findbugs.annotations` package so that we can rely on the cleanroom\nreimplementation rather than annotations in the `javax.annotations` package."},"17337":{"id":"/docs/single-page-7537","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#javadoc---useless-defaults","content":"Don't just leave javadoc tags the way IDE generates them, or fill redundant information in them."},"17338":{"id":"/docs/single-page-7538","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#javadoc---useless-defaults","content":"Either add something descriptive to the tags, or just remove them.\nThe preference is to add something descriptive and useful."},"17339":{"id":"/docs/single-page-7539","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#one-thing-at-a-time-folks","content":"If you submit a patch for one thing, don't do auto-reformatting or unrelated reformatting of code on a completely different area of code."},"17340":{"id":"/docs/single-page-7540","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#one-thing-at-a-time-folks","content":"Likewise, don't add unrelated cleanup or refactorings outside the scope of your Jira."},"17341":{"id":"/docs/single-page-7541","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#ambiguous-unit-tests","content":"Make sure that you're clear about what you are testing in your unit tests and why."},"17342":{"id":"/docs/single-page-7542","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#garbage-collection-conserving-guidelines","content":"The following guidelines were borrowed from http\\://engineering.linkedin.com/performance/linkedin-feed-faster-less-jvm-garbage.\nKeep them in mind to keep preventable garbage collection to a minimum. Have a look\nat the blog post for some great examples of how to refactor your code according to\nthese guidelines."},"17343":{"id":"/docs/single-page-7543","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#garbage-collection-conserving-guidelines","content":"Be careful with Iterators"},"17344":{"id":"/docs/single-page-7544","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#garbage-collection-conserving-guidelines","content":"Estimate the size of a collection when initializing"},"17345":{"id":"/docs/single-page-7545","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#garbage-collection-conserving-guidelines","content":"Defer expression evaluation"},"17346":{"id":"/docs/single-page-7546","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#garbage-collection-conserving-guidelines","content":"Compile the regex patterns in advance"},"17347":{"id":"/docs/single-page-7547","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#garbage-collection-conserving-guidelines","content":"Cache it if you can"},"17348":{"id":"/docs/single-page-7548","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#garbage-collection-conserving-guidelines","content":"String Interns are useful but dangerous"},"17349":{"id":"/docs/single-page-7549","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#invariants","content":"We don't have many but what we have we list below.\nAll are subject to challenge of course but until then, please hold to the rules of the road."},"17350":{"id":"/docs/single-page-7550","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#no-permanent-state-in-zookeeper","content":"ZooKeeper state should transient (treat it like memory). If ZooKeeper state is deleted, hbase should be able to recover and essentially be in the same state."},"17351":{"id":"/docs/single-page-7551","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#no-permanent-state-in-zookeeper","content":".Exceptions: There are currently a few exceptions that we need to fix around whether a table is enabled or disabled."},"17352":{"id":"/docs/single-page-7552","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#no-permanent-state-in-zookeeper","content":"Replication data is currently stored only in ZooKeeper.\nDeleting ZooKeeper data related to replication may cause replication to be disabled.\nDo not delete the replication tree, &#x2A;/hbase/replication/*."},"17353":{"id":"/docs/single-page-7553","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#no-permanent-state-in-zookeeper","content":"Replication may be disrupted and data loss may occur if you delete the replication tree\n(&#x2A;/hbase/replication/*) from ZooKeeper. Follow progress on this issue at\nHBASE-10295."},"17354":{"id":"/docs/single-page-7554","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-in-situ","content":"If you are developing Apache HBase, frequently it is useful to test your changes against a more-real cluster than what you find in unit tests.\nIn this case, HBase can be run directly from the source in local-mode.\nAll you need to do is run:"},"17355":{"id":"/docs/single-page-7555","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-in-situ","content":"This will spin up a full local-cluster, just as if you had packaged up HBase and installed it on your machine."},"17356":{"id":"/docs/single-page-7556","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-in-situ","content":"Keep in mind that you will need to have installed HBase into your local maven repository for the in-situ cluster to work properly.\nThat is, you will need to run:"},"17357":{"id":"/docs/single-page-7557","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#running-in-situ","content":"to ensure that maven can find the correct classpath and dependencies.\nGenerally, the above command is just a good thing to try running first, if maven is acting oddly."},"17358":{"id":"/docs/single-page-7558","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#adding-metrics","content":"After adding a new feature a developer might want to add metrics.\nHBase exposes metrics using the Hadoop Metrics 2 system, so adding a new metric involves exposing that metric to the hadoop system.\nUnfortunately the API of metrics2 changed from hadoop 1 to hadoop 2.\nIn order to get around this a set of interfaces and implementations have to be loaded at runtime.\nTo get an in-depth look at the reasoning and structure of these classes you can read the blog post located here.\nTo add a metric to an existing MBean follow the short guide below:"},"17359":{"id":"/docs/single-page-7559","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#add-metric-name-and-function-to-hadoop-compat-interface","content":"Inside of the source interface the corresponds to where the metrics are generated (eg MetricsMasterSource for things coming from HMaster) create new static strings for metric name and description.\nThen add a new method that will be called to add new reading."},"17360":{"id":"/docs/single-page-7560","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#add-the-implementation-to-both-hadoop-1-and-hadoop-2-compat-modules","content":"Inside of the implementation of the source (eg.\nMetricsMasterSourceImpl in the above example) create a new histogram, counter, gauge, or stat in the init method.\nThen in the method that was added to the interface wire up the parameter passed in to the histogram."},"17361":{"id":"/docs/single-page-7561","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#add-the-implementation-to-both-hadoop-1-and-hadoop-2-compat-modules","content":"Now add tests that make sure the data is correctly exported to the metrics 2 system.\nFor this the MetricsAssertHelper is provided."},"17362":{"id":"/docs/single-page-7562","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#git-best-practices","content":"**Avoid git merges.**\\\nUse `git pull --rebase` or `git fetch` followed by `git rebase`."},"17363":{"id":"/docs/single-page-7563","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#git-best-practices","content":"**Do not use `git push --force`.**\\\nIf the push does not work, fix the problem or ask for help."},"17364":{"id":"/docs/single-page-7564","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#git-best-practices","content":"Please contribute to this document if you think of other Git best practices."},"17365":{"id":"/docs/single-page-7565","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#rebase_all_git_branchessh","content":"The *dev-support/rebase\\_all\\_git\\_branches.sh* script is provided to help keep your Git repository clean.\nUse the `-h` parameter to get usage instructions.\nThe script automatically refreshes your tracking branches, attempts an automatic rebase of each local branch against its remote branch, and gives you the option to delete any branch which represents a closed `HBASE-` JIRA.\nThe script has one optional configuration option, the location of your Git directory.\nYou can set a default by editing the script.\nOtherwise, you can pass the git directory manually by using the `-d&#x60; parameter, followed by an absolute or relative directory name, or even '.' for the current working directory.\nThe script checks the directory for sub-directory called &#x2A;.git/*, before proceeding."},"17366":{"id":"/docs/single-page-7566","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#submitting-patches","content":"If you are new to submitting patches to open source or new to submitting patches to Apache, start by\nreading the On Contributing Patches page from\nApache Commons Project.\nIt provides a nice overview that applies equally to the Apache HBase Project."},"17367":{"id":"/docs/single-page-7567","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#submitting-patches","content":"Make sure you review Code Formatting Conventions for code style. If your patch\nwas generated incorrectly or your code does not adhere to the code formatting guidelines, you may\nbe asked to redo some work."},"17368":{"id":"/docs/single-page-7568","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#submitting-patches","content":"HBase enforces code style via a maven plugin. After you've written up your changes, apply the\nformatter before committing."},"17369":{"id":"/docs/single-page-7569","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#submitting-patches","content":"When your commit is ready, present it to the community as a\nGitHub Pull Request."},"17370":{"id":"/docs/single-page-7570","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#few-general-guidelines","content":"Always patch against the master branch first, even if you want to patch in another branch.\nHBase committers always apply patches first to the master branch, and backport as necessary. For\ncomplex patches, you may be asked to perform the backport(s) yourself."},"17371":{"id":"/docs/single-page-7571","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#few-general-guidelines","content":"Submit one single PR for a single fix. If necessary, squash local commits to merge local commits\ninto a single one first. See this\nStack Overflow\nquestion for more information about squashing commits."},"17372":{"id":"/docs/single-page-7572","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#few-general-guidelines","content":"Please understand that not every patch may get committed, and that feedback will likely be\nprovided on the patch."},"17373":{"id":"/docs/single-page-7573","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#developer-guidelines-submitting-patches-unit-tests","content":"Always add and/or update relevant unit tests when making the changes.\nMake sure that new/changed unit tests pass locally before submitting the patch because it is faster\nthan waiting for presubmit result which runs full test suite. This will save your own time and\neffort.\nUse Mockito to make mocks which are very useful for testing failure scenarios by\ninjecting appropriate failures."},"17374":{"id":"/docs/single-page-7574","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#developer-guidelines-submitting-patches-unit-tests","content":"If you are creating a new unit test class, notice how other unit test classes have\nclassification/sizing annotations before class name and a static methods for setup/teardown of\ntesting environment. Be sure to include annotations in any new unit test files.\nSee Tests for more information on tests."},"17375":{"id":"/docs/single-page-7575","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#developer-guidelines-submitting-patches-integration-tests","content":"Significant new features should provide an integration test in addition to unit tests, suitable for exercising the new feature at different points in its configuration space."},"17376":{"id":"/docs/single-page-7576","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"Patches larger than one screen, or patches that will be tricky to review, should go through ReviewBoard."},"17377":{"id":"/docs/single-page-7577","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"**Procedure: Use ReviewBoard**"},"17378":{"id":"/docs/single-page-7578","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"Register for an account if you don't already have one.\nIt does not use the credentials from issues.apache.org.\nLog in."},"17379":{"id":"/docs/single-page-7579","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"Click **New Review Request**."},"17380":{"id":"/docs/single-page-7580","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"Choose the `hbase-git` repository.\nClick Choose File to select the diff and optionally a parent diff.\nClick **Create Review Request**."},"17381":{"id":"/docs/single-page-7581","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"Fill in the fields as required.\nAt the minimum, fill in the **Summary** and choose `hbase` as the **Review Group**.\nIf you fill in the **Bugs** field, the review board links back to the relevant JIRA.\nThe more fields you fill in, the better.\nClick **Publish** to make your review request public.\nAn email will be sent to everyone in the `hbase` group, to review the patch."},"17382":{"id":"/docs/single-page-7582","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"Back in your JIRA, click , and paste in the URL of your ReviewBoard request.\nThis attaches the ReviewBoard to the JIRA, for easy access."},"17383":{"id":"/docs/single-page-7583","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"To cancel the request, click ."},"17384":{"id":"/docs/single-page-7584","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reviewboard","content":"For more information on how to use ReviewBoard, see the ReviewBoard\ndocumentation."},"17385":{"id":"/docs/single-page-7585","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#github","content":"Submitting GitHub pull requests is another accepted form of\ncontributing patches. Refer to GitHub documentation for details on\nhow to create pull requests."},"17386":{"id":"/docs/single-page-7586","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#github","content":"This section is incomplete and needs to be updated. Refer to\nHBASE-23557"},"17387":{"id":"/docs/single-page-7587","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#github-tooling","content":"**Browser bookmarks**"},"17388":{"id":"/docs/single-page-7588","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#github-tooling","content":"Following is a useful javascript based browser bookmark that redirects from GitHub pull\nrequests to the corresponding jira work item. This redirects based on the HBase jira ID mentioned\nin the issue title for the PR. Add the following javascript snippet as a browser bookmark to the\ntool bar. Clicking on it while you are on an HBase GitHub PR page redirects you to the corresponding\njira item."},"17389":{"id":"/docs/single-page-7589","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Committers are responsible for reviewing and integrating code changes, testing\nand voting on release candidates, weighing in on design discussions, as well as\nother types of project contributions. The PMC votes to make a contributor a\ncommitter based on an assessment of their contributions to the project. It is\nexpected that committers demonstrate a sustained history of high-quality\ncontributions to the project and community involvement."},"17390":{"id":"/docs/single-page-7590","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Contributions can be made in many ways. There is no single path to becoming a\ncommitter, nor any expected timeline. Submitting features, improvements, and bug\nfixes is the most common avenue, but other methods are both recognized and\nencouraged (and may be even more important to the health of HBase as a project and a\ncommunity). A non-exhaustive list of potential contributions (in no particular\norder):"},"17391":{"id":"/docs/single-page-7591","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Update the documentation for new\nchanges, best practices, recipes, and other improvements."},"17392":{"id":"/docs/single-page-7592","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Keep the website up to date."},"17393":{"id":"/docs/single-page-7593","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Perform testing and report the results. For instance, scale testing and\ntesting non-standard configurations is always appreciated."},"17394":{"id":"/docs/single-page-7594","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Maintain the shared Jenkins testing environment and other testing\ninfrastructure."},"17395":{"id":"/docs/single-page-7595","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Vote on release candidates after performing validation, even if non-binding.\nA non-binding vote is a vote by a non-committer."},"17396":{"id":"/docs/single-page-7596","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Provide input for discussion threads on the mailing lists (which usually have\n`[DISCUSS]` in the subject line)."},"17397":{"id":"/docs/single-page-7597","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Answer questions on the user or developer mailing lists and on\nSlack."},"17398":{"id":"/docs/single-page-7598","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Make sure the HBase community is a welcoming one and that we adhere to our\nCode of conduct. Alert the PMC if you\nhave concerns."},"17399":{"id":"/docs/single-page-7599","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Review other people's work (both code and non-code) and provide public\nfeedback."},"17400":{"id":"/docs/single-page-7600","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Report bugs that are found, or file new feature requests."},"17401":{"id":"/docs/single-page-7601","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Triage issues and keep JIRA organized. This includes closing stale issues,\nlabeling new issues, updating metadata, and other tasks as needed."},"17402":{"id":"/docs/single-page-7602","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Mentor new contributors of all sorts."},"17403":{"id":"/docs/single-page-7603","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Give talks and write blogs about HBase. Add these to the News section\nof the website."},"17404":{"id":"/docs/single-page-7604","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Provide UX feedback about HBase, the web UI, the CLI, APIs, and the website."},"17405":{"id":"/docs/single-page-7605","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Write demo applications and scripts."},"17406":{"id":"/docs/single-page-7606","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Help attract and retain a diverse community."},"17407":{"id":"/docs/single-page-7607","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Interact with other projects in ways that benefit HBase and those other\nprojects."},"17408":{"id":"/docs/single-page-7608","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#becoming-a-committer","content":"Not every individual is able to do all (or even any) of the items on this list.\nIf you think of other ways to contribute, go for it (and add them to the list).\nA pleasant demeanor and willingness to contribute are all you need to make a\npositive impact on the HBase project. Invitations to become a committer are the\nresult of steady interaction with the community over the long term, which builds\ntrust and recognition."},"17409":{"id":"/docs/single-page-7609","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-committers","content":"New committers are encouraged to first read Apache's generic committer\ndocumentation:"},"17410":{"id":"/docs/single-page-7610","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-committers","content":"Apache New Committer Guide"},"17411":{"id":"/docs/single-page-7611","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-committers","content":"Apache Committer FAQ"},"17412":{"id":"/docs/single-page-7612","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#review","content":"HBase committers should, as often as possible, attempt to review patches\nsubmitted by others. Ideally every submitted patch will get reviewed by a\ncommitter *within a few days*. If a committer reviews a patch they have not\nauthored, and believe it to be of sufficient quality, then they can commit the\npatch. Otherwise the patch should be cancelled with a clear explanation for why\nit was rejected."},"17413":{"id":"/docs/single-page-7613","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#review","content":"The list of submitted patches is in the\nHBase Review Queue,\nwhich is ordered by time of last modification. Committers should scan the list\nfrom top to bottom, looking for patches that they feel qualified to review and\npossibly commit. If you see a patch you think someone else is better qualified\nto review, you can mention them by username in the JIRA."},"17414":{"id":"/docs/single-page-7614","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#review","content":"For non-trivial changes, it is required that another committer review your\npatches before commit. &#x2A;*Self-commits of non-trivial patches are not allowed.**\nUse the **Submit Patch** button in JIRA, just like other contributors, and\nthen wait for a `+1` response from another committer before committing."},"17415":{"id":"/docs/single-page-7615","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#reject","content":"Patches which do not adhere to the guidelines in\nHowToContribute and to the\ncode review checklist\nshould be rejected. Committers should always be polite to contributors and try\nto instruct and encourage them to contribute better patches. If a committer\nwishes to improve an unacceptable patch, then it should first be rejected, and a\nnew patch should be attached by the committer for further review."},"17416":{"id":"/docs/single-page-7616","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Committers commit patches to the Apache HBase GIT repository."},"17417":{"id":"/docs/single-page-7617","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Make sure your local configuration is correct, especially your identity and email. Examine the\noutput of the `$ git config --list` command and be sure it is correct. See Set Up\nGit if you need pointers."},"17418":{"id":"/docs/single-page-7618","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"When you commit a patch:"},"17419":{"id":"/docs/single-page-7619","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Include the Jira issue ID in the commit message along with a short description\nof the change. Try to add something more than just the Jira title so that\nsomeone looking at `git log` output doesn't have to go to Jira to discern what\nthe change is about. Be sure to get the issue ID right, because this causes\nJira to link to the change in Git (use the issue's \"All\" tab to see these\nautomatic links)."},"17420":{"id":"/docs/single-page-7620","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Commit the patch to a new branch based off `master` or the other intended\nbranch. It's a good idea to include the JIRA ID in the name of this branch.\nCheck out the relevant target branch where you want to commit, and make sure\nyour local branch has all remote changes, by doing a `git pull --rebase` or\nanother similar command. Next, cherry-pick the change into each relevant\nbranch (such as master), and push the changes to the remote branch using\na command such as `git push <remote-server> <remote-branch>`."},"17421":{"id":"/docs/single-page-7621","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"If you do not have all remote changes, the push will fail. If the push fails for any reason,\nfix the problem or ask for help. Do not do a `git push --force`."},"17422":{"id":"/docs/single-page-7622","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Before you can commit a patch, you need to determine how the patch was created.\nThe instructions and preferences around the way to create patches have changed,\nand there will be a transition period."},"17423":{"id":"/docs/single-page-7623","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Determine How a Patch Was Created**"},"17424":{"id":"/docs/single-page-7624","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"If the first few lines of the patch look like the headers of an email, with a From, Date, and\nSubject, it was created using `git format-patch`. This is the preferred way, because you can\nreuse the submitter's commit message. If the commit message is not appropriate, you can still use\nthe commit, then run `git commit --amend` and reword as appropriate."},"17425":{"id":"/docs/single-page-7625","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"If the first line of the patch looks similar to the following, it was created using +git diff+ without `--no-prefix`.\nThis is acceptable too.\nNotice the `a` and `b` in front of the file names.\nThis is the indication that the patch was not created with `--no-prefix`."},"17426":{"id":"/docs/single-page-7626","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"If the first line of the patch looks similar to the following (without the `a` and `b`), the\npatch was created with `git diff --no-prefix` and you need to add `-p0` to the `git apply` command\nbelow."},"17427":{"id":"/docs/single-page-7627","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Example of committing a Patch**"},"17428":{"id":"/docs/single-page-7628","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"One thing you will notice with these examples is that there are a lot of\n`git pull` commands. The only command that actually writes anything to the\nremote repository is `git push`, and you need to make absolutely sure you have\nthe correct versions of everything and don't have any conflicts before pushing.\nThe extra `git pull` commands are usually redundant, but better safe than sorry."},"17429":{"id":"/docs/single-page-7629","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"The first example shows how to apply a patch that was generated with +git\nformat-patch+ and apply it to the `master` and `branch-1` branches."},"17430":{"id":"/docs/single-page-7630","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"The directive to use `git format-patch` rather than `git diff`, and not to use\n`--no-prefix`, is a new one. See the second example for how to apply a patch\ncreated with `git diff`, and educate the person who created the patch."},"17431":{"id":"/docs/single-page-7631","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"This example shows how to commit a patch that was created using `git diff`\nwithout `--no-prefix`. If the patch was created with `--no-prefix`, add `-p0` to\nthe `git apply` command."},"17432":{"id":"/docs/single-page-7632","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Resolve the issue as fixed, thanking the contributor.\nAlways set the \"Fix Version\" at this point, but only set a single fix version\nfor each branch where the change was committed, the earliest release in that\nbranch in which the change will appear."},"17433":{"id":"/docs/single-page-7633","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Commit Message Format**"},"17434":{"id":"/docs/single-page-7634","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"The commit message should contain the JIRA ID and a description of what the patch does.\nThe preferred commit message format is:"},"17435":{"id":"/docs/single-page-7635","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"If the contributor used `git format-patch` to generate the patch, their commit\nmessage is in their patch and you can use that, but be sure the JIRA ID is at\nthe front of the commit message, even if the contributor left it out."},"17436":{"id":"/docs/single-page-7636","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Use GitHub's \"Co-authored-by\" when there are multiple authors**"},"17437":{"id":"/docs/single-page-7637","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"We've established the practice of committing to master and then cherry picking back to branches whenever possible, unless"},"17438":{"id":"/docs/single-page-7638","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"it's breaking compat: In which case, if it can go in minor releases, backport to branch-1 and branch-2."},"17439":{"id":"/docs/single-page-7639","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"it's a new feature: No for maintenance releases, For minor releases, discuss and arrive at consensus."},"17440":{"id":"/docs/single-page-7640","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"There are occasions when there are multiple author for a patch.\nFor example when there is a minor conflict we can fix it up and just proceed with the commit.\nThe amending author will be different from the original committer, so you should also attribute to the original author by\nadding one or more `Co-authored-by` trailers to the commit's message.\nSee the GitHub documentation for \"Creating a commit with multiple authors\"."},"17441":{"id":"/docs/single-page-7641","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"In short, these are the steps to add Co-authors that will be tracked by GitHub:"},"17442":{"id":"/docs/single-page-7642","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Collect the name and email address for each co-author."},"17443":{"id":"/docs/single-page-7643","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Commit the change, but after your commit description, instead of a closing quotation, add two empty lines. (Do not close the commit message with a quotation mark)"},"17444":{"id":"/docs/single-page-7644","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"On the next line of the commit message, type `Co-authored-by: name <name@example.com>`. After the co-author information, add a closing quotation mark."},"17445":{"id":"/docs/single-page-7645","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Here is the example from the GitHub page, using 2 Co-authors:"},"17446":{"id":"/docs/single-page-7646","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Note: `Amending-Author: Author <committer@apache>` was used prior to this\nDISCUSSION."},"17447":{"id":"/docs/single-page-7647","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Close related GitHub PRs**"},"17448":{"id":"/docs/single-page-7648","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"As a project we work to ensure there's a JIRA associated with each change, but we don't mandate any particular tool be used for reviews. Due to implementation details of the ASF's integration between hosted git repositories and GitHub, the PMC has no ability to directly close PRs on our GitHub repo. In the event that a contributor makes a Pull Request on GitHub, either because the contributor finds that easier than attaching a patch to JIRA or because a reviewer prefers that UI for examining changes, it's important to make note of the PR in the commit that goes to the master branch so that PRs are kept up to date."},"17449":{"id":"/docs/single-page-7649","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"To read more about the details of what kinds of commit messages will work with the GitHub \"close via keyword in commit\" mechanism see the GitHub documentation for \"Closing issues using keywords\". In summary, you should include a line with the phrase \"closes #XXX\", where the XXX is the pull request id. The pull request id is usually given in the GitHub UI in grey at the end of the subject heading."},"17450":{"id":"/docs/single-page-7650","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Committers are responsible for making sure commits do not break the build or tests**"},"17451":{"id":"/docs/single-page-7651","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"If a committer commits a patch, it is their responsibility to make sure it passes the test suite.\nIt is helpful if contributors keep an eye out that their patch does not break the hbase build and/or tests, but ultimately, a contributor cannot be expected to be aware of all the particular vagaries and interconnections that occur in a project like HBase.\nA committer should."},"17452":{"id":"/docs/single-page-7652","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Patching Etiquette**"},"17453":{"id":"/docs/single-page-7653","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"In the thread HBase, mail # dev - ANNOUNCEMENT: Git Migration In Progress (WAS =>\nRe: Git Migration), it was agreed on the following patch flow"},"17454":{"id":"/docs/single-page-7654","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Develop and commit the patch against master first."},"17455":{"id":"/docs/single-page-7655","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Try to cherry-pick the patch when backporting if possible."},"17456":{"id":"/docs/single-page-7656","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"If this does not work, manually commit the patch to the branch."},"17457":{"id":"/docs/single-page-7657","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Merge Commits**"},"17458":{"id":"/docs/single-page-7658","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Avoid merge commits, as they create problems in the git history."},"17459":{"id":"/docs/single-page-7659","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**Committing Documentation**"},"17460":{"id":"/docs/single-page-7660","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"See appendix contributing to documentation."},"17461":{"id":"/docs/single-page-7661","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"**How to re-trigger github Pull Request checks/re-build**"},"17462":{"id":"/docs/single-page-7662","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"A Pull Request (PR) submission triggers the hbase yetus checks. The checks make\nsure the patch doesn't break the build or introduce test failures. The checks take\naround four hours to run (They are the same set run when you submit a patch via\nHBASE JIRA). When finished, they add a report to the PR as a comment. If a problem\nw/ the patch — failed compile, checkstyle violation, or an added findbugs --\nthe original author makes fixes and pushes a new patch. This re-runs the checks\nto produce a new report."},"17463":{"id":"/docs/single-page-7663","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#commit","content":"Sometimes though, the patch is good but a flakey, unrelated test has the report vote -1\non the patch. In this case, **committers** can retrigger the check run by doing a force push of the\nexact same patch. Or, click on the `Console output` link which shows toward the end\nof the report (For example `https://builds.apache.org/job/HBase-PreCommit-GitHub-PR/job/PR-289/1/console`).\nThis will take you to `builds.apache.org`, to the build run that failed. See the\n\"breadcrumbs\" along the top (where breadcrumbs is the listing of the directories that\ngets us to this particular build page). It'll look something like\n`Jenkins > HBase-PreCommit-GitHub-PR > PR-289 > #1`. Click on the\nPR number — i.e. PR-289 in our example — and then, when you've arrived at the PR page,\nfind the 'Build with Parameters' menu-item (along top left-hand menu). Click here and\nthen `Build` leaving the JIRA\\_ISSUE\\_KEY empty. This will re-run your checks."},"17464":{"id":"/docs/single-page-7664","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#dialog","content":"Committers should hang out in the #hbase room on irc.freenode.net for real-time discussions.\nHowever any substantive discussion (as with any off-list project-related discussion) should be re-iterated in Jira or on the developer list."},"17465":{"id":"/docs/single-page-7665","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#do-not-edit-jira-comments","content":"Misspellings and/or bad grammar is preferable to the disruption a JIRA comment edit."},"17466":{"id":"/docs/single-page-7666","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"A new project was created for the release of hbase-2.0.0. It was called\n`hbase-thirdparty`. This project exists only to provide the main hbase\nproject with relocated — or shaded — versions of popular thirdparty\nlibraries such as guava, netty, and protobuf. The mainline HBase project\nrelies on the relocated versions of these libraries gotten from hbase-thirdparty\nrather than on finding these classes in their usual locations. We do this so\nwe can specify whatever the version we wish. If we don't relocate, we must\nharmonize our version to match that which hadoop, spark, and other projects use."},"17467":{"id":"/docs/single-page-7667","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"For developers, this means you need to be careful referring to classes from\nnetty, guava, protobuf, gson, etc. (see the hbase-thirdparty pom.xml for what\nit provides). Devs must refer to the hbase-thirdparty provided classes. In\npractice, this is usually not an issue (though it can be a bit of a pain). You\nwill have to hunt for the relocated version of your particular class. You'll\nfind it by prepending the general relocation prefix of `org.apache.hbase.thirdparty.`.\nFor example if you are looking for `com.google.protobuf.Message`, the relocated\nversion used by HBase internals can be found at\n`org.apache.hbase.thirdparty.com.google.protobuf.Message`."},"17468":{"id":"/docs/single-page-7668","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"For a few thirdparty libs, like protobuf (see the protobuf chapter in this book\nfor the why), your IDE may give you both options — the `com.google.protobuf.*`\nand the `org.apache.hbase.thirdparty.com.google.protobuf.*` — because both\nclasses are on your CLASSPATH. Unless you are doing the particular juggling\nrequired in Coprocessor Endpoint development (again see above cited protobuf\nchapter), you'll want to use the shaded version, always."},"17469":{"id":"/docs/single-page-7669","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"The `hbase-thirdparty` project has groupid of `org.apache.hbase.thirdparty`.\nAs of this writing, it provides three jars; one for netty with an artifactid of\n`hbase-thirdparty-netty`, one for protobuf at `hbase-thirdparty-protobuf` and then\na jar for all else — gson, guava — at `hbase-thirdpaty-miscellaneous`."},"17470":{"id":"/docs/single-page-7670","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"The hbase-thirdparty artifacts are a product produced by the Apache HBase\nproject under the aegis of the HBase Project Management Committee. Releases\nare done via the usual voting project on the hbase dev mailing list. If issue\nin the hbase-thirdparty, use the hbase JIRA and mailing lists to post notice."},"17471":{"id":"/docs/single-page-7671","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#development-of-hbase-related-maven-archetypes","content":"The development of HBase-related Maven archetypes was begun with\nHBASE-14876.\nFor an overview of the hbase-archetypes infrastructure and instructions\nfor developing new HBase-related Maven archetypes, please see\n`hbase/hbase-archetypes/README.md`."},"17472":{"id":"/docs/single-page-7672","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unit-testing","content":"Much of the information comes from a community blog post about testing HBase applications.\nFor information on unit tests for HBase itself, see hbase.tests."},"17473":{"id":"/docs/single-page-7673","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#unit-testing","content":"Starting from HBase 2.5.0, HBaseTestingUtility is deprecated and should only be used when writing UTs inside HBase.\nEnd users should use org.apache.hadoop.hbase.testing.TestingHBaseCluster instead."},"17474":{"id":"/docs/single-page-7674","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#junit","content":"HBase uses JUnit for unit tests"},"17475":{"id":"/docs/single-page-7675","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#junit","content":"This example will add unit tests to the following example class:"},"17476":{"id":"/docs/single-page-7676","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#junit","content":"The first step is to add JUnit dependencies to your Maven POM file:"},"17477":{"id":"/docs/single-page-7677","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#junit","content":"Use Maven Surefire 3.0.0 or later when possible, because it automatically aligns the\nJUnit Platform Launcher with the JUnit version on the test runtime classpath. If you use\na version older than 3.0.0-M4, add a test dependency on the matching\n`junit-platform-launcher`; otherwise test discovery may report `Tests run: 0`."},"17478":{"id":"/docs/single-page-7678","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#junit","content":"Next, add some unit tests to your code.\nTests are annotated with `@Test`.\nHere, the unit tests are in bold."},"17479":{"id":"/docs/single-page-7679","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#junit","content":"These tests ensure that your `createPut` method creates, populates, and returns a `Put` object with expected values.\nOf course, JUnit can do much more than this.\nFor an introduction to JUnit, see https\\://docs.junit.org/5.13.4/user-guide/."},"17480":{"id":"/docs/single-page-7680","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mockito","content":"Mockito is a mocking framework.\nIt goes further than JUnit by allowing you to test the interactions between objects without having to replicate the entire environment.\nYou can read more about Mockito at its project site, https\\://code.google.com/p/mockito/."},"17481":{"id":"/docs/single-page-7681","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mockito","content":"You can use Mockito to do unit testing on smaller units.\nFor instance, you can mock a `org.apache.hadoop.hbase.Server` instance or a `org.apache.hadoop.hbase.master.MasterServices` interface reference rather than a full-blown `org.apache.hadoop.hbase.master.HMaster`."},"17482":{"id":"/docs/single-page-7682","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mockito","content":"This example builds upon the example code in unit.tests, to test the `insertRecord` method."},"17483":{"id":"/docs/single-page-7683","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mockito","content":"First, add the Mockito dependencies to your Maven POM file. `@ExtendWith(MockitoExtension.class)`\nlives in `mockito-junit-jupiter`, so add that alongside `mockito-core`."},"17484":{"id":"/docs/single-page-7684","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mockito","content":"Next, add an `@ExtendWith` annotation to your test class, to direct it to use Mockito."},"17485":{"id":"/docs/single-page-7685","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mockito","content":"This code populates `HBaseTestObj` with \"ROWKEY-1\", \"DATA-1\", \"DATA-2\" as values.\nIt then inserts the record into the mocked table.\nThe Put that the DAO would have inserted is captured, and values are tested to verify that they are what you expected them to be."},"17486":{"id":"/docs/single-page-7686","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mockito","content":"The key here is to manage Connection and Table instance creation outside the DAO.\nThis allows you to mock them cleanly and test Puts as shown above.\nSimilarly, you can now expand into other operations such as Get, Scan, or Delete."},"17487":{"id":"/docs/single-page-7687","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mrunit","content":"Apache MRUnit is a library that allows you to unit-test MapReduce jobs.\nYou can use it to test HBase jobs in the same way as other MapReduce jobs."},"17488":{"id":"/docs/single-page-7688","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mrunit","content":"Given a MapReduce job that writes to an HBase table called `MyTest`, which has one column family called `CF`, the reducer of such a job could look like the following:"},"17489":{"id":"/docs/single-page-7689","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mrunit","content":"To test this code, the first step is to add a dependency to MRUnit to your Maven POM file."},"17490":{"id":"/docs/single-page-7690","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mrunit","content":"Next, use the ReducerDriver provided by MRUnit, in your Reducer job."},"17491":{"id":"/docs/single-page-7691","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mrunit","content":"Your MRUnit test verifies that the output is as expected, the Put that is inserted into HBase has the correct value, and the ColumnFamily and ColumnQualifier have the correct values."},"17492":{"id":"/docs/single-page-7692","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#mrunit","content":"MRUnit includes a MapperDriver to test mapping jobs, and you can use MRUnit to test other operations, including reading from HBase, processing data, or writing to HDFS,"},"17493":{"id":"/docs/single-page-7693","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integration-testing-with-an-hbase-mini-cluster","content":"HBase ships with HBaseTestingUtility, which makes it easy to write integration tests using a *mini-cluster*.\nThe first step is to add some dependencies to your Maven POM file.\nCheck the versions to be sure they are appropriate."},"17494":{"id":"/docs/single-page-7694","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integration-testing-with-an-hbase-mini-cluster","content":"This code represents an integration test for the MyDAO insert shown in unit.tests."},"17495":{"id":"/docs/single-page-7695","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integration-testing-with-an-hbase-mini-cluster","content":"Starting from HBase 2.5.0, it is recommended to use TestingHBaseCluster instead."},"17496":{"id":"/docs/single-page-7696","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integration-testing-with-an-hbase-mini-cluster","content":"This code creates an HBase mini-cluster and starts it.\nNext, it creates a table called `MyTest` with one column family, `CF`.\nA record is inserted, a Get is performed from the same table, and the insertion is verified."},"17497":{"id":"/docs/single-page-7697","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integration-testing-with-an-hbase-mini-cluster","content":"Starting the mini-cluster takes about 20-30 seconds, but that should be appropriate for\nintegration testing."},"17498":{"id":"/docs/single-page-7698","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#integration-testing-with-an-hbase-mini-cluster","content":"See the paper at HBase Case-Study: Using HBaseTestingUtility for Local Testing and Development (2010) for more information about HBaseTestingUtility."},"17499":{"id":"/docs/single-page-7699","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-overview","content":"HBase uses Google's protobufs wherever\nit persists metadata — in the tail of hfiles or Cells written by\nHBase into the system hbase:meta table or when HBase writes znodes\nto zookeeper, etc. — and when it passes objects over the wire making\nRPCs. HBase uses protobufs to describe the RPC\nInterfaces (Services) we expose to clients, for example the `Admin` and `Client`\nInterfaces that the RegionServer fields,\nor specifying the arbitrary extensions added by developers via our\nCoprocessor Endpoint mechanism."},"17500":{"id":"/docs/single-page-7700","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-overview","content":"With protobuf, you describe serializations and services in a `.protos` file.\nYou then feed these descriptors to a protobuf tool, the `protoc` binary,\nto generate classes that can marshall and unmarshall the described serializations\nand field the specified Services."},"17501":{"id":"/docs/single-page-7701","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-overview","content":"See the `README.txt` in the HBase sub-modules for details on how\nto run the class generation on a per-module basis;\ne.g. see `hbase-protocol/README.txt` for how to generate protobuf classes\nin the hbase-protocol module."},"17502":{"id":"/docs/single-page-7702","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-overview","content":"In HBase, `.proto` files are either in the `hbase-protocol` module; a module\ndedicated to hosting the common proto files and the protoc generated classes\nthat HBase uses internally serializing metadata. For extensions to hbase\nsuch as REST or Coprocessor Endpoints that need their own descriptors; their\nprotos are located inside the function's hosting module: e.g. `hbase-rest`\nis home to the REST proto files and the `hbase-rsgroup` table grouping\nCoprocessor Endpoint has all protos that have to do with table grouping."},"17503":{"id":"/docs/single-page-7703","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-overview","content":"Protos are hosted by the module that makes use of them. While\nthis makes it so generation of protobuf classes is distributed, done\nper module, we do it this way so modules encapsulate all to do with\nthe functionality they bring to hbase."},"17504":{"id":"/docs/single-page-7704","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-overview","content":"Extensions whether REST or Coprocessor Endpoints will make use\nof core HBase protos found back in the hbase-protocol module. They'll\nuse these core protos when they want to serialize a Cell or a Put or\nrefer to a particular node via ServerName, etc., as part of providing the\nCPEP Service. Going forward, after the release of hbase-2.0.0, this\npractice needs to whither. We'll explain why in the later\nhbase-2.0.0 section."},"17505":{"id":"/docs/single-page-7705","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"As of hbase-2.0.0, our protobuf usage gets a little more involved. HBase\ncore protobuf references are offset so as to refer to a private,\nbundled protobuf. Core stops referring to protobuf\nclasses at com.google.protobuf.\\_ and instead references protobuf at\nthe HBase-specific offset\norg.apache.hadoop.hbase.shaded.com.google.protobuf.\\_. We do this indirection\nso hbase core can evolve its protobuf version independent of whatever our\ndependencies rely on. For instance, HDFS serializes using protobuf.\nHDFS is on our CLASSPATH. Without the above described indirection, our\nprotobuf versions would have to align. HBase would be stuck\non the HDFS protobuf version until HDFS decided to upgrade. HBase\nand HDFS versions would be tied."},"17506":{"id":"/docs/single-page-7706","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"We had to move on from protobuf-2.5.0 because we need facilities\nadded in protobuf-3.1.0; in particular being able to save on\ncopies and avoiding bringing protobufs onheap for\nserialization/deserialization."},"17507":{"id":"/docs/single-page-7707","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"In hbase-2.0.0, we introduced a new module, `hbase-protocol-shaded`\ninside which we contained all to do with protobuf and its subsequent\nrelocation/shading. This module is in essence a copy of much of the old\n`hbase-protocol` but with an extra shading/relocation step.\nCore was moved to depend on this new module."},"17508":{"id":"/docs/single-page-7708","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"That said, a complication arises around Coprocessor Endpoints (CPEPs).\nCPEPs depend on public HBase APIs that reference protobuf classes at\n`com.google.protobuf.*` explicitly. For example, in our Table Interface\nwe have the below as the means by which you obtain a CPEP Service\nto make invocations against:"},"17509":{"id":"/docs/single-page-7709","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"Existing CPEPs will have made reference to core HBase protobufs\nspecifying ServerNames or carrying Mutations.\nSo as to continue being able to service CPEPs and their references\nto `com.google.protobuf.*` across the upgrade to hbase-2.0.0 and beyond,\nHBase needs to be able to deal with both\n`com.google.protobuf.*` references and its internal offset\n`org.apache.hadoop.hbase.shaded.com.google.protobuf.*` protobufs."},"17510":{"id":"/docs/single-page-7710","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"The `hbase-protocol-shaded` module hosts all\nprotobufs used by HBase core."},"17511":{"id":"/docs/single-page-7711","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"But for the vestigial CPEP references to the (non-shaded) content of\n`hbase-protocol`, we keep around most of this module going forward\njust so it is available to CPEPs. Retaining the most of `hbase-protocol`\nmakes for overlapping, 'duplicated' proto instances where some exist as\nnon-shaded/non-relocated here in their old module\nlocation but also in the new location, shaded under\n`hbase-protocol-shaded`. In other words, there is an instance\nof the generated protobuf class\n`org.apache.hadoop.hbase.protobuf.generated.ServerName`\nin hbase-protocol and another generated instance that is the same in all\nregards except its protobuf references are to the internal shaded\nversion at `org.apache.hadoop.hbase.shaded.protobuf.generated.ServerName`\n(note the 'shaded' addition in the middle of the package name)."},"17512":{"id":"/docs/single-page-7712","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"If you extend a proto in `hbase-protocol-shaded` for internal use,\nconsider extending it also in\n`hbase-protocol` (and regenerating)."},"17513":{"id":"/docs/single-page-7713","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-200-and-the-shading-of-protobufs-hbase-15638","content":"Going forward, we will provide a new module of common types for use\nby CPEPs that will have the same guarantees against change as does our\npublic API. TODO."},"17514":{"id":"/docs/single-page-7714","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-changes-for-hbase-300-hbase-23797","content":"Since hadoop(start from 3.3.x) also shades protobuf and bumps the version to\n3.x, there is no reason for us to stay on protobuf 2.5.0 any more."},"17515":{"id":"/docs/single-page-7715","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-changes-for-hbase-300-hbase-23797","content":"In HBase 3.0.0, the hbase-protocol module has been purged, the CPEP\nimplementation should use the protos in hbase-protocol-shaded module, and also\nmake use of the shaded protobuf in hbase-thirdparty. In general, we will keep\nthe protobuf version compatible for a whole major release, unless there are\ncritical problems, for example, a critical CVE on protobuf."},"17516":{"id":"/docs/single-page-7716","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-changes-for-hbase-300-hbase-23797","content":"Add this dependency to your pom:"},"17517":{"id":"/docs/single-page-7717","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-changes-for-hbase-300-hbase-23797","content":"And typically you also need to add this plugin to your pom to make your\ngenerated protobuf code also use the shaded and relocated protobuf version\nin hbase-thirdparty."},"17518":{"id":"/docs/single-page-7718","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#protobuf-changes-for-hbase-300-hbase-23797","content":"In hbase-examples module, we have some examples under the\n`org.apache.hadoop.hbase.coprocessor.example` package. You can see\n`BulkDeleteEndpoint` and `BulkDelete.proto` for more details, and you can also\ncheck the `pom.xml` of hbase-examples module to see how to make use of the above\nplugin."},"17519":{"id":"/docs/single-page-7719","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2","content":"See HBASE-12439 for the original implementation."},"17520":{"id":"/docs/single-page-7720","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2","content":"With Pv2 you can build and run state machines. It was built by Matteo to make distributed state transitions in HBase resilient in the face of process failures. Previous to Pv2, state transition handling was spread about the codebase with implementation varying by transition-type and context. Pv2 was inspired by FATE, of Apache Accumulo."},"17521":{"id":"/docs/single-page-7721","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2","content":"Early Pv2 aspects have been shipping in HBase with a good while now but it has continued to evolve as it takes on more involved scenarios. What we have now is powerful but intricate in operation and incomplete, in need of cleanup and hardening. In this doc we have given overview on the system so you can make use of it (and help with its polishing)."},"17522":{"id":"/docs/single-page-7722","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2","content":"This system has the awkward name of Pv2 because HBase already had the notion of a Procedure used in snapshots (see hbase-server *org.apache.hadoop.hbase.procedure* as opposed to hbase-procedure *org.apache.hadoop.hbase.procedure2*). Pv2 supercedes and is to replace Procedure."},"17523":{"id":"/docs/single-page-7723","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"A Procedure is a transform made on an HBase entity. Examples of HBase entities would be Regions and Tables.\nProcedures are run by a ProcedureExecutor instance. Procedure current state is kept in the ProcedureStore.\nThe ProcedureExecutor has but a primitive view on what goes on inside a Procedure. From its PoV, Procedures are submitted and then the ProcedureExecutor keeps calling &#x2A;#execute(Object)* until the Procedure is done. Execute may be called multiple times in the case of failure or restart, so Procedure code must be idempotent yielding the same result each time it run. Procedure code can also implement *rollback* so steps can be undone if failure. A call to &#x2A;execute()* can result in one of following possibilities:"},"17524":{"id":"/docs/single-page-7724","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*execute()* returns"},"17525":{"id":"/docs/single-page-7725","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*null*: indicates we are done."},"17526":{"id":"/docs/single-page-7726","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*this*: indicates there is more to do so, persist current procedure state and re-&#x2A;execute()*."},"17527":{"id":"/docs/single-page-7727","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*Array* of sub-procedures: indicates a set of procedures needed to be run to completion before we can proceed (after which we expect the framework to call our execute again)."},"17528":{"id":"/docs/single-page-7728","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*execute()* throws exception"},"17529":{"id":"/docs/single-page-7729","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*suspend*: indicates execution of procedure is suspended and can be resumed due to some external event. The procedure state is persisted."},"17530":{"id":"/docs/single-page-7730","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*yield*: procedure is added back to scheduler. The procedure state is not persisted."},"17531":{"id":"/docs/single-page-7731","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"*interrupted*: currently same as *yield*."},"17532":{"id":"/docs/single-page-7732","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"Any *exception* not listed above: Procedure *state* is changed to *FAILED* (after which we expect the framework will attempt rollback)."},"17533":{"id":"/docs/single-page-7733","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"The ProcedureExecutor stamps the frameworks notions of Procedure State into the Procedure itself; e.g. it marks Procedures as INITIALIZING on submit. It moves the state to RUNNABLE when it goes to execute. When done, a Procedure gets marked FAILED or SUCCESS depending. Here is the list of all states as of this writing:"},"17534":{"id":"/docs/single-page-7734","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"***INITIALIZING*** Procedure in construction, not yet added to the executor"},"17535":{"id":"/docs/single-page-7735","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"***RUNNABLE*** Procedure added to the executor, and ready to be executed."},"17536":{"id":"/docs/single-page-7736","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"***WAITING*** The procedure is waiting on children (subprocedures) to be completed"},"17537":{"id":"/docs/single-page-7737","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"***WAITING\\_TIMEOUT*** The procedure is waiting a timeout or an external event"},"17538":{"id":"/docs/single-page-7738","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"***ROLLEDBACK*** The procedure failed and was rolledback."},"17539":{"id":"/docs/single-page-7739","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"***SUCCESS*** The procedure execution completed successfully."},"17540":{"id":"/docs/single-page-7740","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"***FAILED*** The procedure execution failed, may need to rollback."},"17541":{"id":"/docs/single-page-7741","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedures","content":"After each execute, the Procedure state is persisted to the ProcedureStore. Hooks are invoked on Procedures so they can preserve custom state. Post-fault, the ProcedureExecutor re-hydrates its pre-crash state by replaying the content of the ProcedureStore. This makes the Procedure Framework resilient against process failure."},"17542":{"id":"/docs/single-page-7742","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#implementation","content":"In implementation, Procedures tend to divide transforms into finer-grained tasks and while some of these work items are handed off to sub-procedures,\nthe bulk are done as processing *steps* in-Procedure; each invocation of the execute is used to perform a single step, and then the Procedure relinquishes returning to the framework. The Procedure does its own tracking of where it is in the processing."},"17543":{"id":"/docs/single-page-7743","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#implementation","content":"What comprises a sub-task, or *step* in the execution is up to the Procedure author but generally it is a small piece of work that cannot be further decomposed and that moves the processing forward toward its end state. Having procedures made of many small steps rather than a few large ones allows the Procedure framework give out insight on where we are in the processing. It also allows the framework be more fair in its execution. As stated per above, each step may be called multiple times (failure/restart) so steps must be implemented idempotent.\nIt is easy to confuse the state that the Procedure itself is keeping with that of the Framework itself. Try to keep them distinct."},"17544":{"id":"/docs/single-page-7744","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-rollback","content":"Rollback is called when the procedure or one of the sub-procedures has failed. The rollback step is supposed to cleanup the resources created during the execute() step. In case of failure and restart, rollback() may be called multiple times, so again the code must be idempotent."},"17545":{"id":"/docs/single-page-7745","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"There are hooks for collecting metrics on submit of the procedure and on finish."},"17546":{"id":"/docs/single-page-7746","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"updateMetricsOnSubmit()"},"17547":{"id":"/docs/single-page-7747","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"updateMetricsOnFinish()"},"17548":{"id":"/docs/single-page-7748","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"Individual procedures can override these methods to collect procedure specific metrics. The default implementations of these methods try to get an object implementing an interface ProcedureMetrics which encapsulates following set of generic metrics:"},"17549":{"id":"/docs/single-page-7749","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"SubmittedCount (Counter): Total number of procedure instances submitted of a type."},"17550":{"id":"/docs/single-page-7750","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"Time (Histogram): Histogram of runtime for procedure instances."},"17551":{"id":"/docs/single-page-7751","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"FailedCount (Counter): Total number of failed procedure instances."},"17552":{"id":"/docs/single-page-7752","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#pv2-procedures-metrics","content":"Individual procedures can implement this object and define these generic set of metrics."},"17553":{"id":"/docs/single-page-7753","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#baggage","content":"Procedures can carry baggage. One example is the *step* the procedure last attained (see previous section); procedures persist the enum that marks where they are currently. Other examples might be the Region or Server name the Procedure is currently working. After each call to execute, the Procedure#serializeStateData is called. Procedures can persist whatever."},"17554":{"id":"/docs/single-page-7754","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#resultstate-and-queries","content":"(From Matteo's ProcedureV2 and Notification Bus doc)\\\nIn the case of asynchronous operations, the result must be kept around until the client asks for it. Once we receive a \"get\" of the result we can schedule the delete of the record. For some operations the result may be \"unnecessary\" especially in case of failure (e.g. if the create table fail, we can query the operation result or we can just do a list table to see if it was created) so in some cases we can schedule the delete after a timeout. On the client side the operation will return a \"Procedure ID\", this ID can be used to wait until the procedure is completed and get the result/exception."},"17555":{"id":"/docs/single-page-7755","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#resultstate-and-queries","content":"If the master goes down while performing the operation the backup master will pickup the half in­progress operation and complete it. The client will not notice the failure."},"17556":{"id":"/docs/single-page-7756","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#subprocedures","content":"Subprocedures are *Procedure&#x2A; instances created and returned by &#x2A;#execute(Object)* method of a procedure instance (parent procedure). As subprocedures are of type *Procedure*, they can instantiate their own subprocedures. As its a recursive, procedure stack is maintained by the framework. The framework makes sure that the parent procedure does not proceed till all sub-procedures and their subprocedures in a procedure stack are successfully finished."},"17557":{"id":"/docs/single-page-7757","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedureexecutor","content":"*ProcedureExecutor* uses *ProcedureStore* and *ProcedureScheduler* and executes procedures submitted to it. Some of the basic operations supported are:"},"17558":{"id":"/docs/single-page-7758","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedureexecutor","content":"*abort(procId)*: aborts specified procedure if its not finished"},"17559":{"id":"/docs/single-page-7759","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedureexecutor","content":"*submit(Procedure)*: submits procedure for execution"},"17560":{"id":"/docs/single-page-7760","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedureexecutor","content":"*retrieve:* list of get methods to get *Procedure* instances and results"},"17561":{"id":"/docs/single-page-7761","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedureexecutor","content":"*register/ unregister* listeners: for listening on Procedure related notifications"},"17562":{"id":"/docs/single-page-7762","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#procedureexecutor","content":"When *ProcedureExecutor* starts it loads procedure instances persisted in *ProcedureStore* from previous run. All unfinished procedures are resumed from the last stored state."},"17563":{"id":"/docs/single-page-7763","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#nonces","content":"You can pass the nonce that came in with the RPC to the Procedure on submit at the executor. This nonce will then be serialized along w/ the Procedure on persist. If a crash, on reload, the nonce will be put back into a map of nonces to pid in case a client tries to run same procedure for a second time (it will be rejected). See the base Procedure and how nonce is a base data member."},"17564":{"id":"/docs/single-page-7764","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#waitwakesuspendyield","content":"'suspend' means stop processing a procedure because we can make no more progress until a condition changes; i.e. we sent RPC and need to wait on response. The way this works is that a Procedure throws a suspend exception from down in its guts as a GOTO the end-of-the-current-processing step. Suspend also puts the Procedure back on the scheduler. Problematic is we do some accounting on our way out even on suspend making it so it can take time exiting (We have to update state in the WAL)."},"17565":{"id":"/docs/single-page-7765","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#waitwakesuspendyield","content":"RegionTransitionProcedure#reportTransition is called on receipt of a report from a RS. For Assign and Unassign, this event response from the server we sent an RPC wakes up suspended Assign/Unassigns."},"17566":{"id":"/docs/single-page-7766","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#locking","content":"Procedure Locks are not about concurrency! They are about giving a Procedure read/write access to an HBase Entity such as a Table or Region so that is possible to shut out other Procedures from making modifications to an HBase Entity state while the current one is running."},"17567":{"id":"/docs/single-page-7767","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#locking","content":"Locking is optional, up to the Procedure implementor but if an entity is being operated on by a Procedure, all transforms need to be done via Procedures using the same locking scheme else havoc."},"17568":{"id":"/docs/single-page-7768","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#locking","content":"Two ProcedureExecutor Worker threads can actually end up both processing the same Procedure instance. If it happens, the threads are meant to be running different parts of the one Procedure — changes that do not stamp on each other (This gets awkward around the procedure frameworks notion of ‘suspend'. More on this below)."},"17569":{"id":"/docs/single-page-7769","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#locking","content":"Locks optionally may be held for the life of a Procedure. For example, if moving a Region, you probably want to have exclusive access to the HBase Region until the Region completes (or fails). This is used in conjunction with \\{@link #holdLock(Object)}. If \\{@link #holdLock(Object)} returns true, the procedure executor will call acquireLock() once and thereafter not call \\{@link #releaseLock(Object)} until the Procedure is done (Normally, it calls release/acquire around each invocation of \\{@link #execute(Object)}."},"17570":{"id":"/docs/single-page-7770","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#locking","content":"Locks also may live the life of a procedure; i.e. once an Assign Procedure starts, we do not want another procedure meddling w/ the region under assignment. Procedures that hold the lock for the life of the procedure set Procedure#holdLock to true. AssignProcedure does this as do Split and Move (If in the middle of a Region move, you do not want it Splitting)."},"17571":{"id":"/docs/single-page-7771","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#locking","content":"Locking can be for life of Procedure."},"17572":{"id":"/docs/single-page-7772","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#locking","content":"Some locks have a hierarchy. For example, taking a region lock also takes (read) lock on its containing table and namespace to prevent another Procedure obtaining an exclusive lock on the hosting table (or namespace)."},"17573":{"id":"/docs/single-page-7773","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#statemachineprocedure","content":"One can consider each call to &#x2A;#execute(Object)* method as transitioning from one state to another in a state machine. Abstract class *StateMachineProcedure* is wrapper around base *Procedure* class which provides constructs for implementing a state machine as a *Procedure*. After each state transition current state is persisted so that, in case of crash/ restart, the state transition can be resumed from the previous state of a procedure before crash/ restart. Individual procedures need to define initial and terminus states and hooks &#x2A;executeFromState()* and &#x2A;setNextState()* are provided for state transitions."},"17574":{"id":"/docs/single-page-7774","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#remoteproceduredispatcher","content":"A new RemoteProcedureDispatcher (+ subclass RSProcedureDispatcher) primitive takes care of running the Procedure-based Assignments 'remote' component. This dispatcher knows about 'servers'. It does aggregation of assignments by time on a time/count basis so can send procedures in batches rather than one per RPC. Procedure status comes back on the back of the RegionServer heartbeat reporting online/offline regions (No more notifications via ZK). The response is passed to the AMv2 to 'process'. It will check against the in-memory state. If there is a mismatch, it fences out the RegionServer on the assumption that something went wrong on the RS side. Timeouts trigger retries (Not Yet Implemented!). The Procedure machine ensures only one operation at a time on any one Region/Table using entity *locking* and smarts about what is serial and what can be run concurrently (Locking was zk-based — you'd put a znode in zk for a table — but now has been converted to be procedure-based as part of this project)."},"17575":{"id":"/docs/single-page-7775","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#references","content":"Matteo had a slide deck on what it the Procedure Framework would look like and the problems it addresses initially attached to the Pv2 issue."},"17576":{"id":"/docs/single-page-7776","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#references","content":"A good doc by Matteo on problem and how Pv2 addresses it w/ roadmap (from the Pv2 JIRA). We should go back to the roadmap to do the Notification Bus, convertion of log splitting to Pv2, etc."},"17577":{"id":"/docs/single-page-7777","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2","content":"The AMv2 project is a redo of Assignment in an attempt at addressing the root cause of many of our operational issues in production, namely slow assignment and problematic accounting such that Regions are misplaced stuck offline in the notorious &#x2A;Regions-In-Transition (RIT)* limbo state."},"17578":{"id":"/docs/single-page-7778","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2","content":"Below are notes for devs on key aspects of AMv2 in no particular order."},"17579":{"id":"/docs/single-page-7779","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2-background","content":"Assignment in HBase 1.x has been problematic in operation. It is not hard to see why. Region state is kept at the other end of an RPC in ZooKeeper (Terminal states — i.e. OPEN or CLOSED — are published to the *hbase:meta* table). In HBase-1.x.x, state has multiple writers with Master and RegionServers all able to make state edits concurrently (in *hbase:meta* table and out on ZooKeeper). If clocks are awry or watchers missed, state changes can be skipped or overwritten. Locking of HBase Entities — tables, regions — is not comprehensive so a table operation — disable/enable — could clash with a region-level operation; a split or merge. Region state is distributed and hard to reason about and test. Assignment is slow in operation because each assign involves moving remote znodes through transitions. Cluster size tends to top out at a couple of hundred thousand regions; beyond this, cluster start/stop takes hours and is prone to corruption."},"17580":{"id":"/docs/single-page-7780","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2-background","content":"AMv2 (AssignmentManager Version 2) is a refactor (HBASE-14350) of the hbase-1.x AssignmentManager putting it up on a ProcedureV2 (HBASE-12439) basis. ProcedureV2 (Pv2), is an awkwardly named system that allows describing and running multi-step state machines. It is performant and persists all state to a Store which is recoverable post crash. See the companion chapter on Procedure Framework (Pv2), to learn more about the ProcedureV2 system."},"17581":{"id":"/docs/single-page-7781","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2-background","content":"In AMv2, all assignment, crash handling, splits and merges are recast as Procedures(v2). ZooKeeper is purged from the mix. As before, the final assignment state gets published to *hbase:meta* for non-Master participants to read (all-clients) with intermediate state kept in the local Pv2 WAL-based 'store' but only the active Master, a single-writer, evolves state. The Master's in-memory cluster image is the authority and if disagreement, RegionServers are forced to comply. Pv2 adds shared/exclusive locking of all core HBase Entities — namespace, tables, and regions — to ensure one actor at a time access and to prevent operations contending over resources (move/split, disable/assign, etc.)."},"17582":{"id":"/docs/single-page-7782","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2-background","content":"This redo of AM atop of a purposed, performant state machine with all operations taking on the common Procedure form with a single state writer only moves our AM to a new level of resilience and scale."},"17583":{"id":"/docs/single-page-7783","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-system","content":"Each Region Assign or Unassign of a Region is now a Procedure. A Move (Region) Procedure is a compound of Procedures; it is the running of an Unassign Procedure followed by an Assign Procedure. The Move Procedure spawns the Assign and Unassign in series and then waits on their completions."},"17584":{"id":"/docs/single-page-7784","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-system","content":"And so on. ServerCrashProcedure spawns the WAL splitting tasks and then the reassign of all regions that were hosted on the crashed server as subprocedures."},"17585":{"id":"/docs/single-page-7785","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-system","content":"AMv2 Procedures are run by the Master in a ProcedureExecutor instance. All Procedures make use of utility provided by the Pv2 framework."},"17586":{"id":"/docs/single-page-7786","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-system","content":"For example, Procedures persist each state transition to the frameworks' Procedure Store. The default implementation is done as a WAL kept on HDFS. On crash, we reopen the Store and rerun all WALs of Procedure transitions to put the Assignment State Machine back into the attitude it had just before crash. We then continue Procedure execution."},"17587":{"id":"/docs/single-page-7787","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-system","content":"In the new system, the Master is the Authority on all things Assign. Previous we were ambiguous; e.g. the RegionServer was in charge of Split operations. Master keeps an in-memory image of Region states and servers. If disagreement, the Master always prevails; at an extreme it will kill the RegionServer that is in disagreement."},"17588":{"id":"/docs/single-page-7788","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-system","content":"A new RegionStateStore class takes care of publishing the terminal Region state, whether OPEN or CLOSED, out to the *hbase:meta* table."},"17589":{"id":"/docs/single-page-7789","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-system","content":"RegionServers now report their run version on Connection. This version is available inside the AM for use running migrating rolling restarts."},"17590":{"id":"/docs/single-page-7790","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Assign and Unassign subclass a common RegionTransitionProcedure. There can only be one RegionTransitionProcedure per region running at a time since the RTP instance takes a lock on the region. The RTP base Procedure has three steps; a store the procedure step (REGION\\_TRANSITION\\_QUEUE); a dispatch of the procedure open or close followed by a suspend waiting on the remote regionserver to report successful open or fail (REGION\\_TRANSITION\\_DISPATCH) or notification that the server fielding the request crashed; and finally registration of the successful open/close in hbase:meta (REGION\\_TRANSITION\\_FINISH)."},"17591":{"id":"/docs/single-page-7791","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Here is how the assign of a region 56f985a727afe80a184dac75fbf6860c looks in the logs. The assign was provoked by a Server Crash (Process ID 1176 or pid=1176 which when it is the parent of a procedure, it is identified as ppid=1176). The assign is pid=1179, the second region of the two being assigned by this Server Crash."},"17592":{"id":"/docs/single-page-7792","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Next we start the assign by queuing ('registering') the Procedure with the framework."},"17593":{"id":"/docs/single-page-7793","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Track the running of Procedures in logs by tracing their process id — here pid=1179."},"17594":{"id":"/docs/single-page-7794","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Next we move to the dispatch phase where we update hbase:meta table setting the region state as OPENING on server ve540. We then dispatch an rpc to ve540 asking it to open the region. Thereafter we suspend the Assign until we get a message back from ve540 on whether it has opened the region successfully (or not)."},"17595":{"id":"/docs/single-page-7795","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Below we log the incoming report that the region opened successfully on ve540. The Procedure is woken up (you can tell it the procedure is running by the name of the thread, its a ProcedureExecutor thread, ProcExecWrkr-9). The woken up Procedure updates state in hbase:meta to denote the region as open on ve0540. It then reports finished and exits."},"17596":{"id":"/docs/single-page-7796","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Unassign looks similar given it is based on the base RegionTransitionProcedure. It has the same state transitions and does basically the same steps but with different state name (CLOSING, CLOSED)."},"17597":{"id":"/docs/single-page-7797","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#assignunassign","content":"Most other procedures are subclasses of a Pv2 StateMachine implementation. We have both Table and Region focused StateMachines types."},"17598":{"id":"/docs/single-page-7798","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2-ui","content":"Along the top-bar on the Master, you can now find a 'Procedures\\&Locks' tab which takes you to a page that is ugly but useful. It dumps currently running procedures and framework locks. Look at this when you can't figure what stuff is stuck; it will at least identify problematic procedures (take the pid and grep the logs...). Look for ROLLEDBACK or pids that have been RUNNING for a long time."},"17599":{"id":"/docs/single-page-7799","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#logging","content":"Procedures log their process ids as pid= and their parent ids (ppid=) everywhere. Work has been done so you can grep the pid and see history of a procedure operation."},"17600":{"id":"/docs/single-page-7800","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#implementation-notes","content":"In this section we note some idiosyncrasies of operation as an attempt at saving you some head-scratching."},"17601":{"id":"/docs/single-page-7801","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-transition-rpc-and-rs-heartbeat-can-arrive-at-same-time-on-master","content":"Reporting Region Transition on a RegionServer is now a RPC distinct from RS heartbeating ('RegionServerServices' Service). An heartbeat and a status update can arrive at the Master at about the same time. The Master will update its internal state for a Region but this same state is checked when heartbeat processing. We may find the unexpected; i.e. a Region just reported as CLOSED so heartbeat is surprised to find region OPEN on the back of the RS report. In the new system, all slaves must cow to the Masters' understanding of cluster state; the Master will kill/close any misaligned entities."},"17602":{"id":"/docs/single-page-7802","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#region-transition-rpc-and-rs-heartbeat-can-arrive-at-same-time-on-master","content":"To address the above, we added a lastUpdate for in-memory Master state. Let a region state have some vintage before we act on it (one second currently)."},"17603":{"id":"/docs/single-page-7803","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#master-as-regionserver-or-as-regionserver-that-just-does-system-tables","content":"AMv2 enforces current master branch default of HMaster carrying system tables only; i.e. the Master in an HBase cluster acts also as a RegionServer only it is the exclusive host for tables such as *hbase:meta*, *hbase:namespace*, etc., the core system tables. This is causing a couple of test failures as AMv1, though it is not supposed to, allows moving hbase:meta off Master while AMv2 does not."},"17604":{"id":"/docs/single-page-7804","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#new-configs","content":"These configs all need doc on when you'd change them."},"17605":{"id":"/docs/single-page-7805","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseprocedureremotedispatcherthreadpoolsize-toc","content":"Defaults 128"},"17606":{"id":"/docs/single-page-7806","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseprocedureremotedispatcherdelaymsec-toc","content":"Default 150ms"},"17607":{"id":"/docs/single-page-7807","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseprocedureremotedispatchermaxqueuesize-toc","content":"Default 32"},"17608":{"id":"/docs/single-page-7808","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbaseregionserverrpcstartupwaittime-toc","content":"Default 60 seconds."},"17609":{"id":"/docs/single-page-7809","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2-tools","content":"HBASE-15592 Print Procedure WAL Content"},"17610":{"id":"/docs/single-page-7810","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#amv2-tools","content":"Patch in HBASE-18152 \\[AMv2] Corrupt Procedure WAL file; procedure data stored out of order https\\://issues.apache.org/jira/secure/attachment/12871066/reading\\_bad\\_wal.patch"},"17611":{"id":"/docs/single-page-7811","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#masterprocedureschedulerperformanceevaluation","content":"Tool to test performance of locks and queues in procedure scheduler independently from other framework components. Run this after any substantial changes in proc system. Prints nice output:"},"17612":{"id":"/docs/single-page-7812","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"Apache HBase by default manages a ZooKeeper \"cluster\" for you.\nIt will start and stop the ZooKeeper ensemble as part of the HBase start/stop process.\nYou can also manage the ZooKeeper ensemble independent of HBase and just point HBase at the cluster it should use.\nTo toggle HBase management of ZooKeeper, use the `HBASE_MANAGES_ZK` variable in *conf/hbase-env.sh*.\nThis variable, which defaults to `true`, tells HBase whether to start/stop the ZooKeeper ensemble servers as part of HBase start/stop."},"17613":{"id":"/docs/single-page-7813","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"When HBase manages the ZooKeeper ensemble, you can specify ZooKeeper configuration directly in *conf/hbase-site.xml*.\nA ZooKeeper configuration option can be set as a property in the HBase *hbase-site.xml* XML configuration file by prefacing the ZooKeeper option name with `hbase.zookeeper.property`.\nFor example, the `clientPort` setting in ZooKeeper can be changed by setting the `hbase.zookeeper.property.clientPort` property.\nFor all default values used by HBase, including ZooKeeper configuration, see hbase default configurations.\nLook for the `hbase.zookeeper.property` prefix.\nFor the full list of ZooKeeper configurations, see ZooKeeper's *zoo.cfg*.\nHBase does not ship with a *zoo.cfg* so you will need to browse the *conf* directory in an appropriate ZooKeeper download."},"17614":{"id":"/docs/single-page-7814","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"You must at least list the ensemble servers in *hbase-site.xml* using the `hbase.zookeeper.quorum` property.\nThis property defaults to a single ensemble member at `localhost` which is not suitable for a fully distributed HBase.\n(It binds to the local machine only and remote clients will not be able to connect)."},"17615":{"id":"/docs/single-page-7815","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"You can run a ZooKeeper ensemble that comprises 1 node only but in production it is recommended that you run a ZooKeeper ensemble of 3, 5 or 7 machines; the more members an ensemble has, the more tolerant the ensemble is of host failures.\nAlso, run an odd number of machines.\nIn ZooKeeper, an even number of peers is supported, but it is normally not used because an even sized ensemble requires, proportionally, more peers to form a quorum than an odd sized ensemble requires.\nFor example, an ensemble with 4 peers requires 3 to form a quorum, while an ensemble with 5 also requires 3 to form a quorum.\nThus, an ensemble of 5 allows 2 peers to fail, and thus is more fault tolerant than the ensemble of 4, which allows only 1 down peer."},"17616":{"id":"/docs/single-page-7816","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"Give each ZooKeeper server around 1GB of RAM, and if possible, its own dedicated disk (A dedicated disk is the best thing you can do to ensure a performant ZooKeeper ensemble). For very heavily loaded clusters, run ZooKeeper servers on separate machines from RegionServers (DataNodes and TaskTrackers)."},"17617":{"id":"/docs/single-page-7817","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"For example, to have HBase manage a ZooKeeper quorum on nodes *rs\\{1,2,3,4,5}.example.com*, bound to port 2222 (the default is 2181) ensure `HBASE_MANAGE_ZK` is commented out or set to `true` in *conf/hbase-env.sh* and then edit *conf/hbase-site.xml* and set `hbase.zookeeper.property.clientPort` and `hbase.zookeeper.quorum`.\nYou should also set `hbase.zookeeper.property.dataDir&#x60; to other than the default as the default has ZooKeeper persist data under */tmp&#x2A; which is often cleared on system restart.\nIn the example below we have ZooKeeper persist to */user/local/zookeeper*."},"17618":{"id":"/docs/single-page-7818","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"The newer version, the better. ZooKeeper 3.4.x is required as of HBase 1.0.0"},"17619":{"id":"/docs/single-page-7819","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#zookeeper","content":"Be sure to set up the data dir cleaner described under ZooKeeper\nMaintenance else you\ncould have 'interesting' problems a couple of months in; i.e. zookeeper could start dropping\nsessions if it has to run through a directory of hundreds of thousands of logs which is wont to do\naround leader reelection time — a process rare but run on occasion whether because a machine is\ndropped or happens to hiccup."},"17620":{"id":"/docs/single-page-7820","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-existing-zookeeper-ensemble","content":"To point HBase at an existing ZooKeeper cluster, one that is not managed by HBase, set `HBASE_MANAGES_ZK` in *conf/hbase-env.sh* to false"},"17621":{"id":"/docs/single-page-7821","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-existing-zookeeper-ensemble","content":"Next set ensemble locations and client port, if non-standard, in *hbase-site.xml*."},"17622":{"id":"/docs/single-page-7822","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-existing-zookeeper-ensemble","content":"When HBase manages ZooKeeper, it will start/stop the ZooKeeper servers as a part of the regular start/stop scripts.\nIf you would like to run ZooKeeper yourself, independent of HBase start/stop, you would do the following"},"17623":{"id":"/docs/single-page-7823","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-existing-zookeeper-ensemble","content":"Note that you can use HBase in this manner to spin up a ZooKeeper cluster, unrelated to HBase.\nJust make sure to set `HBASE_MANAGES_ZK` to `false` if you want it to stay up across HBase restarts so that when HBase shuts down, it doesn't take ZooKeeper down with it."},"17624":{"id":"/docs/single-page-7824","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#using-existing-zookeeper-ensemble","content":"For more information about running a distinct ZooKeeper cluster, see the ZooKeeper Getting Started Guide.\nAdditionally, see the ZooKeeper Wiki or the ZooKeeper documentation for more information on ZooKeeper sizing."},"17625":{"id":"/docs/single-page-7825","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sasl-authentication-with-zookeeper","content":"Newer releases of Apache HBase (>= 0.92) will support connecting to a ZooKeeper Quorum that supports SASL authentication (which is available in ZooKeeper versions 3.4.0 or later)."},"17626":{"id":"/docs/single-page-7826","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#sasl-authentication-with-zookeeper","content":"This describes how to set up HBase to mutually authenticate with a ZooKeeper Quorum.\nZooKeeper/HBase mutual authentication (HBASE-2418) is required as part of a complete secure HBase configuration (HBASE-3025). For simplicity of explication, this section ignores additional configuration required (Secure HDFS and Coprocessor configuration). It's recommended to begin with an HBase-managed ZooKeeper configuration (as opposed to a standalone ZooKeeper quorum) for ease of learning."},"17627":{"id":"/docs/single-page-7827","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operating-system-prerequisites","content":"You need to have a working Kerberos KDC setup.\nFor each `$HOST` that will run a ZooKeeper server, you should have a principle `zookeeper/$HOST`.\nFor each such host, add a service key (using the `kadmin` or `kadmin.local` tool's `ktadd` command) for `zookeeper/$HOST` and copy this file to `$HOST`, and make it readable only to the user that will run zookeeper on `$HOST&#x60;.\nNote the location of this file, which we will use below as *\\$PATH\\_TO\\_ZOOKEEPER\\_KEYTAB*."},"17628":{"id":"/docs/single-page-7828","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operating-system-prerequisites","content":"Similarly, for each `$HOST` that will run an HBase server (master or regionserver), you should have a principle: `hbase/$HOST`.\nFor each host, add a keytab file called *hbase.keytab* containing a service key for `hbase/$HOST`, copy this file to `$HOST`, and make it readable only to the user that will run an HBase service on `$HOST&#x60;.\nNote the location of this file, which we will use below as *\\$PATH\\_TO\\_HBASE\\_KEYTAB*."},"17629":{"id":"/docs/single-page-7829","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operating-system-prerequisites","content":"Each user who will be an HBase client should also be given a Kerberos principal.\nThis principal should usually have a password assigned to it (as opposed to, as with the HBase servers, a keytab file) which only this user knows.\nThe client's principal's `maxrenewlife` should be set so that it can be renewed enough so that the user can complete their HBase client processes.\nFor example, if a user runs a long-running HBase client process that takes at most 3 days, we might create this user's principal within `kadmin` with: `addprinc -maxrenewlife 3days`.\nThe ZooKeeper client and server libraries manage their own ticket refreshment by running threads that wake up periodically to do the refreshment."},"17630":{"id":"/docs/single-page-7830","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operating-system-prerequisites","content":"On each host that will run an HBase client (e.g. `hbase shell`), add the following file to the HBase home directory's *conf* directory:"},"17631":{"id":"/docs/single-page-7831","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#operating-system-prerequisites","content":"We'll refer to this JAAS configuration file as *\\$CLIENT\\_CONF* below."},"17632":{"id":"/docs/single-page-7832","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"On each node that will run a zookeeper, a master, or a regionserver, create a JAAS configuration file in the conf directory of the node's *HBASE\\_HOME* directory that looks like the following:"},"17633":{"id":"/docs/single-page-7833","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"where the *\\$PATH\\_TO\\_HBASE\\_KEYTAB&#x2A; and *\\$PATH\\_TO\\_ZOOKEEPER\\_KEYTAB* files are what you created above, and `$HOST` is the hostname for that node."},"17634":{"id":"/docs/single-page-7834","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"The `Server` section will be used by the ZooKeeper quorum server, while the `Client&#x60; section will be used by the HBase master and regionservers.\nThe path to this file should be substituted for the text *\\$HBASE\\_SERVER\\_CONF* in the *hbase-env.sh* listing below."},"17635":{"id":"/docs/single-page-7835","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"The path to this file should be substituted for the text *\\$CLIENT\\_CONF* in the *hbase-env.sh* listing below."},"17636":{"id":"/docs/single-page-7836","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"Modify your *hbase-env.sh* to include the following:"},"17637":{"id":"/docs/single-page-7837","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"where *\\$HBASE\\_SERVER\\_CONF&#x2A; and *\\$CLIENT\\_CONF* are the full paths to the JAAS configuration files created above."},"17638":{"id":"/docs/single-page-7838","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"Modify your *hbase-site.xml* on each node that will run zookeeper, master or regionserver to contain:"},"17639":{"id":"/docs/single-page-7839","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"where `$ZK_NODES` is the comma-separated list of hostnames of the ZooKeeper Quorum hosts."},"17640":{"id":"/docs/single-page-7840","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#hbase-managed-zookeeper-configuration","content":"Start your hbase cluster by running one or more of the following set of commands on the appropriate hosts:"},"17641":{"id":"/docs/single-page-7841","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#external-zookeeper-configuration","content":"Add a JAAS configuration file that looks like:"},"17642":{"id":"/docs/single-page-7842","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#external-zookeeper-configuration","content":"where the *\\$PATH\\_TO\\_HBASE\\_KEYTAB* is the keytab created above for HBase services to run on this host, and `$HOST&#x60; is the hostname for that node.\nPut this in the HBase home's configuration directory.\nWe'll refer to this file's full pathname as *\\$HBASE\\_SERVER\\_CONF* below."},"17643":{"id":"/docs/single-page-7843","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#external-zookeeper-configuration","content":"Modify your hbase-env.sh to include the following:"},"17644":{"id":"/docs/single-page-7844","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#external-zookeeper-configuration","content":"Modify your *hbase-site.xml* on each node that will run a master or regionserver to contain:"},"17645":{"id":"/docs/single-page-7845","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#external-zookeeper-configuration","content":"where `$ZK_NODES` is the comma-separated list of hostnames of the ZooKeeper Quorum hosts."},"17646":{"id":"/docs/single-page-7846","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#external-zookeeper-configuration","content":"Also on each of these hosts, create a JAAS configuration file containing:"},"17647":{"id":"/docs/single-page-7847","page_id":"/docs/single-page","tags":["single-page"],"type":"text","url":"/docs/single-page#external-zookeeper-configuration","content":"where `$HOST&#x60; is the hostname of each Quorum host.\nWe will 