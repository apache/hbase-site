["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#units-of-measure-for-metrics","content":"Units of Measure for Metrics"},"6468":{"id":"/docs/operational-management/metrics-and-monitoring-8","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#most-important-master-metrics","content":"Most Important Master Metrics"},"6469":{"id":"/docs/operational-management/metrics-and-monitoring-9","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"Master switch states"},"6470":{"id":"/docs/operational-management/metrics-and-monitoring-10","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"Most Important RegionServer Metrics"},"6471":{"id":"/docs/operational-management/metrics-and-monitoring-11","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"Meta Table Load Metrics"},"6472":{"id":"/docs/operational-management/metrics-and-monitoring-12","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#hbase-monitoring","content":"HBase Monitoring"},"6473":{"id":"/docs/operational-management/metrics-and-monitoring-13","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#hbase-monitoring-overview","content":"Overview"},"6474":{"id":"/docs/operational-management/metrics-and-monitoring-14","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#hbase-toc","content":"HBase [!toc]"},"6475":{"id":"/docs/operational-management/metrics-and-monitoring-15","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#os-toc","content":"OS [!toc]"},"6476":{"id":"/docs/operational-management/metrics-and-monitoring-16","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#java-toc","content":"Java [!toc]"},"6477":{"id":"/docs/operational-management/metrics-and-monitoring-17","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#slow-query-log","content":"Slow Query Log"},"6478":{"id":"/docs/operational-management/metrics-and-monitoring-18","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#operational-management-metrics-and-monitoring-overview-configuration","content":"Configuration"},"6479":{"id":"/docs/operational-management/metrics-and-monitoring-19","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#operational-management-hbase-monitoring-slow-query-log-metrics","content":"Metrics"},"6480":{"id":"/docs/operational-management/metrics-and-monitoring-20","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#output","content":"Output"},"6481":{"id":"/docs/operational-management/metrics-and-monitoring-21","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#operational-management-hbase-monitoring-slow-query-log-example","content":"Example"},"6482":{"id":"/docs/operational-management/metrics-and-monitoring-22","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"Get Slow Response Log from shell"},"6483":{"id":"/docs/operational-management/metrics-and-monitoring-23","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"Get Slow/Large Response Logs from System table hbase:slowlog"},"6484":{"id":"/docs/operational-management/metrics-and-monitoring-24","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#block-cache-monitoring","content":"Block Cache Monitoring"},"6485":{"id":"/docs/operational-management/metrics-and-monitoring-25","page_id":"/docs/operational-management/metrics-and-monitoring","type":"heading","tags":["multi-page"],"url":"/docs/operational-management/metrics-and-monitoring#snapshot-space-usage-monitoring","content":"Snapshot Space Usage Monitoring"},"6486":{"id":"/docs/operational-management/metrics-and-monitoring-26","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#hbase-metrics","content":"HBase emits metrics which adhere to the Hadoop Metrics API. Starting with HBase 0.95 [^5], HBase is configured to emit a default set of metrics with a default sampling period of every 10 seconds. You can use HBase metrics in conjunction with Ganglia. You can also filter which metrics are emitted and extend the metrics framework to capture custom metrics appropriate for your environment."},"6487":{"id":"/docs/operational-management/metrics-and-monitoring-27","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#metric-setup","content":"For HBase 0.95 and newer, HBase ships with a default metrics configuration, or &#x2A;**sink***. This includes a wide variety of individual metrics, and emits them every 10 seconds by default. To configure metrics for a given region server, edit the *conf/hadoop-metrics2-hbase.properties* file. Restart the region server for the changes to take effect."},"6488":{"id":"/docs/operational-management/metrics-and-monitoring-28","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#metric-setup","content":"To change the sampling rate for the default sink, edit the line beginning with `*.period`. To filter which metrics are emitted or to extend the metrics framework, see https\\://hadoop.apache.org/docs/current/api/org/apache/hadoop/metrics2/package-summary.html"},"6489":{"id":"/docs/operational-management/metrics-and-monitoring-29","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#metric-setup","content":"By default, HBase emits a large number of metrics per region server. Ganglia may have difficulty\nprocessing all these metrics. Consider increasing the capacity of the Ganglia server or reducing\nthe number of metrics emitted by HBase. See Metrics\nFiltering."},"6490":{"id":"/docs/operational-management/metrics-and-monitoring-30","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#disabling-metrics","content":"To disable metrics for a region server, edit the *conf/hadoop-metrics2-hbase.properties* file and comment out any uncommented lines. Restart the region server for the changes to take effect."},"6491":{"id":"/docs/operational-management/metrics-and-monitoring-31","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#enabling-metrics-servlets","content":"HBase exposes the metrics in many formats such as JSON, prometheus-format through different servlets (`/jmx`, `/metrics`, `/prometheus`). Any of these servlets can be enabled or disabled by the configuration property `hbase.http.metrics.servlets`. The value for the property should be a comma separated list of the servlet aliases which are `{jmx, metrics, prometheus}`. `/jmx`, `/metrics`, `/prometheus` are enabled by default. To get metrics using these servlets access the URL `http://SERVER_HOSTNAME:SERVER_WEB_UI_PORT/endpoint`. Where endpoint is one of `/jmx`, `/metrics`, or `/prometheus`. Eg. `http://my.rs.xyz.com:16030/prometheus`"},"6492":{"id":"/docs/operational-management/metrics-and-monitoring-32","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#prometheus-servlets","content":"HBase exposes the metrics in prometheus friendly format through a servlet, `/prometheus`. Currently `/prometheus` exposes all the available metrics."},"6493":{"id":"/docs/operational-management/metrics-and-monitoring-33","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"Rather than listing each metric which HBase emits by default, you can browse through the available metrics, either as a JSON output or via JMX. Different metrics are exposed for the Master process and each region server process."},"6494":{"id":"/docs/operational-management/metrics-and-monitoring-34","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"**Procedure: Access a JSON Output of Available Metrics**"},"6495":{"id":"/docs/operational-management/metrics-and-monitoring-35","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"After starting HBase, access the region server's web UI, at http\\://REGIONSERVER\\_HOSTNAME:16030 by default."},"6496":{"id":"/docs/operational-management/metrics-and-monitoring-36","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"Click the **Metrics Dump** link near the top. The metrics for the region server are presented as a dump of the JMX bean in JSON format. This will dump out all metrics names and their values. To include metrics descriptions in the listing — this can be useful when you are exploring what is available — add a query string of `?description=true` so your URL becomes http\\://REGIONSERVER\\_HOSTNAME:16030/jmx?description=true. Not all beans and attributes have descriptions."},"6497":{"id":"/docs/operational-management/metrics-and-monitoring-37","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"To view metrics for the Master, connect to the Master's web UI instead (defaults to http\\://localhost:16010) and click its **Metrics Dump** link. To include metrics descriptions in the listing — this can be useful when you are exploring what is available — add a query string of `?description=true` so your URL becomes http\\://REGIONSERVER\\_HOSTNAME:16010/jmx?description=true. Not all beans and attributes have descriptions."},"6498":{"id":"/docs/operational-management/metrics-and-monitoring-38","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"You can use many different tools to view JMX content by browsing MBeans. This procedure uses `jvisualvm`, which is an application usually available in the JDK."},"6499":{"id":"/docs/operational-management/metrics-and-monitoring-39","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"**Procedure: Browse the JMX Output of Available Metrics**"},"6500":{"id":"/docs/operational-management/metrics-and-monitoring-40","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"Start HBase, if it is not already running."},"6501":{"id":"/docs/operational-management/metrics-and-monitoring-41","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"Run the command `jvisualvm` command on a host with a GUI display. You can launch it from the command line or another method appropriate for your operating system."},"6502":{"id":"/docs/operational-management/metrics-and-monitoring-42","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"Be sure the **VisualVM-MBeans** plugin is installed. Browse to **Tools → Plugins**. Click **Installed** and check whether the plugin is listed. If not, click **Available Plugins**, select it, and click Install. When finished, click Close."},"6503":{"id":"/docs/operational-management/metrics-and-monitoring-43","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"To view details for a given HBase process, double-click the process in the **Local** sub-tree in the left-hand panel. A detailed view opens in the right-hand panel. Click the **MBeans** tab which appears as a tab in the top of the right-hand panel."},"6504":{"id":"/docs/operational-management/metrics-and-monitoring-44","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"To access the HBase metrics, navigate to the appropriate sub-bean: .\\* Master: .\\* RegionServer:"},"6505":{"id":"/docs/operational-management/metrics-and-monitoring-45","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#discovering-available-metrics","content":"The name of each metric and its current value is displayed in the **Attributes** tab. For a view which includes more details, including the description of each attribute, click the **Metadata** tab."},"6506":{"id":"/docs/operational-management/metrics-and-monitoring-46","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#units-of-measure-for-metrics","content":"Different metrics are expressed in different units, as appropriate. Often, the unit of measure is in the name (as in the metric `shippedKBs`). Otherwise, use the following guidelines. When in doubt, you may need to examine the source for a given metric."},"6507":{"id":"/docs/operational-management/metrics-and-monitoring-47","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#units-of-measure-for-metrics","content":"Metrics that refer to a point in time are usually expressed as a timestamp."},"6508":{"id":"/docs/operational-management/metrics-and-monitoring-48","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#units-of-measure-for-metrics","content":"Metrics that refer to an age (such as `ageOfLastShippedOp`) are usually expressed in milliseconds."},"6509":{"id":"/docs/operational-management/metrics-and-monitoring-49","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#units-of-measure-for-metrics","content":"Metrics that refer to memory sizes are in bytes."},"6510":{"id":"/docs/operational-management/metrics-and-monitoring-50","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#units-of-measure-for-metrics","content":"Sizes of queues (such as `sizeOfLogQueue`) are expressed as the number of items in the queue. Determine the size by multiplying by the block size (default is 64 MB in HDFS)."},"6511":{"id":"/docs/operational-management/metrics-and-monitoring-51","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#units-of-measure-for-metrics","content":"Metrics that refer to things like the number of a given type of operations (such as `logEditsRead`) are expressed as an integer."},"6512":{"id":"/docs/operational-management/metrics-and-monitoring-52","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-master-metrics","content":"Note: Counts are usually over the last metrics reporting interval."},"6513":{"id":"/docs/operational-management/metrics-and-monitoring-53","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-master-metrics","content":"**hbase.master.numRegionServers**\\\nNumber of live regionservers"},"6514":{"id":"/docs/operational-management/metrics-and-monitoring-54","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-master-metrics","content":"**hbase.master.numDeadRegionServers**\\\nNumber of dead regionservers"},"6515":{"id":"/docs/operational-management/metrics-and-monitoring-55","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-master-metrics","content":"**hbase.master.ritCount**\\\nThe number of regions in transition"},"6516":{"id":"/docs/operational-management/metrics-and-monitoring-56","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-master-metrics","content":"**hbase.master.ritCountOverThreshold**\\\nThe number of regions that have been in transition longer than a threshold time (default: 60 seconds)"},"6517":{"id":"/docs/operational-management/metrics-and-monitoring-57","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-master-metrics","content":"**hbase.master.ritOldestAge**\\\nThe age of the longest region in transition, in milliseconds"},"6518":{"id":"/docs/operational-management/metrics-and-monitoring-58","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"The active, initialized Master exposes numeric switch-state gauges under\n`Hadoop:service=HBase,name=Master,sub=Server`. A value of `1` means enabled and\n`0` means disabled. The gauges are absent on backup Masters and before the Master\nis initialized.\nEnabled states indicate that an operation is permitted, rather than that it is\ncurrently running."},"6519":{"id":"/docs/operational-management/metrics-and-monitoring-59","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"Gauge"},"6520":{"id":"/docs/operational-management/metrics-and-monitoring-60","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"HBase shell command"},"6521":{"id":"/docs/operational-management/metrics-and-monitoring-61","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`balancerEnabled`"},"6522":{"id":"/docs/operational-management/metrics-and-monitoring-62","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`balance_switch true\\|false`"},"6523":{"id":"/docs/operational-management/metrics-and-monitoring-63","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`normalizerEnabled`"},"6524":{"id":"/docs/operational-management/metrics-and-monitoring-64","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`normalizer_switch true\\|false`"},"6525":{"id":"/docs/operational-management/metrics-and-monitoring-65","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`splitEnabled`"},"6526":{"id":"/docs/operational-management/metrics-and-monitoring-66","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`splitormerge_switch 'SPLIT', true\\|false`"},"6527":{"id":"/docs/operational-management/metrics-and-monitoring-67","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`mergeEnabled`"},"6528":{"id":"/docs/operational-management/metrics-and-monitoring-68","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`splitormerge_switch 'MERGE', true\\|false`"},"6529":{"id":"/docs/operational-management/metrics-and-monitoring-69","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`cleanerChoreEnabled`"},"6530":{"id":"/docs/operational-management/metrics-and-monitoring-70","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`cleaner_chore_switch true\\|false`"},"6531":{"id":"/docs/operational-management/metrics-and-monitoring-71","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`catalogJanitorEnabled`"},"6532":{"id":"/docs/operational-management/metrics-and-monitoring-72","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`catalogjanitor_switch true\\|false`"},"6533":{"id":"/docs/operational-management/metrics-and-monitoring-73","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`snapshotCleanupEnabled`"},"6534":{"id":"/docs/operational-management/metrics-and-monitoring-74","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`snapshot_cleanup_switch true\\|false`"},"6535":{"id":"/docs/operational-management/metrics-and-monitoring-75","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`replicationPeerModificationEnabled`"},"6536":{"id":"/docs/operational-management/metrics-and-monitoring-76","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`peer_modification_switch true\\|false`"},"6537":{"id":"/docs/operational-management/metrics-and-monitoring-77","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`rpcThrottleEnabled`"},"6538":{"id":"/docs/operational-management/metrics-and-monitoring-78","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"`enable_rpc_throttle` / `disable_rpc_throttle`"},"6539":{"id":"/docs/operational-management/metrics-and-monitoring-79","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"The gauges follow the corresponding enabled-state queries. Maintenance mode\ndisables the balancer, normalizer, split, and merge states. Per-table settings can\nfurther restrict these operations. The cleaner state covers the default HFile\ncleaner and the WAL cleaner. The existing `tag.isBalancerActive` tag under\n`Master,sub=Balancer` remains available."},"6540":{"id":"/docs/operational-management/metrics-and-monitoring-80","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#master-switch-states","content":"All switch states are read from memory during metrics collection.\nWhen quota support is disabled, `rpcThrottleEnabled` is `0`. With quota support\nenabled, it is omitted while the quota manager is unavailable, including in\nMaster maintenance mode."},"6541":{"id":"/docs/operational-management/metrics-and-monitoring-81","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"Note: Counts are usually over the last metrics reporting interval."},"6542":{"id":"/docs/operational-management/metrics-and-monitoring-82","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.regionCount**\\\nThe number of regions hosted by the regionserver"},"6543":{"id":"/docs/operational-management/metrics-and-monitoring-83","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.storeFileCount**\\\nThe number of store files on disk currently managed by the regionserver"},"6544":{"id":"/docs/operational-management/metrics-and-monitoring-84","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.storeFileSize**\\\nAggregate size of the store files on disk"},"6545":{"id":"/docs/operational-management/metrics-and-monitoring-85","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.hlogFileCount**\\\nThe number of write ahead logs not yet archived"},"6546":{"id":"/docs/operational-management/metrics-and-monitoring-86","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.totalRequestCount**\\\nThe total number of requests received"},"6547":{"id":"/docs/operational-management/metrics-and-monitoring-87","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.readRequestCount**\\\nThe number of read requests received"},"6548":{"id":"/docs/operational-management/metrics-and-monitoring-88","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.writeRequestCount**\\\nThe number of write requests received"},"6549":{"id":"/docs/operational-management/metrics-and-monitoring-89","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.numOpenConnections**\\\nThe number of open connections at the RPC layer"},"6550":{"id":"/docs/operational-management/metrics-and-monitoring-90","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.numActiveHandler**\\\nThe number of RPC handlers actively servicing requests"},"6551":{"id":"/docs/operational-management/metrics-and-monitoring-91","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.numCallsInGeneralQueue**\\\nThe number of currently enqueued user requests"},"6552":{"id":"/docs/operational-management/metrics-and-monitoring-92","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.numCallsInReplicationQueue**\\\nThe number of currently enqueued operations received from replication"},"6553":{"id":"/docs/operational-management/metrics-and-monitoring-93","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.numCallsInPriorityQueue**\\\nThe number of currently enqueued priority (internal housekeeping) requests"},"6554":{"id":"/docs/operational-management/metrics-and-monitoring-94","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.flushQueueLength**\\\nCurrent depth of the memstore flush queue. If increasing, we are falling behind with clearing memstores out to HDFS."},"6555":{"id":"/docs/operational-management/metrics-and-monitoring-95","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.updatesBlockedTime**\\\nNumber of milliseconds updates have been blocked so the memstore can be flushed"},"6556":{"id":"/docs/operational-management/metrics-and-monitoring-96","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.compactionQueueLength**\\\nCurrent depth of the compaction request queue. If increasing, we are falling behind with storefile compaction."},"6557":{"id":"/docs/operational-management/metrics-and-monitoring-97","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.blockCacheHitCount**\\\nThe number of block cache hits"},"6558":{"id":"/docs/operational-management/metrics-and-monitoring-98","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.blockCacheMissCount**\\\nThe number of block cache misses"},"6559":{"id":"/docs/operational-management/metrics-and-monitoring-99","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.blockCacheExpressHitPercent**\\\nThe percent of the time that requests with the cache turned on hit the cache"},"6560":{"id":"/docs/operational-management/metrics-and-monitoring-100","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.percentFilesLocal**\\\nPercent of store file data that can be read from the local DataNode, 0-100"},"6561":{"id":"/docs/operational-management/metrics-and-monitoring-101","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.\\<op>\\_\\<measure>**\\\nOperation latencies, where \\<op> is one of Append, Delete, Mutate, Get, Replay, Increment; and where \\<measure> is one of min, max, mean, median, 75th\\_percentile, 95th\\_percentile, 99th\\_percentile"},"6562":{"id":"/docs/operational-management/metrics-and-monitoring-102","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.slow\\<op>Count**\\\nThe number of operations we thought were slow, where \\<op> is one of the list above"},"6563":{"id":"/docs/operational-management/metrics-and-monitoring-103","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.GcTimeMillis**\\\nTime spent in garbage collection, in milliseconds"},"6564":{"id":"/docs/operational-management/metrics-and-monitoring-104","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.GcTimeMillisParNew**\\\nTime spent in garbage collection of the young generation, in milliseconds"},"6565":{"id":"/docs/operational-management/metrics-and-monitoring-105","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.GcTimeMillisConcurrentMarkSweep**\\\nTime spent in garbage collection of the old generation, in milliseconds"},"6566":{"id":"/docs/operational-management/metrics-and-monitoring-106","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.authenticationSuccesses**\\\nNumber of client connections where authentication succeeded"},"6567":{"id":"/docs/operational-management/metrics-and-monitoring-107","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.authenticationFailures**\\\nNumber of client connection authentication failures"},"6568":{"id":"/docs/operational-management/metrics-and-monitoring-108","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#most-important-regionserver-metrics","content":"**hbase.regionserver.mutationsWithoutWALCount**\\\nCount of writes submitted with a flag indicating they should bypass the write ahead log"},"6569":{"id":"/docs/operational-management/metrics-and-monitoring-109","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"HBase meta table metrics collection feature is available in HBase 1.4+ but it is disabled by default, as it can affect the performance of the cluster. When it is enabled, it helps to monitor client access patterns by collecting the following statistics:"},"6570":{"id":"/docs/operational-management/metrics-and-monitoring-110","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"number of get, put and delete operations on the `hbase:meta` table"},"6571":{"id":"/docs/operational-management/metrics-and-monitoring-111","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"number of get, put and delete operations made by the top-N clients"},"6572":{"id":"/docs/operational-management/metrics-and-monitoring-112","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"number of operations related to each table"},"6573":{"id":"/docs/operational-management/metrics-and-monitoring-113","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"number of operations related to the top-N regions\\\n**When to use the feature**\\\nThis feature can help to identify hot spots in the meta table by showing the regions or tables where the meta info is modified (e.g. by create, drop, split or move tables) or retrieved most frequently. It can also help to find misbehaving client applications by showing which clients are using the meta table most heavily, which can for example suggest the lack of meta table buffering or the lack of re-using open client connections in the client application."},"6574":{"id":"/docs/operational-management/metrics-and-monitoring-114","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"Having large number of clients and regions in the cluster can cause the registration and tracking\nof a large amount of metrics, which can increase the memory and CPU footprint of the HBase region\nserver handling the `hbase:meta` table. It can also cause the significant increase of the JMX dump\nsize, which can affect the monitoring or log aggregation system you use beside HBase. It is\nrecommended to turn on this feature only during debugging."},"6575":{"id":"/docs/operational-management/metrics-and-monitoring-115","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"**Where to find the metrics in JMX**\\\nEach metric attribute name will start with the ‘MetaTable\\_' prefix. For all the metrics you will see five different JMX attributes: count, mean rate, 1 minute rate, 5 minute rate and 15 minute rate. You will find these metrics in JMX under the following MBean: `Hadoop → HBase → RegionServer → Coprocessor.Region.CP_org.apache.hadoop.hbase.coprocessor.MetaTableMetrics`."},"6576":{"id":"/docs/operational-management/metrics-and-monitoring-116","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"**Examples: some Meta Table metrics you can see in your JMX dump**"},"6577":{"id":"/docs/operational-management/metrics-and-monitoring-117","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"**Configuration**\\\nTo turn on this feature, you have to enable a custom coprocessor by adding the following section to hbase-site.xml. This coprocessor will run on all the HBase RegionServers, but will be active (i.e. consume memory / CPU) only on the server, where the `hbase:meta` table is located. It will produce JMX metrics which can be downloaded from the web UI of the given RegionServer or by a simple REST call. These metrics will not be present in the JMX dump of the other RegionServers."},"6578":{"id":"/docs/operational-management/metrics-and-monitoring-118","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"**Enabling the Meta Table Metrics feature**"},"6579":{"id":"/docs/operational-management/metrics-and-monitoring-119","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"The 'top-N' type of metrics will be counted using the Lossy Counting Algorithm (as defined in Motwani, R; Manku, G.S (2002). \"Approximate frequency counts over data streams\"), which is designed to identify elements in a data stream whose frequency count exceed a user-given threshold. The frequency computed by this algorithm is not always accurate but has an error threshold that can be specified by the user as a configuration parameter. The run time space required by the algorithm is inversely proportional to the specified error threshold, hence larger the error parameter, the smaller the footprint and the less accurate are the metrics."},"6580":{"id":"/docs/operational-management/metrics-and-monitoring-120","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"You can specify the error rate of the algorithm as a floating-point value between 0 and 1 (exclusive), it's default value is 0.02. Having the error rate set to `E` and having `N` as the total number of meta table operations, then (assuming the uniform distribution of the activity of low frequency elements) at most `7 / E` meters will be kept and each kept element will have a frequency higher than `E * N`."},"6581":{"id":"/docs/operational-management/metrics-and-monitoring-121","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#meta-table-load-metrics","content":"An example: Let's assume we are interested in the HBase clients that are most active in accessing the meta table. When there was 1,000,000 operations on the meta table so far and the error rate parameter is set to 0.02, then we can assume that only at most 350 client IP address related counters will be present in JMX and each of these clients accessed the meta table at least 20,000 times."},"6582":{"id":"/docs/operational-management/metrics-and-monitoring-122","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#hbase-monitoring-overview","content":"The following metrics are arguably the most important to monitor for each RegionServer for \"macro monitoring\", preferably with a system like OpenTSDB. If your cluster is having performance issues it's likely that you'll see something unusual with this group."},"6583":{"id":"/docs/operational-management/metrics-and-monitoring-123","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#hbase-toc","content":"See rs metrics"},"6584":{"id":"/docs/operational-management/metrics-and-monitoring-124","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#os-toc","content":"IO Wait"},"6585":{"id":"/docs/operational-management/metrics-and-monitoring-125","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#os-toc","content":"User CPU"},"6586":{"id":"/docs/operational-management/metrics-and-monitoring-126","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#java-toc","content":"GC"},"6587":{"id":"/docs/operational-management/metrics-and-monitoring-127","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#slow-query-log","content":"The HBase slow query log consists of parseable JSON structures describing the properties of those client operations (Gets, Puts, Deletes, etc.) that either took too long to run, or produced too much output. The thresholds for \"too long to run\" and \"too much output\" are configurable, as described below. The output is produced inline in the main region server logs so that it is easy to discover further details from context with other logged events. It is also prepended with identifying tags `(responseTooSlow)`, `(responseTooLarge)`, `(operationTooSlow)`, and `(operationTooLarge)` in order to enable easy filtering with grep, in case the user desires to see only slow queries."},"6588":{"id":"/docs/operational-management/metrics-and-monitoring-128","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-metrics-and-monitoring-overview-configuration","content":"There are four configuration knobs that can be used to adjust the thresholds for when queries are logged. Two of these knobs control the size and time thresholds for all queries. Because Scans can often be larger and slower than other types of queries, there are two additional knobs which can control size and time thresholds for Scans specifically."},"6589":{"id":"/docs/operational-management/metrics-and-monitoring-129","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.time` Maximum number of milliseconds that a query can be run without being logged. Defaults to 10000, or 10 seconds. Can be set to -1 to disable logging by time."},"6590":{"id":"/docs/operational-management/metrics-and-monitoring-130","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.size` Maximum byte size of response that a query can return without being logged. Defaults to 100 megabytes. Can be set to -1 to disable logging by size."},"6591":{"id":"/docs/operational-management/metrics-and-monitoring-131","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.time.scan` Maximum number of milliseconds that a Scan can be run without being logged. Defaults to the `hbase.ipc.warn.response.time` value. Can be set to -1 to disable logging by time."},"6592":{"id":"/docs/operational-management/metrics-and-monitoring-132","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-metrics-and-monitoring-overview-configuration","content":"`hbase.ipc.warn.response.size.scan` Maximum byte size of response that a Scan can return without being logged. Defaults to the `hbase.ipc.warn.response.size` value. Can be set to -1 to disable logging by size."},"6593":{"id":"/docs/operational-management/metrics-and-monitoring-133","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-hbase-monitoring-slow-query-log-metrics","content":"The slow query log exposes to metrics to JMX."},"6594":{"id":"/docs/operational-management/metrics-and-monitoring-134","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-hbase-monitoring-slow-query-log-metrics","content":"`hadoop.regionserver_rpc_slowResponse` a global metric reflecting the durations of all responses that triggered logging."},"6595":{"id":"/docs/operational-management/metrics-and-monitoring-135","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-hbase-monitoring-slow-query-log-metrics","content":"`hadoop.regionserver_rpc_methodName.aboveOneSec` A metric reflecting the durations of all responses that lasted for more than one second."},"6596":{"id":"/docs/operational-management/metrics-and-monitoring-136","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#output","content":"The output is tagged with operation e.g. `(operationTooSlow)` if the call was a client operation, such as a Put, Get, or Delete, which we expose detailed fingerprint information for. If not, it is tagged `(responseTooSlow)` and still produces parseable JSON output, but with less verbose information solely regarding its duration and size in the RPC itself. `TooLarge` is substituted for `TooSlow` if the response size triggered the logging, with `TooLarge` appearing even in the case that both size and duration triggered logging."},"6597":{"id":"/docs/operational-management/metrics-and-monitoring-137","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-hbase-monitoring-slow-query-log-example","content":"Note that everything inside the \"tables\" structure is output produced by MultiPut's fingerprint, while the rest of the information is RPC-specific, such as processing time and client IP/port. Other client operations follow the same pattern and the same general structure, with necessary differences due to the nature of the individual operations. In the case that the call is not a client operation, that detailed fingerprint information will be completely absent."},"6598":{"id":"/docs/operational-management/metrics-and-monitoring-138","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#operational-management-hbase-monitoring-slow-query-log-example","content":"This particular example, for example, would indicate that the likely cause of slowness is simply a very large (on the order of 100MB) multiput, as we can tell by the \"vlen,\" or value length, fields of each put in the multiPut."},"6599":{"id":"/docs/operational-management/metrics-and-monitoring-139","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"When an individual RPC exceeds a configurable time bound we log a complaint by way of the logging subsystem"},"6600":{"id":"/docs/operational-management/metrics-and-monitoring-140","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"e.g."},"6601":{"id":"/docs/operational-management/metrics-and-monitoring-141","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"Unfortunately often the request parameters are truncated as per above Example. The truncation is unfortunate because it eliminates much of the utility of the warnings. For example, the region name, the start and end keys, and the filter hierarchy are all important clues for debugging performance problems caused by moderate to low selectivity queries or queries made at a high rate."},"6602":{"id":"/docs/operational-management/metrics-and-monitoring-142","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"HBASE-22978 introduces maintaining an in-memory ring buffer of requests that were judged to be too slow in addition to the responseTooSlow logging. The in-memory representation can be complete. There is some chance a high rate of requests will cause information on other interesting requests to be overwritten before it can be read. This is an acceptable trade off."},"6603":{"id":"/docs/operational-management/metrics-and-monitoring-143","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"In order to enable the in-memory ring buffer at RegionServers, we need to enable config:"},"6604":{"id":"/docs/operational-management/metrics-and-monitoring-144","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"One more config determines the size of the ring buffer:"},"6605":{"id":"/docs/operational-management/metrics-and-monitoring-145","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"Check the config section for the detailed description."},"6606":{"id":"/docs/operational-management/metrics-and-monitoring-146","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"This config would be disabled by default. Turn it on and these shell commands would provide expected results from the ring-buffers."},"6607":{"id":"/docs/operational-management/metrics-and-monitoring-147","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"shell commands to retrieve slowlog responses from RegionServers:"},"6608":{"id":"/docs/operational-management/metrics-and-monitoring-148","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"All of above queries with filters have default OR operation applied i.e. all records with any of the provided filters applied will be returned. However, we can also apply AND operator i.e. all records that match all (not any) of the provided filters should be returned."},"6609":{"id":"/docs/operational-management/metrics-and-monitoring-149","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"Since OR is the default filter operator, without providing 'FILTER\\_BY\\_OP', query will have same result as providing 'FILTER\\_BY\\_OP' ⇒ 'OR'."},"6610":{"id":"/docs/operational-management/metrics-and-monitoring-150","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"Sometimes output can be long pretty printed json for user to scroll in a single screen and hence user might prefer redirecting output of get\\_slowlog\\_responses to a file."},"6611":{"id":"/docs/operational-management/metrics-and-monitoring-151","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"Example:"},"6612":{"id":"/docs/operational-management/metrics-and-monitoring-152","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"Similar to slow RPC logs, client can also retrieve large RPC logs. Sometimes, slow logs important to debug perf issues turn out to be larger in size."},"6613":{"id":"/docs/operational-management/metrics-and-monitoring-153","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slow-response-log-from-shell","content":"shell command to clear slow/largelog responses from RegionServer:"},"6614":{"id":"/docs/operational-management/metrics-and-monitoring-154","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"The above section provides details about Admin APIs:"},"6615":{"id":"/docs/operational-management/metrics-and-monitoring-155","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"get\\_slowlog\\_responses"},"6616":{"id":"/docs/operational-management/metrics-and-monitoring-156","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"get\\_largelog\\_responses"},"6617":{"id":"/docs/operational-management/metrics-and-monitoring-157","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"clear\\_slowlog\\_responses"},"6618":{"id":"/docs/operational-management/metrics-and-monitoring-158","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"All of the above APIs access online in-memory ring buffers from individual RegionServers and accumulate logs from ring buffers to display to end user. However, since the logs are stored in memory, after RegionServer is restarted, all the objects held in memory of that RegionServer will be cleaned up and previous logs are lost. What if we want to persist all these logs forever? What if we want to store them in such a manner that operator can get all historical records with some filters? e.g get me all large/slow RPC logs that are triggered by user1 and are related to region: cluster\\_test,cccccccc,1589635796466.aa45e1571d533f5ed0bb31cdccaaf9cf. ?"},"6619":{"id":"/docs/operational-management/metrics-and-monitoring-159","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"If we have a system table that stores such logs in increasing (not so strictly though) order of time, it can definitely help operators debug some historical events (scan, get, put, compaction, flush etc) with detailed inputs."},"6620":{"id":"/docs/operational-management/metrics-and-monitoring-160","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"Config which enabled system table to be created and store all log events is `hbase.regionserver.slowlog.systable.enabled`."},"6621":{"id":"/docs/operational-management/metrics-and-monitoring-161","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"The default value for this config is `false`. If provided `true` (Note: `hbase.regionserver.slowlog.buffer.enabled` should also be `true`), a cron job running in every RegionServer will persist the slow/large logs into table hbase:slowlog. By default cron job runs every 10 min. Duration can be configured with key: `hbase.slowlog.systable.chore.duration`. By default, RegionServer will store upto 1000(config key: `hbase.regionserver.slowlog.systable.queue.size`) slow/large logs in an internal queue and the chore will retrieve these logs from the queue and perform batch insertion in hbase:slowlog."},"6622":{"id":"/docs/operational-management/metrics-and-monitoring-162","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"hbase:slowlog has single ColumnFamily: `info` `info` contains multiple qualifiers which are the same attributes present as part of `get_slowlog_responses` API response."},"6623":{"id":"/docs/operational-management/metrics-and-monitoring-163","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:call\\_details"},"6624":{"id":"/docs/operational-management/metrics-and-monitoring-164","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:client\\_address"},"6625":{"id":"/docs/operational-management/metrics-and-monitoring-165","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:method\\_name"},"6626":{"id":"/docs/operational-management/metrics-and-monitoring-166","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:param"},"6627":{"id":"/docs/operational-management/metrics-and-monitoring-167","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:processing\\_time"},"6628":{"id":"/docs/operational-management/metrics-and-monitoring-168","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:queue\\_time"},"6629":{"id":"/docs/operational-management/metrics-and-monitoring-169","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get-slowlarge-response-logs-from-system-table-hbaseslowlog","content":"info:region\\_name"},"6630":{"id":"/docs/operational-management/metrics-and-monitoring-170","page_id":"/docs/operational-management/metrics-and-monitoring","tags":["multi-page"],"type":"text","url":"/docs/operational-management/metrics-and-monitoring#get