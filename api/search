etes the scanner and frees the resources it used."},"4581":{"id":"/docs/external-apis-168","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateful-endpoints-for-scan-operations","content":"For the filter file example, it should contain:"},"4582":{"id":"/docs/external-apis-169","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateful-endpoints-for-scan-operations","content":"**Examples:**"},"4583":{"id":"/docs/external-apis-170","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateless-endpoints-for-scan-operations","content":"Endpoint"},"4584":{"id":"/docs/external-apis-171","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateless-endpoints-for-scan-operations","content":"HTTP Verb"},"4585":{"id":"/docs/external-apis-172","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateless-endpoints-for-scan-operations","content":"Description"},"4586":{"id":"/docs/external-apis-173","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateless-endpoints-for-scan-operations","content":"`/table/*`"},"4587":{"id":"/docs/external-apis-174","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateless-endpoints-for-scan-operations","content":"`GET`"},"4588":{"id":"/docs/external-apis-175","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateless-endpoints-for-scan-operations","content":"Scanning the entire table. The stateless scanner endpoint does not require a followup call to return the results."},"4589":{"id":"/docs/external-apis-176","page_id":"/docs/external-apis","tags":["multi-page"],"type":"text","url":"/docs/external-apis#stateless-endpoints-for-scan-operations","content":"`/table/*?limit=number_of_rows`"},"4