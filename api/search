ions-21","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#storefile-hfile","content":"StoreFile (HFile)"},"704":{"id":"/docs/architecture/regions-22","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#architecture-regions-hfile-format","content":"HFile Format"},"705":{"id":"/docs/architecture/regions-23","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#architecture-regions-store-hfile-tool","content":"HFile Tool"},"706":{"id":"/docs/architecture/regions-24","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#storefile-directory-structure-on-hdfs","content":"StoreFile Directory Structure on HDFS"},"707":{"id":"/docs/architecture/regions-25","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#blocks","content":"Blocks"},"708":{"id":"/docs/architecture/regions-26","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#keyvalue","content":"KeyValue"},"709":{"id":"/docs/architecture/regions-27","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#architecture-regions-store-keyvalue-example","content":"Example"},"710":{"id":"/docs/architecture/regions-28","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#compaction","content":"Compaction"},"711":{"id":"/docs/architecture/regions-29","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architecture/regions#compaction-and-deletions","content":"Compaction and Deletions"},"712":{"id":"/docs/architecture/regions-30","page_id":"/docs/architecture/regions","type":"heading","tags":["multi-page"],"url":"/docs/architec