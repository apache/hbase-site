ge_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"`[order-rowkey]`"},"7962":{"id":"/docs/regionserver-sizing-248","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"`[SHIPPING record type]`"},"7963":{"id":"/docs/regionserver-sizing-249","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"`[shipping location number]` (e.g., 1st location, 2nd, etc.)"},"7964":{"id":"/docs/regionserver-sizing-250","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"The LineItem composite rowkey would be something like this:"},"7965":{"id":"/docs/regionserver-sizing-251","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"`[order-rowkey]`"},"7966":{"id":"/docs/regionserver-sizing-252","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"`[LINE record type]`"},"7967":{"id":"/docs/regionserver-sizing-253","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"`[shipping location number]` (e.g., 1st location, 2nd, etc.)"},"7968":{"id":"/docs/regionserver-sizing-254","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#single-table-with-record-types","content":"`[line item number]` (e.g., 1st lineitem, 2nd, etc.)"},"7969":{"id":"/docs/regionserver-sizing-255","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"A variant of the Single Table With Record Types approach is to denormalize and flatten some of the object hierarchy, such as collapsing the ShippingLocation attributes onto each LineItem instance."},"7970":{"id":"/docs/regionserver-sizing-256","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"The LineItem composite rowkey would be something like this:"},"7971":{"id":"/docs/regionserver-sizing-257","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"`[order-rowkey]`"},"7972":{"id":"/docs/regionserver-sizing-258","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"`[LINE record type]`"},"7973":{"id":"/docs/regionserver-sizing-259","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"`[line item number]` (e.g., 1st lineitem, 2nd, etc., care must be taken that there are unique across the entire order)"},"7974":{"id":"/docs/regionserver-sizing-260","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"and the LineItem columns would be something like this:"},"7975":{"id":"/docs/regionserver-sizing-261","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"itemNumber"},"7976":{"id":"/docs/regionserver-sizing-262","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"quantity"},"7977":{"id":"/docs/regionserver-sizing-263","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"price"},"7978":{"id":"/docs/regionserver-sizing-264","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"shipToLine1 (denormalized from ShippingLocation)"},"7979":{"id":"/docs/regionserver-sizing-265","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"shipToLine2 (denormalized from ShippingLocation)"},"7980":{"id":"/docs/regionserver-sizing-266","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"shipToCity (denormalized from ShippingLocation)"},"7981":{"id":"/docs/regionserver-sizing-267","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"shipToState (denormalized from ShippingLocation)"},"7982":{"id":"/docs/regionserver-sizing-268","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"shipToZip (denormalized from ShippingLocation)"},"7983":{"id":"/docs/regionserver-sizing-269","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#denormalized","content":"The pros of this approach include a less complex object hierarchy, but one of the cons is that updating gets more complicated in case any of this information changes."},"7984":{"id":"/docs/regionserver-sizing-270","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#object-blob","content":"With this approach, the entire Order object graph is treated, in one way or another, as a BLOB. For example, the ORDER table's rowkey was described above: schema.casestudies.custorder, and a single column called \"order\" would contain an object that could be deserialized that contained a container Order, ShippingLocations, and LineItems."},"7985":{"id":"/docs/regionserver-sizing-271","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#object-blob","content":"There are many options here: JSON, XML, Java Serialization, Avro, Hadoop Writables, etc. All of them are variants of the same approach: encode the object graph to a byte-array. Care should be taken with this approach to ensure backward compatibility in case the object model changes such that older persisted structures can still be read back out of HBase."},"7986":{"id":"/docs/regionserver-sizing-272","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#object-blob","content":"Pros are being able to manage complex object graphs with minimal I/O (e.g., a single HBase Get per Order in this example), but the cons include the aforementioned warning about backward compatibility of serialization, language dependencies of serialization (e.g., Java Serialization only works with Java clients), the fact that you have to deserialize the entire object to get any piece of information inside the BLOB, and the difficulty in getting frameworks like Hive to work with custom objects like this."},"7987":{"id":"/docs/regionserver-sizing-273","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---tallwidemiddle-schema-design-smackdown","content":"This section will describe additional schema design questions that appear on the dist-list, specifically about tall and wide tables. These are general guidelines and not laws - each application must consider its own needs."},"7988":{"id":"/docs/regionserver-sizing-274","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#rows-vs-versions","content":"A common question is whether one should prefer rows or HBase's built-in-versioning. The context is typically where there are \"a lot\" of versions of a row to be retained (e.g., where it is significantly above the HBase default of 1 max versions). The rows-approach would require storing a timestamp in some portion of the rowkey so that they would not overwrite with each successive update."},"7989":{"id":"/docs/regionserver-sizing-275","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#rows-vs-versions","content":"Preference: Rows (generally speaking)."},"7990":{"id":"/docs/regionserver-sizing-276","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#rows-vs-columns","content":"Another common question is whether one should prefer rows or columns. The context is typically in extreme cases of wide tables, such as having 1 row with 1 million attributes, or 1 million rows with 1 columns apiece."},"7991":{"id":"/docs/regionserver-sizing-277","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#rows-vs-columns","content":"Preference: Rows (generally speaking). To be clear, this guideline is in the context is in extremely wide cases, not in the standard use-case where one needs to store a few dozen or hundred columns. But there is also a middle path between these two options, and that is \"Rows as Columns.\""},"7992":{"id":"/docs/regionserver-sizing-278","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#rows-as-columns","content":"The middle path between Rows vs. Columns is packing data that would be a separate row into columns, for certain rows. OpenTSDB is the best example of this case where a single row represents a defined time-range, and then discrete events are treated as columns. This approach is often more complex, and may require the additional complexity of re-writing your data, but has the advantage of being I/O efficient. For an overview of this approach, see schema.casestudies.log-steroids."},"7993":{"id":"/docs/regionserver-sizing-279","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"The following is an exchange from the user dist-list regarding a fairly common question: how to handle per-user list data in Apache HBase."},"7994":{"id":"/docs/regionserver-sizing-280","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"QUESTION \\*"},"7995":{"id":"/docs/regionserver-sizing-281","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"We're looking at how to store a large amount of (per-user) list data in HBase, and we were trying to figure out what kind of access pattern made the most sense. One option is store the majority of the data in a key, so we could have something like:"},"7996":{"id":"/docs/regionserver-sizing-282","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"The other option we had was to do this entirely using:"},"7997":{"id":"/docs/regionserver-sizing-283","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"where each row would contain multiple values. So in one case reading the first thirty values would be:"},"7998":{"id":"/docs/regionserver-sizing-284","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"And in the second case it would be"},"7999":{"id":"/docs/regionserver-sizing-285","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"The general usage pattern would be to read only the first 30 values of these lists, with infrequent access reading deeper into the lists. Some users would have ⇐ 30 total values in these lists, and some users would have millions (i.e. power-law distribution)"},"8000":{"id":"/docs/regionserver-sizing-286","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"The single-value format seems like it would take up more space on HBase, but would offer some improved retrieval / pagination flexibility. Would there be any significant performance advantages to be able to paginate via gets vs paginating with scans?"},"8001":{"id":"/docs/regionserver-sizing-287","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"My initial understanding was that doing a scan should be faster if our paging size is unknown (and caching is set appropriately), but that gets should be faster if we'll always need the same page size. I've ended up hearing different people tell me opposite things about performance. I assume the page sizes would be relatively consistent, so for most use cases we could guarantee that we only wanted one page of data in the fixed-page-length case. I would also assume that we would have infrequent updates, but may have inserts into the middle of these lists (meaning we'd need to update all subsequent rows)."},"8002":{"id":"/docs/regionserver-sizing-288","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"Thanks for help / suggestions / follow-up questions."},"8003":{"id":"/docs/regionserver-sizing-289","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"ANSWER \\*"},"8004":{"id":"/docs/regionserver-sizing-290","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"If I understand you correctly, you're ultimately trying to store triples in the form \"user, valueid, value\", right? E.g., something like:"},"8005":{"id":"/docs/regionserver-sizing-291","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"(But the usernames are fixed width, and the valueids are fixed width)."},"8006":{"id":"/docs/regionserver-sizing-292","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"And, your access pattern is along the lines of: \"for user X, list the next 30 values, starting with valueid Y\". Is that right? And these values should be returned sorted by valueid?"},"8007":{"id":"/docs/regionserver-sizing-293","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"The tl;dr version is that you should probably go with one row per user+value, and not build a complicated intra-row pagination scheme on your own unless you're really sure it is needed."},"8008":{"id":"/docs/regionserver-sizing-294","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"Your two options mirror a common question people have when designing HBase schemas: should I go \"tall\" or \"wide\"? Your first schema is \"tall\": each row represents one value for one user, and so there are many rows in the table for each user; the row key is user + valueid, and there would be (presumably) a single column qualifier that means \"the value\". This is great if you want to scan over rows in sorted order by row key (thus my question above, about whether these ids are sorted correctly). You can start a scan at any user+valueid, read the next 30, and be done. What you're giving up is the ability to have transactional guarantees around all the rows for one user, but it doesn't sound like you need that. Doing it this way is generally recommended (see here)."},"8009":{"id":"/docs/regionserver-sizing-295","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"Your second option is \"wide\": you store a bunch of values in one row, using different qualifiers (where the qualifier is the valueid). The simple way to do that would be to just store ALL values for one user in a single row. I'm guessing you jumped to the \"paginated\" version because you're assuming that storing millions of columns in a single row would be bad for performance, which may or may not be true; as long as you're not trying to do too much in a single request, or do things like scanning over and returning all of the cells in the row, it shouldn't be fundamentally worse. The client has methods that allow you to get specific slices of columns."},"8010":{"id":"/docs/regionserver-sizing-296","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"Note that neither case fundamentally uses more disk space than the other; you're just \"shifting\" part of the identifying information for a value either to the left (into the row key, in option one) or to the right (into the column qualifiers in option 2). Under the covers, every key/value still stores the whole row key, and column family name. (If this is a bit confusing, take an hour and watch Lars George's excellent video about understanding HBase schema design: http\\://www\\.youtube.com/watch?v=\\_HLoH\\_PgrLk)."},"8011":{"id":"/docs/regionserver-sizing-297","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#case-study---list-data","content":"A manually paginated version has lots more complexities, as you note, like having to keep track of how many things are in each page, re-shuffling if new values are inserted, etc. That seems significantly more complex. It might have some slight speed advantages (or disadvantages!) at extremely high throughput, and the only way to really know that would be to try it out. If you don't have time to build it both ways and compare, my advice would be to start with the simplest option (one row per user+value). Start simple and iterate! :)"},"8012":{"id":"/docs/regionserver-sizing-298","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"Set `hbase.regionserver.handler.count` (in `hbase-site.xml`) to cores x spindles for concurrency."},"8013":{"id":"/docs/regionserver-sizing-299","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"Optionally, split the call queues into separate read and write queues for differentiated service. The parameter `hbase.ipc.server.callqueue.handler.factor` specifies the number of call queues:"},"8014":{"id":"/docs/regionserver-sizing-300","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"`0` means a single shared queue"},"8015":{"id":"/docs/regionserver-sizing-301","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"`1` means one queue for each handler."},"8016":{"id":"/docs/regionserver-sizing-302","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"A value between `0` and `1` allocates the number of queues proportionally to the number of handlers. For instance, a value of `.5` shares one queue between each two handlers."},"8017":{"id":"/docs/regionserver-sizing-303","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"Use `hbase.ipc.server.callqueue.read.ratio` (`hbase.ipc.server.callqueue.read.share` in 0.98) to split the call queues into read and write queues:"},"8018":{"id":"/docs/regionserver-sizing-304","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"`0.5` means there will be the same number of read and write queues"},"8019":{"id":"/docs/regionserver-sizing-305","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"`< 0.5` for more write than read"},"8020":{"id":"/docs/regionserver-sizing-306","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"`> 0.5` for more read than write"},"8021":{"id":"/docs/regionserver-sizing-307","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"Set `hbase.ipc.server.callqueue.scan.ratio` (HBase 1.0+) to split read call queues into small-read and long-read queues:"},"8022":{"id":"/docs/regionserver-sizing-308","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"0.5 means that there will be the same number of short-read and long-read queues"},"8023":{"id":"/docs/regionserver-sizing-309","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"`< 0.5` for more short-read"},"8024":{"id":"/docs/regionserver-sizing-310","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-hbase-server-rpc-handling","content":"`> 0.5` for more long-read"},"8025":{"id":"/docs/regionserver-sizing-311","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#disable-nagle-for-rpc","content":"Disable Nagle's algorithm. Delayed ACKs can add up to \\~200ms to RPC round trip time. Set the following parameters:"},"8026":{"id":"/docs/regionserver-sizing-312","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#disable-nagle-for-rpc","content":"In Hadoop's `core-site.xml`:"},"8027":{"id":"/docs/regionserver-sizing-313","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#disable-nagle-for-rpc","content":"`ipc.server.tcpnodelay = true`"},"8028":{"id":"/docs/regionserver-sizing-314","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#disable-nagle-for-rpc","content":"`ipc.client.tcpnodelay = true`"},"8029":{"id":"/docs/regionserver-sizing-315","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#disable-nagle-for-rpc","content":"In HBase's `hbase-site.xml`:"},"8030":{"id":"/docs/regionserver-sizing-316","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#disable-nagle-for-rpc","content":"`hbase.ipc.client.tcpnodelay = true`"},"8031":{"id":"/docs/regionserver-sizing-317","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#disable-nagle-for-rpc","content":"`hbase.ipc.server.tcpnodelay = true`"},"8032":{"id":"/docs/regionserver-sizing-318","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#limit-server-failure-impact","content":"Detect regionserver failure as fast as reasonable. Set the following parameters:"},"8033":{"id":"/docs/regionserver-sizing-319","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#limit-server-failure-impact","content":"In `hbase-site.xml`, set `zookeeper.session.timeout` to 30 seconds or less to bound failure detection (20-30 seconds is a good start)."},"8034":{"id":"/docs/regionserver-sizing-320","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#limit-server-failure-impact","content":"Note: Zookeeper clients negotiate a session timeout with the server during client init. Server enforces this timeout to be in the range \\[`minSessionTimeout`, `maxSessionTimeout`] and both these timeouts (measured in milliseconds) are configurable in Zookeeper service configuration. If not configured, these default to 2 \\* `tickTime` and 20 \\* `tickTime` respectively (`tickTime` is the basic time unit used by ZooKeeper, as measured in milliseconds. It is used to regulate heartbeats, timeouts etc.). Refer to Zookeeper documentation for additional details."},"8035":{"id":"/docs/regionserver-sizing-321","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#limit-server-failure-impact","content":"Detect and avoid unhealthy or failed HDFS DataNodes: in `hdfs-site.xml` and `hbase-site.xml`, set the following parameters:"},"8036":{"id":"/docs/regionserver-sizing-322","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#limit-server-failure-impact","content":"`dfs.namenode.avoid.read.stale.datanode = true`"},"8037":{"id":"/docs/regionserver-sizing-323","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#limit-server-failure-impact","content":"`dfs.namenode.avoid.write.stale.datanode = true`"},"8038":{"id":"/docs/regionserver-sizing-324","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"Skip the network for local blocks when the RegionServer goes to read from HDFS by exploiting HDFS's Short-Circuit Local Reads facility. Note how setup must be done both at the datanode and on the dfsclient ends of the conneciton — i.e. at the RegionServer and how both ends need to have loaded the hadoop native `.so` library. After configuring your hadoop setting *dfs.client.read.shortcircuit* to *true* and configuring the *dfs.domain.socket.path* path for the datanode and dfsclient to share and restarting, next configure the regionserver/dfsclient side."},"8039":{"id":"/docs/regionserver-sizing-325","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"In `hbase-site.xml`, set the following parameters:"},"8040":{"id":"/docs/regionserver-sizing-326","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"`dfs.client.read.shortcircuit = true`"},"8041":{"id":"/docs/regionserver-sizing-327","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"`dfs.client.read.shortcircuit.skip.checksum = true` so we don't double checksum (HBase does its own checksumming to save on i/os)."},"8042":{"id":"/docs/regionserver-sizing-328","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"`dfs.domain.socket.path` to match what was set for the datanodes."},"8043":{"id":"/docs/regionserver-sizing-329","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"`dfs.client.read.shortcircuit.buffer.size = 131072` Important to avoid OOME — hbase has a default it uses if unset, see `hbase.dfs.client.read.shortcircuit.buffer.size`; its default is 131072."},"8044":{"id":"/docs/regionserver-sizing-330","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"Ensure data locality. In `hbase-site.xml`, set `hbase.hstore.min.locality.to.skip.major.compact = 0.7` (Meaning that 0.7 \\<= n \\<= 1)"},"8045":{"id":"/docs/regionserver-sizing-331","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"Make sure DataNodes have enough handlers for block transfers. In `hdfs-site.xml`, set the following parameters:"},"8046":{"id":"/docs/regionserver-sizing-332","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"`dfs.datanode.max.xcievers >= 8192`"},"8047":{"id":"/docs/regionserver-sizing-333","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"`dfs.datanode.handler.count =` number of spindles"},"8048":{"id":"/docs/regionserver-sizing-334","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"Check the RegionServer logs after restart. You should only see complaint if misconfiguration. Otherwise, shortcircuit read operates quietly in background. It does not provide metrics so no optics on how effective it is but read latencies should show a marked improvement, especially if good data locality, lots of random reads, and dataset is larger than available cache."},"8049":{"id":"/docs/regionserver-sizing-335","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"Other advanced configurations that you might play with, especially if shortcircuit functionality is complaining in the logs, include `dfs.client.read.shortcircuit.streams.cache.size` and `dfs.client.socketcache.capacity`. Documentation is sparse on these options. You'll have to read source code."},"8050":{"id":"/docs/regionserver-sizing-336","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"RegionServer metric system exposes HDFS short circuit read metrics `shortCircuitBytesRead`. Other HDFS read metrics, including `totalBytesRead` (The total number of bytes read from HDFS), `localBytesRead` (The number of bytes read from the local HDFS DataNode), `zeroCopyBytesRead` (The number of bytes read through HDFS zero copy) are available and can be used to troubleshoot short-circuit read issues."},"8051":{"id":"/docs/regionserver-sizing-337","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#optimize-on-the-server-side-for-low-latency","content":"For more on short-circuit reads, see Colin's old blog on rollout, How Improved Short-Circuit Local Reads Bring Better Performance and Security to Hadoop. The HDFS-347 issue also makes for an interesting read showing the HDFS community at its best (caveat a few comments)."},"8052":{"id":"/docs/regionserver-sizing-338","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-jvm-gc-for-low-collection-latencies","content":"Use the CMS collector: `-XX:+UseConcMarkSweepGC`"},"8053":{"id":"/docs/regionserver-sizing-339","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-jvm-gc-for-low-collection-latencies","content":"Keep eden space as small as possible to minimize average collection time. Example:"},"8054":{"id":"/docs/regionserver-sizing-340","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-jvm-gc-for-low-collection-latencies","content":"Optimize for low collection latency rather than throughput: `-Xmn512m`"},"8055":{"id":"/docs/regionserver-sizing-341","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-jvm-gc-for-low-collection-latencies","content":"Collect eden in parallel: `-XX:+UseParNewGC`"},"8056":{"id":"/docs/regionserver-sizing-342","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-jvm-gc-for-low-collection-latencies","content":"Avoid collection under pressure: `-XX:+UseCMSInitiatingOccupancyOnly`"},"8057":{"id":"/docs/regionserver-sizing-343","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-jvm-gc-for-low-collection-latencies","content":"Limit per request scanner result sizing so everything fits into survivor space but doesn't tenure. In `hbase-site.xml`, set `hbase.client.scanner.max.result.size` to 1/8th of eden space (with -`Xmn512m` this is \\~51MB )"},"8058":{"id":"/docs/regionserver-sizing-344","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#tune-jvm-gc-for-low-collection-latencies","content":"Set `max.result.size` x `handler.count` less than survivor space"},"8059":{"id":"/docs/regionserver-sizing-345","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#os-level-tuning","content":"Turn transparent huge pages (THP) off:"},"8060":{"id":"/docs/regionserver-sizing-346","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#os-level-tuning","content":"Set `vm.swappiness = 0`"},"8061":{"id":"/docs/regionserver-sizing-347","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#os-level-tuning","content":"Set `vm.min_free_kbytes` to at least 1GB (8GB on larger memory systems)"},"8062":{"id":"/docs/regionserver-sizing-348","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#os-level-tuning","content":"Disable NUMA zone reclaim with `vm.zone_reclaim_mode = 0`"},"8063":{"id":"/docs/regionserver-sizing-349","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-where-failing-quickly-is-better-than-waiting","content":"In `hbase-site.xml` on the client side, set the following parameters:"},"8064":{"id":"/docs/regionserver-sizing-350","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-where-failing-quickly-is-better-than-waiting","content":"Set `hbase.client.pause = 1000`"},"8065":{"id":"/docs/regionserver-sizing-351","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-where-failing-quickly-is-better-than-waiting","content":"Set `hbase.client.retries.number = 3`"},"8066":{"id":"/docs/regionserver-sizing-352","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-where-failing-quickly-is-better-than-waiting","content":"If you want to ride over splits and region moves, increase `hbase.client.retries.number` substantially (>= 20)"},"8067":{"id":"/docs/regionserver-sizing-353","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-where-failing-quickly-is-better-than-waiting","content":"Set the RecoverableZookeeper retry count: `zookeeper.recovery.retry = 1` (no retry)"},"8068":{"id":"/docs/regionserver-sizing-354","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-where-failing-quickly-is-better-than-waiting","content":"In `hbase-site.xml` on the server side, set the Zookeeper session timeout for detecting server failures: `zookeeper.session.timeout` ⇐ 30 seconds (20-30 is good)."},"8069":{"id":"/docs/regionserver-sizing-355","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"**HBase timeline consistency (HBASE-10070)** With read replicas enabled, read-only copies of regions (replicas) are distributed over the cluster. One RegionServer services the default or primary replica, which is the only replica that can service writes. Other RegionServers serve the secondary replicas, follow the primary RegionServer, and only see committed updates. The secondary replicas are read-only, but can serve reads immediately while the primary is failing over, cutting read availability blips from seconds to milliseconds. Phoenix supports timeline consistency as of 4.4.0 Tips:"},"8070":{"id":"/docs/regionserver-sizing-356","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"Deploy HBase 1.0.0 or later."},"8071":{"id":"/docs/regionserver-sizing-357","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"Enable timeline consistent replicas on the server side."},"8072":{"id":"/docs/regionserver-sizing-358","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"Use one of the following methods to set timeline consistency:"},"8073":{"id":"/docs/regionserver-sizing-359","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"Use `ALTER SESSION SET CONSISTENCY = 'TIMELINE'`"},"8074":{"id":"/docs/regionserver-sizing-360","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#for-applications-that-can-tolerate-slightly-out-of-date-information","content":"Set the connection property `Consistency` to `timeline` in the JDBC connect string"},"8075":{"id":"/docs/regionserver-sizing-361","page_id":"/docs/regionserver-sizing","tags":["multi-page"],"type":"text","url":"/docs/regionserver-sizing#more-information","content":"See the Performance section perf.schema for more information about operational and performance schema design options, such as Bloom Filters, Table-configured regionsizes, compression, and blocksizes."},"8076":{"id":"/docs/rpc","page_id":"/docs/rpc","type":"page","content":"0.95 RPC Specification","breadcrumbs":["Docs","Multi-Page Documentation","Appendices"],"tags":["multi-page"],"url":"/docs/rpc"},"8077":{"id":"/docs/rpc-0","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc","content":"HBase RPC wire format and client/server protocol specification for version 0.95+."},"8078":{"id":"/docs/rpc-1","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#goals","content":"Goals"},"8079":{"id":"/docs/rpc-2","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#todo","content":"TODO"},"8080":{"id":"/docs/rpc-3","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#rpc-overview","content":"RPC"},"8081":{"id":"/docs/rpc-4","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#connection-setup","content":"Connection Setup"},"8082":{"id":"/docs/rpc-5","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#rpc-connection-setup-client","content":"Client"},"8083":{"id":"/docs/rpc-6","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#server","content":"Server"},"8084":{"id":"/docs/rpc-7","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#request","content":"Request"},"8085":{"id":"/docs/rpc-8","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#request-parts","content":"Request Parts"},"8086":{"id":"/docs/rpc-9","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#response","content":"Response"},"8087":{"id":"/docs/rpc-10","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#response-parts","content":"Response Parts"},"8088":{"id":"/docs/rpc-11","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#exceptions","content":"Exceptions"},"8089":{"id":"/docs/rpc-12","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#cellblocks","content":"CellBlocks"},"8090":{"id":"/docs/rpc-13","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#rpc-notes","content":"Notes"},"8091":{"id":"/docs/rpc-14","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#rpc-constraints","content":"Constraints"},"8092":{"id":"/docs/rpc-15","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#one-fat-pb-request-or-headerparam","content":"One fat pb request or header+param"},"8093":{"id":"/docs/rpc-16","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#rpc-configurations","content":"RPC Configurations"},"8094":{"id":"/docs/rpc-17","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#cellblock-codecs","content":"CellBlock Codecs"},"8095":{"id":"/docs/rpc-18","page_id":"/docs/rpc","type":"heading","tags":["multi-page"],"url":"/docs/rpc#rpc-notes-rpc-configurations-compression","content":"Compression"},"8096":{"id":"/docs/rpc-19","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc","content":"In 0.95, all client/server communication is done with protobuf'ed Messages rather than with Hadoop Writables.\nOur RPC wire format therefore changes.\nThis document describes the client/server request/response protocol and our new RPC wire-format."},"8097":{"id":"/docs/rpc-20","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc","content":"For what RPC is like in 0.94 and previous, see Benoît/Tsuna's Unofficial Hadoop / HBase RPC protocol documentation.\nFor more background on how we arrived at this spec., see HBase RPC: WIP"},"8098":{"id":"/docs/rpc-21","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#goals","content":"A wire-format we can evolve"},"8099":{"id":"/docs/rpc-22","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#goals","content":"A format that does not require our rewriting server core or radically changing its current architecture (for later)."},"8100":{"id":"/docs/rpc-23","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#todo","content":"List of problems with currently specified format and where we would like to go in a version2, etc.\nFor example, what would we have to change if anything to move server async or to support streaming/chunking?"},"8101":{"id":"/docs/rpc-24","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#todo","content":"Diagram on how it works"},"8102":{"id":"/docs/rpc-25","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#todo","content":"A grammar that succinctly describes the wire-format.\nCurrently we have these words and the content of the rpc protobuf idl but a grammar for the back and forth would help with groking rpc.\nAlso, a little state machine on client/server interactions would help with understanding (and ensuring correct implementation)."},"8103":{"id":"/docs/rpc-26","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-overview","content":"The client will send setup information on connection establish.\nThereafter, the client invokes methods against the remote server sending a protobuf Message and receiving a protobuf Message in response.\nCommunication is synchronous.\nAll back and forth is preceded by an int that has the total length of the request/response.\nOptionally, Cells(KeyValues) can be passed outside of protobufs in follow-behind Cell blocks\n(because we can't protobuf megabytes of KeyValues or Cells). These CellBlocks are encoded and optionally compressed."},"8104":{"id":"/docs/rpc-27","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-overview","content":"For more detail on the protobufs involved, see the\nRPC.proto file in master."},"8105":{"id":"/docs/rpc-28","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#connection-setup","content":"Client initiates connection."},"8106":{"id":"/docs/rpc-29","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-connection-setup-client","content":"On connection setup, client sends a preamble followed by a connection header."},"8107":{"id":"/docs/rpc-30","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-connection-setup-client","content":"`<preamble>`"},"8108":{"id":"/docs/rpc-31","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-connection-setup-client","content":"We need the auth method spec.\nhere so the connection header is encoded if auth enabled.\\\nE.g.: HBas0x000x50 — 4 bytes of MAGIC — \\`HBas' — plus one-byte of version, 0 in this case, and one byte, 0x50 (SIMPLE). of an auth type."},"8109":{"id":"/docs/rpc-32","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-connection-setup-client","content":"`<Protobuf ConnectionHeader Message>`\\\nHas user info, and \"protocol\", as well as the encoders and compression the client will use sending CellBlocks.\nCellBlock encoders and compressors are for the life of the connection.\nCellBlock encoders implement org.apache.hadoop.hbase.codec.Codec.\nCellBlocks may then also be compressed.\nCompressors implement org.apache.hadoop.io.compress.CompressionCodec.\nThis protobuf is written using writeDelimited so is prefaced by a pb varint with its serialized length"},"8110":{"id":"/docs/rpc-33","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#server","content":"After client sends preamble and connection header, server does NOT respond if successful connection setup.\nNo response means server is READY to accept requests and to give out response.\nIf the version or authentication in the preamble is not agreeable or the server has trouble parsing the preamble, it will throw a org.apache.hadoop.hbase.ipc.FatalConnectionException explaining the error and will then disconnect.\nIf the client in the connection header — i.e.\nthe protobuf'd Message that comes after the connection preamble — asks for a Service the server does not support or a codec the server does not have, again we throw a FatalConnectionException with explanation."},"8111":{"id":"/docs/rpc-34","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#request","content":"After a Connection has been set up, client makes requests.\nServer responds."},"8112":{"id":"/docs/rpc-35","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#request","content":"A request is made up of a protobuf RequestHeader followed by a protobuf Message parameter.\nThe header includes the method name and optionally, metadata on the optional CellBlock that may be following.\nThe parameter type suits the method being invoked: i.e.\nif we are doing a getRegionInfo request, the protobuf Message param will be an instance of GetRegionInfoRequest.\nThe response will be a GetRegionInfoResponse.\nThe CellBlock is optionally used ferrying the bulk of the RPC data: i.e. Cells/KeyValues."},"8113":{"id":"/docs/rpc-36","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#request-parts","content":"`<Total Length>`\\\nThe request is prefaced by an int that holds the total length of what follows."},"8114":{"id":"/docs/rpc-37","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#request-parts","content":"`<Protobuf RequestHeader Message>`\\\nWill have call.id, trace.id, and method name, etc.\nincluding optional Metadata on the Cell block IFF one is following.\nData is protobuf'd inline in this pb Message or optionally comes in the following CellBlock"},"8115":{"id":"/docs/rpc-38","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#request-parts","content":"`<Protobuf Param Message>`\\\nIf the method being invoked is getRegionInfo, if you study the Service descriptor for the client to regionserver protocol, you will find that the request sends a GetRegionInfoRequest protobuf Message param in this position."},"8116":{"id":"/docs/rpc-39","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#request-parts","content":"`<CellBlock>`\\\nAn encoded and optionally compressed Cell block."},"8117":{"id":"/docs/rpc-40","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#response","content":"Same as Request, it is a protobuf ResponseHeader followed by a protobuf Message response where the Message response type suits the method invoked.\nBulk of the data may come in a following CellBlock."},"8118":{"id":"/docs/rpc-41","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#response-parts","content":"`<Total Length>`\\\nThe response is prefaced by an int that holds the total length of what follows."},"8119":{"id":"/docs/rpc-42","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#response-parts","content":"`<Protobuf ResponseHeader Message>`\\\nWill have call.id, etc.\nWill include exception if failed processing.\nOptionally includes metadata on optional, IFF there is a CellBlock following."},"8120":{"id":"/docs/rpc-43","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#response-parts","content":"`<Protobuf Response Message>`\\\nReturn or may be nothing if exception.\nIf the method being invoked is getRegionInfo, if you study the Service descriptor for the client to regionserver protocol, you will find that the response sends a GetRegionInfoResponse protobuf Message param in this position."},"8121":{"id":"/docs/rpc-44","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#response-parts","content":"`<CellBlock>`\\\nAn encoded and optionally compressed Cell block."},"8122":{"id":"/docs/rpc-45","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#exceptions","content":"There are two distinct types.\nThere is the request failed which is encapsulated inside the response header for the response.\nThe connection stays open to receive new requests.\nThe second type, the FatalConnectionException, kills the connection."},"8123":{"id":"/docs/rpc-46","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#exceptions","content":"Exceptions can carry extra information.\nSee the ExceptionResponse protobuf type.\nIt has a flag to indicate do-no-retry as well as other miscellaneous payload to help improve client responsiveness."},"8124":{"id":"/docs/rpc-47","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#cellblocks","content":"These are not versioned.\nServer can do the codec or it cannot.\nIf new version of a codec with say, tighter encoding, then give it a new class name.\nCodecs will live on the server for all time so old clients can connect."},"8125":{"id":"/docs/rpc-48","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-constraints","content":"In some part, current wire-format — i.e.\nall requests and responses preceded by a length — has been dictated by current server non-async architecture."},"8126":{"id":"/docs/rpc-49","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#one-fat-pb-request-or-headerparam","content":"We went with pb header followed by pb param making a request and a pb header followed by pb response for now.\nDoing header+param rather than a single protobuf Message with both header and param content:"},"8127":{"id":"/docs/rpc-50","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#one-fat-pb-request-or-headerparam","content":"Is closer to what we currently have"},"8128":{"id":"/docs/rpc-51","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#one-fat-pb-request-or-headerparam","content":"Having a single fat pb requires extra copying putting the already pb'd param into the body of the fat request pb (and same making result)"},"8129":{"id":"/docs/rpc-52","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#one-fat-pb-request-or-headerparam","content":"We can decide whether to accept the request or not before we read the param; for example, the request might be low priority.\nAs is, we read header+param in one go as server is currently implemented so this is a TODO."},"8130":{"id":"/docs/rpc-53","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#one-fat-pb-request-or-headerparam","content":"The advantages are minor.\nIf later, fat request has clear advantage, can roll out a v2 later."},"8131":{"id":"/docs/rpc-54","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#cellblock-codecs","content":"To enable a codec other than the default `KeyValueCodec`, set `hbase.client.rpc.codec` to the name of the Codec class to use.\nCodec must implement hbase's `Codec` Interface.\nAfter connection setup, all passed cellblocks will be sent with this codec.\nThe server will return cellblocks using this same codec as long as the codec is on the servers' CLASSPATH (else you will get `UnsupportedCellCodecException`)."},"8132":{"id":"/docs/rpc-55","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#cellblock-codecs","content":"To change the default codec, set `hbase.client.default.rpc.codec`."},"8133":{"id":"/docs/rpc-56","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#cellblock-codecs","content":"To disable cellblocks completely and to go pure protobuf, set the default to the empty String and do not specify a codec in your Configuration.\nSo, set `hbase.client.default.rpc.codec` to the empty string and do not set `hbase.client.rpc.codec`.\nThis will cause the client to connect to the server with no codec specified.\nIf a server sees no codec, it will return all responses in pure protobuf.\nRunning pure protobuf all the time will be slower than running with cellblocks."},"8134":{"id":"/docs/rpc-57","page_id":"/docs/rpc","tags":["multi-page"],"type":"text","url":"/docs/rpc#rpc-notes-rpc-configurations-compression","content":"Uses hadoop's compression codecs.\nTo enable compressing of passed CellBlocks, set `hbase.client.rpc.compressor` to the name of the Compressor to use.\nCompressor must implement Hadoop's CompressionCodec Interface.\nAfter connection setup, all passed cellblocks will be sent compressed.\nThe server will return cellblocks compressed using this same compressor as long as the compressor is on its CLASSPATH (else you will get `UnsupportedCompressionCodecException`)."},"8135":{"id":"/docs/schema-design","page_id":"/docs/schema-design","type":"page","content":"HBase and Schema Design","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts"],"tags":["multi-page"],"url":"/docs/schema-design"},"8136":{"id":"/docs/schema-design-0","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design","content":"Comprehensive guide to designing HBase schemas, including table and column family design, rowkey strategies, and best practices for optimal performance."},"8137":{"id":"/docs/schema-design-1","page_id":"/docs/schema-design","type":"heading","tags":["multi-page"],"url":"/docs/schema-design#schema-creation","content":"Schema Creation"},"8138":{"id":"/docs/schema-design-2","page_id":"/docs/schema-design","type":"heading","tags":["multi-page"],"url":"/docs/schema-design#schema-updates","content":"Schema Updates"},"8139":{"id":"/docs/schema-design-3","page_id":"/docs/schema-design","type":"heading","tags":["multi-page"],"url":"/docs/schema-design#table-schema-rules-of-thumb","content":"Table Schema Rules Of Thumb"},"8140":{"id":"/docs/schema-design-4","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design","content":"A good introduction on the strength and weaknesses modelling on the various non-rdbms datastores is to be found in Ian Varley's Master thesis, No Relation: The Mixed Blessings of Non-Relational Databases. It is a little dated now but a good background read if you have a moment on how HBase schema modeling differs from how it is done in an RDBMS. Also, read keyvalue for how HBase stores data internally, and the section on schema.casestudies."},"8141":{"id":"/docs/schema-design-5","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design","content":"The documentation on the Cloud Bigtable website, Designing Your Schema, is pertinent and nicely done and lessons learned there equally apply here in HBase land; just divide any quoted values by \\~10 to get what works for HBase: e.g. where it says individual values can be \\~10MBs in size, HBase can do similar — perhaps best to go smaller if you can — and where it says a maximum of 100 column families in Cloud Bigtable, think \\~10 when modeling on HBase."},"8142":{"id":"/docs/schema-design-6","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design","content":"See also Robert Yokota's HBase Application Archetypes (an update on work done by other HBasers), for a helpful categorization of use cases that do well on top of the HBase model."},"8143":{"id":"/docs/schema-design-7","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#schema-creation","content":"HBase schemas can be created or updated using the Apache HBase Shell or by using Admin in the Java API."},"8144":{"id":"/docs/schema-design-8","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#schema-creation","content":"Tables must be disabled when making ColumnFamily modifications, for example:"},"8145":{"id":"/docs/schema-design-9","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#schema-creation","content":"See client dependencies for more information about configuring client connections."},"8146":{"id":"/docs/schema-design-10","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#schema-creation","content":"Online schema changes are supported in the 0.92.x codebase, but the 0.90.x codebase requires the\ntable to be disabled."},"8147":{"id":"/docs/schema-design-11","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#schema-updates","content":"When changes are made to either Tables or ColumnFamilies (e.g. region size, block size), these changes take effect the next time there is a major compaction and the StoreFiles get re-written."},"8148":{"id":"/docs/schema-design-12","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#schema-updates","content":"See store for more information on StoreFiles."},"8149":{"id":"/docs/schema-design-13","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"There are many different data sets, with different access patterns and service-level expectations. Therefore, these rules of thumb are only an overview. Read the rest of this chapter to get more details after you have gone through this list."},"8150":{"id":"/docs/schema-design-14","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"Aim to have regions sized between 10 and 50 GB."},"8151":{"id":"/docs/schema-design-15","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"Aim to have cells no larger than 10 MB, or 50 MB if you use mob. Otherwise, consider storing your cell data in HDFS and store a pointer to the data in HBase."},"8152":{"id":"/docs/schema-design-16","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"A typical schema has between 1 and 3 column families per table. HBase tables should not be designed to mimic RDBMS tables."},"8153":{"id":"/docs/schema-design-17","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"Around 50-100 regions is a good number for a table with 1 or 2 column families. Remember that a region is a contiguous segment of a column family."},"8154":{"id":"/docs/schema-design-18","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"Keep your column family names as short as possible. The column family names are stored for every value (ignoring prefix encoding). They should not be self-documenting and descriptive like in a typical RDBMS."},"8155":{"id":"/docs/schema-design-19","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"If you are storing time-based machine data or logging information, and the row key is based on device ID or service ID plus time, you can end up with a pattern where older data regions never have additional writes beyond a certain age. In this type of situation, you end up with a small number of active regions and a large number of older regions which have no new writes. For these situations, you can tolerate a larger number of regions because your resource consumption is driven by the active regions only."},"8156":{"id":"/docs/schema-design-20","page_id":"/docs/schema-design","tags":["multi-page"],"type":"text","url":"/docs/schema-design#table-schema-rules-of-thumb","content":"If only one column family is busy with writes, only that column family accomulates memory. Be aware of write patterns when allocating resources."},"8157":{"id":"/docs/security/client-access","page_id":"/docs/security/client-access","type":"page","content":"Secure Client Access to Apache HBase","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security/client-access"},"8158":{"id":"/docs/security/client-access-0","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access","content":"Configuring Kerberos-based secure authentication for HBase clients, including server and client setup procedures."},"8159":{"id":"/docs/security/client-access-1","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#security-client-access-prerequisites","content":"Prerequisites"},"8160":{"id":"/docs/security/client-access-2","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#hadoop-authentication-configuration-toc","content":"Hadoop Authentication Configuration [!toc]"},"8161":{"id":"/docs/security/client-access-3","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#kerberos-kdc-toc","content":"Kerberos KDC [!toc]"},"8162":{"id":"/docs/security/client-access-4","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#server-side-configuration-for-secure-operation","content":"Server-side Configuration for Secure Operation"},"8163":{"id":"/docs/security/client-access-5","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Client-side Configuration for Secure Operation"},"8164":{"id":"/docs/security/client-access-6","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#client-side-configuration-for-secure-operation---thrift-gateway","content":"Client-side Configuration for Secure Operation - Thrift Gateway"},"8165":{"id":"/docs/security/client-access-7","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"Configure the Thrift Gateway to Authenticate on Behalf of the Client"},"8166":{"id":"/docs/security/client-access-8","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#configure-the-thrift-gateway-to-use-the-doas-feature","content":"Configure the Thrift Gateway to Use the `doAs` Feature"},"8167":{"id":"/docs/security/client-access-9","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"Client-side Configuration for Secure Operation - REST Gateway"},"8168":{"id":"/docs/security/client-access-10","page_id":"/docs/security/client-access","type":"heading","tags":["multi-page"],"url":"/docs/security/client-access#rest-gateway-impersonation-configuration","content":"REST Gateway Impersonation Configuration"},"8169":{"id":"/docs/security/client-access-11","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access","content":"Newer releases of Apache HBase (>= 0.92) support optional SASL authentication of clients. See also Matteo Bertozzi's article on Understanding User Authentication and Authorization in Apache HBase."},"8170":{"id":"/docs/security/client-access-12","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access","content":"This describes how to set up Apache HBase and clients for connection to secure HBase resources."},"8171":{"id":"/docs/security/client-access-13","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#hadoop-authentication-configuration-toc","content":"To run HBase RPC with strong authentication, you must set `hbase.security.authentication` to `kerberos`. In this case, you must also set `hadoop.security.authentication` to `kerberos` in core-site.xml. Otherwise, you would be using strong authentication for HBase but not for the underlying HDFS, which would cancel out any benefit."},"8172":{"id":"/docs/security/client-access-14","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#kerberos-kdc-toc","content":"You need to have a working Kerberos KDC."},"8173":{"id":"/docs/security/client-access-15","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#server-side-configuration-for-secure-operation","content":"First, refer to security.prerequisites and ensure that your underlying HDFS configuration is secure."},"8174":{"id":"/docs/security/client-access-16","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#server-side-configuration-for-secure-operation","content":"Add the following to the `hbase-site.xml` file on every server machine in the cluster:"},"8175":{"id":"/docs/security/client-access-17","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#server-side-configuration-for-secure-operation","content":"A full shutdown and restart of HBase service is required when deploying these configuration changes."},"8176":{"id":"/docs/security/client-access-18","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"First, refer to Prerequisites and ensure that your underlying HDFS configuration is secure."},"8177":{"id":"/docs/security/client-access-19","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Add the following to the `hbase-site.xml` file on every client:"},"8178":{"id":"/docs/security/client-access-20","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Before 2.2.0 version, the client environment must be logged in to Kerberos from KDC or keytab via the `kinit` command before communication with the HBase cluster will be possible."},"8179":{"id":"/docs/security/client-access-21","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Since 2.2.0, client can specify the following configurations in `hbase-site.xml`:"},"8180":{"id":"/docs/security/client-access-22","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Then application can automatically do the login and credential renewal jobs without client interference."},"8181":{"id":"/docs/security/client-access-23","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"It's optional feature, client, who upgrades to 2.2.0, can still keep their login and credential renewal logic already did in older version, as long as keeping `hbase.client.keytab.file` and `hbase.client.keytab.principal` are unset."},"8182":{"id":"/docs/security/client-access-24","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Be advised that if the `hbase.security.authentication` in the client- and server-side site files do not match, the client will not be able to communicate with the cluster."},"8183":{"id":"/docs/security/client-access-25","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Once HBase is configured for secure RPC it is possible to optionally configure encrypted communication. To do so, add the following to the `hbase-site.xml` file on every client:"},"8184":{"id":"/docs/security/client-access-26","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"This configuration property can also be set on a per-connection basis. Set it in the `Configuration` supplied to `Table`:"},"8185":{"id":"/docs/security/client-access-27","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation","content":"Expect a \\~10% performance penalty for encrypted communication."},"8186":{"id":"/docs/security/client-access-28","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---thrift-gateway","content":"Add the following to the `hbase-site.xml` file for every Thrift gateway:"},"8187":{"id":"/docs/security/client-access-29","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---thrift-gateway","content":"When `hbase.unsafe.thrift.hostname` is set to a non-empty value, the Thrift gateway uses the\nconfigured value instead of the hostname discovered through `hbase.thrift.dns.interface` and\n`hbase.thrift.dns.nameserver`. The configured hostname is used for Kerberos `_HOST`\nsubstitution and as the SASL server hostname. This can be useful when multiple Thrift gateways\nare exposed through a common DNS name, VIP, or layer-4 load balancer. Each gateway using the\ncommon hostname must have a keytab containing the corresponding service principal."},"8188":{"id":"/docs/security/client-access-30","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---thrift-gateway","content":"Substitute the appropriate credential and keytab for *\\$USER&#x2A; and *\\$KEYTAB* respectively."},"8189":{"id":"/docs/security/client-access-31","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---thrift-gateway","content":"In order to use the Thrift API principal to interact with HBase, it is also necessary to add the `hbase.thrift.kerberos.principal` to the `acl` table. For example, to give the Thrift API principal, `thrift_server`, administrative access, a command such as this one will suffice:"},"8190":{"id":"/docs/security/client-access-32","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---thrift-gateway","content":"For more information about ACLs, please see the Access Control Labels (ACLs) section"},"8191":{"id":"/docs/security/client-access-33","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---thrift-gateway","content":"The Thrift gateway will authenticate with HBase using the supplied credential. No authentication will be performed by the Thrift gateway itself. All client access via the Thrift gateway will use the Thrift gateway's credential and have its privilege."},"8192":{"id":"/docs/security/client-access-34","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"Client-side Configuration for Secure Operation - Thrift Gateway describes how to authenticate a Thrift client to HBase using a fixed user. As an alternative, you can configure the Thrift gateway to authenticate to HBase on the client's behalf, and to access HBase using a proxy user. This was implemented in HBASE-11349 for Thrift 1, and HBASE-11474 for Thrift 2."},"8193":{"id":"/docs/security/client-access-35","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"If you use framed transport, you cannot yet take advantage of this feature, because SASL does not\nwork with Thrift framed transport at this time."},"8194":{"id":"/docs/security/client-access-36","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"To enable it, do the following."},"8195":{"id":"/docs/security/client-access-37","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"Be sure Thrift is running in secure mode, by following the procedure described in Client-side Configuration for Secure Operation - Thrift Gateway."},"8196":{"id":"/docs/security/client-access-38","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"Be sure that HBase is configured to allow proxy users, as described in REST Gateway Impersonation Configuration."},"8197":{"id":"/docs/security/client-access-39","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"In *hbase-site.xml* for each cluster node running a Thrift gateway, set the property `hbase.thrift.security.qop` to one of the following three values:"},"8198":{"id":"/docs/security/client-access-40","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"`privacy` - authentication, integrity, and confidentiality checking."},"8199":{"id":"/docs/security/client-access-41","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"`integrity` - authentication and integrity checking"},"8200":{"id":"/docs/security/client-access-42","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"`authentication` - authentication checking only"},"8201":{"id":"/docs/security/client-access-43","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-authenticate-on-behalf-of-the-client","content":"Restart the Thrift gateway processes for the changes to take effect. If a node is running Thrift, the output of the `jps` command will list a `ThriftServer` process. To stop Thrift on a node, run the command `bin/hbase-daemon.sh stop thrift`. To start Thrift on a node, run the command `bin/hbase-daemon.sh start thrift`."},"8202":{"id":"/docs/security/client-access-44","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-use-the-doas-feature","content":"Configure the Thrift Gateway to Authenticate on Behalf of the Client describes how to configure the Thrift gateway to authenticate to HBase on the client's behalf, and to access HBase using a proxy user. The limitation of this approach is that after the client is initialized with a particular set of credentials, it cannot change these credentials during the session. The `doAs` feature provides a flexible way to impersonate multiple principals using the same client. This feature was implemented in HBASE-12640 for Thrift 1, but is currently not available for Thrift 2."},"8203":{"id":"/docs/security/client-access-45","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-use-the-doas-feature","content":"**To enable the `doAs` feature**, add the following to the *hbase-site.xml* file for every Thrift gateway:"},"8204":{"id":"/docs/security/client-access-46","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-use-the-doas-feature","content":"**To allow proxy users** when using `doAs` impersonation, add the following to the *hbase-site.xml* file for every HBase node:"},"8205":{"id":"/docs/security/client-access-47","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#configure-the-thrift-gateway-to-use-the-doas-feature","content":"Take a look at the demo client to get an overall idea of how to use this feature in your client."},"8206":{"id":"/docs/security/client-access-48","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"Add the following to the `hbase-site.xml` file for every REST gateway:"},"8207":{"id":"/docs/security/client-access-49","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"Substitute the appropriate credential and keytab for *\\$USER&#x2A; and *\\$KEYTAB* respectively."},"8208":{"id":"/docs/security/client-access-50","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"The REST gateway will authenticate with HBase using the supplied credential."},"8209":{"id":"/docs/security/client-access-51","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"In order to use the REST API principal to interact with HBase, it is also necessary to add the `hbase.rest.kerberos.principal` to the `acl` table. For example, to give the REST API principal, `rest_server`, administrative access, a command such as this one will suffice:"},"8210":{"id":"/docs/security/client-access-52","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"For more information about ACLs, please see the Access Control Labels (ACLs) section"},"8211":{"id":"/docs/security/client-access-53","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"HBase REST gateway supports SPNEGO HTTP authentication for client access to the gateway. To enable REST gateway Kerberos authentication for client access, add the following to the `hbase-site.xml` file for every REST gateway."},"8212":{"id":"/docs/security/client-access-54","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"Substitute the keytab for HTTP for *\\$KEYTAB*."},"8213":{"id":"/docs/security/client-access-55","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#client-side-configuration-for-secure-operation---rest-gateway","content":"HBase REST gateway supports different 'hbase.rest.authentication.type': simple, kerberos. You can also implement a custom authentication by implementing Hadoop AuthenticationHandler, then specify the full class name as 'hbase.rest.authentication.type' value. For more information, refer to SPNEGO HTTP authentication."},"8214":{"id":"/docs/security/client-access-56","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#rest-gateway-impersonation-configuration","content":"By default, the REST gateway doesn't support impersonation. It accesses the HBase on behalf of clients as the user configured as in the previous section. To the HBase server, all requests are from the REST gateway user. The actual users are unknown. You can turn on the impersonation support. With impersonation, the REST gateway user is a proxy user. The HBase server knows the actual/real user of each request. So it can apply proper authorizations."},"8215":{"id":"/docs/security/client-access-57","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#rest-gateway-impersonation-configuration","content":"To turn on REST gateway impersonation, we need to configure HBase servers (masters and region servers) to allow proxy users; configure REST gateway to enable impersonation."},"8216":{"id":"/docs/security/client-access-58","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#rest-gateway-impersonation-configuration","content":"To allow proxy users, add the following to the `hbase-site.xml` file for every HBase server:"},"8217":{"id":"/docs/security/client-access-59","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#rest-gateway-impersonation-configuration","content":"Substitute the REST gateway proxy user for *\\$USER&#x2A;, and the allowed group list for *\\$GROUPS*."},"8218":{"id":"/docs/security/client-access-60","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#rest-gateway-impersonation-configuration","content":"To enable REST gateway impersonation, add the following to the `hbase-site.xml` file for every REST gateway."},"8219":{"id":"/docs/security/client-access-61","page_id":"/docs/security/client-access","tags":["multi-page"],"type":"text","url":"/docs/security/client-access#rest-gateway-impersonation-configuration","content":"Substitute the keytab for HTTP for *\\$KEYTAB*."},"8220":{"id":"/docs/security/data-access","page_id":"/docs/security/data-access","type":"page","content":"Securing Access To Your Data","breadcrumbs":["Docs","Multi-Page Documentation","Core Concepts","Security"],"tags":["multi-page"],"url":"/docs/security/data-access"},"8221":{"id":"/d