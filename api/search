es#no-permanent-state-in-zookeeper","content":"No permanent state in ZooKeeper"},"1781":{"id":"/docs/building-and-developing/developer-guidelines-20","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#running-in-situ","content":"Running In-Situ"},"1782":{"id":"/docs/building-and-developing/developer-guidelines-21","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#adding-metrics","content":"Adding Metrics"},"1783":{"id":"/docs/building-and-developing/developer-guidelines-22","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#add-metric-name-and-function-to-hadoop-compat-interface","content":"Add Metric name and Function to Hadoop Compat Interface."},"1784":{"id":"/docs/building-and-developing/developer-guidelines-23","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#add-the-implementation-to-both-hadoop-1-and-hadoop-2-compat-modules","content":"Add the Implementation to Both Hadoop 1 and Hadoop 2 Compat modules."},"1785":{"id":"/docs/building-and-developing/developer-guidelines-24","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#git-best-practices","content":"Git Best Practices"},"1786":{"id":"/docs/building-and-developing/developer-guidelines-25","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#rebase_all_git_branchessh","content":"`rebase_all_git_branches.sh`"},"1787":{"id":"/docs/building-and-developing/developer-guidelines-26","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#submitting-patches","content":"Submitting Patches"},"1788":{"id":"/docs/building-and-developing/developer-guidelines-27","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#few-general-guidelines","content":"Few general guidelines"},"1789":{"id":"/docs/building-and-developing/developer-guidelines-28","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#developer-guidelines-submitting-patches-unit-tests","content":"Unit Tests"},"1790":{"id":"/docs/building-and-developing/developer-guidelines-29","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#developer-guidelines-submitting-patches-integration-tests","content":"Integration Tests"},"1791":{"id":"/docs/building-and-developing/developer-guidelines-30","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"ReviewBoard"},"1792":{"id":"/docs/building-and-developing/developer-guidelines-31","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#github","content":"GitHub"},"1793":{"id":"/docs/building-and-developing/developer-guidelines-32","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#github-tooling","content":"GitHub Tooling"},"1794":{"id":"/docs/building-and-developing/developer-guidelines-33","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#guide-for-hbase-committers","content":"Guide for HBase Committers"},"1795":{"id":"/docs/building-and-developing/developer-guidelines-34","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Becoming a committer"},"1796":{"id":"/docs/building-and-developing/developer-guidelines-35","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#new-committers","content":"New committers"},"1797":{"id":"/docs/building-and-developing/developer-guidelines-36","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#review","content":"Review"},"1798":{"id":"/docs/building-and-developing/developer-guidelines-37","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#reject","content":"Reject"},"1799":{"id":"/docs/building-and-developing/developer-guidelines-38","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#commit","content":"Commit"},"1800":{"id":"/docs/building-and-developing/developer-guidelines-39","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#dialog","content":"Dialog"},"1801":{"id":"/docs/building-and-developing/developer-guidelines-40","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#do-not-edit-jira-comments","content":"Do not edit JIRA comments"},"1802":{"id":"/docs/building-and-developing/developer-guidelines-41","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"The hbase-thirdparty dependency and shading/relocation"},"1803":{"id":"/docs/building-and-developing/developer-guidelines-42","page_id":"/docs/building-and-developing/developer-guidelines","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/developer-guidelines#development-of-hbase-related-maven-archetypes","content":"Development of HBase-related Maven archetypes"},"1804":{"id":"/docs/building-and-developing/developer-guidelines-43","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#branches","content":"We use Git for source code management and latest development happens on `master` branch. There are\nbranches for past major/minor/maintenance releases and important features and bug fixes are often\nback-ported to them."},"1805":{"id":"/docs/building-and-developing/developer-guidelines-44","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#policy-for-fix-version-in-jira","content":"To determine if a given fix is in a given release purely from the release numbers following rules\nare defined:"},"1806":{"id":"/docs/building-and-developing/developer-guidelines-45","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#policy-for-fix-version-in-jira","content":"Fix version of X.Y.Z => fixed in all releases X.Y.Z' (where Z' = Z).\\\nFix version of X.Y.0 => fixed in all releases X.Y'.\\* (where Y' = Y).\\\nFix version of X.0.0 => fixed in all releases X'.\\*.\\* (where X' = X)."},"1807":{"id":"/docs/building-and-developing/developer-guidelines-46","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#policy-for-fix-version-in-jira","content":"By this policy, fix version of 1.3.0 implies 1.4.0, but 1.3.2 does not imply 1.4.0 as we could not\ntell purely from the numbers which release came first."},"1808":{"id":"/docs/building-and-developing/developer-guidelines-47","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interface-classifications","content":"Interfaces are classified both by audience and by stability level.\nThese labels appear at the head of a class.\nThe conventions followed by HBase are inherited by its parent project, Hadoop."},"1809":{"id":"/docs/building-and-developing/developer-guidelines-48","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interface-classifications","content":"The following interface classifications are commonly used:"},"1810":{"id":"/docs/building-and-developing/developer-guidelines-49","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfaceaudience","content":"`@InterfaceAudience.Public`\\\nAPIs for users and HBase applications.\nThese APIs will be deprecated through major versions of HBase."},"1811":{"id":"/docs/building-and-developing/developer-guidelines-50","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfaceaudience","content":"`@InterfaceAudience.Private`\\\nAPIs for HBase internals developers.\nNo guarantees on compatibility or availability in future versions.\nPrivate interfaces do not need an `@InterfaceStability` classification."},"1812":{"id":"/docs/building-and-developing/developer-guidelines-51","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfaceaudience","content":"`@InterfaceAudience.LimitedPrivate(HBaseInterfaceAudience.COPROC)`\\\nAPIs for HBase coprocessor writers."},"1813":{"id":"/docs/building-and-developing/developer-guidelines-52","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfaceaudience","content":"**No `@InterfaceAudience` Classification**:\\\nPackages without an `@InterfaceAudience` label are considered private.\nMark your new packages if publicly accessible."},"1814":{"id":"/docs/building-and-developing/developer-guidelines-53","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfaceaudience","content":"Only interfaces classified `@InterfaceAudience.Public` should be included in API documentation\n(Javadoc). Committers must add new package excludes `ExcludePackageNames` section of the *pom.xml*\nfor new packages which do not contain public classes."},"1815":{"id":"/docs/building-and-developing/developer-guidelines-54","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfacestability","content":"`@InterfaceStability` is important for packages marked `@InterfaceAudience.Public`."},"1816":{"id":"/docs/building-and-developing/developer-guidelines-55","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfacestability","content":"`@InterfaceStability.Stable`\\\nPublic packages marked as stable cannot be changed without a deprecation path or a very good reason."},"1817":{"id":"/docs/building-and-developing/developer-guidelines-56","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfacestability","content":"`@InterfaceStability.Unstable`\\\nPublic packages marked as unstable can be changed without a deprecation path."},"1818":{"id":"/docs/building-and-developing/developer-guidelines-57","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfacestability","content":"`@InterfaceStability.Evolving`\\\nPublic packages marked as evolving may be changed, but it is discouraged."},"1819":{"id":"/docs/building-and-developing/developer-guidelines-58","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfacestability","content":"**No `@InterfaceStability` Label**:\nPublic classes with no `@InterfaceStability` label are discouraged, and should be considered implicitly unstable."},"1820":{"id":"/docs/building-and-developing/developer-guidelines-59","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#interfacestability","content":"If you are unclear about how to mark packages, ask on the development list."},"1821":{"id":"/docs/building-and-developing/developer-guidelines-60","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#code-formatting-conventions","content":"Please adhere to the following guidelines so that your patches can be reviewed more quickly.\nThese guidelines have been developed based upon common feedback on patches from new contributors."},"1822":{"id":"/docs/building-and-developing/developer-guidelines-61","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#code-formatting-conventions","content":"See the Code Conventions for the Java Programming Language for more information on coding conventions in Java.\nSee Eclipse Code Formatting to setup Eclipse to check for some of\nthese guidelines automatically."},"1823":{"id":"/docs/building-and-developing/developer-guidelines-62","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#space-invaders","content":"Do not use extra spaces around brackets.\nUse the second style, rather than the first."},"1824":{"id":"/docs/building-and-developing/developer-guidelines-63","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#auto-generated-code","content":"Auto-generated code in Eclipse often uses bad variable names such as `arg0`.\nUse more informative variable names.\nUse code like the second example here."},"1825":{"id":"/docs/building-and-developing/developer-guidelines-64","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#long-lines","content":"Keep lines less than 100 characters.\nYou can configure your IDE to do this automatically."},"1826":{"id":"/docs/building-and-developing/developer-guidelines-65","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#trailing-spaces","content":"Be sure there is a line break after the end of your code, and avoid lines with nothing but whitespace.\nThis makes diffs more meaningful.\nYou can configure your IDE to help with this."},"1827":{"id":"/docs/building-and-developing/developer-guidelines-66","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#api-documentation-javadoc","content":"Don't forget Javadoc!"},"1828":{"id":"/docs/building-and-developing/developer-guidelines-67","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#api-documentation-javadoc","content":"Javadoc warnings are checked during precommit.\nIf the precommit tool gives you a '-1', please fix the javadoc issue.\nYour patch won't be committed if it adds such warnings."},"1829":{"id":"/docs/building-and-developing/developer-guidelines-68","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#api-documentation-javadoc","content":"Also, no `@author` tags - that's a rule."},"1830":{"id":"/docs/building-and-developing/developer-guidelines-69","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#findbugs","content":"`Findbugs` is used to detect common bugs pattern.\nIt is checked during the precommit build.\nIf errors are found, please fix them.\nYou can run findbugs locally with `mvn\n                            findbugs:findbugs`, which will generate the `findbugs` files locally.\nSometimes, you may have to write code smarter than `findbugs`.\nYou can annotate your code to tell `findbugs` you know what you're doing, by annotating your class with the following annotation:"},"1831":{"id":"/docs/building-and-developing/developer-guidelines-70","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#findbugs","content":"It is important to use the Apache-licensed version of the annotations. That generally means using\nannotations in the `edu.umd.cs.findbugs.annotations` package so that we can rely on the cleanroom\nreimplementation rather than annotations in the `javax.annotations` package."},"1832":{"id":"/docs/building-and-developing/developer-guidelines-71","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#javadoc---useless-defaults","content":"Don't just leave javadoc tags the way IDE generates them, or fill redundant information in them."},"1833":{"id":"/docs/building-and-developing/developer-guidelines-72","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#javadoc---useless-defaults","content":"Either add something descriptive to the tags, or just remove them.\nThe preference is to add something descriptive and useful."},"1834":{"id":"/docs/building-and-developing/developer-guidelines-73","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#one-thing-at-a-time-folks","content":"If you submit a patch for one thing, don't do auto-reformatting or unrelated reformatting of code on a completely different area of code."},"1835":{"id":"/docs/building-and-developing/developer-guidelines-74","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#one-thing-at-a-time-folks","content":"Likewise, don't add unrelated cleanup or refactorings outside the scope of your Jira."},"1836":{"id":"/docs/building-and-developing/developer-guidelines-75","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#ambiguous-unit-tests","content":"Make sure that you're clear about what you are testing in your unit tests and why."},"1837":{"id":"/docs/building-and-developing/developer-guidelines-76","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#garbage-collection-conserving-guidelines","content":"The following guidelines were borrowed from http\\://engineering.linkedin.com/performance/linkedin-feed-faster-less-jvm-garbage.\nKeep them in mind to keep preventable garbage collection to a minimum. Have a look\nat the blog post for some great examples of how to refactor your code according to\nthese guidelines."},"1838":{"id":"/docs/building-and-developing/developer-guidelines-77","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#garbage-collection-conserving-guidelines","content":"Be careful with Iterators"},"1839":{"id":"/docs/building-and-developing/developer-guidelines-78","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#garbage-collection-conserving-guidelines","content":"Estimate the size of a collection when initializing"},"1840":{"id":"/docs/building-and-developing/developer-guidelines-79","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#garbage-collection-conserving-guidelines","content":"Defer expression evaluation"},"1841":{"id":"/docs/building-and-developing/developer-guidelines-80","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#garbage-collection-conserving-guidelines","content":"Compile the regex patterns in advance"},"1842":{"id":"/docs/building-and-developing/developer-guidelines-81","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#garbage-collection-conserving-guidelines","content":"Cache it if you can"},"1843":{"id":"/docs/building-and-developing/developer-guidelines-82","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#garbage-collection-conserving-guidelines","content":"String Interns are useful but dangerous"},"1844":{"id":"/docs/building-and-developing/developer-guidelines-83","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#invariants","content":"We don't have many but what we have we list below.\nAll are subject to challenge of course but until then, please hold to the rules of the road."},"1845":{"id":"/docs/building-and-developing/developer-guidelines-84","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#no-permanent-state-in-zookeeper","content":"ZooKeeper state should transient (treat it like memory). If ZooKeeper state is deleted, hbase should be able to recover and essentially be in the same state."},"1846":{"id":"/docs/building-and-developing/developer-guidelines-85","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#no-permanent-state-in-zookeeper","content":".Exceptions: There are currently a few exceptions that we need to fix around whether a table is enabled or disabled."},"1847":{"id":"/docs/building-and-developing/developer-guidelines-86","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#no-permanent-state-in-zookeeper","content":"Replication data is currently stored only in ZooKeeper.\nDeleting ZooKeeper data related to replication may cause replication to be disabled.\nDo not delete the replication tree, &#x2A;/hbase/replication/*."},"1848":{"id":"/docs/building-and-developing/developer-guidelines-87","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#no-permanent-state-in-zookeeper","content":"Replication may be disrupted and data loss may occur if you delete the replication tree\n(&#x2A;/hbase/replication/*) from ZooKeeper. Follow progress on this issue at\nHBASE-10295."},"1849":{"id":"/docs/building-and-developing/developer-guidelines-88","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#running-in-situ","content":"If you are developing Apache HBase, frequently it is useful to test your changes against a more-real cluster than what you find in unit tests.\nIn this case, HBase can be run directly from the source in local-mode.\nAll you need to do is run:"},"1850":{"id":"/docs/building-and-developing/developer-guidelines-89","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#running-in-situ","content":"This will spin up a full local-cluster, just as if you had packaged up HBase and installed it on your machine."},"1851":{"id":"/docs/building-and-developing/developer-guidelines-90","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#running-in-situ","content":"Keep in mind that you will need to have installed HBase into your local maven repository for the in-situ cluster to work properly.\nThat is, you will need to run:"},"1852":{"id":"/docs/building-and-developing/developer-guidelines-91","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#running-in-situ","content":"to ensure that maven can find the correct classpath and dependencies.\nGenerally, the above command is just a good thing to try running first, if maven is acting oddly."},"1853":{"id":"/docs/building-and-developing/developer-guidelines-92","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#adding-metrics","content":"After adding a new feature a developer might want to add metrics.\nHBase exposes metrics using the Hadoop Metrics 2 system, so adding a new metric involves exposing that metric to the hadoop system.\nUnfortunately the API of metrics2 changed from hadoop 1 to hadoop 2.\nIn order to get around this a set of interfaces and implementations have to be loaded at runtime.\nTo get an in-depth look at the reasoning and structure of these classes you can read the blog post located here.\nTo add a metric to an existing MBean follow the short guide below:"},"1854":{"id":"/docs/building-and-developing/developer-guidelines-93","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#add-metric-name-and-function-to-hadoop-compat-interface","content":"Inside of the source interface the corresponds to where the metrics are generated (eg MetricsMasterSource for things coming from HMaster) create new static strings for metric name and description.\nThen add a new method that will be called to add new reading."},"1855":{"id":"/docs/building-and-developing/developer-guidelines-94","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#add-the-implementation-to-both-hadoop-1-and-hadoop-2-compat-modules","content":"Inside of the implementation of the source (eg.\nMetricsMasterSourceImpl in the above example) create a new histogram, counter, gauge, or stat in the init method.\nThen in the method that was added to the interface wire up the parameter passed in to the histogram."},"1856":{"id":"/docs/building-and-developing/developer-guidelines-95","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#add-the-implementation-to-both-hadoop-1-and-hadoop-2-compat-modules","content":"Now add tests that make sure the data is correctly exported to the metrics 2 system.\nFor this the MetricsAssertHelper is provided."},"1857":{"id":"/docs/building-and-developing/developer-guidelines-96","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#git-best-practices","content":"**Avoid git merges.**\\\nUse `git pull --rebase` or `git fetch` followed by `git rebase`."},"1858":{"id":"/docs/building-and-developing/developer-guidelines-97","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#git-best-practices","content":"**Do not use `git push --force`.**\\\nIf the push does not work, fix the problem or ask for help."},"1859":{"id":"/docs/building-and-developing/developer-guidelines-98","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#git-best-practices","content":"Please contribute to this document if you think of other Git best practices."},"1860":{"id":"/docs/building-and-developing/developer-guidelines-99","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#rebase_all_git_branchessh","content":"The *dev-support/rebase\\_all\\_git\\_branches.sh* script is provided to help keep your Git repository clean.\nUse the `-h` parameter to get usage instructions.\nThe script automatically refreshes your tracking branches, attempts an automatic rebase of each local branch against its remote branch, and gives you the option to delete any branch which represents a closed `HBASE-` JIRA.\nThe script has one optional configuration option, the location of your Git directory.\nYou can set a default by editing the script.\nOtherwise, you can pass the git directory manually by using the `-d&#x60; parameter, followed by an absolute or relative directory name, or even '.' for the current working directory.\nThe script checks the directory for sub-directory called &#x2A;.git/*, before proceeding."},"1861":{"id":"/docs/building-and-developing/developer-guidelines-100","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#submitting-patches","content":"If you are new to submitting patches to open source or new to submitting patches to Apache, start by\nreading the On Contributing Patches page from\nApache Commons Project.\nIt provides a nice overview that applies equally to the Apache HBase Project."},"1862":{"id":"/docs/building-and-developing/developer-guidelines-101","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#submitting-patches","content":"Make sure you review Code Formatting Conventions for code style. If your patch\nwas generated incorrectly or your code does not adhere to the code formatting guidelines, you may\nbe asked to redo some work."},"1863":{"id":"/docs/building-and-developing/developer-guidelines-102","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#submitting-patches","content":"HBase enforces code style via a maven plugin. After you've written up your changes, apply the\nformatter before committing."},"1864":{"id":"/docs/building-and-developing/developer-guidelines-103","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#submitting-patches","content":"When your commit is ready, present it to the community as a\nGitHub Pull Request."},"1865":{"id":"/docs/building-and-developing/developer-guidelines-104","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#few-general-guidelines","content":"Always patch against the master branch first, even if you want to patch in another branch.\nHBase committers always apply patches first to the master branch, and backport as necessary. For\ncomplex patches, you may be asked to perform the backport(s) yourself."},"1866":{"id":"/docs/building-and-developing/developer-guidelines-105","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#few-general-guidelines","content":"Submit one single PR for a single fix. If necessary, squash local commits to merge local commits\ninto a single one first. See this\nStack Overflow\nquestion for more information about squashing commits."},"1867":{"id":"/docs/building-and-developing/developer-guidelines-106","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#few-general-guidelines","content":"Please understand that not every patch may get committed, and that feedback will likely be\nprovided on the patch."},"1868":{"id":"/docs/building-and-developing/developer-guidelines-107","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#developer-guidelines-submitting-patches-unit-tests","content":"Always add and/or update relevant unit tests when making the changes.\nMake sure that new/changed unit tests pass locally before submitting the patch because it is faster\nthan waiting for presubmit result which runs full test suite. This will save your own time and\neffort.\nUse Mockito to make mocks which are very useful for testing failure scenarios by\ninjecting appropriate failures."},"1869":{"id":"/docs/building-and-developing/developer-guidelines-108","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#developer-guidelines-submitting-patches-unit-tests","content":"If you are creating a new unit test class, notice how other unit test classes have\nclassification/sizing annotations before class name and a static methods for setup/teardown of\ntesting environment. Be sure to include annotations in any new unit test files.\nSee Tests for more information on tests."},"1870":{"id":"/docs/building-and-developing/developer-guidelines-109","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#developer-guidelines-submitting-patches-integration-tests","content":"Significant new features should provide an integration test in addition to unit tests, suitable for exercising the new feature at different points in its configuration space."},"1871":{"id":"/docs/building-and-developing/developer-guidelines-110","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"Patches larger than one screen, or patches that will be tricky to review, should go through ReviewBoard."},"1872":{"id":"/docs/building-and-developing/developer-guidelines-111","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"**Procedure: Use ReviewBoard**"},"1873":{"id":"/docs/building-and-developing/developer-guidelines-112","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"Register for an account if you don't already have one.\nIt does not use the credentials from issues.apache.org.\nLog in."},"1874":{"id":"/docs/building-and-developing/developer-guidelines-113","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"Click **New Review Request**."},"1875":{"id":"/docs/building-and-developing/developer-guidelines-114","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"Choose the `hbase-git` repository.\nClick Choose File to select the diff and optionally a parent diff.\nClick **Create Review Request**."},"1876":{"id":"/docs/building-and-developing/developer-guidelines-115","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"Fill in the fields as required.\nAt the minimum, fill in the **Summary** and choose `hbase` as the **Review Group**.\nIf you fill in the **Bugs** field, the review board links back to the relevant JIRA.\nThe more fields you fill in, the better.\nClick **Publish** to make your review request public.\nAn email will be sent to everyone in the `hbase` group, to review the patch."},"1877":{"id":"/docs/building-and-developing/developer-guidelines-116","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"Back in your JIRA, click , and paste in the URL of your ReviewBoard request.\nThis attaches the ReviewBoard to the JIRA, for easy access."},"1878":{"id":"/docs/building-and-developing/developer-guidelines-117","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"To cancel the request, click ."},"1879":{"id":"/docs/building-and-developing/developer-guidelines-118","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reviewboard","content":"For more information on how to use ReviewBoard, see the ReviewBoard\ndocumentation."},"1880":{"id":"/docs/building-and-developing/developer-guidelines-119","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#github","content":"Submitting GitHub pull requests is another accepted form of\ncontributing patches. Refer to GitHub documentation for details on\nhow to create pull requests."},"1881":{"id":"/docs/building-and-developing/developer-guidelines-120","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#github","content":"This section is incomplete and needs to be updated. Refer to\nHBASE-23557"},"1882":{"id":"/docs/building-and-developing/developer-guidelines-121","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#github-tooling","content":"**Browser bookmarks**"},"1883":{"id":"/docs/building-and-developing/developer-guidelines-122","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#github-tooling","content":"Following is a useful javascript based browser bookmark that redirects from GitHub pull\nrequests to the corresponding jira work item. This redirects based on the HBase jira ID mentioned\nin the issue title for the PR. Add the following javascript snippet as a browser bookmark to the\ntool bar. Clicking on it while you are on an HBase GitHub PR page redirects you to the corresponding\njira item."},"1884":{"id":"/docs/building-and-developing/developer-guidelines-123","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Committers are responsible for reviewing and integrating code changes, testing\nand voting on release candidates, weighing in on design discussions, as well as\nother types of project contributions. The PMC votes to make a contributor a\ncommitter based on an assessment of their contributions to the project. It is\nexpected that committers demonstrate a sustained history of high-quality\ncontributions to the project and community involvement."},"1885":{"id":"/docs/building-and-developing/developer-guidelines-124","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Contributions can be made in many ways. There is no single path to becoming a\ncommitter, nor any expected timeline. Submitting features, improvements, and bug\nfixes is the most common avenue, but other methods are both recognized and\nencouraged (and may be even more important to the health of HBase as a project and a\ncommunity). A non-exhaustive list of potential contributions (in no particular\norder):"},"1886":{"id":"/docs/building-and-developing/developer-guidelines-125","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Update the documentation for new\nchanges, best practices, recipes, and other improvements."},"1887":{"id":"/docs/building-and-developing/developer-guidelines-126","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Keep the website up to date."},"1888":{"id":"/docs/building-and-developing/developer-guidelines-127","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Perform testing and report the results. For instance, scale testing and\ntesting non-standard configurations is always appreciated."},"1889":{"id":"/docs/building-and-developing/developer-guidelines-128","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Maintain the shared Jenkins testing environment and other testing\ninfrastructure."},"1890":{"id":"/docs/building-and-developing/developer-guidelines-129","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Vote on release candidates after performing validation, even if non-binding.\nA non-binding vote is a vote by a non-committer."},"1891":{"id":"/docs/building-and-developing/developer-guidelines-130","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Provide input for discussion threads on the mailing lists (which usually have\n`[DISCUSS]` in the subject line)."},"1892":{"id":"/docs/building-and-developing/developer-guidelines-131","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Answer questions on the user or developer mailing lists and on\nSlack."},"1893":{"id":"/docs/building-and-developing/developer-guidelines-132","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Make sure the HBase community is a welcoming one and that we adhere to our\nCode of conduct. Alert the PMC if you\nhave concerns."},"1894":{"id":"/docs/building-and-developing/developer-guidelines-133","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Review other people's work (both code and non-code) and provide public\nfeedback."},"1895":{"id":"/docs/building-and-developing/developer-guidelines-134","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Report bugs that are found, or file new feature requests."},"1896":{"id":"/docs/building-and-developing/developer-guidelines-135","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Triage issues and keep JIRA organized. This includes closing stale issues,\nlabeling new issues, updating metadata, and other tasks as needed."},"1897":{"id":"/docs/building-and-developing/developer-guidelines-136","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Mentor new contributors of all sorts."},"1898":{"id":"/docs/building-and-developing/developer-guidelines-137","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Give talks and write blogs about HBase. Add these to the News section\nof the website."},"1899":{"id":"/docs/building-and-developing/developer-guidelines-138","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Provide UX feedback about HBase, the web UI, the CLI, APIs, and the website."},"1900":{"id":"/docs/building-and-developing/developer-guidelines-139","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Write demo applications and scripts."},"1901":{"id":"/docs/building-and-developing/developer-guidelines-140","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Help attract and retain a diverse community."},"1902":{"id":"/docs/building-and-developing/developer-guidelines-141","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Interact with other projects in ways that benefit HBase and those other\nprojects."},"1903":{"id":"/docs/building-and-developing/developer-guidelines-142","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#becoming-a-committer","content":"Not every individual is able to do all (or even any) of the items on this list.\nIf you think of other ways to contribute, go for it (and add them to the list).\nA pleasant demeanor and willingness to contribute are all you need to make a\npositive impact on the HBase project. Invitations to become a committer are the\nresult of steady interaction with the community over the long term, which builds\ntrust and recognition."},"1904":{"id":"/docs/building-and-developing/developer-guidelines-143","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#new-committers","content":"New committers are encouraged to first read Apache's generic committer\ndocumentation:"},"1905":{"id":"/docs/building-and-developing/developer-guidelines-144","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#new-committers","content":"Apache New Committer Guide"},"1906":{"id":"/docs/building-and-developing/developer-guidelines-145","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#new-committers","content":"Apache Committer FAQ"},"1907":{"id":"/docs/building-and-developing/developer-guidelines-146","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#review","content":"HBase committers should, as often as possible, attempt to review patches\nsubmitted by others. Ideally every submitted patch will get reviewed by a\ncommitter *within a few days*. If a committer reviews a patch they have not\nauthored, and believe it to be of sufficient quality, then they can commit the\npatch. Otherwise the patch should be cancelled with a clear explanation for why\nit was rejected."},"1908":{"id":"/docs/building-and-developing/developer-guidelines-147","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#review","content":"The list of submitted patches is in the\nHBase Review Queue,\nwhich is ordered by time of last modification. Committers should scan the list\nfrom top to bottom, looking for patches that they feel qualified to review and\npossibly commit. If you see a patch you think someone else is better qualified\nto review, you can mention them by username in the JIRA."},"1909":{"id":"/docs/building-and-developing/developer-guidelines-148","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#review","content":"For non-trivial changes, it is required that another committer review your\npatches before commit. &#x2A;*Self-commits of non-trivial patches are not allowed.**\nUse the **Submit Patch** button in JIRA, just like other contributors, and\nthen wait for a `+1` response from another committer before committing."},"1910":{"id":"/docs/building-and-developing/developer-guidelines-149","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#reject","content":"Patches which do not adhere to the guidelines in\nHowToContribute and to the\ncode review checklist\nshould be rejected. Committers should always be polite to contributors and try\nto instruct and encourage them to contribute better patches. If a committer\nwishes to improve an unacceptable patch, then it should first be rejected, and a\nnew patch should be attached by the committer for further review."},"1911":{"id":"/docs/building-and-developing/developer-guidelines-150","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Committers commit patches to the Apache HBase GIT repository."},"1912":{"id":"/docs/building-and-developing/developer-guidelines-151","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Make sure your local configuration is correct, especially your identity and email. Examine the\noutput of the `$ git config --list` command and be sure it is correct. See Set Up\nGit if you need pointers."},"1913":{"id":"/docs/building-and-developing/developer-guidelines-152","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"When you commit a patch:"},"1914":{"id":"/docs/building-and-developing/developer-guidelines-153","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Include the Jira issue ID in the commit message along with a short description\nof the change. Try to add something more than just the Jira title so that\nsomeone looking at `git log` output doesn't have to go to Jira to discern what\nthe change is about. Be sure to get the issue ID right, because this causes\nJira to link to the change in Git (use the issue's \"All\" tab to see these\nautomatic links)."},"1915":{"id":"/docs/building-and-developing/developer-guidelines-154","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Commit the patch to a new branch based off `master` or the other intended\nbranch. It's a good idea to include the JIRA ID in the name of this branch.\nCheck out the relevant target branch where you want to commit, and make sure\nyour local branch has all remote changes, by doing a `git pull --rebase` or\nanother similar command. Next, cherry-pick the change into each relevant\nbranch (such as master), and push the changes to the remote branch using\na command such as `git push <remote-server> <remote-branch>`."},"1916":{"id":"/docs/building-and-developing/developer-guidelines-155","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"If you do not have all remote changes, the push will fail. If the push fails for any reason,\nfix the problem or ask for help. Do not do a `git push --force`."},"1917":{"id":"/docs/building-and-developing/developer-guidelines-156","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Before you can commit a patch, you need to determine how the patch was created.\nThe instructions and preferences around the way to create patches have changed,\nand there will be a transition period."},"1918":{"id":"/docs/building-and-developing/developer-guidelines-157","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Determine How a Patch Was Created**"},"1919":{"id":"/docs/building-and-developing/developer-guidelines-158","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"If the first few lines of the patch look like the headers of an email, with a From, Date, and\nSubject, it was created using `git format-patch`. This is the preferred way, because you can\nreuse the submitter's commit message. If the commit message is not appropriate, you can still use\nthe commit, then run `git commit --amend` and reword as appropriate."},"1920":{"id":"/docs/building-and-developing/developer-guidelines-159","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"If the first line of the patch looks similar to the following, it was created using +git diff+ without `--no-prefix`.\nThis is acceptable too.\nNotice the `a` and `b` in front of the file names.\nThis is the indication that the patch was not created with `--no-prefix`."},"1921":{"id":"/docs/building-and-developing/developer-guidelines-160","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"If the first line of the patch looks similar to the following (without the `a` and `b`), the\npatch was created with `git diff --no-prefix` and you need to add `-p0` to the `git apply` command\nbelow."},"1922":{"id":"/docs/building-and-developing/developer-guidelines-161","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Example of committing a Patch**"},"1923":{"id":"/docs/building-and-developing/developer-guidelines-162","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"One thing you will notice with these examples is that there are a lot of\n`git pull` commands. The only command that actually writes anything to the\nremote repository is `git push`, and you need to make absolutely sure you have\nthe correct versions of everything and don't have any conflicts before pushing.\nThe extra `git pull` commands are usually redundant, but better safe than sorry."},"1924":{"id":"/docs/building-and-developing/developer-guidelines-163","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"The first example shows how to apply a patch that was generated with +git\nformat-patch+ and apply it to the `master` and `branch-1` branches."},"1925":{"id":"/docs/building-and-developing/developer-guidelines-164","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"The directive to use `git format-patch` rather than `git diff`, and not to use\n`--no-prefix`, is a new one. See the second example for how to apply a patch\ncreated with `git diff`, and educate the person who created the patch."},"1926":{"id":"/docs/building-and-developing/developer-guidelines-165","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"This example shows how to commit a patch that was created using `git diff`\nwithout `--no-prefix`. If the patch was created with `--no-prefix`, add `-p0` to\nthe `git apply` command."},"1927":{"id":"/docs/building-and-developing/developer-guidelines-166","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Resolve the issue as fixed, thanking the contributor.\nAlways set the \"Fix Version\" at this point, but only set a single fix version\nfor each branch where the change was committed, the earliest release in that\nbranch in which the change will appear."},"1928":{"id":"/docs/building-and-developing/developer-guidelines-167","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Commit Message Format**"},"1929":{"id":"/docs/building-and-developing/developer-guidelines-168","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"The commit message should contain the JIRA ID and a description of what the patch does.\nThe preferred commit message format is:"},"1930":{"id":"/docs/building-and-developing/developer-guidelines-169","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"If the contributor used `git format-patch` to generate the patch, their commit\nmessage is in their patch and you can use that, but be sure the JIRA ID is at\nthe front of the commit message, even if the contributor left it out."},"1931":{"id":"/docs/building-and-developing/developer-guidelines-170","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Use GitHub's \"Co-authored-by\" when there are multiple authors**"},"1932":{"id":"/docs/building-and-developing/developer-guidelines-171","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"We've established the practice of committing to master and then cherry picking back to branches whenever possible, unless"},"1933":{"id":"/docs/building-and-developing/developer-guidelines-172","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"it's breaking compat: In which case, if it can go in minor releases, backport to branch-1 and branch-2."},"1934":{"id":"/docs/building-and-developing/developer-guidelines-173","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"it's a new feature: No for maintenance releases, For minor releases, discuss and arrive at consensus."},"1935":{"id":"/docs/building-and-developing/developer-guidelines-174","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"There are occasions when there are multiple author for a patch.\nFor example when there is a minor conflict we can fix it up and just proceed with the commit.\nThe amending author will be different from the original committer, so you should also attribute to the original author by\nadding one or more `Co-authored-by` trailers to the commit's message.\nSee the GitHub documentation for \"Creating a commit with multiple authors\"."},"1936":{"id":"/docs/building-and-developing/developer-guidelines-175","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"In short, these are the steps to add Co-authors that will be tracked by GitHub:"},"1937":{"id":"/docs/building-and-developing/developer-guidelines-176","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Collect the name and email address for each co-author."},"1938":{"id":"/docs/building-and-developing/developer-guidelines-177","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Commit the change, but after your commit description, instead of a closing quotation, add two empty lines. (Do not close the commit message with a quotation mark)"},"1939":{"id":"/docs/building-and-developing/developer-guidelines-178","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"On the next line of the commit message, type `Co-authored-by: name <name@example.com>`. After the co-author information, add a closing quotation mark."},"1940":{"id":"/docs/building-and-developing/developer-guidelines-179","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Here is the example from the GitHub page, using 2 Co-authors:"},"1941":{"id":"/docs/building-and-developing/developer-guidelines-180","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Note: `Amending-Author: Author <committer@apache>` was used prior to this\nDISCUSSION."},"1942":{"id":"/docs/building-and-developing/developer-guidelines-181","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Close related GitHub PRs**"},"1943":{"id":"/docs/building-and-developing/developer-guidelines-182","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"As a project we work to ensure there's a JIRA associated with each change, but we don't mandate any particular tool be used for reviews. Due to implementation details of the ASF's integration between hosted git repositories and GitHub, the PMC has no ability to directly close PRs on our GitHub repo. In the event that a contributor makes a Pull Request on GitHub, either because the contributor finds that easier than attaching a patch to JIRA or because a reviewer prefers that UI for examining changes, it's important to make note of the PR in the commit that goes to the master branch so that PRs are kept up to date."},"1944":{"id":"/docs/building-and-developing/developer-guidelines-183","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"To read more about the details of what kinds of commit messages will work with the GitHub \"close via keyword in commit\" mechanism see the GitHub documentation for \"Closing issues using keywords\". In summary, you should include a line with the phrase \"closes #XXX\", where the XXX is the pull request id. The pull request id is usually given in the GitHub UI in grey at the end of the subject heading."},"1945":{"id":"/docs/building-and-developing/developer-guidelines-184","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Committers are responsible for making sure commits do not break the build or tests**"},"1946":{"id":"/docs/building-and-developing/developer-guidelines-185","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"If a committer commits a patch, it is their responsibility to make sure it passes the test suite.\nIt is helpful if contributors keep an eye out that their patch does not break the hbase build and/or tests, but ultimately, a contributor cannot be expected to be aware of all the particular vagaries and interconnections that occur in a project like HBase.\nA committer should."},"1947":{"id":"/docs/building-and-developing/developer-guidelines-186","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Patching Etiquette**"},"1948":{"id":"/docs/building-and-developing/developer-guidelines-187","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"In the thread HBase, mail # dev - ANNOUNCEMENT: Git Migration In Progress (WAS =>\nRe: Git Migration), it was agreed on the following patch flow"},"1949":{"id":"/docs/building-and-developing/developer-guidelines-188","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Develop and commit the patch against master first."},"1950":{"id":"/docs/building-and-developing/developer-guidelines-189","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Try to cherry-pick the patch when backporting if possible."},"1951":{"id":"/docs/building-and-developing/developer-guidelines-190","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"If this does not work, manually commit the patch to the branch."},"1952":{"id":"/docs/building-and-developing/developer-guidelines-191","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Merge Commits**"},"1953":{"id":"/docs/building-and-developing/developer-guidelines-192","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Avoid merge commits, as they create problems in the git history."},"1954":{"id":"/docs/building-and-developing/developer-guidelines-193","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**Committing Documentation**"},"1955":{"id":"/docs/building-and-developing/developer-guidelines-194","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"See appendix contributing to documentation."},"1956":{"id":"/docs/building-and-developing/developer-guidelines-195","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"**How to re-trigger github Pull Request checks/re-build**"},"1957":{"id":"/docs/building-and-developing/developer-guidelines-196","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"A Pull Request (PR) submission triggers the hbase yetus checks. The checks make\nsure the patch doesn't break the build or introduce test failures. The checks take\naround four hours to run (They are the same set run when you submit a patch via\nHBASE JIRA). When finished, they add a report to the PR as a comment. If a problem\nw/ the patch — failed compile, checkstyle violation, or an added findbugs --\nthe original author makes fixes and pushes a new patch. This re-runs the checks\nto produce a new report."},"1958":{"id":"/docs/building-and-developing/developer-guidelines-197","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#commit","content":"Sometimes though, the patch is good but a flakey, unrelated test has the report vote -1\non the patch. In this case, **committers** can retrigger the check run by doing a force push of the\nexact same patch. Or, click on the `Console output` link which shows toward the end\nof the report (For example `https://builds.apache.org/job/HBase-PreCommit-GitHub-PR/job/PR-289/1/console`).\nThis will take you to `builds.apache.org`, to the build run that failed. See the\n\"breadcrumbs\" along the top (where breadcrumbs is the listing of the directories that\ngets us to this particular build page). It'll look something like\n`Jenkins > HBase-PreCommit-GitHub-PR > PR-289 > #1`. Click on the\nPR number — i.e. PR-289 in our example — and then, when you've arrived at the PR page,\nfind the 'Build with Parameters' menu-item (along top left-hand menu). Click here and\nthen `Build` leaving the JIRA\\_ISSUE\\_KEY empty. This will re-run your checks."},"1959":{"id":"/docs/building-and-developing/developer-guidelines-198","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#dialog","content":"Committers should hang out in the #hbase room on irc.freenode.net for real-time discussions.\nHowever any substantive discussion (as with any off-list project-related discussion) should be re-iterated in Jira or on the developer list."},"1960":{"id":"/docs/building-and-developing/developer-guidelines-199","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#do-not-edit-jira-comments","content":"Misspellings and/or bad grammar is preferable to the disruption a JIRA comment edit."},"1961":{"id":"/docs/building-and-developing/developer-guidelines-200","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"A new project was created for the release of hbase-2.0.0. It was called\n`hbase-thirdparty`. This project exists only to provide the main hbase\nproject with relocated — or shaded — versions of popular thirdparty\nlibraries such as guava, netty, and protobuf. The mainline HBase project\nrelies on the relocated versions of these libraries gotten from hbase-thirdparty\nrather than on finding these classes in their usual locations. We do this so\nwe can specify whatever the version we wish. If we don't relocate, we must\nharmonize our version to match that which hadoop, spark, and other projects use."},"1962":{"id":"/docs/building-and-developing/developer-guidelines-201","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"For developers, this means you need to be careful referring to classes from\nnetty, guava, protobuf, gson, etc. (see the hbase-thirdparty pom.xml for what\nit provides). Devs must refer to the hbase-thirdparty provided classes. In\npractice, this is usually not an issue (though it can be a bit of a pain). You\nwill have to hunt for the relocated version of your particular class. You'll\nfind it by prepending the general relocation prefix of `org.apache.hbase.thirdparty.`.\nFor example if you are looking for `com.google.protobuf.Message`, the relocated\nversion used by HBase internals can be found at\n`org.apache.hbase.thirdparty.com.google.protobuf.Message`."},"1963":{"id":"/docs/building-and-developing/developer-guidelines-202","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"For a few thirdparty libs, like protobuf (see the protobuf chapter in this book\nfor the why), your IDE may give you both options — the `com.google.protobuf.*`\nand the `org.apache.hbase.thirdparty.com.google.protobuf.*` — because both\nclasses are on your CLASSPATH. Unless you are doing the particular juggling\nrequired in Coprocessor Endpoint development (again see above cited protobuf\nchapter), you'll want to use the shaded version, always."},"1964":{"id":"/docs/building-and-developing/developer-guidelines-203","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"The `hbase-thirdparty` project has groupid of `org.apache.hbase.thirdparty`.\nAs of this writing, it provides three jars; one for netty with an artifactid of\n`hbase-thirdparty-netty`, one for protobuf at `hbase-thirdparty-protobuf` and then\na jar for all else — gson, guava — at `hbase-thirdpaty-miscellaneous`."},"1965":{"id":"/docs/building-and-developing/developer-guidelines-204","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#the-hbase-thirdparty-dependency-and-shadingrelocation","content":"The hbase-thirdparty artifacts are a product produced by the Apache HBase\nproject under the aegis of the HBase Project Management Committee. Releases\nare done via the usual voting project on the hbase dev mailing list. If issue\nin the hbase-thirdparty, use the hbase JIRA and mailing lists to post notice."},"1966":{"id":"/docs/building-and-developing/developer-guidelines-205","page_id":"/docs/building-and-developing/developer-guidelines","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/developer-guidelines#development-of-hbase-related-maven-archetypes","content":"The development of HBase-related Maven archetypes was begun with\nHBASE-14876.\nFor an overview of the hbase-archetypes infrastructure and instructions\nfor developing new HBase-related Maven archetypes, please see\n`hbase/hbase-archetypes/README.md`."},"1967":{"id":"/docs/building-and-developing/generating-documentation","page_id":"/docs/building-and-developing/generating-documentation","type":"page","content":"Generating the HBase Reference Guide","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/generating-documentation"},"1968":{"id":"/docs/building-and-developing/generating-documentation-0","page_id":"/docs/building-and-developing/generating-documentation","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/generating-documentation","content":"Building HBase documentation from MDX markup."},"1969":{"id":"/docs/building-and-developing/generating-documentation-1","page_id":"/docs/building-and-developing/generating-documentation","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/generating-documentation","content":"The manual is marked up using MDX (just extended markdown).\nThen we render markdown into HTML content by using Fumadocs.\nTo build run `mvn site` from the root or `hbase-website` directory.\nSee appendix contributing to documentation for more information on building the documentation."},"1970":{"id":"/docs/building-and-developing/getting-involved","page_id":"/docs/building-and-developing/getting-involved","type":"page","content":"Getting Involved","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/getting-involved"},"1971":{"id":"/docs/building-and-developing/getting-involved-0","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved","content":"How to contribute to Apache HBase including mailing lists, Slack, IRC, JIRA, and guidelines for reporting effective issues."},"1972":{"id":"/docs/building-and-developing/getting-involved-1","page_id":"/docs/building-and-developing/getting-involved","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-mailing-lists","content":"Mailing Lists"},"1973":{"id":"/docs/building-and-developing/getting-involved-2","page_id":"/docs/building-and-developing/getting-involved","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-slack","content":"Slack"},"1974":{"id":"/docs/building-and-developing/getting-involved-3","page_id":"/docs/building-and-developing/getting-involved","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/getting-involved#internet-relay-chat-irc","content":"Internet Relay Chat (IRC)"},"1975":{"id":"/docs/building-and-developing/getting-involved-4","page_id":"/docs/building-and-developing/getting-involved","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"Jira"},"1976":{"id":"/docs/building-and-developing/getting-involved-5","page_id":"/docs/building-and-developing/getting-involved","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"Guidelines for reporting effective issues"},"1977":{"id":"/docs/building-and-developing/getting-involved-6","page_id":"/docs/building-and-developing/getting-involved","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"Working on an issue"},"1978":{"id":"/docs/building-and-developing/getting-involved-7","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved","content":"Apache HBase gets better only when people contribute! If you are looking to contribute to Apache HBase, look for issues in JIRA tagged with the label 'beginner'.\nThese are issues HBase contributors have deemed worthy but not of immediate priority and a good way to ramp on HBase internals.\nSee What label\nis used for issues that are good on ramps for new contributors? from the dev mailing list for background."},"1979":{"id":"/docs/building-and-developing/getting-involved-8","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved","content":"Before you get started submitting code to HBase, please refer to Developer Guidelines."},"1980":{"id":"/docs/building-and-developing/getting-involved-9","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved","content":"As Apache HBase is an Apache Software Foundation project, see The Apache Software Foundation for more information about how the ASF functions."},"1981":{"id":"/docs/building-and-developing/getting-involved-10","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-mailing-lists","content":"Sign up for the dev-list and the user-list.\nSee the mailing lists page.\nPosing questions - and helping to answer other people's questions - is encouraged! There are varying levels of experience on both lists so patience and politeness are encouraged (and please stay on topic.)"},"1982":{"id":"/docs/building-and-developing/getting-involved-11","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-slack","content":"The Apache HBase project uses the #hbase channel on the official\nASF Slack Workspace for real-time questions and discussion.\nAll committers of any Apache projects can join the channel directly, for others, please mail\ndev\\@hbase.apache.org to request an invite."},"1983":{"id":"/docs/building-and-developing/getting-involved-12","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#internet-relay-chat-irc","content":"(NOTE: Our IRC channel seems to have been deprecated in favor of the above Slack channel)"},"1984":{"id":"/docs/building-and-developing/getting-involved-13","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#internet-relay-chat-irc","content":"For real-time questions and discussions, use the `#hbase` IRC channel on the FreeNode IRC network.\nFreeNode offers a web-based client, but most people prefer a native client, and several clients are available for each operating system."},"1985":{"id":"/docs/building-and-developing/getting-involved-14","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"Check for existing issues in Jira.\nIf it's either a new feature request, enhancement, or a bug, file a ticket."},"1986":{"id":"/docs/building-and-developing/getting-involved-15","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"We track multiple types of work in JIRA:"},"1987":{"id":"/docs/building-and-developing/getting-involved-16","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"Bug: Something is broken in HBase itself."},"1988":{"id":"/docs/building-and-developing/getting-involved-17","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"Test: A test is needed, or a test is broken."},"1989":{"id":"/docs/building-and-developing/getting-involved-18","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"New feature: You have an idea for new functionality. It's often best to bring\nthese up on the mailing lists first, and then write up a design specification\nthat you add to the feature request JIRA."},"1990":{"id":"/docs/building-and-developing/getting-involved-19","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"Improvement: A feature exists, but could be tweaked or augmented. It's often\nbest to bring these up on the mailing lists first and have a discussion, then\nsummarize or link to the discussion if others seem interested in the\nimprovement."},"1991":{"id":"/docs/building-and-developing/getting-involved-20","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"Wish: This is like a new feature, but for something you may not have the\nbackground to flesh out yourself."},"1992":{"id":"/docs/building-and-developing/getting-involved-21","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#building-and-developing-getting-involved-jira","content":"Bugs and tests have the highest priority and should be actionable."},"1993":{"id":"/docs/building-and-developing/getting-involved-22","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"*Search for duplicates*: Your issue may have already been reported. Have a\nlook, realizing that someone else might have worded the summary differently."},"1994":{"id":"/docs/building-and-developing/getting-involved-23","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"Also search the mailing lists, which may have information about your problem\nand how to work around it. Don't file an issue for something that has already\nbeen discussed and resolved on a mailing list, unless you strongly disagree\nwith the resolution *and* are willing to help take the issue forward."},"1995":{"id":"/docs/building-and-developing/getting-involved-24","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"*Discuss in public*: Use the mailing lists to discuss what you've discovered\nand see if there is something you've missed. Avoid using back channels, so\nthat you benefit from the experience and expertise of the project as a whole."},"1996":{"id":"/docs/building-and-developing/getting-involved-25","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"*Don't file on behalf of others*: You might not have all the context, and you\ndon't have as much motivation to see it through as the person who is actually\nexperiencing the bug. It's more helpful in the long term to encourage others\nto file their own issues. Point them to this material and offer to help out\nthe first time or two."},"1997":{"id":"/docs/building-and-developing/getting-involved-26","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"*Write a good summary*: A good summary includes information about the problem,\nthe impact on the user or developer, and the area of the code."},"1998":{"id":"/docs/building-and-developing/getting-involved-27","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"Good: `Address new license dependencies from hadoop3-alpha4`"},"1999":{"id":"/docs/building-and-developing/getting-involved-28","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"Room for improvement: `Canary is broken`\nIf you write a bad title, someone else will rewrite it for you. This is time\nthey could have spent working on the issue instead."},"2000":{"id":"/docs/building-and-developing/getting-involved-29","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"*Give context in the description*: It can be good to think of this in multiple\nparts:"},"2001":{"id":"/docs/building-and-developing/getting-involved-30","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"What happens or doesn't happen?"},"2002":{"id":"/docs/building-and-developing/getting-involved-31","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"How does it impact you?"},"2003":{"id":"/docs/building-and-developing/getting-involved-32","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"How can someone else reproduce it?"},"2004":{"id":"/docs/building-and-developing/getting-involved-33","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"What would \"fixed\" look like?\\\nYou don't need to know the answers for all of these, but give as much\ninformation as you can. If you can provide technical information, such as a\nGit commit SHA that you think might have caused the issue or a build failure\non builds.apache.org where you think the issue first showed up, share that\ninfo."},"2005":{"id":"/docs/building-and-developing/getting-involved-34","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"**Fill in all relevant fields**: These fields help us filter, categorize, and\nfind things."},"2006":{"id":"/docs/building-and-developing/getting-involved-35","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"**One bug, one issue, one patch**: To help with back-porting, don't split issues\nor fixes among multiple bugs."},"2007":{"id":"/docs/building-and-developing/getting-involved-36","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"**Add value if you can**: Filing issues is great, even if you don't know how to\nfix them. But providing as much information as possible, being willing to\ntriage and answer questions, and being willing to test potential fixes is even\nbetter! We want to fix your issue as quickly as you want it to be fixed."},"2008":{"id":"/docs/building-and-developing/getting-involved-37","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#guidelines-for-reporting-effective-issues","content":"**Don't be upset if we don't fix it**: Time and resources are finite. In some\ncases, we may not be able to (or might choose not to) fix an issue, especially\nif it is an edge case or there is a workaround. Even if it doesn't get fixed,\nthe JIRA is a public record of it, and will help others out if they run into\na similar issue in the future."},"2009":{"id":"/docs/building-and-developing/getting-involved-38","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"To check for existing issues which you can tackle as a beginner, search for issues in JIRA tagged with the label 'beginner'."},"2010":{"id":"/docs/building-and-developing/getting-involved-39","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"JIRA Priorites:"},"2011":{"id":"/docs/building-and-developing/getting-involved-40","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"**Blocker**: Should only be used if the issue WILL cause data loss or cluster instability reliably."},"2012":{"id":"/docs/building-and-developing/getting-involved-41","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"**Critical**: The issue described can cause data loss or cluster instability in some cases."},"2013":{"id":"/docs/building-and-developing/getting-involved-42","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"**Major**: Important but not tragic issues, like updates to the client API that will add a lot of much-needed functionality or significant bugs that need to be fixed but that don't cause data loss."},"2014":{"id":"/docs/building-and-developing/getting-involved-43","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"**Minor**: Useful enhancements and annoying but not damaging bugs."},"2015":{"id":"/docs/building-and-developing/getting-involved-44","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"**Trivial**: Useful enhancements but generally cosmetic."},"2016":{"id":"/docs/building-and-developing/getting-involved-45","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"Code Blocks in Jira Comments:"},"2017":{"id":"/docs/building-and-developing/getting-involved-46","page_id":"/docs/building-and-developing/getting-involved","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/getting-involved#working-on-an-issue","content":"A commonly used macro in Jira is `{code}`. Everything inside the tags is preformatted, as in this example."},"2018":{"id":"/docs/building-and-developing/ides","page_id":"/docs/building-and-developing/ides","type":"page","content":"IDEs","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/ides"},"2019":{"id":"/docs/building-and-developing/ides-0","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides","content":"Setting up Eclipse and IntelliJ IDEA for HBase development including formatters, plugins, and Maven integration."},"2020":{"id":"/docs/building-and-developing/ides-1","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#eclipse","content":"Eclipse"},"2021":{"id":"/docs/building-and-developing/ides-2","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#code-formatting","content":"Code Formatting"},"2022":{"id":"/docs/building-and-developing/ides-3","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#eclipse-git-plugin","content":"Eclipse Git Plugin"},"2023":{"id":"/docs/building-and-developing/ides-4","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"HBase Project Setup in Eclipse using `m2eclipse`"},"2024":{"id":"/docs/building-and-developing/ides-5","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-the-command-line","content":"HBase Project Setup in Eclipse Using the Command Line"},"2025":{"id":"/docs/building-and-developing/ides-6","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#maven-classpath-variable","content":"Maven Classpath Variable"},"2026":{"id":"/docs/building-and-developing/ides-7","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#eclipse-known-issues","content":"Eclipse Known Issues"},"2027":{"id":"/docs/building-and-developing/ides-8","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#eclipse---more-information","content":"Eclipse - More Information"},"2028":{"id":"/docs/building-and-developing/ides-9","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#intellij-idea","content":"IntelliJ IDEA"},"2029":{"id":"/docs/building-and-developing/ides-10","page_id":"/docs/building-and-developing/ides","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/ides#other-ides","content":"Other IDEs"},"2030":{"id":"/docs/building-and-developing/ides-11","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#code-formatting","content":"Under the &#x2A;dev-support/* folder, you will find *hbase\\_eclipse\\_formatter.xml*.\nWe encourage you to have this formatter in place in eclipse when editing HBase code."},"2031":{"id":"/docs/building-and-developing/ides-12","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#code-formatting","content":"Go to `Preferences->Java->Code Style->Formatter->Import` to load the xml file.\nGo to `Preferences->Java->Editor->Save Actions`, and make sure 'Format source code' and 'Format\nedited lines' is selected."},"2032":{"id":"/docs/building-and-developing/ides-13","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#code-formatting","content":"In addition to the automatic formatting, make sure you follow the style guidelines explained in\nCode Formatting Conventions."},"2033":{"id":"/docs/building-and-developing/ides-14","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#eclipse-git-plugin","content":"If you cloned the project via git, download and install the Git plugin (EGit). Attach to your local git repo (via the Git Repositories window) and you'll be able to see file revision history, generate patches, etc."},"2034":{"id":"/docs/building-and-developing/ides-15","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"The easiest way is to use the `m2eclipse` plugin for Eclipse.\nEclipse Indigo or newer includes +m2eclipse+, or you can download it from http\\://www\\.eclipse.org/m2e/. It provides Maven integration for Eclipse, and even lets you use the direct Maven commands from within Eclipse to compile and test your project."},"2035":{"id":"/docs/building-and-developing/ides-16","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"To import the project, click and select the HBase root directory. `m2eclipse` locates all the hbase modules for you."},"2036":{"id":"/docs/building-and-developing/ides-17","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"If you install `m2eclipse` and import HBase in your workspace, do the following to fix your eclipse Build Path."},"2037":{"id":"/docs/building-and-developing/ides-18","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"Remove *target* folder"},"2038":{"id":"/docs/building-and-developing/ides-19","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"Add *target/generated-sources/java* folder."},"2039":{"id":"/docs/building-and-developing/ides-20","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"Remove from your Build Path the exclusions on the *src/main/resources* and *src/test/resources* to avoid error message in the console, such as the following:"},"2040":{"id":"/docs/building-and-developing/ides-21","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-m2eclipse","content":"This will also reduce the eclipse build cycles and make your life easier when developing."},"2041":{"id":"/docs/building-and-developing/ides-22","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-the-command-line","content":"Instead of using `m2eclipse`, you can generate the Eclipse files from the command line."},"2042":{"id":"/docs/building-and-developing/ides-23","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-the-command-line","content":"First, run the following command, which builds HBase.\nYou only need to do this once."},"2043":{"id":"/docs/building-and-developing/ides-24","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-the-command-line","content":"Close Eclipse, and execute the following command from the terminal, in your local HBase project directory, to generate new *.project&#x2A; and *.classpath* files."},"2044":{"id":"/docs/building-and-developing/ides-25","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#hbase-project-setup-in-eclipse-using-the-command-line","content":"Reopen Eclipse and import the *.project* file in the HBase directory to a workspace."},"2045":{"id":"/docs/building-and-developing/ides-26","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#maven-classpath-variable","content":"The `$M2_REPO&#x60; classpath variable needs to be set up for the project.\nThis needs to be set to your local Maven repository, which is usually *\\~/.m2/repository*"},"2046":{"id":"/docs/building-and-developing/ides-27","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#maven-classpath-variable","content":"If this classpath variable is not configured, you will see compile errors in Eclipse like this:"},"2047":{"id":"/docs/building-and-developing/ides-28","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#eclipse-known-issues","content":"Eclipse will currently complain about *Bytes.java*.\nIt is not possible to turn these errors off."},"2048":{"id":"/docs/building-and-developing/ides-29","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#eclipse---more-information","content":"For additional information on setting up Eclipse for HBase development on Windows, see Michael Morello's blog on the topic."},"2049":{"id":"/docs/building-and-developing/ides-30","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"A functional development environment can be setup around an IntelliJ IDEA installation that has the\nplugins necessary for building Java projects with Maven."},"2050":{"id":"/docs/building-and-developing/ides-31","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"Use either File > New > \"Project from Existing Sources...\" or \"Project From Version Control..\""},"2051":{"id":"/docs/building-and-developing/ides-32","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"Depending on your version of IntelliJ, you may need to choose Maven as the \"project\" or \"model\"\ntype."},"2052":{"id":"/docs/building-and-developing/ides-33","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"The following plugins are recommended:"},"2053":{"id":"/docs/building-and-developing/ides-34","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"Maven, bundled. This allows IntelliJ to resolve dependencies and recognize the project structure."},"2054":{"id":"/docs/building-and-developing/ides-35","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"EditorConfig, bundled. This will apply project whitespace settings found in the\n`.editorconfig` file available on branches with\nHBASE-23234 or later."},"2055":{"id":"/docs/building-and-developing/ides-36","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"Checkstyle-IDEA. Configure this\nagainst the configuration file found under `hbase-checkstyle/src/main/resources/hbase/checkstyle.xml`\n(If the Intellij checkstyle plugin complains parsing the volunteered hbase `checkstyle.xml`, make\nsure the plugin's `version` popup menu matches the hbase checkstyle version. Find the current\ncheckstyle version as a property in `pom.xml`.\nThis plugin will highlight style errors in the IDE, so you can fix them before they get flagged during the\npre-commit process."},"2056":{"id":"/docs/building-and-developing/ides-37","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"Protobuf Support. HBase uses\nProtocol Buffers in a number of places where\nserialization is required. This plugin is helpful when editing these object definitions."},"2057":{"id":"/docs/building-and-developing/ides-38","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#intellij-idea","content":"MDX. HBase uses\nMDX (just extended markdown) for building it's project documentation. This plugin is helpful\nwhen editing this book."},"2058":{"id":"/docs/building-and-developing/ides-39","page_id":"/docs/building-and-developing/ides","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/ides#other-ides","content":"If you'd have another environment with which you'd like to develop on HBase, please consider\ndocumenting your setup process here."},"2059":{"id":"/docs/building-and-developing","page_id":"/docs/building-and-developing","type":"page","content":"Building and Developing Apache HBase","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing"},"2060":{"id":"/docs/building-and-developing-0","page_id":"/docs/building-and-developing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing","content":"Comprehensive guide for building, testing, releasing, and contributing to Apache HBase."},"2061":{"id":"/docs/building-and-developing-1","page_id":"/docs/building-and-developing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing","content":"This chapter contains information and guidelines for building and releasing HBase code and documentation.\nBeing familiar with these guidelines will help the HBase committers to use your contributions more easily."},"2062":{"id":"/docs/building-and-developing/releasing","page_id":"/docs/building-and-developing/releasing","type":"page","content":"Releasing Apache HBase","breadcrumbs":["Docs","Multi-Page Documentation","Operations & Development","Building and Developing Apache HBase"],"tags":["multi-page"],"url":"/docs/building-and-developing/releasing"},"2063":{"id":"/docs/building-and-developing/releasing-0","page_id":"/docs/building-and-developing/releasing","tags":["multi-page"],"type":"text","url":"/docs/building-and-developing/releasing","content":"Complete guide to creating HBase release candidates including building, signing, staging artifacts, and publishing releases."},"2064":{"id":"/docs/building-and-developing/releasing-1","page_id":"/docs/building-and-developing/releasing","type":"heading","tags":["multi-page"],"url":"/docs/building-and-developing/releasing#making-a-release-candidate","content":"Making a Release Candidate"},"2065":{"id":"/docs/bui